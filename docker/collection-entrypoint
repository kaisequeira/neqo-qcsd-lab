#!/bin/sh
set -eu

uid="${QCSD_LAB_UID:?QCSD_LAB_UID is required}"
gid="${QCSD_LAB_GID:?QCSD_LAB_GID is required}"
scheduler_contract="${QCSD_CAPTURE_SCHEDULER_CONTRACT:-}"
orchestrator_cpu=11
if [ "${scheduler_contract}" = qcsd-client-rr1-portable-etf-helper-v3 ] ||
   [ "${scheduler_contract}" = qcsd-client-rr1-portable-etf-helper-v4 ]; then
  client_cpu="${QCSD_CAPTURE_CLIENT_CPU:-}"
  orchestrator_cpu="${QCSD_CAPTURE_ORCHESTRATOR_CPU:-}"
  /usr/bin/python3 -I -c '
import os
import re
import sys

contract, client_text, helper_text = sys.argv[1:]
if not all(re.fullmatch(r"[1-9][0-9]*", value) for value in (client_text, helper_text)):
    raise SystemExit("portable capture scheduler CPUs must be positive decimal indices")
client, helper = int(client_text), int(helper_text)
if contract.endswith("-v3") and helper != client + 1:
    raise SystemExit("portable capture scheduler CPUs must be adjacent")
if helper <= client:
    raise SystemExit("portable capture scheduler helper CPU must follow the client CPU")
available = os.sched_getaffinity(0)
if available != {client, helper}:
    raise SystemExit(
        "portable capture scheduler requires the container affinity to be exactly "
        f"CPUs {client} and {helper}; observed {sorted(available)}. "
        "The daemon CPU affinity changed after the prelaunch probe; "
        "rerun capture with a fresh CPU-ID observation"
    )
' "${scheduler_contract}" "${client_cpu}" "${orchestrator_cpu}"
fi

case "${scheduler_contract}" in
  "") ;;
  qcsd-client-rr1-cpu10-v1)
    exec setpriv \
      --reuid "${uid}" \
      --regid "${gid}" \
      --clear-groups \
      --bounding-set=-all,+net_raw,+net_admin \
      --inh-caps=+net_raw,+net_admin \
      --ambient-caps=+net_raw,+net_admin \
      --no-new-privs \
      taskset --cpu-list "${orchestrator_cpu}" qcsd-lab-internal "$@"
    ;;
  qcsd-client-rr1-cpu10-etf-helper-cpu11-v1|qcsd-client-rr1-portable-etf-helper-v3|qcsd-client-rr1-portable-etf-helper-v4)
    # CAP_SETPCAP is retained only by the orchestration/setup lineage so the
    # measured Rust client can irrevocably remove its temporary NET_ADMIN and
    # SETPCAP bounding bits after configuring SO_TXTIME(CLOCK_TAI).  The
    # completed-run receipt must prove all capability sets are then empty.
    if [ -n "${QCSD_KERNEL_TX_PUBLIC_ROUTER_IP:-}" ]; then
      : "${QCSD_KERNEL_TX_PUBLIC_CLIENT_SUBNET:?QCSD_KERNEL_TX_PUBLIC_CLIENT_SUBNET is required}"
      # A user-defined Docker bridge normally installs its own gateway.  Flush
      # every default before adding the measured router so no public datagram
      # can bypass the independent post-veth observer.
      ip -4 route flush default
      ip -4 route add default via "${QCSD_KERNEL_TX_PUBLIC_ROUTER_IP}" dev eth0
      ip -j -4 route show default | /usr/bin/python3 -c '
import json
import sys

routes = json.load(sys.stdin)
expected = sys.argv[1]
if (
    not isinstance(routes, list)
    or len(routes) != 1
    or routes[0].get("dst") != "default"
    or routes[0].get("gateway") != expected
    or routes[0].get("dev") != "eth0"
):
    raise SystemExit("public kernel-TX client default route is not exclusive")
' "${QCSD_KERNEL_TX_PUBLIC_ROUTER_IP}"
      ip -4 route show "${QCSD_KERNEL_TX_PUBLIC_CLIENT_SUBNET}" | grep -F \
        "${QCSD_KERNEL_TX_PUBLIC_CLIENT_SUBNET} dev eth0" >/dev/null
    fi
    exec setpriv \
      --reuid "${uid}" \
      --regid "${gid}" \
      --clear-groups \
      --bounding-set=-all,+net_raw,+net_admin,+setpcap \
      --inh-caps=+net_raw,+net_admin,+setpcap \
      --ambient-caps=+net_raw,+net_admin,+setpcap \
      --no-new-privs \
      taskset --cpu-list "${orchestrator_cpu}" qcsd-lab-internal "$@"
    ;;
  *)
    echo "unsupported capture scheduler contract: ${scheduler_contract}" >&2
    exit 1
    ;;
esac

exec setpriv \
  --reuid "${uid}" \
  --regid "${gid}" \
  --clear-groups \
  --bounding-set=-all,+net_raw,+net_admin \
  --inh-caps=+net_raw,+net_admin \
  --ambient-caps=+net_raw,+net_admin \
  --no-new-privs \
  qcsd-lab-internal "$@"
