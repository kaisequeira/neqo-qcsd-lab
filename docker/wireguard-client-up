#!/bin/sh
set -eu

: "${QCSD_WG_CLIENT_PRIVATE_KEY:?QCSD_WG_CLIENT_PRIVATE_KEY is required}"
: "${QCSD_WG_GATEWAY_PUBLIC_KEY:?QCSD_WG_GATEWAY_PUBLIC_KEY is required}"
: "${QCSD_WG_GATEWAY_ADDRESS:?QCSD_WG_GATEWAY_ADDRESS is required}"

client_port="${QCSD_WG_CLIENT_PORT:-51821}"
gateway_port="${QCSD_WG_GATEWAY_PORT:-51820}"
default_gateway="$(ip -4 route show default | awk 'NR == 1 {print $3}')"
default_device="$(ip -4 route show default | awk 'NR == 1 {print $5}')"
test -n "${default_gateway}" && test -n "${default_device}"

key_file="$(mktemp)"
trap 'rm -f "${key_file}"' EXIT
chmod 600 "${key_file}"
printf '%s\n' "${QCSD_WG_CLIENT_PRIVATE_KEY}" > "${key_file}"

wireguard-go wg0
ip address add 10.203.0.2/24 dev wg0
wg set wg0 private-key "${key_file}" listen-port "${client_port}" \
  peer "${QCSD_WG_GATEWAY_PUBLIC_KEY}" \
  endpoint "${QCSD_WG_GATEWAY_ADDRESS}:${gateway_port}" \
  allowed-ips 0.0.0.0/0
ip link set mtu 1420 up dev wg0
ip route add "${QCSD_WG_GATEWAY_ADDRESS}/32" via "${default_gateway}" dev "${default_device}"
ip route replace default dev wg0

# Docker's loopback resolver would bypass the measured tunnel. A public DNS
# resolver address follows the default wg0 route and is therefore encrypted.
printf 'nameserver 1.1.1.1\nnameserver 1.0.0.1\noptions timeout:2 attempts:2\n' > /etc/resolv.conf
ping -c 1 -W 5 1.1.1.1 >/dev/null
latest="$(wg show wg0 latest-handshakes | awk 'NR == 1 {print $2}')"
test -n "${latest}" && test "${latest}" -gt 0
