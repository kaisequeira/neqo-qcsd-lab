#!/bin/sh
set -eu

: "${QCSD_WG_GATEWAY_PRIVATE_KEY:?QCSD_WG_GATEWAY_PRIVATE_KEY is required}"
: "${QCSD_WG_CLIENT_PUBLIC_KEY:?QCSD_WG_CLIENT_PUBLIC_KEY is required}"

gateway_port="${QCSD_WG_GATEWAY_PORT:-51820}"
key_file="$(mktemp)"
trap 'rm -f "${key_file}"' EXIT
chmod 600 "${key_file}"
printf '%s\n' "${QCSD_WG_GATEWAY_PRIVATE_KEY}" > "${key_file}"

wireguard-go wg0
ip address add 10.203.0.1/24 dev wg0
wg set wg0 private-key "${key_file}" listen-port "${gateway_port}" \
  peer "${QCSD_WG_CLIENT_PUBLIC_KEY}" allowed-ips 10.203.0.2/32
ip link set mtu 1420 up dev wg0
iptables -A FORWARD -i wg0 -o eth0 -j ACCEPT
iptables -A FORWARD -i eth0 -o wg0 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
iptables -t nat -A POSTROUTING -s 10.203.0.0/24 -o eth0 -j MASQUERADE

test_server_ports="${QCSD_WG_TEST_SERVER_PORTS:-${QCSD_WG_TEST_SERVER_PORT:-}}"
for port in ${test_server_ports}; do
  neqo-server "10.203.0.1:${port}" >"/tmp/neqo-server-${port}.log" 2>&1 &
done

exec sleep infinity
