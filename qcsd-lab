QCSD_DOCKER_IDS_SIDECARS=()
cleanup_sidecars() {
  local cleanup_status=0
  local cid state
  for cid in "${QCSD_DOCKER_IDS_SIDECARS[@]}"; do
    if [[ ! "${cid}" =~ ^[0-9a-f]{64}$ ]]; then
      echo "refusing malformed Docker sidecar identity ${cid}" >&2
      cleanup_status=1
      continue
    fi
    state="$(_qcsd_docker_exact_id_presence "${cid}")"
    if [[ "${state}" == "unknown" ]]; then
      echo "Docker sidecar ${cid} disappeared before teardown (${state})" >&2
      cleanup_status=1
      continue
    fi
    if [[ "${state}" == "present" ]]; then
      _qcsd_docker_api rm --force "${cid}" >/dev/null 2>&1 || true
    else
      echo "Docker sidecar ${cid} disappeared before teardown (${state})" >&2
      cleanup_status=1
    fi
    state="$(_qcsd_docker_exact_id_presence "${cid}")"
    if [[ "${state}" != "absent" ]]; then
      echo "Docker sidecar ${cid} teardown state is ${state}" >&2
      cleanup_status=1
    elif ! qcsd_retire_docker_handoff \
        run "${cid}" QCSD_DOCKER_IDS_SIDECARS; then
      echo "Docker sidecar ${cid} handoff retirement failed" >&2
      cleanup_status=1
    fi
  done
  return "${cleanup_status}"
}

