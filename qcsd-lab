  mapfile -t cleanup_fields <<<"${cleanup_output}"
  (( ${#cleanup_fields[@]} >= 2 )) || return 1
  network_id="${cleanup_fields[0]}"
  volume_name="${cleanup_fields[1]}"
  for stale_id in "${cleanup_fields[@]:2}"; do
    _qcsd_docker_api container rm --force "${stale_id}" >/dev/null || return 1
  done
  if [[ "${network_id}" != none ]]; then
    _qcsd_docker_api network rm "${network_id}" >/dev/null || return 1
  fi
  if [[ "${volume_name}" != none ]]; then
    _qcsd_docker_api volume rm "${volume_name}" >/dev/null || return 1
  fi
  container_id_output="$(_qcsd_docker_api ps --all --quiet --no-trunc \
      --filter label=org.qcsd.owner=qcsd-lab \
      --filter label=org.qcsd.study=classifier-multiorigin100-v1 \
