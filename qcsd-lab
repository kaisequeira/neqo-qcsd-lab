        qualification_cohort_version="${argument}"
      else
        qualification_destinations=$((qualification_destinations + 1))
      fi
      qualification_expect=""
      continue
    fi
    case "${argument}" in
      --controlled-result) qualification_expect="controlled-result" ;;
      --destination) qualification_expect="destination" ;;
      --cohort-version) qualification_expect="cohort-version" ;;
      --cohort-version=*)
        qualification_cohort_versions=$((qualification_cohort_versions + 1))
        if [[ ${qualification_cohort_versions} -ne 1 ]]; then
          echo "buflo-study qualify accepts at most one --cohort-version value" >&2
          exit 2
