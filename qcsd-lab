if [[ "${1:-}" == "class-study" &&
      "${class_study_action}" == "acquisition-admission" ]]; then
  # The first verifier pass cannot mutate Docker or the lifecycle namespace.
  # The guarded inner repeats it immediately before authenticated stale-state
  # recovery once the separate Docker lifecycle authority has been acquired.
  require_docker
  # The first pass execs the guardian and never returns.  Reaching here means
  # the guarded inner process consumed exact GO and repeated the scoped watch
  # check inside require_docker; the inherited authority is no longer needed.
  unset QCSD_CLASS_WATCH_STATE_ROOT QCSD_CLASS_WATCH_SCOPE_ROOT
  unset QCSD_CLASS_WATCH_REQUEST_AUTHORITY QCSD_CLASS_WATCH_ACTION_SHA256
  unset QCSD_CLASS_WATCH_SOURCE_BINDING_SHA256
  class_admission_observed_server_id="$(_qcsd_docker_api info --format '{{.ID}}')" ||
    class_admission_observed_server_id=""
  if [[ "${class_admission_observed_server_id}" != \
        "${_QCSD_DOCKER_PINNED_SERVER_ID}" ]]; then
    echo "class-study acquisition-admission Docker daemon changed before publication" >&2
    exit 1
  fi
  IFS= read -r class_admission_boot_id </proc/sys/kernel/random/boot_id ||
    class_admission_boot_id=""
  if [[ ! "${class_admission_boot_id}" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
    echo "class-study acquisition-admission cannot bind the host boot identity" >&2
    exit 1
  fi
  printf '{\n'
  printf '  "artifact_type": "qcsd-class-study-docker-admission",\n'
  printf '  "docker_context": "%s",\n' "${_QCSD_DOCKER_PINNED_CONTEXT}"
  printf '  "docker_host": "%s",\n' "${_QCSD_DOCKER_PINNED_HOST}"
  printf '  "docker_server_id": "%s",\n' "${_QCSD_DOCKER_PINNED_SERVER_ID}"
  printf '  "host_boot_id": "%s",\n' "${class_admission_boot_id}"
  printf '  "schema_version": 1\n'
  printf '}\n'
  exit 0
fi

