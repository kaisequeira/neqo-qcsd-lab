vector=value["vector"]
print(vector["vector_id"])
print(vector["ordinal"])
print(value["global_ordinal"])
print(value["attempt_number"])
print(vector["family"])
launch=vector.get("browser_launch_contract")
if not isinstance(launch,dict):
