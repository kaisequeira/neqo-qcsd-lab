declare -A class_path_hosts=()

class_host_path() {
  python3 -I -c '
import os
import sys
from pathlib import Path

root = Path(sys.argv[1])
raw = Path(sys.argv[2])
container_root = Path("/lab")
if raw == container_root:
    raise SystemExit("class-study rejects the /lab container root as an explicit path")
if raw.is_absolute() and raw.is_relative_to(container_root):
    raw = root / raw.relative_to(container_root)
candidate = Path(os.path.abspath(raw if raw.is_absolute() else root / raw))
try:
    if os.path.commonpath((str(root), str(candidate))) != str(root):
        raise ValueError
except ValueError:
    raise SystemExit("class-study path is outside the Lab root")
if candidate == root:
    raise SystemExit("class-study rejects the workspace root as an explicit path")
cursor = root
for component in candidate.relative_to(root).parts:
    cursor /= component
    if cursor.is_symlink():
        raise SystemExit(f"class-study path traverses a symlink: {cursor}")
print(candidate)
' "${ROOT}" "$1"
}

class_container_path() {
  local host_path="$1"
  printf '/lab/%s\n' "${host_path#${ROOT}/}"
}

class_add_unique() {
  local -n target_array="$1"
  local value="$2"
  local existing
  for existing in "${target_array[@]:-}"; do
    if [[ "${existing}" == "${value}" ]]; then
      return
    fi
  done
  target_array+=("${value}")
}

class_require_directory() {
  local value="$1"
  local label="$2"
  if [[ -z "${value}" || ! -d "${value}" || -L "${value}" ]]; then
    echo "class-study ${label} must be an existing non-symlink directory" >&2
    exit 2
  fi
}

class_acquire_acquisition_lock() {
  local acquisition_root="$1"
  command -v flock >/dev/null 2>&1 || {
    echo "class-study acquisition coordination requires flock on the host" >&2
    return 1
  }
  class_require_directory "${acquisition_root}" "acquisition lock root"
  local lock_path="${acquisition_root}/.class-study-acquisition.lock"
  if [[ -L "${lock_path}" || ! -f "${lock_path}" ]]; then
    echo "class-study acquisition lock must be a regular non-symlink file" >&2
    return 1
  fi
  if [[ -n "${QCSD_CLASS_ACQUISITION_LOCK_FD:-}" ]]; then
    class_acquisition_lock_fd="${QCSD_CLASS_ACQUISITION_LOCK_FD}"
    if [[ ! "${class_acquisition_lock_fd}" =~ ^[0-9]+$ ]] ||
       [[ ! -e "/proc/$$/fd/${class_acquisition_lock_fd}" ]] ||
       [[ "$(stat -Lc '%d:%i' -- "${lock_path}")" != \
          "$(stat -Lc '%d:%i' -- "/proc/$$/fd/${class_acquisition_lock_fd}")" ]]; then
      echo "inherited class-study acquisition lock descriptor is invalid" >&2
      return 1
    fi
  else
    exec {class_acquisition_lock_fd}<>"${lock_path}"
  fi
  if ! flock -n "${class_acquisition_lock_fd}"; then
    echo "another class-study acquisition process holds the runner lock" >&2
    return 1
  fi
}

class_require_output_parent() {
  local value="$1"
  local label="$2"
  if [[ -z "${value}" ]]; then
    echo "class-study ${label} is required" >&2
    exit 2
  fi
  if [[ -L "${value}" ]]; then
    echo "class-study ${label} destination cannot be a symlink" >&2
    exit 1
  fi
  local parent
  parent="$(dirname "${value}")"
  if [[ "${parent}" == "${ROOT}" ]]; then
    echo "class-study ${label} rejects the broad Lab root parent" >&2
    exit 2
  fi
  class_require_directory "${parent}" "${label} parent"
}

class_require_canonical_path() {
  local value="$1"
  local expected="$2"
  local label="$3"
  if [[ -n "${value}" && "${value}" != "${expected}" ]]; then
    echo "class-study ${label} must use the canonical path ${expected}" >&2
    exit 2
  fi
}

class_require_canonical_parent() {
  local value="$1"
  local expected="$2"
  local label="$3"
  if [[ -n "${value}" && "$(dirname "${value}")" != "${expected}" ]]; then
    echo "class-study ${label} must be published directly under ${expected}" >&2
    exit 2
  fi
}

class_require_canonical_choice() {
  local value="$1"
  local first="$2"
  local second="$3"
  local label="$4"
  if [[ -n "${value}" && "${value}" != "${first}" && "${value}" != "${second}" ]]; then
    echo "class-study ${label} must use one canonical class-study path" >&2
    echo "expected ${first} or ${second}" >&2
    exit 2
  fi
}

if [[ "${1:-}" == "class-study" ]]; then
  command -v python3 >/dev/null 2>&1 || {
    echo "class-study requires python3 on the host for path validation" >&2
    exit 1
  }
  mapfile -t class_layout_fields < <(
    QCSD_LAB_ROOT="${ROOT}" python3 -I -c '
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(os.environ["QCSD_LAB_ROOT"]).resolve() / "src"))
from qcsd_lab.class_layout import (
    AUTHORITATIVE_COHORT_ASSEMBLY_FILENAME,
    AUTHORITATIVE_COHORT_FILENAME,
    FINAL_SELECTION_FILENAME,
    PILOT_COHORT_ASSEMBLY_FILENAME,
    PILOT_COHORT_FILENAME,
    class_study_layout,
)
from qcsd_lab.acquisition_timing import (
    GLOBAL_LIVE_PAGE_CAP,
    MAX_CANDIDATES_PER_ACTION,
)

layout = class_study_layout()
for field in (
    "config_root",
    "campaign_root",
    "workload_root",
    "study_config_root",
    "defense_params_root",
    "artifacts_root",
    "acquisition_root",
    "stability_root",
    "pilot_numeric_root",
    "pilot_final_root",
    "pilot_prefix_root",
    "authoritative_numeric_root",
    "authoritative_final_root",
    "authoritative_prefix_root",
    "qualification_sets_root",
    "pilot_qualification_set_root",
    "final_qualification_set_root",
):
    print(getattr(layout, field))
for filename in (
    PILOT_COHORT_FILENAME,
    PILOT_COHORT_ASSEMBLY_FILENAME,
    AUTHORITATIVE_COHORT_FILENAME,
    AUTHORITATIVE_COHORT_ASSEMBLY_FILENAME,
    FINAL_SELECTION_FILENAME,
):
    print(filename)
print(MAX_CANDIDATES_PER_ACTION)
print(GLOBAL_LIVE_PAGE_CAP)
'
  )
  if (( ${#class_layout_fields[@]} != 24 )); then
    echo "class-study could not derive the canonical Lab layout" >&2
    exit 1
  fi
  class_config_root="${class_layout_fields[0]}"
  class_campaign_root="${class_layout_fields[1]}"
  class_workload_root="${class_layout_fields[2]}"
  class_study_config_root="${class_layout_fields[3]}"
  class_defense_params_root="${class_layout_fields[4]}"
  class_artifacts_root="${class_layout_fields[5]}"
  class_acquisition_root="${class_layout_fields[6]}"
  class_stability_root="${class_layout_fields[7]}"
  class_pilot_numeric_root="${class_layout_fields[8]}"
  class_pilot_final_root="${class_layout_fields[9]}"
  class_pilot_prefix_root="${class_layout_fields[10]}"
  class_authoritative_numeric_root="${class_layout_fields[11]}"
  class_authoritative_final_root="${class_layout_fields[12]}"
  class_authoritative_prefix_root="${class_layout_fields[13]}"
  class_qualification_sets_root="${class_layout_fields[14]}"
  class_pilot_qualification_root="${class_layout_fields[15]}"
  class_final_qualification_root="${class_layout_fields[16]}"
  class_pilot_cohort="${class_study_config_root}/${class_layout_fields[17]}"
  class_pilot_cohort_assembly="${class_study_config_root}/${class_layout_fields[18]}"
  class_final_cohort="${class_study_config_root}/${class_layout_fields[19]}"
  class_final_cohort_assembly="${class_study_config_root}/${class_layout_fields[20]}"
  class_final_selection="${class_study_config_root}/${class_layout_fields[21]}"
  class_acquisition_canonical_max_candidates="${class_layout_fields[22]}"
  class_acquisition_global_live_page_cap="${class_layout_fields[23]}"
  class_candidate_catalogue="${class_study_config_root}/classifier-multiorigin100-v1-candidates.json"
  class_pilot_qualification_manifest="${class_pilot_qualification_root}/_qualification-set.json"
  class_final_qualification_manifest="${class_final_qualification_root}/_qualification-set.json"
  class_study_action="${2:-}"
  case "${class_study_action}" in
    status|acquisition-authority|acquisition-init|acquisition-run|acquisition-status|acquisition-admission|acquisition-complete|stability|cohort|campaigns|fit-numeric|prefix-specs|qualify-prefix|finalize-fitting|capture|resume|export|evaluate|foundation|readiness|historical-snapshot|comparison-review|attest|successor-policy|successor-decision|successor-restart|successor-verify|verify) ;;
    *)
      echo "class-study requires one recognised action" >&2
      exit 2
      ;;
  esac
  class_container_args=(class-study "${class_study_action}")
  class_index=3
  while (( class_index <= $# )); do
    class_argument="${!class_index}"
    class_flag="${class_argument%%=*}"
    class_inline=0
    if [[ "${class_argument}" == --*=* ]]; then
      class_value="${class_argument#*=}"
      class_inline=1
    fi
    case "${class_flag}" in
      --execute|--qualify-all-pending|--shallow)
        if (( class_inline )); then
          echo "${class_flag} does not accept a value" >&2
          exit 2
        fi
        class_container_args+=("${class_flag}")
        if [[ "${class_flag}" == "--execute" ]]; then
          class_study_execute=1
        elif [[ "${class_flag}" == "--qualify-all-pending" ]]; then
          class_study_live=1
        fi
        class_index=$((class_index + 1))
        continue
        ;;
      --stage|--qualification-workload|--acquisition-started-at|--acquisition-browser-tool|--acquisition-max-candidates|--acquisition-timeout-ms|--cohort-version|--snapshot-phase|--reviewer|--reviewed-at)
        if (( ! class_inline )); then
          class_next=$((class_index + 1))
          if (( class_next > $# )); then
            echo "${class_flag} requires a value" >&2
            exit 2
          fi
          class_value="${!class_next}"
          class_index=$((class_index + 1))
        fi
        class_container_args+=("${class_flag}" "${class_value}")
        if [[ "${class_flag}" == "--stage" ]]; then
          if [[ -n "${class_study_stage}" ]]; then
            echo "class-study accepts --stage at most once" >&2
            exit 2
          fi
          class_study_stage="${class_value}"
        elif [[ "${class_flag}" == "--cohort-version" ]]; then
          if [[ -n "${class_study_cohort_version}" ]]; then
            echo "class-study accepts --cohort-version at most once" >&2
            exit 2
          fi
          if [[ ! "${class_value}" =~ ^[1-9][0-9]*$ ]]; then
            echo "class-study --cohort-version must be a positive integer" >&2
            exit 2
          fi
          class_study_cohort_version="${class_value}"
        elif [[ "${class_flag}" == "--qualification-workload" ]]; then
          class_study_live=1
        elif [[ "${class_flag}" == "--acquisition-max-candidates" ]]; then
          class_acquisition_max_candidates="${class_value}"
        elif [[ "${class_flag}" == "--acquisition-timeout-ms" ]]; then
          class_acquisition_timeout_ms="${class_value}"
        fi
        class_index=$((class_index + 1))
        continue
        ;;
      --candidate-catalogue|--acquisition-root|--stability-root|--stability-input|--workload-root|--acquisition-completion|--pilot-cohort|--pilot-cohort-assembly|--final-cohort|--final-cohort-assembly|--cohort|--cohort-assembly|--final-selection|--campaign-root|--campaign|--results-root|--capture-result|--result|--regression-result|--controlled-result|--canary-result|--formal-result|--artifacts-root|--numeric-bundle|--prefix-spec-root|--qualification-checkpoint|--qualification-sidecar-root|--qualification-publication-root|--qualification-manifest|--final-bundle|--handoff|--evaluation-receipt|--build-execution-receipt|--pinned-cdp-receipt|--browser-egress-qualification-root|--reference-receipt|--code-gate-receipt|--controlled-qualification-receipt|--pilot-fitting-result|--pilot-compatibility-result|--authoritative-fitting-result|--certification-result|--acquisition-authority|--foundation-attestation|--readiness-attestation|--historical-pre-snapshot|--historical-post-snapshot|--comparison-review|--comparison-review-input|--validation-attestation|--successor-policy|--successor-decision|--successor-restart|--destination|--target|--dlsvm-cache-directory)
        if (( ! class_inline )); then
          class_next=$((class_index + 1))
          if (( class_next > $# )); then
            echo "${class_flag} requires a value" >&2
            exit 2
          fi
          class_value="${!class_next}"
          class_index=$((class_index + 1))
        fi
        class_host="$(class_host_path "${class_value}")" || exit 2
        class_inside="$(class_container_path "${class_host}")"
        case "${class_flag}" in
          --numeric-bundle) class_numeric_bundle_hosts+=("${class_host}") ;;
          --prefix-spec-root) class_prefix_spec_root_hosts+=("${class_host}") ;;
          --qualification-manifest) class_qualification_manifest_hosts+=("${class_host}") ;;
          --final-bundle) class_final_bundle_hosts+=("${class_host}") ;;
        esac
        if [[ "${class_flag}" == "--result" ]]; then
          class_result_hosts+=("${class_host}")
        elif [[ "${class_flag}" == "--regression-result" ]]; then
          class_regression_result_hosts+=("${class_host}")
        elif [[ "${class_flag}" == "--controlled-result" ]]; then
          class_controlled_result_hosts+=("${class_host}")
        elif [[ "${class_flag}" == "--canary-result" ]]; then
          class_canary_result_hosts+=("${class_host}")
        elif [[ "${class_flag}" == "--formal-result" ]]; then
          class_formal_result_hosts+=("${class_host}")
        else
          class_repeatable_status_path=0
          if [[ "${class_study_action}" == "status" ]]; then
            case "${class_flag}" in
              --numeric-bundle)
                class_repeatable_status_path=1
                ;;
              --prefix-spec-root)
                class_repeatable_status_path=1
                ;;
              --qualification-manifest)
                class_repeatable_status_path=1
                ;;
              --final-bundle)
                class_repeatable_status_path=1
                ;;
            esac
          fi
          if [[ -n "${class_path_hosts[${class_flag}]:-}" &&
                "${class_repeatable_status_path}" != "1" ]]; then
            echo "class-study accepts ${class_flag} at most once" >&2
            exit 2
          fi
          if [[ -z "${class_path_hosts[${class_flag}]:-}" ]]; then
            class_path_hosts["${class_flag}"]="${class_host}"
          fi
        fi
        class_container_args+=("${class_flag}" "${class_inside}")
        class_index=$((class_index + 1))
        continue
        ;;
      *)
        echo "class-study rejects unsupported argument: ${class_argument}" >&2
        exit 2
        ;;
    esac
  done

  class_fresh_layout=0
  case "${class_study_action}" in
    acquisition-authority|acquisition-init|acquisition-run|acquisition-status|acquisition-complete|stability|cohort|campaigns|fit-numeric|prefix-specs|qualify-prefix|finalize-fitting|capture|foundation|readiness|historical-snapshot|comparison-review|attest)
      class_fresh_layout=1
      ;;
  esac

  if [[ "${class_study_action}" == "acquisition-run" ]]; then
    if [[ "${class_acquisition_canonical_max_candidates}" != "2" ||
          "${class_acquisition_global_live_page_cap}" != "5" ]]; then
      echo "class-study acquisition batching constants are not canonical" >&2
      exit 1
    fi
    if [[ -n "${class_acquisition_max_candidates}" &&
          "${class_acquisition_max_candidates}" != "1" &&
          "${class_acquisition_max_candidates}" != \
            "${class_acquisition_canonical_max_candidates}" ]]; then
      echo "class-study acquisition-run accepts at most two candidates per action" >&2
      exit 2
    fi
    if [[ -n "${class_acquisition_timeout_ms}" &&
          "${class_acquisition_timeout_ms}" != "60000" ]]; then
      echo "class-study acquisition-run requires --acquisition-timeout-ms 60000" >&2
      exit 2
    fi
  fi
  if [[ "${class_study_action}" == "evaluate" &&
        -z "${class_path_hosts[--dlsvm-cache-directory]:-}" ]]; then
    echo "class-study evaluate requires --dlsvm-cache-directory for resumable persistent storage" >&2
    exit 2
  fi
  class_requires_dlsvm_wall=0
  if [[ "${class_study_action}" == "evaluate" ||
        "${class_study_action}" == "comparison-review" ||
        "${class_study_action}" == "attest" ]]; then
    class_requires_dlsvm_wall=1
  elif [[ "${class_study_action}" == "verify" &&
          -n "${class_path_hosts[--handoff]:-}" ]]; then
    class_requires_dlsvm_wall=1
  elif [[ "${class_study_action}" == "verify" &&
          -n "${class_path_hosts[--target]:-}" ]]; then
    class_verify_target_name="$(basename -- "${class_path_hosts[--target]}")"
    if [[ "${class_verify_target_name}" == *-comparison-review.json ||
          "${class_verify_target_name}" == *-validation-attestation.json ]]; then
      class_requires_dlsvm_wall=1
    elif [[ -f "${class_path_hosts[--target]}" &&
            ! -L "${class_path_hosts[--target]}" ]]; then
      class_verify_receipt_type="$({
        /usr/bin/python3 -I -c '
import json
import sys

value = json.load(open(sys.argv[1], encoding="utf-8"))
print(value.get("receipt_type", ""))
' "${class_path_hosts[--target]}"
      } 2>/dev/null || true)"
      case "${class_verify_receipt_type}" in
        qcsd-class-study-evaluation|qcsd-class-study-comparison-review|qcsd-class-study-validation-attestation)
          class_requires_dlsvm_wall=1
