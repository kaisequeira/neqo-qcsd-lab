    try:
        output = os.open(
            destination,
            os.O_WRONLY
            | os.O_CREAT
            | os.O_EXCL
            | os.O_CLOEXEC
            | getattr(os, "O_NOFOLLOW", 0),
            0o600,
        )
    except FileExistsError:
        existing = destination.lstat()
        if (
            not stat.S_ISREG(existing.st_mode)
            or existing.st_uid != os.geteuid()
            or stat.S_IMODE(existing.st_mode) != 0o600
            or existing.st_nlink != 1
            or destination.read_bytes() != canonical
        ):
            raise SystemExit("browser-egress causal evidence conflicts")
        continue
    try:
        view = memoryview(canonical)
        while view:
            written = os.write(output, view)
            if written <= 0:
                raise OSError("short causal-evidence write")
            view = view[written:]
        os.fsync(output)
    finally:
        os.close(output)
directory = os.open(
    destination_root,
    os.O_RDONLY | os.O_CLOEXEC | getattr(os, "O_DIRECTORY", 0),
)
try:
    os.fsync(directory)
finally:
    os.close(directory)
' "${browser_egress_attempt_scratch}" \
    "${browser_egress_attempt_evidence_host}" "${browser_egress_vector_id}"
}

browser_egress_record_failed_attempt() {
  local original_status="$?" failure_finished prior_artifact prior_result role_name role_id
  trap - ERR
  set +e
  failure_finished="$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)"
  if [[ -n "${browser_egress_observer_id:-}" &&
        ! -e "${browser_egress_evidence_host}" &&
        -f "${browser_egress_attempt_scratch}/capture-closure.json" &&
        ! -L "${browser_egress_attempt_scratch}/capture-closure.json" ]]; then
    browser_egress_extract_observer_pcap "${browser_egress_observer_id}" \
      "${browser_egress_evidence_host}" \
      "${browser_egress_attempt_scratch}/capture-closure.json" \
      "${browser_egress_evidence_relative}" >/dev/null 2>&1 || true
  fi
  if ! browser_egress_preserve_capture_closure; then
    echo "browser-egress could not preserve closed-capture failure evidence" >&2
    exit "${original_status}"
  fi
  if ! browser_egress_preserve_causal_evidence; then
    echo "browser-egress could not preserve its causal failure evidence" >&2
    exit "${original_status}"
  fi
  for role_name in browser observer fixture forbidden dns; do
    case "${role_name}" in
      browser) role_id="${browser_egress_browser_id:-}" ;;
      observer) role_id="${browser_egress_observer_id:-}" ;;
      fixture) role_id="${browser_egress_fixture_id:-}" ;;
      forbidden) role_id="${browser_egress_forbidden_id:-}" ;;
      dns) role_id="${browser_egress_dns_id:-}" ;;
    esac
    [[ -n "${role_id}" ]] || continue
    if [[ ! -e "${browser_egress_attempt_evidence_host}/${role_name}.log" ]]; then
      _qcsd_docker_api logs "${role_id}" \
        >"${browser_egress_attempt_evidence_host}/${role_name}.log" 2>&1 || true
      [[ -s "${browser_egress_attempt_evidence_host}/${role_name}.log" ]] || \
        rm -f -- "${browser_egress_attempt_evidence_host}/${role_name}.log"
    fi
    if [[ ! -e "${browser_egress_attempt_evidence_host}/${role_name}-inspect.txt" ]]; then
      _qcsd_docker_api container inspect --format \
        '{{.Id}} {{.Image}} {{.State.Status}} {{.State.ExitCode}}' "${role_id}" \
        >"${browser_egress_attempt_evidence_host}/${role_name}-inspect.txt" 2>/dev/null || true
      [[ -s "${browser_egress_attempt_evidence_host}/${role_name}-inspect.txt" ]] || \
        rm -f -- "${browser_egress_attempt_evidence_host}/${role_name}-inspect.txt"
    fi
  done
  if [[ -n "${browser_egress_network_id:-}" &&
        ! -e "${browser_egress_attempt_evidence_host}/network-inspect.txt" ]]; then
    _qcsd_docker_api network inspect --format \
      '{{.Id}} {{.Name}} {{.Driver}} {{.Internal}} {{.EnableIPv6}}' \
      "${browser_egress_network_id}" \
      >"${browser_egress_attempt_evidence_host}/network-inspect.txt" 2>/dev/null || true
    [[ -s "${browser_egress_attempt_evidence_host}/network-inspect.txt" ]] || \
      rm -f -- "${browser_egress_attempt_evidence_host}/network-inspect.txt"
  fi
  if [[ -n "${browser_egress_observer_id:-}" &&
        ! -e "${browser_egress_evidence_host}" &&
        -f "${browser_egress_attempt_scratch}/capture.json" &&
        ! -L "${browser_egress_attempt_scratch}/capture.json" ]]; then
    browser_egress_extract_observer_pcap "${browser_egress_observer_id}" \
      "${browser_egress_evidence_host}" \
      "${browser_egress_attempt_scratch}/capture.json" \
      "${browser_egress_evidence_relative}" >/dev/null 2>&1 || true
  fi
  if ! browser_egress_cleanup_topology; then
    echo "browser-egress left its attempt outstanding after teardown failed" >&2
    exit "${original_status}"
  fi
  browser_egress_failure_mounts=(
    --volume "${browser_egress_result_host}:${browser_egress_result_container}:rw"
    --volume "${browser_egress_result_host}/foundation.json:${browser_egress_result_container}/foundation.json:ro"
    --volume "${browser_egress_result_host}/attempts:${browser_egress_result_container}/attempts:rw"
    --volume "${browser_egress_result_host}/attempt-intents:${browser_egress_result_container}/attempt-intents:ro"
    --volume "${browser_egress_result_host}/evidence:${browser_egress_result_container}/evidence:ro"
    --volume "${browser_egress_attempt_evidence_host}:${browser_egress_result_container}/evidence/$(printf '%03d' "${browser_egress_vector_ordinal}")--${browser_egress_vector_id}/attempt-${browser_egress_attempt_number}:rw"
  )
  while IFS= read -r -d '' prior_artifact; do
    [[ -f "${prior_artifact}" && ! -L "${prior_artifact}" ]] || continue
    browser_egress_failure_mounts+=(
      --volume "${prior_artifact}:${browser_egress_result_container}/${prior_artifact#"${browser_egress_result_host}/"}:ro"
    )
  done < <(find "${browser_egress_attempt_evidence_host}" -mindepth 1 -maxdepth 1 -print0)
  while IFS= read -r -d '' prior_result; do
    [[ -f "${prior_result}" && ! -L "${prior_result}" ]] || continue
    browser_egress_failure_mounts+=(
      --volume "${prior_result}:${browser_egress_result_container}/attempts/${prior_result##*/}:ro"
    )
  done < <(find "${browser_egress_result_host}/attempts" -mindepth 1 -maxdepth 1 -print0)
  qcsd_run_attached_docker docker run --network none \
    --user "${qcsd_invoking_uid}:${qcsd_invoking_gid}" --cap-drop ALL \
    --security-opt no-new-privileges:true --read-only \
    --tmpfs /tmp:rw,nosuid,nodev,noexec,mode=1777 \
    --env "QCSD_LAB_IMAGE_DIGEST=${image_id}" --volume "${ROOT}:/lab:ro" \
    "${browser_egress_failure_mounts[@]}" \
    --volume "${browser_egress_attempt_scratch}:/qcsd-input:ro" \
    --entrypoint /usr/bin/tini "${image_id}" -- "${browser_egress_tool}" record-failure \
    --result-root "${browser_egress_result_container}" \
    --vector-id "${browser_egress_vector_id}" --next-json /qcsd-input/next.json \
    --started-at "${browser_egress_started_at}" --finished-at "${failure_finished}" \
    --verdict "${browser_egress_failure_verdict}" \
    --failure-code "${browser_egress_failure_code}" \
    --stage "${browser_egress_failure_stage}" >/dev/null
  failure_record_status=$?
  if (( failure_record_status != 0 )); then
    echo "browser-egress failed to seal failed attempt at ${browser_egress_failure_stage}" >&2
  else
    echo "browser-egress sealed ${browser_egress_failure_verdict} at ${browser_egress_failure_stage}" >&2
  fi
  exit "${original_status}"
}

browser_egress_live_docker_json=""
if [[ "${1:-}" == "test" && "${2:-}" == "browser-egress" ]]; then
  browser_egress_live_docker_binding || exit 1
fi

if [[ "${1:-}" == "test" && "${2:-}" == "browser-egress" &&
      "${browser_egress_action}" == "verify" ]]; then
  browser_egress_tool=/usr/local/bin/qcsd-browser-egress-qualification
  browser_egress_reconcile_filesystem || exit 1
  set +e
  qcsd_run_attached_docker docker run --network none \
    --user "${qcsd_invoking_uid}:${qcsd_invoking_gid}" \
    --cap-drop ALL --security-opt no-new-privileges:true --read-only \
    --tmpfs /tmp:rw,nosuid,nodev,noexec,mode=1777 \
    --env "QCSD_LAB_IMAGE_DIGEST=${image_id}" \
    --volume "${ROOT}:/lab:ro" \
    --entrypoint /usr/bin/tini "${image_id}" -- \
    /usr/bin/timeout --signal=TERM --kill-after=10s 600s \
    /usr/local/bin/qcsd-browser-egress-qualification verify \
    --cohort-version "${browser_egress_cohort_version}" \
    --build-execution-receipt "${browser_egress_build_container}" \
    --result-root "${browser_egress_result_container}" \
    --live-docker-json "${browser_egress_live_docker_json}"
  browser_egress_verify_status=$?
  set -e
  exit "${browser_egress_verify_status}"
fi

if [[ "${1:-}" == "test" && "${2:-}" == "browser-egress" &&
      ( "${browser_egress_action}" == "create" ||
        "${browser_egress_action}" == "resume" ) ]]; then
  if (( qcsd_invoking_uid == 0 || qcsd_invoking_gid == 0 )); then
    echo "test browser-egress requires a numeric non-root invoking UID and GID" >&2
    exit 2
  fi
  browser_egress_tool=/usr/local/bin/qcsd-browser-egress-qualification
  browser_egress_repo_digests="$(_qcsd_docker_api image inspect --format \
    '{{json .RepoDigests}}' "${image_id}")"
  browser_egress_coordinator_prefix=(
    docker run --network none
    --user "${qcsd_invoking_uid}:${qcsd_invoking_gid}"
    --cap-drop ALL --security-opt no-new-privileges:true --read-only
    --tmpfs /tmp:rw,nosuid,nodev,noexec,mode=1777
    --env "QCSD_LAB_IMAGE_DIGEST=${image_id}"
    --volume "${ROOT}:/lab:ro"
  )
  browser_egress_coordinator_suffix=(
    --entrypoint /usr/bin/tini "${image_id}" --
    /usr/bin/timeout --signal=TERM --kill-after=10s 600s
    "${browser_egress_tool}"
  )
  if [[ "${browser_egress_action}" == "create" ]]; then
    browser_egress_foundation_mounts=(
      --volume "${browser_egress_result_parent}:${browser_egress_result_parent_container}:rw"
    )
    while IFS= read -r -d '' browser_egress_existing_child; do
      if [[ -L "${browser_egress_existing_child}" ]]; then
        echo "browser-egress result parent contains a symlink" >&2
        exit 1
      fi
      if [[ ! -f "${browser_egress_existing_child}" &&
            ! -d "${browser_egress_existing_child}" ]]; then
        echo "browser-egress result parent contains a non-regular entry" >&2
        exit 1
      fi
      browser_egress_existing_name="${browser_egress_existing_child##*/}"
      if [[ ! "${browser_egress_existing_name}" =~ ^[A-Za-z0-9._-]+$ ]]; then
        echo "browser-egress result parent contains an unsafe existing name" >&2
        exit 1
      fi
      if [[ "${browser_egress_existing_name}" =~ ^\.browser-egress-qualification-v${browser_egress_cohort_version}\.[0-9a-f]{8}\.qcsd-tmp$ ]]; then
        # A process may die after publishing private staging entries but before
        # the no-replace root rename.  The coordinator must inspect and retire
        # only this exact cohort-bound sibling, so do not mask it read-only.
        continue
      fi
      browser_egress_foundation_mounts+=(
        --volume "${browser_egress_existing_child}:${browser_egress_result_parent_container}/${browser_egress_existing_name}:ro"
      )
    done < <(find "${browser_egress_result_parent}" -mindepth 1 -maxdepth 1 -print0)
    qcsd_run_attached_docker docker run --network none \
      --user "${qcsd_invoking_uid}:${qcsd_invoking_gid}" \
      --cap-drop ALL --security-opt no-new-privileges:true --read-only \
      --tmpfs /tmp:rw,nosuid,nodev,noexec,mode=1777 \
      --env "QCSD_LAB_IMAGE_DIGEST=${image_id}" \
      --volume "${ROOT}:/lab:ro" \
      "${browser_egress_foundation_mounts[@]}" \
      --entrypoint /usr/bin/tini "${image_id}" -- \
      /usr/bin/timeout --signal=TERM --kill-after=10s 600s \
      "${browser_egress_tool}" foundation \
      --cohort-version "${browser_egress_cohort_version}" \
      --build-execution-receipt "${browser_egress_build_container}" \
      --result-root "${browser_egress_result_container}" \
      --prepare-repo-digests-json "${browser_egress_repo_digests}" \
      --live-docker-json "${browser_egress_live_docker_json}" >/dev/null
  else
    browser_egress_reconcile_filesystem || exit 1
    QCSD_DOCKER_OUTPUT_BROWSER_EGRESS_RESUME=""
    qcsd_capture_attached_docker_output QCSD_DOCKER_OUTPUT_BROWSER_EGRESS_RESUME \
      "${browser_egress_coordinator_prefix[@]}" \
      --volume "${browser_egress_result_host}:${browser_egress_result_container}:ro" \
      "${browser_egress_coordinator_suffix[@]}" \
      admit-resume --cohort-version "${browser_egress_cohort_version}" \
      --build-execution-receipt "${browser_egress_build_container}" \
      --result-root "${browser_egress_result_container}" \
      --live-docker-json "${browser_egress_live_docker_json}"
    browser_egress_retire_stale_topology \
      "${QCSD_DOCKER_OUTPUT_BROWSER_EGRESS_RESUME}"
    browser_egress_resume_fields_output="$(python3 -I -c '
import json,re,sys
value=json.loads(sys.argv[1])
if set(value) != {"schema_version","checkpoint_publish_lag","checkpoint_status","prepare_image_id","docker_root_dir","cleanup"}:
    raise SystemExit("browser-egress resume plan is malformed")
if type(value["checkpoint_publish_lag"]) is not bool:
    raise SystemExit("browser-egress resume publish-lag flag is malformed")
cleanup=value["cleanup"]
if cleanup is None:
    print("true" if value["checkpoint_publish_lag"] else "false")
    print("false")
    print("none")
    raise SystemExit(0)
if set(cleanup) != {"vector_id","global_ordinal","attempt_number","evidence_directory","topology_token","cohort_version","foundation_payload_sha256","outstanding"}:
    raise SystemExit("browser-egress resume cleanup binding is malformed")
relative=cleanup["evidence_directory"]
if not isinstance(relative,str) or re.fullmatch(r"evidence/[0-9]{3}--[a-z0-9][a-z0-9-]{0,127}/attempt-[1-3]",relative) is None:
    raise SystemExit("browser-egress resume evidence path is malformed")
print("true" if value["checkpoint_publish_lag"] else "false")
print("true" if cleanup["outstanding"] is True else "false")
print(relative)
' "${QCSD_DOCKER_OUTPUT_BROWSER_EGRESS_RESUME}")" || exit 1
    mapfile -t browser_egress_resume_fields <<<"${browser_egress_resume_fields_output}"
    if (( ${#browser_egress_resume_fields[@]} != 3 )); then
      echo "browser-egress resume mount plan is malformed" >&2
      exit 1
    fi
    browser_egress_checkpoint_publish_lag="${browser_egress_resume_fields[0]}"
    browser_egress_resume_outstanding="${browser_egress_resume_fields[1]}"
    browser_egress_recovery_evidence_relative="${browser_egress_resume_fields[2]}"
    browser_egress_recovery_mounts=(
      --volume "${browser_egress_result_host}:${browser_egress_result_container}:ro"
    )
    if [[ "${browser_egress_checkpoint_publish_lag}" == true ||
          "${browser_egress_resume_outstanding}" == true ]]; then
      browser_egress_recovery_mounts=(
        --volume "${browser_egress_result_host}:${browser_egress_result_container}:rw"
        --volume "${browser_egress_result_host}/foundation.json:${browser_egress_result_container}/foundation.json:ro"
        --volume "${browser_egress_result_host}/attempt-intents:${browser_egress_result_container}/attempt-intents:ro"
        --volume "${browser_egress_result_host}/evidence:${browser_egress_result_container}/evidence:ro"
      )
      if [[ "${browser_egress_resume_outstanding}" == true ]]; then
        browser_egress_recovery_vector_host="$(dirname \
          "${browser_egress_result_host}/${browser_egress_recovery_evidence_relative}")"
        browser_egress_recovery_attempt_host="${browser_egress_result_host}/${browser_egress_recovery_evidence_relative}"
        if [[ ! -e "${browser_egress_recovery_vector_host}" ]]; then
          mkdir --mode=0700 -- "${browser_egress_recovery_vector_host}"
        elif [[ -L "${browser_egress_recovery_vector_host}" ||
                ! -d "${browser_egress_recovery_vector_host}" ]]; then
          echo "browser-egress recovery vector evidence directory is unsafe" >&2
          exit 1
        fi
        if [[ ! -e "${browser_egress_recovery_attempt_host}" ]]; then
          mkdir --mode=0700 -- "${browser_egress_recovery_attempt_host}"
        elif [[ -L "${browser_egress_recovery_attempt_host}" ||
                ! -d "${browser_egress_recovery_attempt_host}" ]]; then
          echo "browser-egress recovery attempt evidence directory is unsafe" >&2
          exit 1
        fi
        browser_egress_recovery_mounts+=(
          --volume "${browser_egress_result_host}/attempts:${browser_egress_result_container}/attempts:rw"
          --volume "${browser_egress_recovery_attempt_host}:${browser_egress_result_container}/${browser_egress_recovery_evidence_relative}:rw"
        )
      else
        browser_egress_recovery_mounts+=(
          --volume "${browser_egress_result_host}/attempts:${browser_egress_result_container}/attempts:ro"
        )
      fi
    fi
    while IFS= read -r -d '' browser_egress_recovery_result; do
      if [[ -L "${browser_egress_recovery_result}" ||
            ! -f "${browser_egress_recovery_result}" ]]; then
        echo "browser-egress recovery ledger contains an unsafe result" >&2
        exit 1
      fi
      if [[ "${browser_egress_resume_outstanding}" == true ]]; then
        browser_egress_recovery_mounts+=(
          --volume "${browser_egress_recovery_result}:${browser_egress_result_container}/attempts/${browser_egress_recovery_result##*/}:ro"
        )
      fi
    done < <(find "${browser_egress_result_host}/attempts" -mindepth 1 -maxdepth 1 -print0)
    qcsd_run_attached_docker "${browser_egress_coordinator_prefix[@]}" \
      "${browser_egress_recovery_mounts[@]}" \
      "${browser_egress_coordinator_suffix[@]}" \
      recover-resume --cohort-version "${browser_egress_cohort_version}" \
      --build-execution-receipt "${browser_egress_build_container}" \
      --result-root "${browser_egress_result_container}" \
      --live-docker-json "${browser_egress_live_docker_json}" >/dev/null
  fi

  QCSD_DOCKER_IDS_BROWSER_EGRESS_CONTAINERS=()
  QCSD_DOCKER_IDS_BROWSER_EGRESS_NETWORKS=()
  QCSD_DOCKER_IDS_BROWSER_EGRESS_VOLUMES=()
  browser_egress_scratch="$(mktemp -d --tmpdir=/tmp qcsd-browser-egress.XXXXXXXX)"
  trap browser_egress_exit_cleanup EXIT
  browser_egress_network_name="qcsd-browser-egress-v1"
  browser_egress_policy_directory="$(python3 -I -c '
import json, sys
value=json.load(open(sys.argv[1], encoding="utf-8"))
machine=value["payload"]["docker_daemon"]["server_architecture"]
paths={"aarch64":"/etc/chromium/policies/managed", "arm64":"/etc/chromium/policies/managed", "x86_64":"/etc/opt/chrome_for_testing/policies/managed", "amd64":"/etc/opt/chrome_for_testing/policies/managed"}
if machine not in paths:
    raise SystemExit("browser-egress architecture is unsupported")
print(paths[machine])
' "${browser_egress_result_host}/foundation.json")"
  while :; do
    browser_egress_attempt_scratch=""
    browser_egress_causal_inputs_ready=0
    if [[ -n "$(find "${browser_egress_result_host}" -type l -print -quit)" ]]; then
