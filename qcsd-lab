capture_scheduler_host_partition_b64() {
  local docker_ncpu inspect_json
  local -a study_container_ids=()
  docker_ncpu="$(_qcsd_docker_api info --format '{{.NCPU}}')"
  if [[ ! "${docker_ncpu}" =~ ^[0-9]+$ ]] || (( docker_ncpu <= 11 )); then
    echo "capture scheduler requires at least 12 Docker CPUs" >&2
    return 1
  fi
  mapfile -t study_container_ids < <(
    _qcsd_docker_api ps --format '{{.ID}}'
  )
  if (( ${#study_container_ids[@]} )); then
    inspect_json="$(_qcsd_docker_api container inspect "${study_container_ids[@]}")"
  else
    inspect_json='[]'
  fi
  printf '%s' "${inspect_json}" | /usr/bin/python3 -I -c '
import base64
import json
import re
import sys
import time

CLIENT_CPU = 10
HELPER_CPU = 11
docker_ncpu = int(sys.argv[1])
contract = sys.argv[2]
if contract not in {
    "qcsd-client-rr1-cpu10-v1",
    "qcsd-client-rr1-cpu10-etf-helper-cpu11-v1",
}:
    raise SystemExit(f"capture scheduler contract is invalid: {contract!r}")
kernel_timed = contract == "qcsd-client-rr1-cpu10-etf-helper-cpu11-v1"
protected_cpus = [CLIENT_CPU, HELPER_CPU] if kernel_timed else [CLIENT_CPU]
expected_arguments = sys.argv[3:]
if len(expected_arguments) % 2:
    raise SystemExit("capture scheduler expected-sidecar pairs are incomplete")
expected_names = expected_arguments[::2]
expected_ids = expected_arguments[1::2]
expected_pairs = set(zip(expected_names, expected_ids, strict=True))
if (
    len(expected_names) != len(set(expected_names))
    or len(expected_ids) != len(set(expected_ids))
    or any(not item for item in expected_names)
    or any(re.fullmatch(r"[0-9a-f]{64}", item) is None for item in expected_ids)
):
    raise SystemExit("capture scheduler expected-sidecar list is invalid")
try:
    inspected = json.load(sys.stdin)
except json.JSONDecodeError as error:
    raise SystemExit(f"Docker inspect output is invalid JSON: {error}")
if not isinstance(inspected, list):
    raise SystemExit("Docker inspect output is not a list")

def cpus(value):
    if value == "":
        return list(range(docker_ncpu))
    selected = set()
    for component in value.split(","):
        if re.fullmatch(r"[0-9]+(?:-[0-9]+)?", component) is None:
            raise SystemExit(f"Docker cpuset is invalid: {value!r}")
        bounds = [int(item) for item in component.split("-")]
        start, end = (bounds[0], bounds[-1])
        if end < start:
            raise SystemExit(f"Docker cpuset is reversed: {value!r}")
        selected.update(range(start, end + 1))
    return sorted(selected)

containers = []
for item in inspected:
    labels = item.get("Config", {}).get("Labels") or {}
    if labels.get("org.qcsd.owner") != "qcsd-lab":
        raise SystemExit(
            "capture scheduler refuses a running Docker container without the "
            "qcsd-lab owner label"
        )
    if item.get("State", {}).get("Running") is not True:
        raise SystemExit("Docker inspect selection contains a stopped container")
    name = str(item.get("Name", "")).removeprefix("/")
    configured = item.get("HostConfig", {}).get("CpusetCpus")
    if not isinstance(configured, str):
        raise SystemExit(f"Docker container {name!r} lacks a cpuset value")
    effective = cpus(configured)
    container = {
        "id": item.get("Id"),
        "name": name,
        "study": labels.get("org.qcsd.study", ""),
        "role": labels.get("org.qcsd.role", ""),
        "configured_cpuset": configured,
        "effective_cpus": effective,
        "expected_sidecar": (name, item.get("Id")) in expected_pairs,
    }
    if kernel_timed:
        container["protected_cpu_overlaps"] = [
            cpu for cpu in protected_cpus if cpu in effective
        ]
    else:
        container["client_cpu_overlap"] = CLIENT_CPU in effective
    containers.append(container)
containers.sort(key=lambda item: (item["name"], item["id"]))
observed_pairs = {(item["name"], item["id"]) for item in containers}
container_set_matches_expected = expected_pairs == observed_pairs
for item in containers:
    if item["expected_sidecar"] and item["effective_cpus"] != list(range(CLIENT_CPU)):
        raise SystemExit(
            "study sidecar {!r} is not confined to CPUs 0-9".format(item["name"])
        )
overlaps_by_cpu = {
    str(cpu): sorted(
        item["id"] for item in containers if cpu in item["effective_cpus"]
    )
    for cpu in protected_cpus
}
value = {
    "schema_version": 2 if kernel_timed else 1,
    "source": (
        "docker-inspect-all-running-containers-prelaunch-v2"
        if kernel_timed
        else "docker-inspect-all-running-containers-prelaunch-v1"
    ),
    "captured_at_unix_ns": time.time_ns(),
    "owner_label": "org.qcsd.owner=qcsd-lab",
    "docker_ncpu": docker_ncpu,
    "expected_sidecar_names": expected_names,
    "running_study_containers": containers,
    "running_container_set_matches_expected": container_set_matches_expected,
    "unavailable_scope": [
        "non-container host processes",
        "the measured client container itself, which does not exist at prelaunch",
        "containers or cpuset changes after the prelaunch observation",
        "host-kernel and hypervisor scheduling of the selected logical CPUs",
    ],
}
if kernel_timed:
    value.update({
        "protected_cpus": protected_cpus,
        "overlapping_container_ids_by_cpu": overlaps_by_cpu,
        "valid": (
            container_set_matches_expected
            and all(not items for items in overlaps_by_cpu.values())
        ),
        "verified_scope": (
            "all running Docker containers at prelaunch; every container must carry the "
            "qcsd-lab owner label and avoid protected logical CPUs 10 and 11"
        ),
    })
else:
    value.update({
        "client_cpu": CLIENT_CPU,
        "overlapping_container_ids": overlaps_by_cpu[str(CLIENT_CPU)],
        "valid": container_set_matches_expected and not overlaps_by_cpu[str(CLIENT_CPU)],
        "verified_scope": (
            "all running Docker containers at prelaunch; each must carry the qcsd-lab owner label"
        ),
    })
if not value["valid"]:
    raise SystemExit(
        "capture scheduler Docker partition is invalid: "
        f"container_set_matches_expected={container_set_matches_expected}, "
        f"protected CPU overlaps={overlaps_by_cpu}"
    )
encoded = json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
print(base64.b64encode(encoded).decode("ascii"))
' "${docker_ncpu}" "${study_capture_scheduler_contract}" "$@"
}

