os.environ["QCSD_LAB_ROOT"] = str(lab_root)
sys.path.insert(0, str(lab_root / "src"))
from qcsd_lab.etf_probe import load_supervised_request

print(load_supervised_request(Path(sys.argv[1]))["image"])
' "${etf_probe_request}")"
  _qcsd_docker_api image inspect --format '{{json .}}' \
    "${etf_probe_requested_image}" >"${etf_probe_image}"
  mapfile -t etf_probe_docker_fields < <(QCSD_ETF_PROBE_LAB_ROOT="${ROOT}" \
    "${etf_probe_python}" -I -c '
import os
