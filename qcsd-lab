    "{{with index .NetworkSettings.Networks \"${server_network}\"}}{{.EndpointID}}{{end}}" \
    "${router_id}")"
  /usr/bin/python3 -I -c '
import base64
import ipaddress
import json
import re
import sys

hex64 = re.compile(r"[0-9a-f]{64}\Z")
image = re.compile(r"sha256:[0-9a-f]{64}\Z")
if any(hex64.fullmatch(value) is None for value in sys.argv[5:10]):
    raise SystemExit("kernel-TX observer Docker identity is malformed")
if image.fullmatch(sys.argv[4]) is None:
    raise SystemExit("kernel-TX observer image identity is malformed")
try:
    observer_ip = str(ipaddress.ip_address(sys.argv[10]))
except ValueError as error:
