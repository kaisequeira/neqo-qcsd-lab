if [[ "${1:-}" == "class-study" &&
      "${class_study_action}" == "qualify-prefix" ]]; then
  class_foundation_path="${class_path_hosts[--foundation-attestation]}"
  mapfile -t class_qualification_fields < <(
    python3 -I -c '
import hashlib, importlib.util, json, os, re, sys
from pathlib import Path

root = Path(sys.argv[1]).resolve()
foundation_path = Path(sys.argv[2])
validator_path = root / "src/qcsd_lab/build_storage.py"
spec = importlib.util.spec_from_file_location("_qcsd_build_storage", validator_path)
if spec is None or spec.loader is None:
    raise SystemExit("cannot load the exact build evidence validator")
validator = importlib.util.module_from_spec(spec)
spec.loader.exec_module(validator)

def canonical(value):
    return (json.dumps(value, indent=2, sort_keys=True, allow_nan=False) + "\n").encode()

def under_root(raw):
    text = str(raw)
    candidate = root / text.removeprefix("/lab/") if text.startswith("/lab/") else Path(text)
    if not candidate.is_absolute():
        candidate = root / candidate
    unresolved = Path(os.path.abspath(candidate))
    try:
        unresolved.relative_to(root)
    except ValueError:
        raise SystemExit("class-study foundation build receipt is outside the Lab root")
    cursor = root
    for part in unresolved.relative_to(root).parts:
        cursor /= part
        if cursor.is_symlink():
            raise SystemExit(f"class-study foundation build path traverses a symlink: {cursor}")
    if not unresolved.is_file():
        raise SystemExit("class-study foundation build receipt is not a regular file")
    return unresolved

foundation_raw = foundation_path.read_bytes()
foundation = json.loads(foundation_raw)
if (
    set(foundation) != {"schema_version", "receipt_type", "payload_sha256", "payload"}
    or foundation.get("schema_version") != 1
    or foundation.get("receipt_type") != "qcsd-class-study-foundation-attestation"
    or not isinstance(foundation.get("payload"), dict)
    or foundation.get("payload_sha256")
       != hashlib.sha256(canonical(foundation["payload"])).hexdigest()
):
    raise SystemExit("class-study foundation attestation envelope is invalid")
payload = foundation["payload"]
evidence = payload.get("evidence")
binding = evidence.get("build_execution") if isinstance(evidence, dict) else None
if (
    not isinstance(binding, dict)
    or set(binding) != {"path", "sha256"}
    or re.fullmatch(r"[0-9a-f]{64}", str(binding.get("sha256"))) is None
):
    raise SystemExit("class-study foundation build binding is invalid")
build_path = under_root(binding.get("path"))
build_raw = build_path.read_bytes()
if hashlib.sha256(build_raw).hexdigest() != binding["sha256"]:
    raise SystemExit("class-study foundation build receipt digest changed")
build = json.loads(build_raw)
validated_build = validator.validate_build_execution_envelope(
    build,
    expected_probe_sha256=hashlib.sha256(
        (root / "tools/windows_docker_storage_probe.ps1").read_bytes()
    ).hexdigest(),
    checkout_root=root,
    expected_build_root=root,
)
source = validated_build["source"]
prepare_id = validated_build["image_ids"]["prepare"]
foundation_source = payload.get("source")
identity = payload.get("build_execution_identity")
if (
    source != foundation_source
    or not isinstance(identity, dict)
    or identity.get("sha256") != binding["sha256"]
    or identity.get("collection_image") != source.get("image_digest")
):
    raise SystemExit("class-study foundation prepare build identity is invalid")
print(prepare_id)
' "${ROOT}" "${class_foundation_path}"
  )
