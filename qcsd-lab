        "collection_image", "started_at", "finished_at",
    }
    or identity.get("cohort_version") != version
    or identity.get("sha256") != binding.get("sha256")
    or identity.get("completion_path")
       != f"/lab/artifacts/buflo-study/build-completion-v{version}.json"
    or re.fullmatch(r"[0-9a-f]{64}", str(identity.get("completion_sha256"))) is None
    or re.fullmatch(r"sha256:[0-9a-f]{64}", str(identity.get("collection_image"))) is None
):
    raise SystemExit("capture admission has no valid versioned build binding")
print(version)
print(binding["path"])
print(binding["sha256"])
print(identity["completion_path"])
print(identity["completion_sha256"])
print(identity["collection_image"])
' "${admission}"
  )
  if (( ${#fields[@]} != 6 )); then
    echo "capture admission has no valid versioned build binding" >&2
    exit 1
  fi
  study_cohort_version="${fields[0]}"
  study_admission_build_path="${fields[1]}"
  study_admission_build_sha256="${fields[2]}"
  study_admission_completion_path="${fields[3]}"
