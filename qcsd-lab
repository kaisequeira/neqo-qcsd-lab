# Parse a build request and enforce its create-only destination before any
# host-capacity or Docker probe.  A responsive daemon and large WSL ext4 free
# count do not prove that the Windows volume backing Docker's VHDX can safely
# export a new image.
if [[ "${1:-}" == "build" ]]; then
  build_transaction_root=""
  build_retired_transaction_root=""
  build_receipt_binding=""
  build_transaction_retirement_binding=""
  build_completion_final_reproof=""
  build_cohort_claim_snapshot=""
  build_cohort_claim_chain=""
  build_cohort_claim_chain_sha256=""
  build_cohort_reproof_observations=()
  if (( $# == 3 )) && [[ "${2:-}" == "--cohort-version" ]]; then
    build_cohort_version="${3}"
  elif (( $# == 2 )) && [[ "${2:-}" == --cohort-version=* ]]; then
    build_cohort_version="${2#--cohort-version=}"
  else
    echo "build requires exactly one explicit --cohort-version N" >&2
    exit 2
  fi
  if [[ ! "${build_cohort_version}" =~ ^[1-9][0-9]*$ ]]; then
    echo "build cohort version must be a positive integer" >&2
    exit 2
  fi
  reject_evidence_build_image_overrides
  reject_docker_endpoint_overrides
  # Enter the guardian exactly once before publishing the permanent cohort
  # claim.  The guardian acquisition itself does not touch Docker; the later
  # require_docker call performs recovery only after the claim is durable.
  _qcsd_require_lifecycle_guardian_entry || exit 1
  build_receipt="${ROOT}/artifacts/buflo-study/build-execution-v${build_cohort_version}.json"
  build_completion="${ROOT}/artifacts/buflo-study/build-completion-v${build_cohort_version}.json"
  build_receipt_parent="$(dirname "${build_receipt}")"
  if [[ -L "${ROOT}/artifacts" || -L "${build_receipt_parent}" ||
        -L "${build_receipt}" || -L "${build_completion}" ]]; then
    echo "build receipt parent/destination cannot be a symlink" >&2
    exit 1
  fi
  mkdir -p -- "${build_receipt_parent}"
  build_receipt_parent="$(realpath -- "${build_receipt_parent}")" || exit 1
  build_receipt="${build_receipt_parent}/$(basename "${build_receipt}")"
  build_receipt_stage="${build_receipt}.staged-${_QCSD_LIFECYCLE_LEASE_NONCE}"
  build_receipt_parent_owner="$(stat -Lc '%u' -- "${build_receipt_parent}" 2>/dev/null)" || exit 1
  build_receipt_parent_mode="$(stat -Lc '%a' -- "${build_receipt_parent}" 2>/dev/null)" || exit 1
  if [[ "${build_receipt_parent}" != "${ROOT}/artifacts/buflo-study" ||
        "${build_receipt_parent_owner}" != "$(id -u)" ||
        ! "${build_receipt_parent_mode}" =~ ^[0-7]{3,4}$ ||
        $(( 8#${build_receipt_parent_mode} & 0022 )) -ne 0 ||
        ! -d "${build_receipt_parent}" || -e "${build_receipt}" ||
        -e "${build_completion}" || -L "${build_completion}" ||
        -L "${build_receipt}" || -e "${build_receipt_stage}" ||
        -L "${build_receipt_stage}" ]]; then
    echo "build requires one safe absent create-only receipt destination" >&2
    exit 1
  fi
  if ! build_cohort_ledger_snapshot="$(
    _qcsd_validate_consumed_cohort_ledger "${build_cohort_version}"
  )" || [[ -z "${build_cohort_ledger_snapshot}" ||
            "${build_cohort_ledger_snapshot}" == *$'\n'* ]]; then
    echo "build cohort allocation is not authorised by the consumed-cohort ledger" >&2
    exit 1
  fi
  build_cohort_authority_fields="$(/usr/bin/python3 -I -c '
import json, re, sys
value=json.loads(sys.stdin.read())
if set(value)!={"schema_version","artifact_type","git","filesystem","receipt"}:
    raise SystemExit(1)
git=value["git"]
receipt=value["receipt"]
if (
    value["schema_version"] != 2
    or value["artifact_type"] != "qcsd-buflo-study-cohort-allocation-authority"
    or not isinstance(git, dict)
    or not isinstance(receipt, dict)
):
    raise SystemExit(1)
fields=(git.get("lab_head"),git.get("neqo_head"),git.get("head_gitlink"))
if any(not isinstance(item,str) or re.fullmatch(r"[0-9a-f]{40,64}",item) is None for item in fields):
    raise SystemExit(1)
if fields[1] != fields[2] or receipt.get("lab_commit") != fields[0]:
    raise SystemExit(1)
print("\n".join(fields))
' <<<"${build_cohort_ledger_snapshot}")" || {
    echo "build consumed-cohort authority record is malformed" >&2
    exit 1
  }
  mapfile -t build_cohort_authority_values <<<"${build_cohort_authority_fields}"
  if (( ${#build_cohort_authority_values[@]} != 3 )); then
    echo "build consumed-cohort authority record is incomplete" >&2
    exit 1
  fi
  build_cohort_lab_head="${build_cohort_authority_values[0]}"
  build_cohort_neqo_head="${build_cohort_authority_values[1]}"
  build_cohort_gitlink="${build_cohort_authority_values[2]}"
  unset build_cohort_authority_fields build_cohort_authority_values
  _qcsd_reprove_build_cohort_authority "before-cohort-claim" || exit 1
  build_started_unix_ns="$(/usr/bin/date +%s%N)"
  if [[ ! "${build_started_unix_ns}" =~ ^[1-9][0-9]*$ ]] ||
     ! _qcsd_invoke_cohort_allocator publish \
       "${build_cohort_ledger_snapshot}" build_cohort_claim_snapshot; then
    echo "build could not publish its permanent cohort-allocation claim" >&2
    exit 1
  fi
  if ! _qcsd_invoke_cohort_allocator chain \
      "${build_cohort_claim_snapshot}" build_cohort_claim_chain; then
    echo "build could not close its permanent cohort-allocation claim chain" >&2
    exit 1
  fi
  build_cohort_claim_chain_sha256="$(
    printf '%s' "${build_cohort_claim_chain}" | /usr/bin/sha256sum
  )" || exit 1
  build_cohort_claim_chain_sha256="${build_cohort_claim_chain_sha256%% *}"
  if [[ ! "${build_cohort_claim_chain_sha256}" =~ ^[0-9a-f]{64}$ ]]; then
    echo "build could not hash its permanent cohort-allocation claim chain" >&2
    exit 1
  fi
  _qcsd_reprove_build_cohort_authority \
    "after-cohort-claim-before-docker-recovery" || exit 1
  require_docker
  build_receipt_parent_identity="$(stat -Lc '%d:%i:%u:%a:%F' -- \
    "${build_receipt_parent}")" || exit 1
  if [[ -e "${build_receipt}" ]]; then
    echo "build requires an absent create-only receipt: ${build_receipt}" >&2
    exit 1
  fi
  require_submodule
  wsl_host_build_storage_init
  wsl_host_build_storage_probe "before-collection"
  validate_local_docker_build_endpoint
  acquire_evidence_build_lock
  if [[ -L "${build_receipt_parent}" || -L "${build_receipt}" ||
        "$(stat -Lc '%d:%i:%u:%a:%F' -- "${build_receipt_parent}" 2>/dev/null)" != \
          "${build_receipt_parent_identity}" || -e "${build_receipt}" ]]; then
    echo "build lost its create-only receipt destination while waiting for lifecycle/build admission" >&2
    exit 1
  fi
  # The build supervisor binds its durable taint to its physical working
  # directory. Canonicalise that directory before both the taint scan and every
  # Docker build so invocation from another caller directory cannot bypass the
  # next-build interlock.
  cd "${ROOT}"
  _qcsd_reprove_build_cohort_authority "after-evidence-build-lock" || exit 1
  reject_unresolved_evidence_build
  _QCSD_DOCKER_BUILD_DAEMON_ID="${build_docker_server_id}"
  _QCSD_DOCKER_BUILD_LOCK_FD="${build_host_lock_fd}"
elif [[ "${1:-}" == "lifecycle-recover" ]]; then
  # Deliberately stop after guarded daemon/boot admission and durable-ledger
  # reconciliation. This action never selects an image, creates a campaign
  # object, or enters any build/capture path.
  require_docker
  echo "qcsd-lab Docker lifecycle reconciliation completed" >&2
  exit 0
elif [[ "${1:-}" != "class-study" && "${1:-}" != "etf-probe" &&
        "${1:-}" != "etf-veth-probe" ]]; then
  # Defer Docker/lifecycle recovery until any current build receipt and its
  # authoritative completion companion have been validated below.  Argument
  # parsing and local evidence validation before that boundary are read-only.
  qcsd_deferred_generic_docker=1
  require_submodule
fi

