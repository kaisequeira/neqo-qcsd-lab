        "${_QCSD_LIFECYCLE_LOCK_PARENT_DEVICE}:${_QCSD_LIFECYCLE_LOCK_PARENT_INODE}" &&
      "$(stat -Lc '%d:%i:%u:%a:%h:%F' -- "${_QCSD_LIFECYCLE_BUILDX_CONFIG_PATH}")" == \
        "${_QCSD_LIFECYCLE_BUILDX_CONFIG_DEVICE}:${_QCSD_LIFECYCLE_BUILDX_CONFIG_INODE}:$(id -u):700:2:directory" &&
      -z "$(find -H "${_QCSD_LIFECYCLE_BUILDX_CONFIG_PATH}" -mindepth 1 -maxdepth 1 -print -quit)" ]] || return 1
  export DOCKER_CONFIG="${_QCSD_LIFECYCLE_DOCKER_CONFIG_PATH}"
  export BUILDX_CONFIG="${_QCSD_LIFECYCLE_BUILDX_CONFIG_PATH}"
  readonly _QCSD_LIFECYCLE_GUARD_PID _QCSD_LIFECYCLE_GUARD_START
  readonly _QCSD_LIFECYCLE_LOCK_DEVICE _QCSD_LIFECYCLE_LOCK_INODE
  readonly _QCSD_LIFECYCLE_QCSD_PID _QCSD_LIFECYCLE_QCSD_START
  readonly _QCSD_LIFECYCLE_HELPER_SHA256 _QCSD_LIFECYCLE_NATIVE_PATH
  readonly _QCSD_LIFECYCLE_NATIVE_SHA256 _QCSD_LIFECYCLE_LEASE_SOCKET
  readonly _QCSD_LIFECYCLE_LEASE_NONCE
  readonly _QCSD_LIFECYCLE_BOOT_ID _QCSD_LIFECYCLE_GUARD_SOURCE_DEVICE
  readonly _QCSD_LIFECYCLE_GUARD_SOURCE_INODE _QCSD_LIFECYCLE_GUARD_SOURCE_PATH
  readonly _QCSD_LIFECYCLE_GUARD_SOURCE_SHA256 _QCSD_LIFECYCLE_HELPER_SOURCE_DEVICE
  readonly _QCSD_LIFECYCLE_HELPER_SOURCE_INODE _QCSD_LIFECYCLE_HELPER_SOURCE_PATH
  readonly _QCSD_LIFECYCLE_LOCK_PARENT_DEVICE _QCSD_LIFECYCLE_LOCK_PARENT_INODE
  readonly _QCSD_LIFECYCLE_LOCK_PATH _QCSD_LIFECYCLE_NATIVE_SOURCE_DEVICE
  readonly _QCSD_LIFECYCLE_NATIVE_SOURCE_INODE _QCSD_LIFECYCLE_QCSD_SOURCE_DEVICE
  readonly _QCSD_LIFECYCLE_QCSD_SOURCE_INODE _QCSD_LIFECYCLE_QCSD_SOURCE_PATH
  readonly _QCSD_LIFECYCLE_QCSD_SOURCE_SHA256 _QCSD_LIFECYCLE_QCSD_SOURCE_FD
  readonly _QCSD_LIFECYCLE_DOCKER_CONFIG_DEVICE _QCSD_LIFECYCLE_DOCKER_CONFIG_INODE
  readonly _QCSD_LIFECYCLE_DOCKER_CONFIG_PATH
  readonly _QCSD_LIFECYCLE_BUILDX_CONFIG_DEVICE _QCSD_LIFECYCLE_BUILDX_CONFIG_INODE
  readonly _QCSD_LIFECYCLE_BUILDX_CONFIG_PATH
  _QCSD_LIFECYCLE_LOCK_MODE=exclusive
}

_qcsd_enter_lifecycle_guardian() {
  local guardian_path="${ROOT}/tools/docker_lifecycle_lock_guardian.py"
  local guardian_fd guardian_metadata
  unset DOCKER_CONTEXT DOCKER_HOST
  [[ -f "${guardian_path}" && ! -L "${guardian_path}" ]] || return 1
  guardian_metadata="$(stat -Lc '%u:%a:%h:%F' -- "${guardian_path}")" || return 1
  [[ "${guardian_metadata}" == "$(id -u):644:1:regular file" ]] || return 1
  exec {guardian_fd}<"${guardian_path}" || return 1
  exec /usr/bin/python3 -I "/proc/self/fd/${guardian_fd}" \
    --entry-source-fd "${guardian_fd}" --entry-source-path "${guardian_path}" -- \
    "${ROOT}/qcsd-lab" "${QCSD_ORIGINAL_ARGV[@]}"
}

reconcile_stale_docker_supervisors() {
  # Validate the durable namespace before legacy recovery can mutate anything;
  # both sets are then revalidated at their respective mutation boundaries.
  [[ "${_QCSD_LIFECYCLE_LOCK_MODE:-}" == "exclusive" ]] || return 1
  local nullglob_was_set=0
  local -a durable_roots=() legacy_roots=()
  shopt -q nullglob && nullglob_was_set=1
  shopt -s nullglob
  durable_roots=("${_qcsd_lifecycle_base}"/{run,network,build,transaction}.*
    "${_qcsd_lifecycle_base}"/retirement.{run,network,build,transaction}.*
    "${_qcsd_lifecycle_base}"/.retired.{run,network,build,transaction}.*)
  legacy_roots=(/tmp/qcsd-docker-supervisor.* /tmp/qcsd-docker-network-supervisor.*)
  (( nullglob_was_set )) || shopt -u nullglob
  if (( ${#durable_roots[@]} != 0 && ${#legacy_roots[@]} != 0 )); then
    echo "qcsd-lab Docker admission refuses mixed legacy and durable ownership namespaces" >&2
    return 1
  fi
  if (( ${#legacy_roots[@]} != 0 )); then
    echo "qcsd-lab Docker admission quarantines legacy /tmp ownership state; audit it manually before retrying" >&2
    return 1
  fi
  qcsd_reconcile_docker_lifecycle validate || return 1
  qcsd_reconcile_docker_lifecycle recover
}

require_docker() {
  # These are helper-internal trust anchors, never caller inputs.  Clear any
  # ambient values before the first discovery call so endpoint selection
  # cannot accidentally inherit a forged prior binding.
  unset _QCSD_DOCKER_PINNED_CONTEXT _QCSD_DOCKER_PINNED_HOST
  unset _QCSD_DOCKER_PINNED_SERVER_ID _QCSD_DOCKER_PINNED_BOOT_ID
  local guardian_environment_present=0
  while IFS='=' read -r _qcsd_guard_key _qcsd_guard_value; do
    if [[ "${_qcsd_guard_key}" == QCSD_DOCKER_LOCK_GUARDIAN_* ]]; then
      guardian_environment_present=1
      break
    fi
  done < <(env)
  if (( guardian_environment_present == 0 )); then
    _qcsd_enter_lifecycle_guardian || exit 1
  fi
  _qcsd_validate_lifecycle_guardian || {
    echo "qcsd-lab lifecycle guardian authority is invalid" >&2
    exit 1
  }
  _qcsd_secure_lifecycle_base || exit 1
  command -v docker >/dev/null 2>&1 || {
    echo "qcsd-lab requires Docker on the host" >&2
    exit 1
  }
  local pinned_context pinned_endpoint pinned_server_id observed_server_id
  local pinned_boot_id observed_boot_id
  pinned_context="$(_qcsd_docker_api context show 2>/dev/null)"
  if [[ ! "${pinned_context}" =~ ^[A-Za-z0-9_.-]+$ ]]; then
    echo "qcsd-lab cannot pin one safe Docker context" >&2
    exit 1
  fi
  pinned_endpoint="$(_qcsd_docker_api context inspect --format \
    '{{.Endpoints.docker.Host}}' "${pinned_context}" 2>/dev/null)"
  if [[ "${pinned_endpoint}" != "unix:///var/run/docker.sock" &&
        "${pinned_endpoint}" != \
          "npipe:////./pipe/dockerDesktopLinuxEngine" ]]; then
    echo "qcsd-lab requires one local Docker endpoint" >&2
    exit 1
  fi
  pinned_server_id="$(_qcsd_docker_api --context "${pinned_context}" info \
    --format '{{.ID}}' 2>/dev/null)"
  if [[ ! "${pinned_server_id}" =~ ^[A-Za-z0-9_.:-]+$ ||
        "${pinned_server_id}" == "unavailable" ]]; then
    echo "qcsd-lab cannot bind the local Docker daemon identity" >&2
    exit 1
  fi
  IFS= read -r pinned_boot_id </proc/sys/kernel/random/boot_id ||
    pinned_boot_id=""
  if [[ ! "${pinned_boot_id}" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
    echo "qcsd-lab cannot bind the current host boot identity" >&2
    exit 1
  fi
  if [[ -n "${QCSD_DOCKER_PINNED_CONTEXT:-}" ||
        -n "${QCSD_DOCKER_PINNED_HOST:-}" ||
        -n "${QCSD_DOCKER_PINNED_SERVER_ID:-}" ]]; then
    if [[ "${QCSD_DOCKER_PINNED_CONTEXT:-}" != "${pinned_context}" ||
          "${QCSD_DOCKER_PINNED_HOST:-}" != "${pinned_endpoint}" ||
          "${QCSD_DOCKER_PINNED_SERVER_ID:-}" != "${pinned_server_id}" ]]; then
      echo "qcsd-lab Docker endpoint drifted from its supervising watch binding" >&2
      exit 1
    fi
  fi
  export DOCKER_CONTEXT="${pinned_context}"
  _QCSD_DOCKER_PINNED_CONTEXT="${pinned_context}"
  _QCSD_DOCKER_PINNED_HOST="${pinned_endpoint}"
  _QCSD_DOCKER_PINNED_SERVER_ID="${pinned_server_id}"
  _QCSD_DOCKER_PINNED_BOOT_ID="${pinned_boot_id}"
  observed_server_id="$(_qcsd_docker_api info --format '{{.ID}}' 2>/dev/null)"
  if [[ "${observed_server_id}" != "${pinned_server_id}" ]]; then
    echo "Docker is installed but its daemon is unavailable" >&2
    exit 1
  fi
  IFS= read -r observed_boot_id </proc/sys/kernel/random/boot_id ||
    observed_boot_id=""
  if [[ "${observed_boot_id}" != "${pinned_boot_id}" ]]; then
    echo "qcsd-lab host boot changed across lifecycle admission" >&2
    exit 1
  fi
  if [[ "${QCSD_LAUNCH_ACTION}" == "class-study" &&
        ( "${class_study_action:-}" == "acquisition-admission" ||
          "${class_study_action:-}" == "acquisition-run" ||
          "${class_study_action:-}" == "acquisition-status" ) ]]; then
    # The first invocation clears prior watcher scopes.  Repeat the complete
    # current-scope/authority check only after the potentially blocking Docker
    # lifecycle lock has been acquired, immediately before stale Docker state
    # can be mutated.
    "${class_watch_scope_recovery[@]}" >/dev/null || {
      echo "class-study ${class_study_action} lost scoped request authority before Docker recovery" >&2
      exit 1
    }
    unset class_watch_scope_recovery
  fi
  reconcile_stale_docker_supervisors || exit 1
  observed_server_id="$(_qcsd_docker_api info --format '{{.ID}}' 2>/dev/null)"
  if [[ "${observed_server_id}" != "${pinned_server_id}" ]]; then
    echo "qcsd-lab Docker daemon changed across lifecycle admission" >&2
    exit 1
  fi
  IFS= read -r observed_boot_id </proc/sys/kernel/random/boot_id ||
    observed_boot_id=""
  if [[ "${observed_boot_id}" != "${pinned_boot_id}" ]]; then
    echo "qcsd-lab host boot changed across lifecycle reconciliation" >&2
    exit 1
  fi
  # Campaign execution is intentionally serial. Retain the exact exclusive
  # lifecycle lock for the full invocation so publication, handoff retirement,
  # and crash recovery share one globally quiescent ownership namespace.
}

reject_evidence_build_image_overrides() {
  local variable
  for variable in QCSD_LAB_COLLECTION_IMAGE QCSD_LAB_PREPARE_IMAGE \
                  QCSD_LAB_REFERENCE_IMAGE; do
    if [[ -v "${variable}" ]]; then
      echo "qcsd-lab evidence build rejects image-role override ${variable}" >&2
      return 1
    fi
  done
}

acquire_evidence_build_lock() {
  command -v flock >/dev/null 2>&1 &&
    command -v sha256sum >/dev/null 2>&1 &&
    command -v stat >/dev/null 2>&1 || {
    echo "qcsd-lab evidence build requires flock, sha256sum, and stat on the host" >&2
    return 1
  }
  local current_uid lock_identity lock_root lock_state previous_umask
  current_uid="$(id -u)"
  if [[ ! "${current_uid}" =~ ^[0-9]+$ || -z "${build_docker_lock_identity}" ||
        -L /tmp || ! -d /tmp ]]; then
    echo "qcsd-lab evidence build cannot establish its shared host-lock root" >&2
    return 1
  fi
  lock_root="/tmp/qcsd-lab-evidence-build-${current_uid}"
  if ! mkdir -m 700 -- "${lock_root}" 2>/dev/null; then
    if [[ -L "${lock_root}" || ! -d "${lock_root}" ]]; then
      echo "qcsd-lab evidence build host-lock root is unsafe" >&2
      return 1
    fi
  fi
  lock_state="$(stat -c '%u:%a' -- "${lock_root}")"
  if [[ "${lock_state}" != "${current_uid}:700" ]]; then
    echo "qcsd-lab evidence build host-lock root has unsafe ownership or mode" >&2
    return 1
  fi
  lock_identity="$(
    printf '%s' "${build_docker_lock_identity}" | sha256sum | awk '{print $1}'
  )"
  if [[ ! "${lock_identity}" =~ ^[0-9a-f]{64}$ ]]; then
    echo "qcsd-lab evidence build cannot derive the Docker daemon lock identity" >&2
    return 1
  fi
  build_lock_path="${lock_root}/${lock_identity}.lock"
  if [[ -e "${build_lock_path}" || -L "${build_lock_path}" ]]; then
    lock_state="$(stat -Lc '%u:%a:%h:%F' -- "${build_lock_path}" 2>/dev/null)" ||
      lock_state="invalid"
    if [[ "${lock_state}" != "${current_uid}:600:1:regular empty file" ]]; then
      echo "qcsd-lab evidence build lock must be an exact private empty file" >&2
      return 1
    fi
  fi
  if [[ -L "${build_lock_path}" ]]; then
    echo "qcsd-lab evidence build lock must not be a symbolic link" >&2
    return 1
  fi
  previous_umask="$(umask)"
  umask 077
  exec {build_host_lock_fd}<>"${build_lock_path}"
  umask "${previous_umask}"
  lock_state="$(stat -Lc '%u:%a:%h:%F' -- "${build_lock_path}")"
  if [[ "${lock_state}" != "${current_uid}:600:1:regular empty file" ]]; then
    echo "qcsd-lab evidence build lock has unsafe ownership or mode" >&2
    return 1
  fi
  if ! flock -n "${build_host_lock_fd}"; then
    echo "another qcsd-lab evidence build holds this user/WSL instance's Docker-daemon lock" >&2
    return 1
  fi
}

reject_unresolved_evidence_build() {
  local current_uid record supervisor_root root_metadata record_metadata line
  local field_key field_count expected_field record_line_count scope_record_invalid
  local object_count working_directory_count daemon_id_count context_count host_count
