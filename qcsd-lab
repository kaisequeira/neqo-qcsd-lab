  )
  image_neqo="${image_neqo_source[0]:-}"
  image_pin="${image_neqo_source[1]:-}"
  image_neqo_dirty="${image_neqo_source[2]:-}"
  image_neqo_patch="${image_neqo_source[3]:-}"
  neqo_head="$(git -C "${ROOT}/neqo-qcsd" rev-parse HEAD)"
