  runtime+=(--user "$(id -u):$(id -g)" --cap-drop ALL)
elif [[ "${1:-}" == "class-study" &&
      ! ( ( "${class_study_action}" == "capture" ||
            "${class_study_action}" == "resume" ) &&
          "${class_study_execute}" == "1" ) ]]; then
  # Every class-study action other than execute-mode capture/resume runs
  # without packet or network-administration capabilities.  Bypass
  # collection-entrypoint, whose sole purpose is privileged capture setup,
  # while retaining tini as PID 1 for signal forwarding and child reaping.
  # The explicit host identity also keeps every writable class-study overlay
  # usable by its creating user.
  runtime+=(
    --user "$(id -u):$(id -g)"
    --cap-drop ALL
    --entrypoint /usr/bin/tini
  )
  if [[ "${class_study_action}" == "acquisition-run" ]]; then
    # Bound the complete in-container coordinator action, not merely each
    # browser navigation. INT starts the normal evidence cleanup path; KILL is
    # reserved for a cleanup path that exceeds the documented 120-second
    # supervisor envelope.
    class_image_command=(
      -- /usr/bin/timeout --signal=INT --kill-after=120s 1800s
      /usr/local/bin/qcsd-lab-internal
    )
  else
    class_image_command=(-- /usr/local/bin/qcsd-lab-internal)
  fi
elif [[ "${1:-}" == "prepare" || "${1:-}" == "derive-chaff-prefix-specs" ||
      ( "${1:-}" == "buflo-study" && "${2:-}" == "reference" ) ||
      "${1:-}" == "qualify-chaff" || "${1:-}" == "qualify-response-chaff" ]]; then
  runtime+=(--user "$(id -u):$(id -g)")
else
  runtime+=(
    --cap-drop ALL
    --cap-add NET_RAW --cap-add NET_ADMIN
    --cap-add SETUID --cap-add SETGID --cap-add SETPCAP
