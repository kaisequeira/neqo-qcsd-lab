import json, re, sys
from pathlib import Path
before = json.loads(Path(sys.argv[1]).read_text())
after = json.loads(Path(sys.argv[2]).read_text())
status = int(sys.argv[3])
mode = sys.argv[4]
set_name = sys.argv[5]
ids = tuple(sys.argv[6:])
