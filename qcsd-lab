        if [[ ${qualification_cohort_versions} -ne 1 ]]; then
          echo "buflo-study qualify accepts at most one --cohort-version value" >&2
          exit 2
        fi
        if [[ ! "${argument}" =~ ^[1-9][0-9]*$ ]]; then
          echo "buflo-study qualify cohort version must be a positive integer" >&2
          exit 2
