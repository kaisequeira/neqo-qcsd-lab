remove_study_environment_transport() {
  if [[ -z "${study_environment_transport_dir}" ]]; then
    return 0
  fi
  if [[ ! "${study_environment_transport_dir}" =~ ^/tmp/qcsd-study-environment\.[A-Za-z0-9]{8}$ ||
        "${study_environment_host_path}" != \
          "${study_environment_transport_dir}/study-environment.json" ]]; then
    echo "refusing to remove an invalid study-environment transport path" >&2
    return 1
  fi
  local cleanup_status=0
  if [[ -e "${study_environment_host_path}" || -L "${study_environment_host_path}" ]]; then
    if [[ -L "${study_environment_host_path}" ||
          ! -f "${study_environment_host_path}" ]]; then
      echo "study-environment transport changed type before cleanup" >&2
      cleanup_status=1
    elif ! rm -f -- "${study_environment_host_path}"; then
      echo "cannot remove the study-environment transport file" >&2
      cleanup_status=1
    fi
  fi
  if [[ -L "${study_environment_transport_dir}" ||
        ! -d "${study_environment_transport_dir}" ]]; then
    echo "study-environment transport directory changed type before cleanup" >&2
    cleanup_status=1
  elif ! rmdir -- "${study_environment_transport_dir}"; then
    echo "cannot remove the study-environment transport directory" >&2
    cleanup_status=1
  fi
  if (( cleanup_status == 0 )); then
    study_environment_host_path=""
    study_environment_transport_dir=""
  fi
  return "${cleanup_status}"
}

cleanup_study_environment_transport_on_exit() {
  local cleanup_entry_status="$1"
