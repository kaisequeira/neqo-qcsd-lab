# The role starts its hard guard at process birth, before the shell completes
# staged readiness and sends the first phase signal.  Pass this one named
# budget into every role and derive the shell observation bound from it so the
# two supervisors cannot drift independently.
readonly browser_egress_role_deadline_seconds=300
readonly browser_egress_role_exit_observation_grace_seconds=15
readonly browser_egress_role_exit_wait_seconds=$((
  browser_egress_role_deadline_seconds +
  browser_egress_role_exit_observation_grace_seconds
))
if (( browser_egress_role_deadline_seconds <= 0 ||
      browser_egress_role_exit_observation_grace_seconds <= 0 ||
      browser_egress_role_exit_wait_seconds <=
        browser_egress_role_deadline_seconds )); then
  echo "browser-egress role supervision budgets are invalid" >&2
  exit 1
fi

browser_egress_wait_healthy() {
  local container_id="$1" deadline state
  deadline=$((SECONDS + 20))
  while (( SECONDS < deadline )); do
    state="$(_qcsd_docker_api container inspect --format \
      '{{if .State.Health}}{{.State.Health.Status}}{{else}}missing{{end}}' \
      "${container_id}" 2>/dev/null)" || state="unavailable"
    case "${state}" in
      healthy) return 0 ;;
      unhealthy|missing|unavailable)
        echo "browser-egress role failed readiness: ${state}" >&2
        return 1
        ;;
    esac
    sleep 0.1
  done
  echo "browser-egress role readiness timed out" >&2
  return 1
}

browser_egress_cleanup_topology() {
  local cleanup_status=0 container_id network_id volume_name container_index
  local volume_inventory
  local prior_cleanup_active="${_QCSD_LIFETIME_CLEANUP_ACTIVE:-0}"
  local -a retained_containers=() retained_networks=() retained_volumes=()
  # Normal per-vector teardown also owns a retirement transaction. Keep TERM
  # from entering EXIT cleanup with already-retired IDs still in the arrays,
  # or with a published retirement authority that has not finished yet.
  _QCSD_LIFETIME_CLEANUP_ACTIVE=1
  for ((container_index=${#QCSD_DOCKER_IDS_BROWSER_EGRESS_CONTAINERS[@]}-1;
       container_index>=0; container_index--)); do
    container_id="${QCSD_DOCKER_IDS_BROWSER_EGRESS_CONTAINERS[container_index]}"
    [[ -n "${container_id}" ]] || continue
    _qcsd_docker_api rm --force "${container_id}" >/dev/null 2>&1 || true
    if ! qcsd_retire_docker_handoff run "${container_id}" \
      QCSD_DOCKER_IDS_BROWSER_EGRESS_CONTAINERS; then
      cleanup_status=1
      retained_containers+=("${container_id}")
    fi
  done
  QCSD_DOCKER_IDS_BROWSER_EGRESS_CONTAINERS=("${retained_containers[@]}")
  for network_id in "${QCSD_DOCKER_IDS_BROWSER_EGRESS_NETWORKS[@]:-}"; do
    [[ -n "${network_id}" ]] || continue
    _qcsd_docker_api network rm "${network_id}" >/dev/null 2>&1 || true
    if ! qcsd_retire_docker_handoff network "${network_id}" \
      QCSD_DOCKER_IDS_BROWSER_EGRESS_NETWORKS; then
      cleanup_status=1
      retained_networks+=("${network_id}")
    fi
  done
  QCSD_DOCKER_IDS_BROWSER_EGRESS_NETWORKS=("${retained_networks[@]}")
  for volume_name in "${QCSD_DOCKER_IDS_BROWSER_EGRESS_VOLUMES[@]:-}"; do
    [[ -n "${volume_name}" ]] || continue
    _qcsd_docker_api volume rm "${volume_name}" >/dev/null 2>&1 || true
    if ! volume_inventory="$(_qcsd_docker_api volume ls --quiet \
      --filter "name=^${volume_name}$" 2>/dev/null)" ||
       [[ -n "${volume_inventory}" ]]; then
      echo "browser-egress policy volume absence could not be proved" >&2
      cleanup_status=1
      retained_volumes+=("${volume_name}")
    fi
  done
  QCSD_DOCKER_IDS_BROWSER_EGRESS_VOLUMES=("${retained_volumes[@]}")
  _QCSD_LIFETIME_CLEANUP_ACTIVE="${prior_cleanup_active}"
  if (( prior_cleanup_active == 0 && ${_QCSD_LIFETIME_SIGNAL_STATUS:-0} != 0 )); then
    # Arrays now contain only genuinely unproved identities. Let the existing
    # EXIT handler finish those, but never proceed to result publication.
    exit "${_QCSD_LIFETIME_SIGNAL_STATUS}"
  fi
  return "${cleanup_status}"
}

browser_egress_exit_cleanup() {
  local cleanup_entry_status="$?"
  local cleanup_signal_status=0 cleanup_complete=0 cleanup_failure_status=0
  _qcsd_begin_latched_cleanup
  browser_egress_cleanup_topology || cleanup_failure_status=1
  if [[ -n "${browser_egress_scratch:-}" &&
        -d "${browser_egress_scratch}" ]]; then
    rm -rf -- "${browser_egress_scratch}" || cleanup_failure_status=1
  fi
  _qcsd_finish_latched_cleanup
}

browser_egress_wait_observer_receipt() {
  local container_id="$1" destination="$2" deadline state
  deadline=$((SECONDS + 30))
  while (( SECONDS < deadline )); do
    _qcsd_docker_api logs "${container_id}" >"${destination}.candidate" 2>/dev/null || true
    if python3 -I -c '
import json, sys
from pathlib import Path
path=Path(sys.argv[1])
raw=path.read_bytes()
try:
    value=json.loads(raw)
except (UnicodeDecodeError, json.JSONDecodeError):
    raise SystemExit(1)
canonical=(json.dumps(value, indent=2, sort_keys=True, allow_nan=False)+"\n").encode()
if raw != canonical or not isinstance(value, dict) or value.get("role") != "observer":
    raise SystemExit(1)
' "${destination}.candidate"; then
      mv -- "${destination}.candidate" "${destination}"
      return 0
    fi
    state="$(_qcsd_docker_api container inspect --format '{{.State.Status}}' \
      "${container_id}" 2>/dev/null)" || state="unavailable"
    if [[ "${state}" != "running" ]]; then
      echo "browser-egress observer exited before PCAP extraction" >&2
      return 1
    fi
    sleep 0.1
  done
  echo "browser-egress observer receipt timed out" >&2
  return 1
}

browser_egress_fetch_observer_capture_closure() {
  local container_id="$1" destination="$2" evidence_relative="$3" vector_id="$4"
  local parent
  parent="$(dirname -- "${destination}")"
  if [[ -z "${container_id}" || "${destination}" != /* ||
        -z "${evidence_relative}" || -z "${vector_id}" ||
        -L "${parent}" || ! -d "${parent}" ||
        -e "${destination}" || -L "${destination}" ]]; then
    echo "browser-egress capture-closure destination is unsafe" >&2
    return 1
  fi
  if ! _qcsd_docker_api exec "${container_id}" \
      /bin/cat -- /tmp/qcsd-browser-egress-capture-closure.json | python3 -I -c '
import json
import os
from pathlib import Path
import re
import stat
import sys

destination = Path(sys.argv[1])
expected_relative = sys.argv[2]
expected_vector = sys.argv[3]
expected_uid = int(sys.argv[4])
expected_gid = int(sys.argv[5])
raw = sys.stdin.buffer.read(2 * 1024 * 1024 + 1)
if not raw or len(raw) > 2 * 1024 * 1024:
    raise SystemExit("browser-egress capture closure has an invalid size")
try:
    role = json.loads(raw)
except (UnicodeDecodeError, json.JSONDecodeError) as error:
    raise SystemExit("browser-egress capture closure is invalid JSON") from error
canonical = (json.dumps(role, indent=2, sort_keys=True, allow_nan=False) + "\n").encode()
if (
    raw != canonical
    or not isinstance(role, dict)
    or set(role) != {"schema_version", "role", "vector_id", "capture_closure"}
    or role.get("schema_version") != 1
    or role.get("role") != "observer"
    or role.get("vector_id") != expected_vector
):
    raise SystemExit("browser-egress capture closure role binding is invalid")
closure = role["capture_closure"]
closure_fields = {
    "schema_version", "artifact_type", "vector_id", "pcap", "observer",
    "capture_process_terminal", "capture_tool", "chronology",
}
if (
    not isinstance(closure, dict)
    or set(closure) != closure_fields
    or closure.get("schema_version") != 1
    or closure.get("artifact_type") != "qcsd-browser-egress-capture-closure"
    or closure.get("vector_id") != expected_vector
):
    raise SystemExit("browser-egress capture closure identity is invalid")
capture = closure["pcap"]
if (
    not isinstance(capture, dict)
    or set(capture) != {"path", "sha256", "size_bytes"}
    or capture.get("path") != expected_relative
    or not isinstance(capture.get("sha256"), str)
    or re.fullmatch(r"[0-9a-f]{64}", capture["sha256"]) is None
    or type(capture.get("size_bytes")) is not int
    or capture["size_bytes"] <= 0
):
    raise SystemExit("browser-egress capture closure PCAP binding is invalid")
if closure["observer"] != {
    "network_namespace": "browser", "interface": "any", "capture_filter": None,
    "privileged": False, "cap_drop": ["ALL"], "cap_add": ["CAP_NET_RAW"],
    "separate_container": True,
}:
    raise SystemExit("browser-egress capture closure observer binding is invalid")
process = closure["capture_process_terminal"]
if (
    not isinstance(process, dict)
    or set(process) != {"exit_code", "stderr"}
    or type(process.get("exit_code")) is not int
    or not isinstance(process.get("stderr"), str)
):
    raise SystemExit("browser-egress capture closure terminal-process binding is invalid")
tool = closure["capture_tool"]
if (
    not isinstance(tool, dict)
    or set(tool) != {"path", "sha256", "version_first_line", "argv"}
    or not isinstance(tool.get("path"), str)
    or not isinstance(tool.get("sha256"), str)
    or re.fullmatch(r"[0-9a-f]{64}", tool["sha256"]) is None
    or not isinstance(tool.get("version_first_line"), str)
    or not tool["version_first_line"]
    or not isinstance(tool.get("argv"), list)
    or any(not isinstance(item, str) or not item for item in tool["argv"])
):
    raise SystemExit("browser-egress capture closure tool binding is invalid")
chronology = closure["chronology"]
chronology_fields = {
    "observer_started_ns", "observer_ready_ns", "subject_started_ns",
    "subject_exited_ns", "reporting_grace_finished_ns", "observer_stopped_ns",
}
if (
    not isinstance(chronology, dict)
    or set(chronology) != chronology_fields
    or any(type(value) is not int or value < 0 for value in chronology.values())
    or not (
        chronology["observer_started_ns"] <= chronology["observer_ready_ns"]
        <= chronology["subject_started_ns"] <= chronology["subject_exited_ns"]
        <= chronology["reporting_grace_finished_ns"] <= chronology["observer_stopped_ns"]
    )
    or chronology["reporting_grace_finished_ns"] - chronology["subject_exited_ns"]
    < 5_000_000_000
):
    raise SystemExit("browser-egress capture closure chronology is invalid")
parent = destination.parent
parent_descriptor = os.open(
    parent, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_DIRECTORY
)
output_descriptor = -1
created = False
keep = False
try:
    parent_metadata = os.fstat(parent_descriptor)
    if (
        not stat.S_ISDIR(parent_metadata.st_mode)
        or parent_metadata.st_uid != expected_uid
        or parent_metadata.st_gid != expected_gid
        or stat.S_IMODE(parent_metadata.st_mode) != 0o700
    ):
        raise SystemExit("browser-egress capture closure parent is unsafe")
    output_descriptor = os.open(
        destination.name,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
        0o600,
        dir_fd=parent_descriptor,
    )
    created = True
    view = memoryview(raw)
    while view:
        written = os.write(output_descriptor, view)
        if written <= 0:
            raise OSError("browser-egress capture closure write made no progress")
        view = view[written:]
    os.fchmod(output_descriptor, 0o600)
    metadata = os.fstat(output_descriptor)
    if (
        not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != expected_uid
        or metadata.st_gid != expected_gid
        or stat.S_IMODE(metadata.st_mode) != 0o600
        or metadata.st_nlink != 1
        or metadata.st_size != len(raw)
    ):
        raise SystemExit("browser-egress capture closure inode is unsafe")
    os.fsync(output_descriptor)
    os.fsync(parent_descriptor)
    keep = True
finally:
    if output_descriptor >= 0:
        os.close(output_descriptor)
    if created and not keep:
        try:
            os.unlink(destination.name, dir_fd=parent_descriptor)
            os.fsync(parent_descriptor)
        except FileNotFoundError:
            pass
    os.close(parent_descriptor)
' "${destination}" "${evidence_relative}" "${vector_id}" \
      "${qcsd_invoking_uid}" "${qcsd_invoking_gid}"; then
    echo "browser-egress capture-closure extraction failed" >&2
    return 1
  fi
}

browser_egress_extract_observer_pcap() {
  local container_id="$1" destination="$2" capture_receipt="$3"
  local evidence_relative="$4" parent
  parent="$(dirname -- "${destination}")"
  if [[ -z "${container_id}" || "${destination}" != /* ||
        "${capture_receipt}" != /* || -L "${capture_receipt}" ||
        ! -f "${capture_receipt}" || -z "${evidence_relative}" ||
        -L "${parent}" || ! -d "${parent}" ||
        -e "${destination}" || -L "${destination}" ]]; then
    echo "browser-egress observer PCAP extraction destination is unsafe" >&2
    return 1
  fi
  # Docker's archive endpoint does not expose files backed by a container
  # tmpfs.  Keep the observer capture mount-free, but read the closed file
  # through the running container's namespace.  The host consumer creates the
  # intent-authorised evidence name with O_EXCL, validates the exact receipt
  # size and digest while streaming, and fsyncs both file and parent.  A hard
  # interruption can therefore leave only the already-recognised canonical
  # capture.pcapng recovery artifact, never an unknown staging name.
  if ! _qcsd_docker_api exec "${container_id}" \
      /bin/cat -- /tmp/capture.pcapng | python3 -I -c '
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import re
import stat
import sys

destination = Path(sys.argv[1])
receipt_path = Path(sys.argv[2])
expected_relative = sys.argv[3]
expected_uid = int(sys.argv[4])
expected_gid = int(sys.argv[5])
if (
    not destination.is_absolute()
    or destination.name != "capture.pcapng"
    or PurePosixPath(expected_relative).name != destination.name
):
    raise SystemExit("browser-egress extraction path binding is invalid")
receipt_before = receipt_path.lstat()
receipt_descriptor = os.open(
    receipt_path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW
)
try:
    receipt_opened = os.fstat(receipt_descriptor)
    if (
        not stat.S_ISREG(receipt_opened.st_mode)
        or (receipt_opened.st_dev, receipt_opened.st_ino)
        != (receipt_before.st_dev, receipt_before.st_ino)
        or receipt_opened.st_uid != expected_uid
        or receipt_opened.st_nlink != 1
    ):
        raise SystemExit("browser-egress capture receipt inode is unsafe")
    with os.fdopen(os.dup(receipt_descriptor), "rb") as source:
        raw_receipt = source.read()
finally:
    os.close(receipt_descriptor)
try:
    role_receipt = json.loads(raw_receipt)
except (UnicodeDecodeError, json.JSONDecodeError) as error:
    raise SystemExit("browser-egress capture receipt is invalid") from error
canonical = (
    json.dumps(role_receipt, indent=2, sort_keys=True, allow_nan=False) + "\n"
).encode()
closure = role_receipt.get("capture_closure")
if closure is not None:
    if (
        set(role_receipt) != {"schema_version", "role", "vector_id", "capture_closure"}
        or role_receipt.get("schema_version") != 1
        or not isinstance(closure, dict)
        or closure.get("schema_version") != 1
        or closure.get("artifact_type") != "qcsd-browser-egress-capture-closure"
        or closure.get("vector_id") != role_receipt.get("vector_id")
    ):
        raise SystemExit("browser-egress capture closure binding is invalid")
    capture = closure.get("pcap", {})
else:
    capture = role_receipt.get("receipt", {}).get("pcap", {})
expected_sha256 = capture.get("sha256")
expected_size = capture.get("size_bytes")
if (
    raw_receipt != canonical
    or role_receipt.get("role") != "observer"
    or capture.get("path") != expected_relative
    or not isinstance(expected_sha256, str)
    or re.fullmatch(r"[0-9a-f]{64}", expected_sha256) is None
    or type(expected_size) is not int
    or expected_size <= 0
):
    raise SystemExit("browser-egress capture receipt binding is invalid")
parent = destination.parent
parent_descriptor = os.open(
    parent, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_DIRECTORY
)
output_descriptor = -1
created = False
keep = False
try:
    parent_metadata = os.fstat(parent_descriptor)
    if (
        not stat.S_ISDIR(parent_metadata.st_mode)
        or parent_metadata.st_uid != expected_uid
        or parent_metadata.st_gid != expected_gid
        or stat.S_IMODE(parent_metadata.st_mode) != 0o700
    ):
        raise SystemExit("browser-egress extraction parent is unsafe")
    output_descriptor = os.open(
        destination.name,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
        0o600,
        dir_fd=parent_descriptor,
    )
    created = True
    digest = hashlib.sha256()
    observed_size = 0
    while True:
        block = sys.stdin.buffer.read(1024 * 1024)
        if not block:
            break
        observed_size += len(block)
        if observed_size > expected_size:
            raise SystemExit("browser-egress PCAP stream exceeds its receipt")
        digest.update(block)
        view = memoryview(block)
        while view:
            written = os.write(output_descriptor, view)
            if written <= 0:
                raise OSError("browser-egress PCAP output made no progress")
            view = view[written:]
    if observed_size != expected_size or digest.hexdigest() != expected_sha256:
        raise SystemExit("browser-egress PCAP stream differs from its receipt")
    os.fchmod(output_descriptor, 0o600)
    output_metadata = os.fstat(output_descriptor)
    if (
        not stat.S_ISREG(output_metadata.st_mode)
        or output_metadata.st_uid != expected_uid
        or output_metadata.st_gid != expected_gid
        or stat.S_IMODE(output_metadata.st_mode) != 0o600
        or output_metadata.st_nlink != 1
        or output_metadata.st_size != expected_size
    ):
        raise SystemExit("browser-egress extracted PCAP inode is unsafe")
    os.fsync(output_descriptor)
    os.fsync(parent_descriptor)
    keep = True
finally:
    if output_descriptor >= 0:
        os.close(output_descriptor)
    if created and not keep:
        try:
            os.unlink(destination.name, dir_fd=parent_descriptor)
            os.fsync(parent_descriptor)
        except FileNotFoundError:
            pass
    os.close(parent_descriptor)
' "${destination}" "${capture_receipt}" "${evidence_relative}" \
      "${qcsd_invoking_uid}" "${qcsd_invoking_gid}"; then
    echo "browser-egress observer PCAP stream extraction failed" >&2
    return 1
  fi
}

browser_egress_wait_container_marker() {
  local container_id="$1" marker="$2" label="$3" deadline state
  deadline=$((SECONDS + 30))
  while (( SECONDS < deadline )); do
    if _qcsd_docker_api exec "${container_id}" test -f "${marker}" >/dev/null 2>&1; then
      return 0
    fi
    state="$(_qcsd_docker_api container inspect --format '{{.State.Status}}' \
      "${container_id}" 2>/dev/null)" || state="unavailable"
    if [[ "${state}" != "running" ]]; then
      echo "browser-egress ${label} exited before its phase marker" >&2
      return 1
    fi
    sleep 0.1
  done
  echo "browser-egress ${label} phase marker timed out" >&2
  return 1
}

browser_egress_wait_observer_finalisation() {
  local container_id="$1" deadline state
  deadline=$((SECONDS + 30))
  while (( SECONDS < deadline )); do
    if _qcsd_docker_api exec "${container_id}" \
        test -f /tmp/qcsd-browser-egress-capture-policy-failed.ready \
        >/dev/null 2>&1; then
      browser_egress_failure_verdict=semantic-failure
      browser_egress_failure_code=packet-policy-failed
      browser_egress_failure_stage=packet-policy
      echo "browser-egress observer rejected the closed capture packet policy" >&2
      return 1
    fi
    if _qcsd_docker_api exec "${container_id}" \
        test -f /tmp/qcsd-browser-egress-receipt.ready >/dev/null 2>&1; then
      return 0
    fi
    if _qcsd_docker_api exec "${container_id}" \
        test -f /tmp/qcsd-browser-egress-capture-analysis-failed.ready \
        >/dev/null 2>&1; then
      echo "browser-egress observer rejected the closed capture during analysis" >&2
      return 1
    fi
    state="$(_qcsd_docker_api container inspect --format '{{.State.Status}}' \
      "${container_id}" 2>/dev/null)" || state="unavailable"
    if [[ "${state}" != "running" ]]; then
      echo "browser-egress observer exited before its finalisation marker" >&2
      return 1
    fi
    sleep 0.1
  done
  echo "browser-egress observer finalisation phase marker timed out" >&2
  return 1
}

browser_egress_wait_exit_code() {
  local container_id="$1" label="$2" deadline state exit_code
  deadline=$((SECONDS + browser_egress_role_exit_wait_seconds))
  while (( SECONDS < deadline )); do
    if ! read -r state exit_code < <(_qcsd_docker_api container inspect --format \
      '{{.State.Status}} {{.State.ExitCode}}' "${container_id}" 2>/dev/null); then
      echo "browser-egress ${label} exit state is unavailable" >&2
      return 1
    fi
    case "${state}" in
      exited|dead)
        if [[ ! "${exit_code}" =~ ^(0|[1-9][0-9]{0,2})$ ]] ||
           (( exit_code > 255 )); then
          echo "browser-egress ${label} exit code is invalid" >&2
          return 1
        fi
        printf '%s\n' "${exit_code}"
        return 0
        ;;
      created|running|restarting)
        sleep 0.1
        ;;
      *)
        echo "browser-egress ${label} entered unexpected state: ${state}" >&2
        return 1
        ;;
    esac
  done
  echo "browser-egress ${label} exit timed out" >&2
  return 1
}

