      echo "class-study rejects a blanket workspace read-write mount" >&2
      exit 2
    fi
    class_write_container="$(class_container_path "${class_write_root}")"
    container+=(--volume "${class_write_root}:${class_write_container}:rw")
    while IFS= read -r -d '' class_existing_child; do
      if [[ -L "${class_existing_child}" ]]; then
        echo "class-study guarded output root contains a symlink: ${class_existing_child}" >&2
        exit 1
      fi
      class_existing_name="${class_existing_child##*/}"
      if [[ ! "${class_existing_name}" =~ ^[A-Za-z0-9._-]+$ ]]; then
        echo "class-study rejects unsafe existing output name: ${class_existing_name}" >&2
        exit 1
      fi
      class_existing_container="$(class_container_path "${class_existing_child}")"
      container+=(--volume "${class_existing_child}:${class_existing_container}:ro")
    done < <(find "${class_write_root}" -mindepth 1 -maxdepth 1 -print0)
  done
  for class_write_root in "${class_direct_rw_dirs[@]:-}"; do
    [[ -n "${class_write_root}" ]] || continue
    class_require_directory "${class_write_root}" "direct writable root"
    container+=(
