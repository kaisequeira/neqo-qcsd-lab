      "${1:-}" == "fit" || "${1:-}" == "derive-chaff-prefix-specs" ||
      ( "${1:-}" == "buflo-study" && "${2:-}" == "reference" ) ||
      ( "${1:-}" == "class-study" &&
        "${class_study_action}" != "acquisition-run" &&
        ! ( "${class_study_action}" == "qualify-prefix" &&
            "${class_study_live}" == "1" ) &&
        ! ( ( "${class_study_action}" == "capture" ||
              "${class_study_action}" == "resume" ) &&
