    --volume-inspect-json "${volume_inspect_json}" || return 1
  cleanup_json="${QCSD_DOCKER_OUTPUT_BROWSER_EGRESS_STALE_PLAN}"
  cleanup_output="$(python3 -I -c '
import json,re,sys
value=json.loads(sys.argv[1])
if set(value) != {"schema_version","container_ids","network_id","volume_name"} or value["schema_version"] != 1:
    raise SystemExit("browser-egress stale cleanup plan is malformed")
ids=value["container_ids"]
network=value["network_id"]
volume=value["volume_name"]
if not isinstance(ids,list) or len(ids) != len(set(ids)):
    raise SystemExit("browser-egress stale cleanup container inventory is malformed")
if any(not isinstance(item,str) or re.fullmatch(r"[0-9a-f]{64}",item) is None for item in ids):
    raise SystemExit("browser-egress stale cleanup container ID is malformed")
if network is not None and (not isinstance(network,str) or re.fullmatch(r"[0-9a-f]{64}",network) is None):
    raise SystemExit("browser-egress stale cleanup network ID is malformed")
if volume is not None and (not isinstance(volume,str) or re.fullmatch(r"qcsd-be-[0-9a-f]{32}-policy0",volume) is None):
    raise SystemExit("browser-egress stale cleanup volume name is malformed")
print(network or "none")
print(volume or "none")
print(*ids,sep="\n")
