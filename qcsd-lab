  if [[ -n "${study_admission_build_path}" ]] &&
     { [[ "${study_admission_build_path}" != "/lab/artifacts/buflo-study/build-execution-v${study_cohort_version}.json" ]] ||
       [[ "${study_admission_build_sha256}" != "${study_build_execution_sha256}" ]] ||
