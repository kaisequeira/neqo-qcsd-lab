#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COLLECTION_IMAGE="${QCSD_LAB_COLLECTION_IMAGE:-neqo-qcsd-lab-collection:local}"
PREPARE_IMAGE="${QCSD_LAB_PREPARE_IMAGE:-neqo-qcsd-lab-prepare:local}"

usage() {
  echo "Usage: qcsd-lab {build|prepare|run|resume|verify|analyze|fit|test} [arguments...]" >&2
}

require_submodule() {
  if [[ ! -f "${ROOT}/neqo-qcsd/Cargo.lock" ]]; then
    echo "Missing Neqo submodule; run: git submodule update --init --recursive" >&2
    exit 1
  fi
}

command -v docker >/dev/null 2>&1 || {
  echo "qcsd-lab requires Docker on the host" >&2
  exit 1
}
if ! docker info >/dev/null 2>&1; then
  echo "Docker is installed but its daemon is unavailable" >&2
  exit 1
fi

require_submodule

if [[ "${1:-}" == "build" ]]; then
  if (( $# != 1 )); then
    echo "build accepts no arguments" >&2
    exit 2
  fi
  docker build --pull --target collection \
    --tag "${COLLECTION_IMAGE}" --file "${ROOT}/Dockerfile" "${ROOT}"
  docker build --pull --target prepare \
    --tag "${PREPARE_IMAGE}" --file "${ROOT}/Dockerfile" "${ROOT}"
  exit 0
fi

case "${1:-}" in
  prepare) image="${PREPARE_IMAGE}" ;;
  run|resume|verify|analyze|fit|test) image="${COLLECTION_IMAGE}" ;;
  *) usage; exit 2 ;;
esac

if ! docker image inspect "${image}" >/dev/null 2>&1; then
  echo "Missing image ${image}; run: ./qcsd-lab build" >&2
  exit 1
fi

mkdir -p "${ROOT}/results" "${ROOT}/artifacts" "${ROOT}/config/workloads"
image_id="$(docker image inspect --format '{{.Id}}' "${image}")"
runtime=(--rm --security-opt no-new-privileges)
network_mode="bridge"
if [[ "${1:-}" == "fit" ]]; then
  network_mode="none"
fi
if [[ "${1:-}" == "prepare" ]]; then
  runtime+=(--user "$(id -u):$(id -g)")
else
  runtime+=(
    --cap-drop ALL
    --cap-add NET_RAW --cap-add NET_ADMIN
    --cap-add SETUID --cap-add SETGID --cap-add SETPCAP
    --env "QCSD_LAB_UID=$(id -u)"
    --env "QCSD_LAB_GID=$(id -g)"
  )
fi

container=(
  docker run "${runtime[@]}"
  --network "${network_mode}"
  --env "HOME=/tmp/qcsd-home"
  --env "MPLCONFIGDIR=/tmp/matplotlib"
  --env "QCSD_LAB_IMAGE_DIGEST=${image_id}"
  --volume "${ROOT}:/lab:ro"
  --volume "${ROOT}/results:/lab/results:rw"
)
if [[ "${1:-}" == "prepare" ]]; then
  container+=(--volume "${ROOT}/config/workloads:/lab/config/workloads:rw")
fi
if [[ "${1:-}" == "fit" ]]; then
  container+=(--volume "${ROOT}/artifacts:/lab/artifacts:rw")
fi
container+=(--workdir /lab)

sidecars=()
cleanup_sidecars() {
  local name
  for name in "${sidecars[@]}"; do
    docker rm -f "${name}" >/dev/null 2>&1 || true
  done
}

start_capture_acceptance_server() {
  local server_name="$1"
  local server_port="$2"
  docker run --detach --name "${server_name}" \
    --network bridge \
    --security-opt no-new-privileges \
    --cap-drop ALL --cap-add NET_ADMIN \
    --env "QCSD_ACCEPTANCE_SERVER_PORT=${server_port}" \
    --entrypoint /bin/sh \
    "${image_id}" -eu -c \
    'ethtool -K eth0 gro off gso off tso off tx-udp-segmentation off
exec /usr/local/bin/neqo-server "0.0.0.0:${QCSD_ACCEPTANCE_SERVER_PORT}"'
}

if [[ "${1:-}" == "test" && "${2:-}" == "live" ]]; then
  if (( $# != 2 )); then
    echo "test live accepts no additional arguments" >&2
    exit 2
  fi
  trap cleanup_sidecars EXIT INT TERM
  first_server="qcsd-direct-server-$$"
  second_server="qcsd-direct-server-two-$$"
  sidecars+=("${first_server}" "${second_server}")
  start_capture_acceptance_server "${first_server}" 4433 >/dev/null
  start_capture_acceptance_server "${second_server}" 4434 >/dev/null
  first_address="$(docker inspect --format '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "${first_server}")"
  second_address="$(docker inspect --format '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "${second_server}")"
  test -n "${first_address}" && test -n "${second_address}"
  sleep 1
  set +e
  "${container[@]}" \
    --env "QCSD_RUN_CAPTURE_ACCEPTANCE=1" \
    --env "QCSD_CAPTURE_SERVER_ADDRESS=${first_address}" \
    --env "QCSD_CAPTURE_SERVER_PORT=4433" \
    --env "QCSD_CAPTURE_SERVER_TWO_ADDRESS=${second_address}" \
    --env "QCSD_CAPTURE_SERVER_TWO_PORT=4434" \
    "${image_id}" "$@"
  status=$?
  set -e
  exit "${status}"
fi

exec "${container[@]}" "${image_id}" "$@"
