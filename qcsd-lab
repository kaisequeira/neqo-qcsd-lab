  _qcsd_read_exact_lifecycle_frame "${go_fd}" "${go_nonce}" || return 1
  eval "exec ${go_fd}<&-" || return 1
  docker_config_name="${_QCSD_LIFECYCLE_DOCKER_CONFIG_PATH##*/}"
  docker_config_boot="${_QCSD_LIFECYCLE_BOOT_ID//-/}"
  [[ "${docker_config_name}" =~ ^[.]qcsd-docker-config-$(id -u)[.]v2[.]([0-9a-f]{32})[.]([1-9][0-9]*)[.][0-9a-f]{64}$ ]] || return 1
  [[ "${BASH_REMATCH[1]}" == "${docker_config_boot}" &&
      "${BASH_REMATCH[2]}" == "${_QCSD_LIFECYCLE_GUARD_START}" ]] || return 1
  [[ "${_QCSD_LIFECYCLE_DOCKER_CONFIG_PATH%/*}" == "${_QCSD_LIFECYCLE_LOCK_PATH%/*}" &&
      -d "${_QCSD_LIFECYCLE_DOCKER_CONFIG_PATH}" &&
      ! -L "${_QCSD_LIFECYCLE_DOCKER_CONFIG_PATH}" &&
      "$(stat -Lc '%d:%i:%u:%a:%h:%F' -- "${_QCSD_LIFECYCLE_DOCKER_CONFIG_PATH}")" == \
        "${_QCSD_LIFECYCLE_DOCKER_CONFIG_DEVICE}:${_QCSD_LIFECYCLE_DOCKER_CONFIG_INODE}:$(id -u):500:2:directory" &&
      -z "$(find -H "${_QCSD_LIFECYCLE_DOCKER_CONFIG_PATH}" -mindepth 1 -maxdepth 1 -print -quit)" ]] || return 1
  [[ "${_QCSD_LIFECYCLE_BUILDX_CONFIG_PATH}" =~ ^/proc/${_QCSD_LIFECYCLE_GUARD_PID}/fd/[0-9]+/[.]qcsd-buildx-config-$(id -u)[.][0-9a-f]{64}$ &&
      -d "${_QCSD_LIFECYCLE_BUILDX_CONFIG_PATH}" &&
      ! -L "${_QCSD_LIFECYCLE_BUILDX_CONFIG_PATH}" &&
      "$(stat -Lc '%d:%i' -- "${_QCSD_LIFECYCLE_BUILDX_CONFIG_PATH%/*}")" == \
        "${_QCSD_LIFECYCLE_LOCK_PARENT_DEVICE}:${_QCSD_LIFECYCLE_LOCK_PARENT_INODE}" &&
      "$(stat -Lc '%d:%i:%u:%a:%h:%F' -- "${_QCSD_LIFECYCLE_BUILDX_CONFIG_PATH}")" == \
        "${_QCSD_LIFECYCLE_BUILDX_CONFIG_DEVICE}:${_QCSD_LIFECYCLE_BUILDX_CONFIG_INODE}:$(id -u):700:2:directory" &&
      -z "$(find -H "${_QCSD_LIFECYCLE_BUILDX_CONFIG_PATH}" -mindepth 1 -maxdepth 1 -print -quit)" ]] || return 1
  export DOCKER_CONFIG="${_QCSD_LIFECYCLE_DOCKER_CONFIG_PATH}"
  export BUILDX_CONFIG="${_QCSD_LIFECYCLE_BUILDX_CONFIG_PATH}"
  readonly _QCSD_LIFECYCLE_GUARD_PID _QCSD_LIFECYCLE_GUARD_START
  readonly _QCSD_LIFECYCLE_LOCK_DEVICE _QCSD_LIFECYCLE_LOCK_INODE
  readonly _QCSD_LIFECYCLE_QCSD_PID _QCSD_LIFECYCLE_QCSD_START
  readonly _QCSD_LIFECYCLE_HELPER_SHA256 _QCSD_LIFECYCLE_NATIVE_PATH
  readonly _QCSD_LIFECYCLE_NATIVE_SHA256 _QCSD_LIFECYCLE_LEASE_SOCKET
  readonly _QCSD_LIFECYCLE_LEASE_NONCE
  readonly _QCSD_LIFECYCLE_RECOVERY_READY_FD _QCSD_LIFECYCLE_RECOVERY_NONCE
  readonly _QCSD_LIFECYCLE_FINAL_GO_FD _QCSD_LIFECYCLE_FINAL_GO_NONCE
  readonly _QCSD_LIFECYCLE_BOOT_ID _QCSD_LIFECYCLE_GUARD_SOURCE_DEVICE
  readonly _QCSD_LIFECYCLE_GUARD_SOURCE_INODE _QCSD_LIFECYCLE_GUARD_SOURCE_PATH
  readonly _QCSD_LIFECYCLE_GUARD_SOURCE_SHA256 _QCSD_LIFECYCLE_HELPER_SOURCE_DEVICE
  readonly _QCSD_LIFECYCLE_HELPER_SOURCE_INODE _QCSD_LIFECYCLE_HELPER_SOURCE_PATH
  readonly _QCSD_LIFECYCLE_LOCK_PARENT_DEVICE _QCSD_LIFECYCLE_LOCK_PARENT_INODE
  readonly _QCSD_LIFECYCLE_LOCK_PATH _QCSD_LIFECYCLE_NATIVE_SOURCE_DEVICE
  readonly _QCSD_LIFECYCLE_NATIVE_SOURCE_INODE _QCSD_LIFECYCLE_QCSD_SOURCE_DEVICE
  readonly _QCSD_LIFECYCLE_QCSD_SOURCE_INODE _QCSD_LIFECYCLE_QCSD_SOURCE_PATH
  readonly _QCSD_LIFECYCLE_QCSD_SOURCE_SHA256 _QCSD_LIFECYCLE_QCSD_SOURCE_FD
  readonly _QCSD_LIFECYCLE_DOCKER_CONFIG_DEVICE _QCSD_LIFECYCLE_DOCKER_CONFIG_INODE
  readonly _QCSD_LIFECYCLE_DOCKER_CONFIG_PATH
  readonly _QCSD_LIFECYCLE_BUILDX_CONFIG_DEVICE _QCSD_LIFECYCLE_BUILDX_CONFIG_INODE
  readonly _QCSD_LIFECYCLE_BUILDX_CONFIG_PATH
  readonly _QCSD_LIFECYCLE_COHORT_LOCK_REQUIRED _QCSD_LIFECYCLE_COHORT_VERSION
  readonly _QCSD_LIFECYCLE_COHORT_LOCK_FD _QCSD_LIFECYCLE_COHORT_LOCK_PATH
  readonly _QCSD_LIFECYCLE_COHORT_LOCK_DEVICE _QCSD_LIFECYCLE_COHORT_LOCK_INODE
  readonly _QCSD_LIFECYCLE_COHORT_LOCK_PARENT_DEVICE
  readonly _QCSD_LIFECYCLE_COHORT_LOCK_PARENT_INODE
  readonly _QCSD_LIFECYCLE_ENTRY_VALIDATED=1
  _QCSD_LIFECYCLE_RECOVERY_STATE=armed
  _QCSD_LIFECYCLE_LOCK_MODE=exclusive
}

_qcsd_complete_lifecycle_recovery() {
  local recovery_fd="${_QCSD_LIFECYCLE_RECOVERY_READY_FD:-}"
  local final_go_fd="${_QCSD_LIFECYCLE_FINAL_GO_FD:-}"
  [[ "${_QCSD_LIFECYCLE_RECOVERY_STATE:-}" == armed &&
      "${recovery_fd}" =~ ^[0-9]+$ &&
      "${final_go_fd}" =~ ^[0-9]+$ &&
      "${_QCSD_LIFECYCLE_RECOVERY_NONCE:-}" =~ ^[0-9a-f]{64}$ &&
      "${_QCSD_LIFECYCLE_FINAL_GO_NONCE:-}" =~ ^[0-9a-f]{64}$ ]] || return 1
  _QCSD_LIFECYCLE_RECOVERY_STATE=consuming
  printf '%s\n' "${_QCSD_LIFECYCLE_RECOVERY_NONCE}" >&"${recovery_fd}" || return 1
  eval "exec ${recovery_fd}>&-" || return 1
  _qcsd_read_exact_lifecycle_frame \
    "${final_go_fd}" "${_QCSD_LIFECYCLE_FINAL_GO_NONCE}" || return 1
  eval "exec ${final_go_fd}<&-" || return 1
  _QCSD_LIFECYCLE_RECOVERY_STATE=complete
}

_qcsd_enter_lifecycle_guardian() {
  local guardian_path="${ROOT}/tools/docker_lifecycle_lock_guardian.py"
  local guardian_fd guardian_metadata
  unset DOCKER_CONTEXT DOCKER_HOST
  [[ -f "${guardian_path}" && ! -L "${guardian_path}" ]] || return 1
  guardian_metadata="$(stat -Lc '%u:%a:%h:%F' -- "${guardian_path}")" || return 1
  [[ "${guardian_metadata}" == "$(id -u):644:1:regular file" ]] || return 1
  exec {guardian_fd}<"${guardian_path}" || return 1
  exec /usr/bin/python3 -I "/proc/self/fd/${guardian_fd}" \
    --entry-source-fd "${guardian_fd}" --entry-source-path "${guardian_path}" -- \
    "${ROOT}/qcsd-lab" "${QCSD_ORIGINAL_ARGV[@]}"
}

reconcile_stale_docker_supervisors() {
  if [[ "${QCSD_LAUNCH_ACTION}" == "build" ]]; then
    _qcsd_reprove_build_cohort_authority "immediately-before-docker-recovery" || exit 1
  fi
  # Validate the durable namespace before legacy recovery can mutate anything;
  # both sets are then revalidated at their respective mutation boundaries.
  [[ "${_QCSD_LIFECYCLE_LOCK_MODE:-}" == "exclusive" ]] || return 1
  local nullglob_was_set=0
  local -a durable_roots=() legacy_roots=()
  shopt -q nullglob && nullglob_was_set=1
  shopt -s nullglob
  durable_roots=("${_qcsd_lifecycle_base}"/{run,network,build,transaction}.*
    "${_qcsd_lifecycle_base}"/retirement.{run,network,build,transaction}.*
    "${_qcsd_lifecycle_base}"/.retired.{run,network,build,transaction}.*)
  legacy_roots=(/tmp/qcsd-docker-supervisor.* /tmp/qcsd-docker-network-supervisor.*)
  (( nullglob_was_set )) || shopt -u nullglob
  if (( ${#durable_roots[@]} != 0 && ${#legacy_roots[@]} != 0 )); then
    echo "qcsd-lab Docker admission refuses mixed legacy and durable ownership namespaces" >&2
    return 1
  fi
  if (( ${#legacy_roots[@]} != 0 )); then
    echo "qcsd-lab Docker admission quarantines legacy /tmp ownership state; audit it manually before retrying" >&2
    return 1
  fi
  qcsd_reconcile_docker_lifecycle validate || return 1
  qcsd_reconcile_docker_lifecycle recover
}

_qcsd_require_lifecycle_guardian_entry() {
  if [[ "${_QCSD_LIFECYCLE_ENTRY_VALIDATED:-}" == 1 ]]; then
    return 0
  fi
  local guardian_environment_present=0
  while IFS='=' read -r _qcsd_guard_key _qcsd_guard_value; do
    if [[ "${_qcsd_guard_key}" == QCSD_DOCKER_LOCK_GUARDIAN_* ]]; then
      guardian_environment_present=1
      break
    fi
  done < <(env)
  if (( guardian_environment_present == 0 )); then
    _qcsd_enter_lifecycle_guardian || exit 1
  fi
  _qcsd_validate_lifecycle_guardian || {
    echo "qcsd-lab lifecycle guardian authority is invalid" >&2
    return 1
  }
}

require_docker() {
  # These are helper-internal trust anchors, never caller inputs.  Clear any
  # ambient values before the first discovery call so endpoint selection
  # cannot accidentally inherit a forged prior binding.
  unset _QCSD_DOCKER_PINNED_CONTEXT _QCSD_DOCKER_PINNED_HOST
  unset _QCSD_DOCKER_PINNED_SERVER_ID _QCSD_DOCKER_PINNED_BOOT_ID
  _qcsd_require_lifecycle_guardian_entry || exit 1
  _qcsd_secure_lifecycle_base || exit 1
  command -v docker >/dev/null 2>&1 || {
    echo "qcsd-lab requires Docker on the host" >&2
    exit 1
  }
  local pinned_context pinned_endpoint pinned_server_id observed_server_id
  local pinned_boot_id observed_boot_id
  pinned_context="$(_qcsd_docker_api context show 2>/dev/null)"
  if [[ ! "${pinned_context}" =~ ^[A-Za-z0-9_.-]+$ ]]; then
    echo "qcsd-lab cannot pin one safe Docker context" >&2
    exit 1
  fi
  pinned_endpoint="$(_qcsd_docker_api context inspect --format \
    '{{.Endpoints.docker.Host}}' "${pinned_context}" 2>/dev/null)"
  if [[ "${pinned_endpoint}" != "unix:///var/run/docker.sock" &&
        "${pinned_endpoint}" != \
          "npipe:////./pipe/dockerDesktopLinuxEngine" ]]; then
    echo "qcsd-lab requires one local Docker endpoint" >&2
    exit 1
  fi
  pinned_server_id="$(_qcsd_read_docker_daemon_id "${pinned_endpoint}" 2>/dev/null)"
  if [[ ! "${pinned_server_id}" =~ ^[A-Za-z0-9_.:-]+$ ||
        "${pinned_server_id}" == "unavailable" ]]; then
    echo "qcsd-lab cannot bind the local Docker daemon identity" >&2
    exit 1
  fi
  IFS= read -r pinned_boot_id </proc/sys/kernel/random/boot_id ||
    pinned_boot_id=""
  if [[ ! "${pinned_boot_id}" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
    echo "qcsd-lab cannot bind the current host boot identity" >&2
    exit 1
  fi
  if [[ -n "${QCSD_DOCKER_PINNED_CONTEXT:-}" ||
        -n "${QCSD_DOCKER_PINNED_HOST:-}" ||
        -n "${QCSD_DOCKER_PINNED_SERVER_ID:-}" ]]; then
    if [[ "${QCSD_DOCKER_PINNED_CONTEXT:-}" != "${pinned_context}" ||
          "${QCSD_DOCKER_PINNED_HOST:-}" != "${pinned_endpoint}" ||
          "${QCSD_DOCKER_PINNED_SERVER_ID:-}" != "${pinned_server_id}" ]]; then
      echo "qcsd-lab Docker endpoint drifted from its supervising watch binding" >&2
      exit 1
    fi
  fi
  export DOCKER_CONTEXT="${pinned_context}"
  _QCSD_DOCKER_PINNED_CONTEXT="${pinned_context}"
  _QCSD_DOCKER_PINNED_HOST="${pinned_endpoint}"
  _QCSD_DOCKER_PINNED_SERVER_ID="${pinned_server_id}"
  _QCSD_DOCKER_PINNED_BOOT_ID="${pinned_boot_id}"
  observed_server_id="$(_qcsd_read_docker_daemon_id "${pinned_endpoint}" 2>/dev/null)"
  if [[ "${observed_server_id}" != "${pinned_server_id}" ]]; then
    echo "Docker is installed but its daemon is unavailable" >&2
    exit 1
  fi
  IFS= read -r observed_boot_id </proc/sys/kernel/random/boot_id ||
    observed_boot_id=""
  if [[ "${observed_boot_id}" != "${pinned_boot_id}" ]]; then
    echo "qcsd-lab host boot changed across lifecycle admission" >&2
    exit 1
  fi
  if [[ "${QCSD_LAUNCH_ACTION}" == "class-study" &&
        ( "${class_study_action:-}" == "acquisition-admission" ||
          "${class_study_action:-}" == "acquisition-run" ||
          "${class_study_action:-}" == "acquisition-status" ) ]]; then
    # The first invocation clears prior watcher scopes.  Repeat the complete
    # current-scope/authority check only after the potentially blocking Docker
    # lifecycle lock has been acquired, immediately before stale Docker state
    # can be mutated.
    "${class_watch_scope_recovery[@]}" >/dev/null || {
      echo "class-study ${class_study_action} lost scoped request authority before Docker recovery" >&2
      exit 1
    }
    unset class_watch_scope_recovery
  fi
  reconcile_stale_docker_supervisors || exit 1
  observed_server_id="$(_qcsd_read_docker_daemon_id "${pinned_endpoint}" 2>/dev/null)"
  if [[ "${observed_server_id}" != "${pinned_server_id}" ]]; then
    echo "qcsd-lab Docker daemon changed across lifecycle admission" >&2
    exit 1
  fi
  IFS= read -r observed_boot_id </proc/sys/kernel/random/boot_id ||
    observed_boot_id=""
  if [[ "${observed_boot_id}" != "${pinned_boot_id}" ]]; then
    echo "qcsd-lab host boot changed across lifecycle reconciliation" >&2
    exit 1
  fi
  _qcsd_complete_lifecycle_recovery || {
    echo "qcsd-lab final Docker lifecycle admission failed" >&2
    exit 1
  }
  # Campaign execution is intentionally serial. Retain the exact exclusive
  # lifecycle lock for the full invocation so publication, handoff retirement,
  # and crash recovery share one globally quiescent ownership namespace.
}

reject_evidence_build_image_overrides() {
  local variable
  for variable in QCSD_LAB_COLLECTION_IMAGE QCSD_LAB_PREPARE_IMAGE \
                  QCSD_LAB_REFERENCE_IMAGE; do
    if [[ -v "${variable}" ]]; then
      echo "qcsd-lab evidence build rejects image-role override ${variable}" >&2
      return 1
    fi
  done
}

acquire_evidence_build_lock() {
  command -v flock >/dev/null 2>&1 &&
    command -v sha256sum >/dev/null 2>&1 &&
    command -v stat >/dev/null 2>&1 || {
    echo "qcsd-lab evidence build requires flock, sha256sum, and stat on the host" >&2
    return 1
  }
  local current_uid lock_identity lock_root lock_state previous_umask
  current_uid="$(id -u)"
  if [[ ! "${current_uid}" =~ ^[0-9]+$ || -z "${build_docker_lock_identity}" ||
        -L /tmp || ! -d /tmp ]]; then
    echo "qcsd-lab evidence build cannot establish its shared host-lock root" >&2
    return 1
  fi
  lock_root="/tmp/qcsd-lab-evidence-build-${current_uid}"
  if ! mkdir -m 700 -- "${lock_root}" 2>/dev/null; then
    if [[ -L "${lock_root}" || ! -d "${lock_root}" ]]; then
      echo "qcsd-lab evidence build host-lock root is unsafe" >&2
      return 1
    fi
  fi
  lock_state="$(stat -c '%u:%a' -- "${lock_root}")"
  if [[ "${lock_state}" != "${current_uid}:700" ]]; then
    echo "qcsd-lab evidence build host-lock root has unsafe ownership or mode" >&2
    return 1
  fi
  lock_identity="$(
    printf '%s' "${build_docker_lock_identity}" | sha256sum | awk '{print $1}'
  )"
  if [[ ! "${lock_identity}" =~ ^[0-9a-f]{64}$ ]]; then
    echo "qcsd-lab evidence build cannot derive the Docker daemon lock identity" >&2
    return 1
  fi
  build_lock_path="${lock_root}/${lock_identity}.lock"
  if [[ -e "${build_lock_path}" || -L "${build_lock_path}" ]]; then
    lock_state="$(stat -Lc '%u:%a:%h:%F' -- "${build_lock_path}" 2>/dev/null)" ||
      lock_state="invalid"
    if [[ "${lock_state}" != "${current_uid}:600:1:regular empty file" ]]; then
      echo "qcsd-lab evidence build lock must be an exact private empty file" >&2
      return 1
    fi
  fi
  if [[ -L "${build_lock_path}" ]]; then
    echo "qcsd-lab evidence build lock must not be a symbolic link" >&2
    return 1
  fi
  previous_umask="$(umask)"
  umask 077
  exec {build_host_lock_fd}<>"${build_lock_path}"
  umask "${previous_umask}"
  lock_state="$(stat -Lc '%u:%a:%h:%F' -- "${build_lock_path}")"
  if [[ "${lock_state}" != "${current_uid}:600:1:regular empty file" ]]; then
    echo "qcsd-lab evidence build lock has unsafe ownership or mode" >&2
    return 1
  fi
  if ! flock -n "${build_host_lock_fd}"; then
    echo "another qcsd-lab evidence build holds this user/WSL instance's Docker-daemon lock" >&2
    return 1
  fi
}

reject_unresolved_evidence_build() {
  local current_uid record supervisor_root root_metadata record_metadata line
  local field_key field_count expected_field record_line_count scope_record_invalid
  local object_count working_directory_count daemon_id_count context_count host_count
  local server_id_count cli_pid_count cli_start_count cli_session_count cli_group_count
  local argv_hash_count cohort_count receipt_count transaction_state_count
  local object working_directory docker_daemon_id docker_context docker_host
  local docker_server_id cli_pid cli_start cli_session cli_group build_argv_sha256
  local transaction_cohort transaction_receipt transaction_state canonical_path
  local scope_unit scope_control_group scope_state scope_pid scope_start
  local scope_session scope_group scope_docker_status scope_systemd_status
  local nullglob_was_set=0
  local -a records=()
  local -a scope_supervision_fields=(
    object process_identity_role scope_launcher_pid scope_launcher_start_time
    scope_launcher_session scope_launcher_process_group docker_context docker_host
    docker_server_id docker_daemon_id working_directory build_argv_sha256
    scope_required scope_unit scope_control_group scope_state host_boot_id
    status_file status_file_state requested_signal forwarded_cli_signal
    daemon_cancellation
  )
  local -a scope_recovery_fields=(
    object process_identity_role scope_launcher_pid scope_launcher_start_time
    scope_launcher_session scope_launcher_process_group docker_context docker_host
    docker_server_id docker_daemon_id working_directory build_argv_sha256
    scope_required scope_unit scope_control_group scope_final_state
    scope_signal_attempted scope_signal_outcome scope_leak_detected
    scope_kill_attempted scope_kill_outcome scope_empty_proven host_boot_id
    status_file status_file_state status_file_matches docker_command_status
    systemd_run_status requested_signal forwarded_cli_signal
    cli_signal_attempted cli_signal_outcome cli_forced cli_force_attempted
    cli_force_outcome daemon_cancellation
  )
  local -A scope_field_counts=()
  local -A scope_field_values=()
  current_uid="$(id -u)"
  shopt -q nullglob && nullglob_was_set=1
  shopt -s nullglob
  records=(
    /tmp/qcsd-docker-build-supervisor.*/SUPERVISION
    /tmp/qcsd-docker-build-supervisor.*/RECOVERY
  )
  (( nullglob_was_set )) || shopt -u nullglob
  for record in "${records[@]}"; do
    supervisor_root="${record%/*}"
    if [[ -L "${supervisor_root}" ]]; then
      echo "qcsd-lab evidence build found unsafe prior supervisor state: ${supervisor_root}" >&2
      return 1
    fi
    root_metadata="$(stat -c '%u:%a:%F' -- "${supervisor_root}" 2>/dev/null)" ||
      continue
    if [[ "${root_metadata%%:*}" != "${current_uid}" ]]; then
      continue
    fi
    if [[ "${root_metadata}" != "${current_uid}:700:directory" ]]; then
      echo "qcsd-lab evidence build found unsafe prior supervisor state: ${supervisor_root}" >&2
      return 1
    fi
    if [[ -L "${record}" ]]; then
      echo "qcsd-lab evidence build found unsafe prior supervisor record: ${record}" >&2
      return 1
    fi
    record_metadata="$(stat -c '%u:%a:%h:%F' -- "${record}" 2>/dev/null)" ||
      continue
    if [[ "${record_metadata}" != "${current_uid}:600:1:regular file" ]]; then
      echo "qcsd-lab evidence build found unsafe prior supervisor record: ${record}" >&2
      return 1
    fi
    object_count=0
    working_directory_count=0
    daemon_id_count=0
    context_count=0
    host_count=0
    server_id_count=0
    cli_pid_count=0
    cli_start_count=0
    cli_session_count=0
    cli_group_count=0
    argv_hash_count=0
    cohort_count=0
    receipt_count=0
    transaction_state_count=0
    record_line_count=0
    scope_field_counts=()
    scope_field_values=()
    object=""
    working_directory=""
    docker_daemon_id=""
    docker_context=""
    docker_host=""
    docker_server_id=""
    cli_pid=""
    cli_start=""
    cli_session=""
    cli_group=""
    build_argv_sha256=""
    transaction_cohort=""
    transaction_receipt=""
    transaction_state=""
    while IFS= read -r line || [[ -n "${line}" ]]; do
      record_line_count=$((record_line_count + 1))
      field_key="${line%%=*}"
      case "${field_key}" in
        object|process_identity_role|scope_launcher_pid|scope_launcher_start_time|\
        scope_launcher_session|scope_launcher_process_group|docker_context|\
        docker_host|docker_server_id|docker_daemon_id|working_directory|\
        build_argv_sha256|scope_required|scope_unit|scope_control_group|\
        scope_state|scope_final_state|scope_signal_attempted|scope_signal_outcome|\
        scope_leak_detected|scope_kill_attempted|scope_kill_outcome|\
        scope_empty_proven|host_boot_id|status_file|status_file_state|\
        status_file_matches|docker_command_status|systemd_run_status|\
        requested_signal|forwarded_cli_signal|cli_signal_attempted|\
        cli_signal_outcome|cli_forced|cli_force_attempted|cli_force_outcome|\
        daemon_cancellation)
          field_count="${scope_field_counts[${field_key}]-0}"
          scope_field_counts[${field_key}]=$((field_count + 1))
          scope_field_values[${field_key}]="${line#*=}"
          ;;
      esac
      case "${line}" in
        object=*)
          object_count=$((object_count + 1))
          object="${line#object=}"
          ;;
        working_directory=*)
          working_directory_count=$((working_directory_count + 1))
          working_directory="${line#working_directory=}"
          ;;
        docker_daemon_id=*)
          daemon_id_count=$((daemon_id_count + 1))
          docker_daemon_id="${line#docker_daemon_id=}"
          ;;
        docker_context=*) context_count=$((context_count + 1)); docker_context="${line#*=}" ;;
        docker_host=*) host_count=$((host_count + 1)); docker_host="${line#*=}" ;;
        docker_server_id=*)
          server_id_count=$((server_id_count + 1)); docker_server_id="${line#*=}"
          ;;
        cli_pid=*) cli_pid_count=$((cli_pid_count + 1)); cli_pid="${line#*=}" ;;
        cli_start_time=*)
          cli_start_count=$((cli_start_count + 1)); cli_start="${line#*=}"
          ;;
        cli_session=*)
          cli_session_count=$((cli_session_count + 1)); cli_session="${line#*=}"
          ;;
        cli_process_group=*)
          cli_group_count=$((cli_group_count + 1)); cli_group="${line#*=}"
          ;;
        build_argv_sha256=*)
          argv_hash_count=$((argv_hash_count + 1)); build_argv_sha256="${line#*=}"
          ;;
        cohort_version=*)
          cohort_count=$((cohort_count + 1)); transaction_cohort="${line#*=}"
          ;;
        receipt_path=*)
          receipt_count=$((receipt_count + 1)); transaction_receipt="${line#*=}"
          ;;
        transaction_state=*)
          transaction_state_count=$((transaction_state_count + 1));
          transaction_state="${line#*=}"
          ;;
      esac
    done <"${record}"
    if (( object_count != 1 || working_directory_count != 1 ||
          daemon_id_count != 1 )) ||
       [[ "${object}" != "docker-build-cli" &&
          "${object}" != "docker-build-transaction" &&
          "${object}" != "docker-build-scope-launcher" ]]; then
      echo "qcsd-lab evidence build found malformed prior supervisor record: ${record}" >&2
      return 1
    fi
    canonical_path="$(realpath -m -- "${working_directory}" 2>/dev/null)" ||
      canonical_path=""
    if [[ ! "${docker_daemon_id}" =~ ^[A-Za-z0-9_.:-]+$ ||
          "${docker_daemon_id}" == "unavailable" ||
          "${working_directory}" != /* || "${working_directory}" == "/" ||
          "${canonical_path}" != "${working_directory}" ||
          ${context_count} -ne 1 ||
          ! "${docker_context}" =~ ^[A-Za-z0-9_.-]+$ ||
          ${host_count} -ne 1 ||
          ( "${docker_host}" != "unix:///var/run/docker.sock" &&
            "${docker_host}" != "npipe:////./pipe/dockerDesktopLinuxEngine" ) ]]; then
      echo "qcsd-lab evidence build found malformed prior supervisor record: ${record}" >&2
      return 1
    fi
    if [[ "${object}" == "docker-build-cli" ]]; then
      if (( server_id_count != 1 || cli_pid_count != 1 || cli_start_count != 1 ||
            cli_session_count != 1 || cli_group_count != 1 || argv_hash_count != 1 )) ||
         [[ "${docker_server_id}" != "${docker_daemon_id}" ||
            ! "${build_argv_sha256}" =~ ^[0-9a-f]{64}$ ||
            ! "${cli_pid}" =~ ^(unavailable|[1-9][0-9]*)$ ||
            ! "${cli_start}" =~ ^(unavailable|[1-9][0-9]*)$ ||
            ! "${cli_session}" =~ ^(unavailable|[1-9][0-9]*)$ ||
            ! "${cli_group}" =~ ^(unavailable|[1-9][0-9]*)$ ]]; then
        echo "qcsd-lab evidence build found malformed prior supervisor record: ${record}" >&2
        return 1
      fi
    elif [[ "${object}" == "docker-build-transaction" ]]; then
      canonical_path="$(realpath -m -- "${transaction_receipt}" 2>/dev/null)" ||
        canonical_path=""
      if (( server_id_count != 1 || cohort_count != 1 || receipt_count != 1 ||
            transaction_state_count != 1 )) ||
         [[ "${docker_server_id}" != "${docker_daemon_id}" ||
            ! "${transaction_cohort}" =~ ^[1-9][0-9]*$ ||
            "${transaction_receipt}" != /* || "${transaction_receipt}" == "/" ||
            "${canonical_path}" != "${transaction_receipt}" ||
            "${transaction_state}" != "uncommitted-static-tag-mutation" ]]; then
        echo "qcsd-lab evidence build found malformed prior supervisor record: ${record}" >&2
        return 1
      fi
    else
      scope_record_invalid=0
      if [[ "${record##*/}" == "SUPERVISION" ]]; then
        if (( record_line_count != ${#scope_supervision_fields[@]} )); then
          scope_record_invalid=1
        fi
        for expected_field in "${scope_supervision_fields[@]}"; do
          if (( ${scope_field_counts[${expected_field}]-0} != 1 )); then
            scope_record_invalid=1
          fi
        done
      elif [[ "${record##*/}" == "RECOVERY" ]]; then
        if (( record_line_count != ${#scope_recovery_fields[@]} )); then
          scope_record_invalid=1
        fi
        for expected_field in "${scope_recovery_fields[@]}"; do
          if (( ${scope_field_counts[${expected_field}]-0} != 1 )); then
            scope_record_invalid=1
          fi
        done
      else
        scope_record_invalid=1
      fi
      if (( scope_record_invalid != 0 )); then
        echo "qcsd-lab evidence build found malformed prior supervisor record: ${record}" >&2
        return 1
      fi

      scope_unit="${scope_field_values[scope_unit]}"
      scope_control_group="${scope_field_values[scope_control_group]}"
      if [[ "${scope_control_group}" != "unavailable" ]]; then
        canonical_path="$(realpath -m -- "${scope_control_group}" 2>/dev/null)" ||
          canonical_path=""
      else
        canonical_path="unavailable"
      fi
      if (( server_id_count != 1 || argv_hash_count != 1 )) ||
         [[ "${docker_server_id}" != "${docker_daemon_id}" ||
            "${scope_field_values[process_identity_role]}" != "local-systemd-run-scope-launcher" ||
            ! "${build_argv_sha256}" =~ ^[0-9a-f]{64}$ ||
            "${scope_field_values[scope_required]}" != "1" ||
            ! "${scope_unit}" =~ ^qcsd-docker-build-[0-9a-f]{32}[.]scope$ ||
            ! "${scope_field_values[host_boot_id]}" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ||
            "${scope_field_values[status_file]}" != "${supervisor_root}/build.status" ||
            ! "${scope_field_values[requested_signal]}" =~ ^(none|HUP|INT|QUIT|TERM)$ ||
            ! "${scope_field_values[forwarded_cli_signal]}" =~ ^(none|INT)$ ||
            "${scope_field_values[daemon_cancellation]}" != "unavailable-client-disconnect-only" ||
            ( "${scope_control_group}" != "unavailable" &&
              ( "${scope_control_group}" != /* ||
                "${canonical_path}" != "${scope_control_group}" ||
                "${scope_control_group}" != */"${scope_unit}" ||
                ! "${scope_control_group}" =~ ^/[A-Za-z0-9_.@:/-]+$ ) ) ]]; then
        echo "qcsd-lab evidence build found malformed prior supervisor record: ${record}" >&2
        return 1
      fi

      scope_pid="${scope_field_values[scope_launcher_pid]}"
      scope_start="${scope_field_values[scope_launcher_start_time]}"
      scope_session="${scope_field_values[scope_launcher_session]}"
      scope_group="${scope_field_values[scope_launcher_process_group]}"
      if [[ "${record##*/}" == "SUPERVISION" ]]; then
        scope_state="${scope_field_values[scope_state]}"
        if [[ "${scope_field_values[forwarded_cli_signal]}" != "none" ]]; then
          scope_record_invalid=1
        fi
        case "${scope_state}" in
          declared)
            if [[ "${scope_pid}" != "unavailable" ||
                  "${scope_start}" != "unavailable" ||
                  "${scope_session}" != "unavailable" ||
                  "${scope_group}" != "unavailable" ||
                  "${scope_control_group}" != "unavailable" ||
                  "${scope_field_values[status_file_state]}" != "declared" ||
                  "${scope_field_values[requested_signal]}" != "none" ]]; then
              scope_record_invalid=1
            fi
            ;;
          active|inactive)
            if [[ ! "${scope_pid}" =~ ^[1-9][0-9]*$ ||
                  ! "${scope_start}" =~ ^[1-9][0-9]*$ ||
                  "${scope_session}" != "${scope_pid}" ||
                  "${scope_group}" != "${scope_pid}" ||
                  "${scope_control_group}" == "unavailable" ||
                  "${scope_field_values[status_file_state]}" != "awaiting-command-status" ]]; then
              scope_record_invalid=1
            fi
            ;;
          absent)
            if [[ ! "${scope_pid}" =~ ^[1-9][0-9]*$ ||
                  ! "${scope_start}" =~ ^[1-9][0-9]*$ ||
                  "${scope_session}" != "${scope_pid}" ||
                  "${scope_group}" != "${scope_pid}" ||
                  "${scope_control_group}" != "unavailable" ||
                  "${scope_field_values[status_file_state]}" != "awaiting-command-status" ]]; then
              scope_record_invalid=1
            fi
            ;;
          *) scope_record_invalid=1 ;;
        esac
      else
        scope_state="${scope_field_values[scope_final_state]}"
        if [[ ! "${scope_pid}" =~ ^[1-9][0-9]*$ ||
              ! "${scope_start}" =~ ^(unavailable|[1-9][0-9]*)$ ]]; then
          scope_record_invalid=1
        elif [[ "${scope_session}" == "unavailable" &&
                "${scope_group}" == "unavailable" ]]; then
          :
        elif [[ "${scope_start}" =~ ^[1-9][0-9]*$ &&
                "${scope_session}" == "${scope_pid}" &&
                "${scope_group}" == "${scope_pid}" ]]; then
          :
        else
          scope_record_invalid=1
        fi

        case "${scope_field_values[scope_signal_attempted]}:${scope_field_values[scope_signal_outcome]}" in
          0:not_attempted) ;;
          1:accepted|1:unknown) ;;
          *) scope_record_invalid=1 ;;
        esac
        if [[ "${scope_field_values[requested_signal]}" == "none" ]]; then
          [[ "${scope_field_values[scope_signal_attempted]}" == "0" ]] ||
            scope_record_invalid=1
        elif [[ "${scope_field_values[scope_signal_attempted]}" == "0" ]]; then
          # A terminal signal may latch after the scope-signal boundary. It is
          # valid to make no signalling attempt only when the later evidence
          # proves both the scope and its launcher already terminal.
          if [[ "${scope_field_values[scope_empty_proven]}" != "1" ||
                "${scope_field_values[status_file_state]}" == "launcher-unreaped" ]]; then
            scope_record_invalid=1
          fi
        elif [[ "${scope_field_values[scope_signal_attempted]}" != "1" ]]; then
          scope_record_invalid=1
        fi

        case "${scope_field_values[scope_leak_detected]}:${scope_field_values[scope_kill_attempted]}:${scope_field_values[scope_kill_outcome]}" in
          0:0:not_attempted) ;;
          1:1:accepted|1:1:unknown) ;;
          *) scope_record_invalid=1 ;;
        esac
        case "${scope_field_values[scope_empty_proven]}:${scope_state}" in
          1:inactive)
            [[ "${scope_control_group}" != "unavailable" ]] ||
              scope_record_invalid=1
            ;;
          1:absent|0:unknown) ;;
          *) scope_record_invalid=1 ;;
        esac

        scope_docker_status="${scope_field_values[docker_command_status]}"
        scope_systemd_status="${scope_field_values[systemd_run_status]}"
        case "${scope_field_values[status_file_state]}" in
          valid)
            if [[ "${scope_field_values[status_file_matches]}" != "1" ||
                  ! "${scope_docker_status}" =~ ^(0|[1-9][0-9]{0,2})$ ||
                  ! "${scope_systemd_status}" =~ ^(0|[1-9][0-9]{0,2})$ ||
                  "${scope_docker_status}" != "${scope_systemd_status}" ]]; then
              scope_record_invalid=1
            elif (( 10#${scope_docker_status} > 255 ||
                    10#${scope_systemd_status} > 255 )); then
              scope_record_invalid=1
            fi
            ;;
          status-mismatch)
            if [[ "${scope_field_values[status_file_matches]}" != "0" ||
                  ! "${scope_docker_status}" =~ ^(0|[1-9][0-9]{0,2})$ ||
                  ! "${scope_systemd_status}" =~ ^(0|[1-9][0-9]{0,2})$ ||
                  "${scope_docker_status}" == "${scope_systemd_status}" ]]; then
              scope_record_invalid=1
            elif (( 10#${scope_docker_status} > 255 ||
                    10#${scope_systemd_status} > 255 )); then
              scope_record_invalid=1
            fi
            ;;
          invalid|missing)
            if [[ "${scope_field_values[status_file_matches]}" != "0" ||
                  "${scope_docker_status}" != "unavailable" ||
                  ! "${scope_systemd_status}" =~ ^(0|[1-9][0-9]{0,2})$ ]]; then
              scope_record_invalid=1
            elif (( 10#${scope_systemd_status} > 255 )); then
              scope_record_invalid=1
            fi
            ;;
          launcher-unreaped)
            if [[ "${scope_field_values[status_file_matches]}" != "0" ||
                  "${scope_docker_status}" != "unavailable" ||
                  "${scope_systemd_status}" != "unavailable" ]]; then
              scope_record_invalid=1
            fi
            ;;
          *) scope_record_invalid=1 ;;
        esac

        case "${scope_field_values[cli_signal_attempted]}:${scope_field_values[cli_signal_outcome]}:${scope_field_values[forwarded_cli_signal]}" in
          0:not_attempted:none) ;;
          1:accepted:INT|1:unknown:none) ;;
          *) scope_record_invalid=1 ;;
        esac
        if [[ "${scope_field_values[requested_signal]}" == "none" &&
              "${scope_field_values[cli_signal_attempted]}" != "0" ]]; then
          scope_record_invalid=1
        fi
        case "${scope_field_values[cli_force_attempted]}:${scope_field_values[cli_forced]}:${scope_field_values[cli_force_outcome]}" in
          0:0:not_attempted) ;;
          1:1:accepted|1:0:unknown) ;;
          *) scope_record_invalid=1 ;;
        esac
      fi
      if (( scope_record_invalid != 0 )); then
        echo "qcsd-lab evidence build found malformed prior supervisor record: ${record}" >&2
        return 1
      fi
    fi
    if [[ "${docker_daemon_id}" == "${build_docker_server_id}" ||
          "${working_directory}" == "${ROOT}" ]]; then
      echo "qcsd-lab evidence build is blocked by unresolved prior Docker build state: ${record}" >&2
      echo "restart and audit the Docker daemon, then remove only this verified supervisor directory before retrying" >&2
      return 1
    fi
  done
}

begin_evidence_build_transaction() {
  local staged root_metadata token transaction_boot_id
  if [[ -n "${build_transaction_root:-}" ]]; then
    echo "qcsd-lab evidence build transaction is already active" >&2
    return 1
  fi
  if [[ "${_QCSD_LIFECYCLE_LOCK_MODE:-}" != "exclusive" ]] ||
     ! command -v sync >/dev/null 2>&1 ||
     ! _qcsd_bind_helper_source_identity; then
    echo "qcsd-lab cannot establish durable build-transaction evidence" >&2
    return 1
  fi
  # This transaction is the one exact provisional mutation owned by the
  # current guardian lease.  Deriving its canonical name from the guardian's
  # unguessable lease nonce lets the completion child independently prove that
  # the retired path supplied by its qcsd parent belongs to this invocation;
  # an arbitrary absent transaction.<nonce> pathname is not sufficient.
  [[ "${_QCSD_LIFECYCLE_LEASE_NONCE:-}" =~ ^[0-9a-f]{64}$ ]] || return 1
  token="${_QCSD_LIFECYCLE_LEASE_NONCE:0:32}"
  _qcsd_create_lifecycle_root transaction "${token}" || return 1
  build_transaction_root="${_qcsd_lifecycle_root}"
  IFS= read -r transaction_boot_id </proc/sys/kernel/random/boot_id || {
    _qcsd_cancel_lifecycle_root_creation || true; return 1;
  }
  [[ "${transaction_boot_id}" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] ||
    { _qcsd_cancel_lifecycle_root_creation || true; return 1; }
  root_metadata="$(stat -Lc '%u:%a:%F' -- "${build_transaction_root}" 2>/dev/null)" ||
    { _qcsd_cancel_lifecycle_root_creation || true; return 1; }
  if [[ "${root_metadata}" != "$(id -u):700:directory" ]]; then
    echo "qcsd-lab build transaction root is not private" >&2
    _qcsd_cancel_lifecycle_root_creation || true
    return 1
  fi
  staged="${build_transaction_root}/SUPERVISION.next"
  local supervisor_root="${build_transaction_root}"
  local lifecycle_state="request-authorised"
  if ! {
    printf 'object=docker-build-transaction\n'
    _qcsd_print_lifecycle_identity
    printf 'docker_context=%s\n' "${build_docker_context}"
    _qcsd_print_docker_binding
    printf 'docker_daemon_id=%s\n' "${build_docker_server_id}"
    printf 'host_boot_id=%s\n' "${transaction_boot_id}"
    printf 'working_directory=%s\n' "${ROOT}"
    printf 'cohort_version=%s\n' "${build_cohort_version}"
    printf 'receipt_path=%s\n' "${build_receipt}"
    printf 'transaction_state=uncommitted-static-tag-mutation\n'
  } >"${staged}"; then
    _qcsd_cancel_lifecycle_root_creation || true
    return 1
  fi
  if ! _qcsd_publish_supervision_file \
      "${staged}" "${build_transaction_root}/SUPERVISION"; then
    echo "qcsd-lab cannot publish durable build-transaction evidence" >&2
    if (( _QCSD_PUBLISH_REPLACED != 0 )); then
      _qcsd_commit_lifecycle_root_creation || true
    else
      _qcsd_cancel_lifecycle_root_creation || true
    fi
    return 1
  fi
  _qcsd_commit_lifecycle_root_creation || return 1
  _QCSD_DOCKER_BUILD_TRANSACTION_ROOT="${build_transaction_root}"
}

complete_evidence_build_transaction() {
  local record root_metadata record_metadata receipt_binding_recheck
  local transaction_binding
  record="${build_transaction_root:-}/SUPERVISION"
  if [[ "${_QCSD_LIFECYCLE_LOCK_MODE:-}" != "exclusive" ]] ||
     ! _qcsd_verify_pinned_docker_daemon ||
     ! _qcsd_verify_pinned_host_boot ||
     ! _qcsd_lifecycle_validate_root \
        "${build_transaction_root:-}" transaction ||
     (( _QCSD_LIFECYCLE_SELECTED_UNPUBLISHED != 0 )) ||
     [[ "${_QCSD_LIFECYCLE_SELECTED_VALUES[lifecycle_state]}" != \
          "request-authorised" ||
        "${_QCSD_LIFECYCLE_SELECTED_VALUES[working_directory]}" != "${ROOT}" ||
        "${_QCSD_LIFECYCLE_SELECTED_VALUES[cohort_version]}" != \
          "${build_cohort_version}" ||
        "${_QCSD_LIFECYCLE_SELECTED_VALUES[receipt_path]}" != \
        "${build_receipt}" ]] ||
     ! receipt_binding_recheck="$(
       python3 -I "${ROOT}/src/qcsd_lab/build_storage.py" receipt-binding \
         "${build_receipt}" --expected-cohort "${build_cohort_version}" \
         --probe-path "${ROOT}/tools/windows_docker_storage_probe.ps1"
     )" || [[ -z "${receipt_binding_recheck}" ||
               "${receipt_binding_recheck}" == *$'\n'* ||
               "${receipt_binding_recheck}" != "${build_receipt_binding:-}" ]]; then
    echo "qcsd-lab cannot validate the active build transaction at commit" >&2
    return 1
  fi
  root_metadata="$(stat -Lc '%u:%a:%F' -- "${build_transaction_root:-}" 2>/dev/null)" ||
    return 1
  record_metadata="$(stat -Lc '%u:%a:%h:%F' -- "${record}" 2>/dev/null)" ||
    return 1
  if [[ "${root_metadata}" != "$(id -u):700:directory" ||
        "${record_metadata}" != "$(id -u):600:1:regular file" ]]; then
    echo "qcsd-lab cannot acknowledge an incomplete build transaction" >&2
    return 1
  fi
  if ! transaction_binding="$(
    python3 -I "${ROOT}/src/qcsd_lab/build_storage.py" transaction-binding \
      "${record}" --expected-receipt "${build_receipt}" \
      --expected-cohort "${build_cohort_version}" \
      --expected-lease-nonce "${_QCSD_LIFECYCLE_LEASE_NONCE}" \
      --probe-path "${ROOT}/tools/windows_docker_storage_probe.ps1"
  )" || [[ -z "${transaction_binding}" || "${transaction_binding}" == *$'\n'* ]]; then
    echo "qcsd-lab cannot bind the active build transaction before retirement" >&2
    return 1
  fi
  # The receipt writer has already fsynced both the exact validated receipt
  # inode and its parent.  The transaction may retire only while that complete
  # byte/stat/schema/cohort binding remains unchanged.  Retirement is still
  # provisional: the separately fsynced completion file is the authoritative
  # build-success linearisation after scratch cleanup and final reproof.
  build_retired_transaction_root="${build_transaction_root}"
  build_transaction_retirement_binding="${transaction_binding}"
  _qcsd_lifecycle_remove_root "${build_transaction_root}" 0 transaction-committed || return 1
  _QCSD_DOCKER_BUILD_TRANSACTION_ROOT=""
  build_transaction_root=""
}

read_built_image_id() {
  local target="$1"
  local iidfile="$2"
  local -a lines=()
  if [[ -L "${iidfile}" || ! -f "${iidfile}" ]]; then
    echo "qcsd-lab ${target} build did not create a regular IID file" >&2
    return 1
  fi
  mapfile -t lines <"${iidfile}"
  if (( ${#lines[@]} != 1 )) ||
     [[ ! "${lines[0]}" =~ ^sha256:[0-9a-f]{64}$ ]]; then
    echo "qcsd-lab ${target} build returned an invalid immutable image ID" >&2
    return 1
  fi
  printf '%s\n' "${lines[0]}"
}

verify_built_image_binding() {
  local target="$1"
  local tag="$2"
  local expected_id="$3"
  local observed_id
  observed_id="$(
    _qcsd_docker_api --context "${build_docker_context}" image inspect \
      --format '{{.Id}}' "${tag}"
  )"
  if [[ "${observed_id}" != "${expected_id}" ]]; then
    echo "qcsd-lab ${target} image tag no longer binds its build-produced ID" >&2
    return 1
  fi
}

reject_docker_endpoint_overrides() {
  local variable
  for variable in DOCKER_HOST DOCKER_CONTEXT DOCKER_CONFIG DOCKER_TLS_VERIFY \
                  DOCKER_CERT_PATH DOCKER_DEFAULT_PLATFORM BUILDX_BUILDER \
                  BUILDX_CONFIG BUILDKIT_HOST DOCKER_BUILDKIT; do
    if [[ -n "${!variable:-}" ]]; then
      echo "qcsd-lab evidence build rejects Docker endpoint/builder override ${variable}" >&2
      return 1
    fi
  done
}

validate_local_docker_build_endpoint() {
  local current_context current_endpoint current_server_name
  local current_server_operating_system current_server_os_type
  local current_server_architecture current_server_id current_identity
  local current_server_json
  local -a current_server_fields
  current_context="$(_qcsd_docker_api context show)"
  if [[ "${current_context}" != "default" &&
        "${current_context}" != "desktop-linux" ]]; then
    echo "qcsd-lab evidence build requires the default local Docker context" >&2
    return 1
  fi
  current_endpoint="$(
    _qcsd_docker_api context inspect --format '{{.Endpoints.docker.Host}}' \
      "${current_context}"
  )"
  if [[ "${current_endpoint}" != "unix:///var/run/docker.sock" &&
        "${current_endpoint}" != "npipe:////./pipe/dockerDesktopLinuxEngine" ]]; then
    echo "qcsd-lab evidence build requires a local Docker Desktop endpoint" >&2
    return 1
  fi
  current_server_json="$(
    _qcsd_docker_api_with_timeout "${_QCSD_DOCKER_METADATA_TIMEOUT_SECONDS}" \
      --context "${current_context}" info --format '{{json .}}'
  )"
  if ! mapfile -t current_server_fields < <(
    printf '%s\n' "${current_server_json}" | python3 -I -c '
import json, sys
value = json.load(sys.stdin)
for key in ("Name", "OperatingSystem", "OSType", "Architecture", "ID"):
    item = value.get(key)
    if not isinstance(item, str) or not item:
        raise SystemExit(1)
    print(item)
'
  ) || (( ${#current_server_fields[@]} != 5 )); then
    echo "qcsd-lab evidence build received invalid local Docker server identity" >&2
    return 1
  fi
  current_server_name="${current_server_fields[0]}"
  current_server_operating_system="${current_server_fields[1]}"
  current_server_os_type="${current_server_fields[2]}"
  current_server_architecture="${current_server_fields[3]}"
  current_server_id="${current_server_fields[4]}"
  if [[ -z "${current_server_name}" ||
        -z "${current_server_operating_system}" ||
        "${current_server_os_type}" != "linux" ||
        -z "${current_server_architecture}" ||
        -z "${current_server_id}" ]]; then
    echo "qcsd-lab evidence build received invalid local Docker server identity" >&2
    return 1
  fi
  if (( build_host_storage_applicable )) &&
     [[ "${current_server_operating_system,,}" != *docker\ desktop* ]]; then
    echo "qcsd-lab WSL evidence build requires the local Docker Desktop Linux engine" >&2
    return 1
  fi
  current_identity="${current_context}"$'\t'"${current_endpoint}"$'\t'\
"${current_server_name}"$'\t'"${current_server_operating_system}"$'\t'\
"${current_server_os_type}"$'\t'"${current_server_architecture}"$'\t'\
"${current_server_id}"
  if [[ -n "${build_docker_identity}" &&
        "${current_identity}" != "${build_docker_identity}" ]]; then
    echo "qcsd-lab evidence build Docker daemon identity changed between build boundaries" >&2
    return 1
  fi
  build_docker_identity="${current_identity}"
  build_docker_context="${current_context}"
  build_docker_endpoint="${current_endpoint}"
  build_docker_server_name="${current_server_name}"
  build_docker_server_operating_system="${current_server_operating_system}"
  build_docker_server_os_type="${current_server_os_type}"
  build_docker_server_architecture="${current_server_architecture}"
  build_docker_server_id="${current_server_id}"
  build_docker_lock_identity="${current_server_id}"$'\t'\
"${current_server_os_type}"$'\t'"${current_server_architecture}"
}

wsl_host_build_storage_init() {
  build_host_storage_applicable=0
  build_host_storage_platform="other-host"
  build_host_storage_policy="docker-data-vhdx-backing-volume-minimum-v1"
