browser_egress_reconcile_filesystem() {
  local entry name relative residue_entry="" residue_kind="" residue_count=0
  local recovery_parent recovery_relative target_name
  local -a reconcile_mounts=()
  while IFS= read -r -d '' entry; do
    name="${entry##*/}"
    relative="${entry#"${browser_egress_result_host}/"}"
    case "${relative}" in
      .foundation.json.[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].qcsd-tmp)
        residue_kind=foundation ;;
      .final.json.[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].qcsd-tmp)
        residue_kind=final ;;
      .experiment.json.qcsd-tmp-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f])
        residue_kind=checkpoint ;;
      attempts/.result-[0-9][0-9][0-9][0-9].json.[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].qcsd-tmp)
        residue_kind=result ;;
      attempt-intents/.intent-[0-9][0-9][0-9][0-9].json.[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].qcsd-tmp)
        residue_kind=intent ;;
      *)
        if [[ "${relative}" =~ ^evidence/[0-9]{3}--[a-z0-9][a-z0-9-]{0,127}/attempt-[1-3]/\.resume-recovery\.json\.[0-9a-f]{8}\.qcsd-tmp$ ]]; then
          residue_kind=recovery
        else
          continue
        fi
        ;;
    esac
    residue_entry="${entry}"
    residue_count=$((residue_count + 1))
  done < <(find "${browser_egress_result_host}" -mindepth 1 -maxdepth 4 \
    -name '*qcsd-tmp*' -print0)
  if (( residue_count > 1 )); then
    echo "browser-egress reconciliation found multiple ledger residues" >&2
    return 1
  fi
  if (( residue_count == 0 )); then
    reconcile_mounts=(
      --volume "${browser_egress_result_host}:${browser_egress_result_container}:ro"
    )
  else
    reconcile_mounts=(
      --volume "${browser_egress_result_host}:${browser_egress_result_container}:rw"
      --volume "${browser_egress_result_host}/evidence:${browser_egress_result_container}/evidence:ro"
    )
    if [[ "${residue_kind}" != result ]]; then
      reconcile_mounts+=(
        --volume "${browser_egress_result_host}/attempts:${browser_egress_result_container}/attempts:ro"
      )
    fi
    if [[ "${residue_kind}" != intent ]]; then
      reconcile_mounts+=(
        --volume "${browser_egress_result_host}/attempt-intents:${browser_egress_result_container}/attempt-intents:ro"
      )
    fi
    if [[ "${residue_kind}" != foundation ]]; then
      reconcile_mounts+=(
        --volume "${browser_egress_result_host}/foundation.json:${browser_egress_result_container}/foundation.json:ro"
      )
    fi
    if [[ "${residue_kind}" != checkpoint && "${residue_kind}" != result ]]; then
      reconcile_mounts+=(
        --volume "${browser_egress_result_host}/experiment.json:${browser_egress_result_container}/experiment.json:ro"
      )
    fi
    if [[ -f "${browser_egress_result_host}/final.json" &&
          "${residue_kind}" != final ]]; then
      reconcile_mounts+=(
        --volume "${browser_egress_result_host}/final.json:${browser_egress_result_container}/final.json:ro"
      )
    fi
    if [[ "${residue_kind}" == result ]]; then
      while IFS= read -r -d '' entry; do
        target_name="${entry##*/}"
        if compgen -G "${browser_egress_result_host}/attempts/.${target_name}.????????.qcsd-tmp" >/dev/null; then
          continue
        fi
        reconcile_mounts+=(
          --volume "${entry}:${browser_egress_result_container}/attempts/${target_name}:ro"
        )
      done < <(find "${browser_egress_result_host}/attempts" -mindepth 1 -maxdepth 1 \
        -type f -name 'result-????.json' -print0)
    elif [[ "${residue_kind}" == intent ]]; then
      while IFS= read -r -d '' entry; do
        target_name="${entry##*/}"
        if compgen -G "${browser_egress_result_host}/attempt-intents/.${target_name}.????????.qcsd-tmp" >/dev/null; then
          continue
        fi
        reconcile_mounts+=(
          --volume "${entry}:${browser_egress_result_container}/attempt-intents/${target_name}:ro"
        )
      done < <(find "${browser_egress_result_host}/attempt-intents" -mindepth 1 -maxdepth 1 \
        -type f -name 'intent-????.json' -print0)
    elif [[ "${residue_kind}" == recovery ]]; then
      recovery_parent="$(dirname "${residue_entry}")"
      recovery_relative="${recovery_parent#"${browser_egress_result_host}/"}"
      reconcile_mounts+=(
        --volume "${recovery_parent}:${browser_egress_result_container}/${recovery_relative}:rw"
      )
    fi
  fi
  qcsd_run_attached_docker docker run --network none \
    --user "${qcsd_invoking_uid}:${qcsd_invoking_gid}" \
    --cap-drop ALL --security-opt no-new-privileges:true --read-only \
    --tmpfs /tmp:rw,nosuid,nodev,noexec,mode=1777 \
    --env "QCSD_LAB_IMAGE_DIGEST=${image_id}" --volume "${ROOT}:/lab:ro" \
    "${reconcile_mounts[@]}" \
    --entrypoint /usr/bin/tini "${image_id}" -- \
    /usr/bin/timeout --signal=TERM --kill-after=10s 600s \
    /usr/local/bin/qcsd-browser-egress-qualification reconcile-filesystem \
    --cohort-version "${browser_egress_cohort_version}" \
    --build-execution-receipt "${browser_egress_build_container}" \
    --result-root "${browser_egress_result_container}" \
    --live-docker-json "${browser_egress_live_docker_json}" >/dev/null
}

