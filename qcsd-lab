        -L "${pinned_cdp_build_host}" || ! -f "${pinned_cdp_build_host}" ||
        -e "${pinned_cdp_destination_host}" ||
        -L "${pinned_cdp_destination_host}" ]]; then
    echo "test pinned-cdp lost its create-only receipt paths before launch" >&2
    exit 1
  fi
  # The parent overlay grants only the ability to create the requested new
  # receipt.  Every pre-existing child, including the exact build input, is
  # over-mounted read-only so no earlier evidence can be replaced or removed.
  container+=(
    --volume "${pinned_cdp_destination_parent}:${pinned_cdp_destination_parent_container}:rw"
  )
  pinned_cdp_build_overlay=0
  while IFS= read -r -d '' pinned_cdp_existing_child; do
    if [[ -L "${pinned_cdp_existing_child}" ||
          ( ! -f "${pinned_cdp_existing_child}" &&
            ! -d "${pinned_cdp_existing_child}" ) ]]; then
      echo "test pinned-cdp output parent contains an unsafe existing child" >&2
      exit 1
    fi
    pinned_cdp_existing_name="${pinned_cdp_existing_child##*/}"
    if [[ ! "${pinned_cdp_existing_name}" =~ ^[A-Za-z0-9._-]+$ ]]; then
      echo "test pinned-cdp rejects unsafe existing output name: ${pinned_cdp_existing_name}" >&2
      exit 1
