    "${etf_probe_info}" "${etf_probe_image}")
  if (( ${#etf_probe_docker_fields[@]} != 2 )) ||
     [[ ! "${etf_probe_docker_fields[0]}" =~ ^sha256:[0-9a-f]{64}$ ||
        ! "${etf_probe_docker_fields[1]}" =~ ^(3|[4-9]|[1-9][0-9]+)$ ]]; then
    echo "ETF probe Docker binding is invalid" >&2
