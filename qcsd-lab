# Formal classifier work can run for hours.  Reject missing wall-capacity
# authority before build-receipt validation or Docker inspection so an invalid
# invocation cannot pay any evaluator startup cost.  Focused-study callers may
# provide the typed CLI override; generic analysis receives only the forwarded
# environment value.
qcsd_dlsvm_wall_argument=0
qcsd_validation_attestation_argument=0
qcsd_option_index=1
while (( qcsd_option_index <= $# )); do
  qcsd_option="${!qcsd_option_index}"
  case "${qcsd_option}" in
    --dlsvm-wall-seconds=*)
      if [[ -z "${qcsd_option#--dlsvm-wall-seconds=}" ]]; then
        echo "--dlsvm-wall-seconds requires a value" >&2
        exit 2
      fi
      qcsd_dlsvm_wall_argument=1
      ;;
    --dlsvm-wall-seconds)
      qcsd_option_value_index=$((qcsd_option_index + 1))
      if (( qcsd_option_value_index > $# )); then
        echo "--dlsvm-wall-seconds requires a value" >&2
        exit 2
      fi
      qcsd_dlsvm_wall_argument=1
      qcsd_option_index="${qcsd_option_value_index}"
      ;;
    --validation-attestation|--validation-attestation=*)
      qcsd_validation_attestation_argument=1
      ;;
  esac
  qcsd_option_index=$((qcsd_option_index + 1))
done
if [[ "${1:-}" == "buflo-study" &&
      ( "${2:-}" == "evaluate" || "${2:-}" == "verify" ) &&
      -z "${QCSD_DLSVM_AVAILABLE_WALL_SECONDS:-}" &&
      "${qcsd_dlsvm_wall_argument}" != "1" ]]; then
  echo "buflo-study ${2} requires --dlsvm-wall-seconds or QCSD_DLSVM_AVAILABLE_WALL_SECONDS for current capacity admission" >&2
  exit 2
fi
if [[ "${1:-}" == "analyze" &&
      "${qcsd_validation_attestation_argument}" == "1" &&
      -z "${QCSD_DLSVM_AVAILABLE_WALL_SECONDS:-}" ]]; then
  echo "analyze --validation-attestation requires QCSD_DLSVM_AVAILABLE_WALL_SECONDS for current capacity admission" >&2
  exit 2
fi

# Keep one terminal-signal handler installed for the complete mutable launcher
# lifetime.  Cleanup routines change only the atomic phase flag; they never
# replace four traps one at a time and therefore have no transition window in
# which a signal can be discarded or can interrupt exact-object teardown.
_QCSD_LIFETIME_SIGNAL_STATUS=0
_QCSD_LIFETIME_CLEANUP_ACTIVE=0
_qcsd_latch_lifetime_signal() {
  local received_status="$1"
  if (( _QCSD_LIFETIME_SIGNAL_STATUS == 0 )); then
    _QCSD_LIFETIME_SIGNAL_STATUS="${received_status}"
  fi
  if (( _QCSD_LIFETIME_CLEANUP_ACTIVE == 0 )); then
    exit "${_QCSD_LIFETIME_SIGNAL_STATUS}"
  fi
}
trap '_qcsd_latch_lifetime_signal 129' HUP
trap '_qcsd_latch_lifetime_signal 130' INT
trap '_qcsd_latch_lifetime_signal 131' QUIT
trap '_qcsd_latch_lifetime_signal 143' TERM

