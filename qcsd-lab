#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
COLLECTION_IMAGE="${QCSD_LAB_COLLECTION_IMAGE:-neqo-qcsd-lab-collection:local}"
PREPARE_IMAGE="${QCSD_LAB_PREPARE_IMAGE:-neqo-qcsd-lab-prepare:local}"
REFERENCE_IMAGE="${QCSD_LAB_REFERENCE_IMAGE:-neqo-qcsd-lab-reference:local}"
WSL_HOST_BUILD_MIN_AVAILABLE_BYTES=68719476736

usage() {
  echo "Usage: qcsd-lab {build|prepare|derive-chaff-prefix-specs|qualify-chaff|qualify-response-chaff|run|resume|verify|analyze|fit|buflo-study|class-study|test} [arguments...]" >&2
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

# Acquisition spans stability windows measured in days.  Keep its supervisor
# on the host so it can remain interruptible, resume only from checkpoint.json,
# and invoke the existing bounded Docker-backed coordinator actions when work
# is due.  The Python tool owns argument validation; this branch intentionally
# runs before all Docker and mutable study-state checks.
if [[ "${1:-}" == "class-study" && "${2:-}" == "acquisition-watch" ]]; then
  watch_python="python3"
  if [[ -x "${ROOT}/.venv/bin/python" ]]; then
    watch_python="${ROOT}/.venv/bin/python"
  fi
  command -v "${watch_python}" >/dev/null 2>&1 || {
    echo "class-study acquisition-watch requires python3 on the host" >&2
    exit 1
  }
  exec "${watch_python}" "${ROOT}/tools/class_acquisition_watch.py" "${@:3}"
fi

# Nested help is read-only and must not depend on Docker, a built image, or
# any mutable study state.  Forward only the two exact argparse help shapes;
# ordinary execution continues through every host-side validation below.
if [[ ( "${1:-}" == "class-study" || "${1:-}" == "buflo-study" ) &&
      ( ( $# == 2 && "${2:-}" == "--help" ) ||
        ( $# == 3 && "${3:-}" == "--help" ) ) ]]; then
  help_python="python3"
  if [[ -x "${ROOT}/.venv/bin/python" ]]; then
    help_python="${ROOT}/.venv/bin/python"
  fi
  command -v "${help_python}" >/dev/null 2>&1 || {
    echo "qcsd-lab nested help requires python3" >&2
    exit 1
  }
  if [[ $# == 2 && "${1}" == "class-study" && "${2}" == "--help" ]]; then
    PYTHONPATH="${ROOT}/src" "${help_python}" -c \
      'from qcsd_lab.cli import main; main()' "$@"
    echo
    echo "Host-only action:"
    echo "  acquisition-watch   supervise due acquisition work with bounded 1-5 s heartbeats"
    exit 0
  fi
  PYTHONPATH="${ROOT}/src" exec "${help_python}" -c \
    'from qcsd_lab.cli import main; main()' "$@"
fi

require_submodule() {
  if [[ ! -f "${ROOT}/neqo-qcsd/Cargo.lock" ]]; then
    echo "Missing Neqo submodule; run: git submodule update --init --recursive" >&2
    exit 1
  fi
}

require_docker() {
  command -v docker >/dev/null 2>&1 || {
    echo "qcsd-lab requires Docker on the host" >&2
    exit 1
  }
  if ! docker info >/dev/null 2>&1; then
    echo "Docker is installed but its daemon is unavailable" >&2
    exit 1
  fi
}

reject_evidence_build_image_overrides() {
  local variable
  for variable in QCSD_LAB_COLLECTION_IMAGE QCSD_LAB_PREPARE_IMAGE \
                  QCSD_LAB_REFERENCE_IMAGE; do
    if [[ -v "${variable}" ]]; then
      echo "qcsd-lab evidence build rejects image-role override ${variable}" >&2
      return 1
    fi
  done
}

acquire_evidence_build_lock() {
  command -v flock >/dev/null 2>&1 &&
    command -v sha256sum >/dev/null 2>&1 &&
    command -v stat >/dev/null 2>&1 || {
    echo "qcsd-lab evidence build requires flock, sha256sum, and stat on the host" >&2
    return 1
  }
  local current_uid lock_identity lock_root lock_state previous_umask
  current_uid="$(id -u)"
  if [[ ! "${current_uid}" =~ ^[0-9]+$ || -z "${build_docker_lock_identity}" ||
        -L /tmp || ! -d /tmp ]]; then
    echo "qcsd-lab evidence build cannot establish its shared host-lock root" >&2
    return 1
  fi
  lock_root="/tmp/qcsd-lab-evidence-build-${current_uid}"
  if ! mkdir -m 700 -- "${lock_root}" 2>/dev/null; then
    if [[ -L "${lock_root}" || ! -d "${lock_root}" ]]; then
      echo "qcsd-lab evidence build host-lock root is unsafe" >&2
      return 1
    fi
  fi
  lock_state="$(stat -c '%u:%a' -- "${lock_root}")"
  if [[ "${lock_state}" != "${current_uid}:700" ]]; then
    echo "qcsd-lab evidence build host-lock root has unsafe ownership or mode" >&2
    return 1
  fi
  lock_identity="$(
    printf '%s' "${build_docker_lock_identity}" | sha256sum | awk '{print $1}'
  )"
  if [[ ! "${lock_identity}" =~ ^[0-9a-f]{64}$ ]]; then
    echo "qcsd-lab evidence build cannot derive the Docker daemon lock identity" >&2
    return 1
  fi
  build_lock_path="${lock_root}/${lock_identity}.lock"
  if [[ -L "${build_lock_path}" ||
        ( -e "${build_lock_path}" && ! -f "${build_lock_path}" ) ]]; then
    echo "qcsd-lab evidence build lock must be a regular non-symlink file" >&2
    return 1
  fi
  previous_umask="$(umask)"
  umask 077
  exec {build_host_lock_fd}>>"${build_lock_path}"
  umask "${previous_umask}"
  lock_state="$(stat -c '%u:%a' -- "${build_lock_path}")"
  if [[ "${lock_state}" != "${current_uid}:600" ]]; then
    echo "qcsd-lab evidence build lock has unsafe ownership or mode" >&2
    return 1
  fi
  if ! flock -n "${build_host_lock_fd}"; then
    echo "another qcsd-lab evidence build holds this user/WSL instance's Docker-daemon lock" >&2
    return 1
  fi
}

read_built_image_id() {
  local target="$1"
  local iidfile="$2"
  local -a lines=()
  if [[ -L "${iidfile}" || ! -f "${iidfile}" ]]; then
    echo "qcsd-lab ${target} build did not create a regular IID file" >&2
    return 1
  fi
  mapfile -t lines <"${iidfile}"
  if (( ${#lines[@]} != 1 )) ||
     [[ ! "${lines[0]}" =~ ^sha256:[0-9a-f]{64}$ ]]; then
    echo "qcsd-lab ${target} build returned an invalid immutable image ID" >&2
    return 1
  fi
  printf '%s\n' "${lines[0]}"
}

verify_built_image_binding() {
  local target="$1"
  local tag="$2"
  local expected_id="$3"
  local observed_id
  observed_id="$(
    docker --context "${build_docker_context}" image inspect \
      --format '{{.Id}}' "${tag}"
  )"
  if [[ "${observed_id}" != "${expected_id}" ]]; then
    echo "qcsd-lab ${target} image tag no longer binds its build-produced ID" >&2
    return 1
  fi
}

reject_docker_endpoint_overrides() {
  local variable
  for variable in DOCKER_HOST DOCKER_CONTEXT DOCKER_CONFIG DOCKER_TLS_VERIFY \
                  DOCKER_CERT_PATH DOCKER_DEFAULT_PLATFORM BUILDX_BUILDER \
                  BUILDX_CONFIG BUILDKIT_HOST DOCKER_BUILDKIT; do
    if [[ -n "${!variable:-}" ]]; then
      echo "qcsd-lab evidence build rejects Docker endpoint/builder override ${variable}" >&2
      return 1
    fi
  done
}

validate_local_docker_build_endpoint() {
  local current_context current_endpoint current_server_name
  local current_server_operating_system current_server_os_type
  local current_server_architecture current_server_id current_identity
  local current_server_json
  local -a current_server_fields
  current_context="$(docker context show)"
  if [[ "${current_context}" != "default" &&
        "${current_context}" != "desktop-linux" ]]; then
    echo "qcsd-lab evidence build requires the default local Docker context" >&2
    return 1
  fi
  current_endpoint="$(
    docker context inspect --format '{{.Endpoints.docker.Host}}' \
      "${current_context}"
  )"
  if [[ "${current_endpoint}" != "unix:///var/run/docker.sock" &&
        "${current_endpoint}" != "npipe:////./pipe/dockerDesktopLinuxEngine" ]]; then
    echo "qcsd-lab evidence build requires a local Docker Desktop endpoint" >&2
    return 1
  fi
  current_server_json="$(
    docker --context "${current_context}" info --format '{{json .}}'
  )"
  if ! mapfile -t current_server_fields < <(
    printf '%s\n' "${current_server_json}" | python3 -I -c '
import json, sys
value = json.load(sys.stdin)
for key in ("Name", "OperatingSystem", "OSType", "Architecture", "ID"):
    item = value.get(key)
    if not isinstance(item, str) or not item:
        raise SystemExit(1)
    print(item)
'
  ) || (( ${#current_server_fields[@]} != 5 )); then
    echo "qcsd-lab evidence build received invalid local Docker server identity" >&2
    return 1
  fi
  current_server_name="${current_server_fields[0]}"
  current_server_operating_system="${current_server_fields[1]}"
  current_server_os_type="${current_server_fields[2]}"
  current_server_architecture="${current_server_fields[3]}"
  current_server_id="${current_server_fields[4]}"
  if [[ -z "${current_server_name}" ||
        -z "${current_server_operating_system}" ||
        "${current_server_os_type}" != "linux" ||
        -z "${current_server_architecture}" ||
        -z "${current_server_id}" ]]; then
    echo "qcsd-lab evidence build received invalid local Docker server identity" >&2
    return 1
  fi
  if (( build_host_storage_applicable )) &&
     [[ "${current_server_operating_system,,}" != *docker\ desktop* ]]; then
    echo "qcsd-lab WSL evidence build requires the local Docker Desktop Linux engine" >&2
    return 1
  fi
  current_identity="${current_context}"$'\t'"${current_endpoint}"$'\t'\
"${current_server_name}"$'\t'"${current_server_operating_system}"$'\t'\
"${current_server_os_type}"$'\t'"${current_server_architecture}"$'\t'\
"${current_server_id}"
  if [[ -n "${build_docker_identity}" &&
        "${current_identity}" != "${build_docker_identity}" ]]; then
    echo "qcsd-lab evidence build Docker daemon identity changed between build boundaries" >&2
    return 1
  fi
  build_docker_identity="${current_identity}"
  build_docker_context="${current_context}"
  build_docker_endpoint="${current_endpoint}"
  build_docker_server_name="${current_server_name}"
  build_docker_server_operating_system="${current_server_operating_system}"
  build_docker_server_os_type="${current_server_os_type}"
  build_docker_server_architecture="${current_server_architecture}"
  build_docker_server_id="${current_server_id}"
  build_docker_lock_identity="${current_server_id}"$'\t'\
"${current_server_os_type}"$'\t'"${current_server_architecture}"
}

wsl_host_build_storage_init() {
  build_host_storage_applicable=0
  build_host_storage_platform="other-host"
  build_host_storage_policy="docker-data-vhdx-backing-volume-minimum-v1"
  build_host_storage_required_bytes="${WSL_HOST_BUILD_MIN_AVAILABLE_BYTES}"
  build_host_storage_identity=""
  build_host_storage_observations=()
  build_docker_identity=""
  build_docker_lock_identity=""
  build_host_wsl_interop_env_present=0
  build_host_wsl_distro_name_env_present=0
  build_host_run_wsl_directory_present=0
  if ! build_host_kernel_release="$(uname -r)" ||
     [[ -z "${build_host_kernel_release}" ]]; then
    echo "qcsd-lab build cannot establish the host kernel release" >&2
    return 1
  fi
  if ! build_host_proc_version="$(< /proc/version)" ||
     [[ -z "${build_host_proc_version}" ]]; then
    echo "qcsd-lab build cannot establish the host kernel version evidence" >&2
    return 1
  fi
  if [[ -n "${WSL_INTEROP:-}" ]]; then
    build_host_wsl_interop_env_present=1
  fi
  if [[ -n "${WSL_DISTRO_NAME:-}" ]]; then
    build_host_wsl_distro_name_env_present=1
  fi
  if [[ -d /run/WSL ]]; then
    build_host_run_wsl_directory_present=1
  fi
  if [[ "${build_host_kernel_release,,}" == *microsoft* ||
        "${build_host_proc_version,,}" == *microsoft* ]] ||
     (( build_host_wsl_interop_env_present ||
        build_host_wsl_distro_name_env_present ||
        build_host_run_wsl_directory_present )); then
    build_host_storage_applicable=1
    build_host_storage_platform="windows-wsl2"
  fi
}

wsl_host_build_storage_probe() {
  local boundary="${1}"
  if (( ! build_host_storage_applicable )); then
    return 0
  fi
  command -v powershell.exe >/dev/null 2>&1 || {
    echo "qcsd-lab build cannot verify the Docker data VHDX backing volume: powershell.exe is unavailable" >&2
    return 1
  }
  command -v wslpath >/dev/null 2>&1 || {
    echo "qcsd-lab build cannot verify the Docker data VHDX backing volume: wslpath is unavailable" >&2
    return 1
  }

  local probe_script probe_script_windows raw validated
  local data_vhd_path backing_volume_unique_id available_bytes identity
  probe_script="${ROOT}/tools/windows_docker_storage_probe.ps1"
  if [[ -L "${probe_script}" || ! -f "${probe_script}" ]]; then
    echo "qcsd-lab build cannot verify the Docker data VHDX backing volume: the source-controlled probe is unavailable" >&2
    return 1
  fi
  if ! probe_script_windows="$(wslpath -w -- "${probe_script}")" ||
     [[ -z "${probe_script_windows}" ]]; then
    echo "qcsd-lab build cannot map the Docker data VHDX probe into Windows" >&2
    return 1
  fi
  if ! raw="$(
    powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass \
      -File "${probe_script_windows}" -Boundary "${boundary}"
  )"; then
    echo "qcsd-lab build cannot establish exactly one healthy Docker data VHDX backing volume at ${boundary}; WSL logical free space is not accepted" >&2
    return 1
  fi

  if ! validated="$(
    printf '%s\n' "${raw}" | python3 -I \
      "${ROOT}/src/qcsd_lab/build_storage.py" observation --boundary "${boundary}" \
      --probe-path "${probe_script}"
  )"; then
    return 1
  fi
  local -a build_host_storage_fields
  mapfile -t build_host_storage_fields <<< "${validated}"
  if (( ${#build_host_storage_fields[@]} != 5 )); then
    echo "qcsd-lab build host-storage probe returned malformed validated evidence" >&2
    return 1
  fi
  data_vhd_path="${build_host_storage_fields[1]}"
  backing_volume_unique_id="${build_host_storage_fields[2]}"
  available_bytes="${build_host_storage_fields[3]}"
  identity="${build_host_storage_fields[4]}"
  if [[ -n "${build_host_storage_identity}" &&
        "${identity}" != "${build_host_storage_identity}" ]]; then
    echo "qcsd-lab build Docker data VHDX backing-volume identity changed at ${boundary}; refusing an evidentiary receipt" >&2
    return 1
  fi
  build_host_storage_identity="${identity}"
  build_host_storage_observations+=("${build_host_storage_fields[0]}")
  echo "WSL Docker backing-storage check passed at ${boundary}: ${available_bytes} available bytes" >&2
}

# Parse a build request and enforce its create-only destination before any
# host-capacity or Docker probe.  A responsive daemon and large WSL ext4 free
# count do not prove that the Windows volume backing Docker's VHDX can safely
# export a new image.
if [[ "${1:-}" == "build" ]]; then
  build_cohort_version=1
  if (( $# == 3 )) && [[ "${2:-}" == "--cohort-version" ]]; then
    build_cohort_version="${3}"
  elif (( $# == 2 )) && [[ "${2:-}" == --cohort-version=* ]]; then
    build_cohort_version="${2#--cohort-version=}"
  elif (( $# != 1 )); then
    echo "build accepts only one optional --cohort-version N" >&2
    exit 2
  fi
  if [[ ! "${build_cohort_version}" =~ ^[1-9][0-9]*$ ]]; then
    echo "build cohort version must be a positive integer" >&2
    exit 2
  fi
  reject_evidence_build_image_overrides
  build_receipt="${ROOT}/artifacts/buflo-study/build-execution-v${build_cohort_version}.json"
  build_receipt_parent="$(dirname "${build_receipt}")"
  if [[ -L "${build_receipt_parent}" || -L "${build_receipt}" ]]; then
    echo "build receipt parent/destination cannot be a symlink" >&2
    exit 1
  fi
  mkdir -p "${build_receipt_parent}"
  build_receipt_parent="$(realpath "${build_receipt_parent}")"
  build_receipt="${build_receipt_parent}/$(basename "${build_receipt}")"
  if [[ -e "${build_receipt}" ]]; then
    echo "build requires an absent create-only receipt: ${build_receipt}" >&2
    exit 1
  fi
  require_submodule
  wsl_host_build_storage_init
  wsl_host_build_storage_probe "before-collection"
  reject_docker_endpoint_overrides
  require_docker
  validate_local_docker_build_endpoint
  acquire_evidence_build_lock
elif [[ "${1:-}" != "class-study" ]]; then
  require_docker
  require_submodule
fi

if [[ "${1:-}" == "build" ]]; then
  build_started_unix_ns="$(date +%s%N)"
  build_iid_dir="$(
    mktemp -d "${build_receipt_parent}/.build-iids-v${build_cohort_version}.XXXXXX"
  )"
  collection_iid_path="${build_iid_dir}/collection.iid"
  prepare_iid_path="${build_iid_dir}/prepare.iid"
  reference_iid_path="${build_iid_dir}/reference.iid"
  cleanup_build_iids() {
    rm -f -- "${collection_iid_path}" "${prepare_iid_path}" "${reference_iid_path}"
    rmdir -- "${build_iid_dir}" 2>/dev/null || true
  }
  trap cleanup_build_iids EXIT
  docker --context "${build_docker_context}" build --pull --no-cache \
    --iidfile "${collection_iid_path}" \
    --target collection \
    --tag "${COLLECTION_IMAGE}" --file "${ROOT}/Dockerfile" "${ROOT}"
  collection_id="$(read_built_image_id collection "${collection_iid_path}")"
  verify_built_image_binding collection "${COLLECTION_IMAGE}" "${collection_id}"
  wsl_host_build_storage_probe "before-prepare"
  validate_local_docker_build_endpoint
  docker --context "${build_docker_context}" build --pull --no-cache \
    --iidfile "${prepare_iid_path}" \
    --target prepare \
    --tag "${PREPARE_IMAGE}" --file "${ROOT}/Dockerfile" "${ROOT}"
  prepare_id="$(read_built_image_id prepare "${prepare_iid_path}")"
  verify_built_image_binding prepare "${PREPARE_IMAGE}" "${prepare_id}"
  wsl_host_build_storage_probe "before-reference"
  validate_local_docker_build_endpoint
  docker --context "${build_docker_context}" build --pull --no-cache \
    --iidfile "${reference_iid_path}" \
    --target reference \
    --tag "${REFERENCE_IMAGE}" --file "${ROOT}/Dockerfile" "${ROOT}"
  reference_id="$(read_built_image_id reference "${reference_iid_path}")"
  verify_built_image_binding reference "${REFERENCE_IMAGE}" "${reference_id}"
  wsl_host_build_storage_probe "after-reference"
  validate_local_docker_build_endpoint
  build_host_storage_observations_json="$(
    printf '%s\n' "${build_host_storage_observations[@]}" | python3 -I -c '
import json, sys
print(json.dumps([json.loads(line) for line in sys.stdin if line.strip()], separators=(",", ":")))
'
  )"
  verify_built_image_binding collection "${COLLECTION_IMAGE}" "${collection_id}"
  verify_built_image_binding prepare "${PREPARE_IMAGE}" "${prepare_id}"
  verify_built_image_binding reference "${REFERENCE_IMAGE}" "${reference_id}"
  collection_source="$(
    docker --context "${build_docker_context}" run --rm --entrypoint /bin/cat \
      "${collection_id}" /usr/share/qcsd-lab/source.json
  )"
  prepare_source="$(
    docker --context "${build_docker_context}" run --rm --entrypoint /bin/cat \
      "${prepare_id}" /usr/share/qcsd-lab/source.json
  )"
  reference_source="$(
    docker --context "${build_docker_context}" run --rm --entrypoint /bin/cat \
      "${reference_id}" /usr/share/qcsd-lab/source.json
  )"
  if [[ "${collection_source}" != "${prepare_source}" ||
        "${collection_source}" != "${reference_source}" ]]; then
    echo "qcsd-lab image roles were built from different source snapshots" >&2
    exit 1
  fi
  collection_build_inputs="$(
    docker --context "${build_docker_context}" run --rm --entrypoint /bin/cat \
      "${collection_id}" /usr/share/qcsd-lab/study-build-inputs.json
  )"
  prepare_build_inputs="$(
    docker --context "${build_docker_context}" run --rm --entrypoint /bin/cat \
      "${prepare_id}" /usr/share/qcsd-lab/study-build-inputs.json
  )"
  if [[ "${collection_build_inputs}" != "${prepare_build_inputs}" ]]; then
    echo "qcsd-lab image roles used different build inputs" >&2
    exit 1
  fi
  collection_repo_digests="$(docker --context "${build_docker_context}" image inspect --format '{{json .RepoDigests}}' "${collection_id}")"
  prepare_repo_digests="$(docker --context "${build_docker_context}" image inspect --format '{{json .RepoDigests}}' "${prepare_id}")"
  reference_repo_digests="$(docker --context "${build_docker_context}" image inspect --format '{{json .RepoDigests}}' "${reference_id}")"
  build_docker_version="$(docker --context "${build_docker_context}" version --format '{{json .}}')"
  validate_local_docker_build_endpoint
  build_finished_unix_ns="$(date +%s%N)"
  COLLECTION_ID="${collection_id}" \
  COLLECTION_REPO_DIGESTS="${collection_repo_digests}" \
  PREPARE_ID="${prepare_id}" \
  PREPARE_REPO_DIGESTS="${prepare_repo_digests}" \
  REFERENCE_ID="${reference_id}" \
  REFERENCE_REPO_DIGESTS="${reference_repo_digests}" \
  COLLECTION_SOURCE="${collection_source}" \
  PREPARE_SOURCE="${prepare_source}" \
  REFERENCE_SOURCE="${reference_source}" \
  COLLECTION_BUILD_INPUTS="${collection_build_inputs}" \
  PREPARE_BUILD_INPUTS="${prepare_build_inputs}" \
  BUILD_DOCKER_VERSION="${build_docker_version}" \
  BUILD_DOCKER_CONTEXT="${build_docker_context}" \
  BUILD_DOCKER_ENDPOINT="${build_docker_endpoint}" \
  BUILD_DOCKER_SERVER_NAME="${build_docker_server_name}" \
  BUILD_DOCKER_SERVER_OPERATING_SYSTEM="${build_docker_server_operating_system}" \
  BUILD_DOCKER_SERVER_OS_TYPE="${build_docker_server_os_type}" \
  BUILD_DOCKER_SERVER_ARCHITECTURE="${build_docker_server_architecture}" \
  BUILD_DOCKER_SERVER_ID="${build_docker_server_id}" \
  BUILD_STARTED_UNIX_NS="${build_started_unix_ns}" \
  BUILD_FINISHED_UNIX_NS="${build_finished_unix_ns}" \
  COLLECTION_IID_PATH="${collection_iid_path}" \
  PREPARE_IID_PATH="${prepare_iid_path}" \
  REFERENCE_IID_PATH="${reference_iid_path}" \
  BUILD_RECEIPT="${build_receipt}" \
  BUILD_COHORT_VERSION="${build_cohort_version}" \
  BUILD_ROOT="${ROOT}" \
  BUILD_HOST_STORAGE_APPLICABLE="${build_host_storage_applicable}" \
  BUILD_HOST_STORAGE_PLATFORM="${build_host_storage_platform}" \
  BUILD_HOST_STORAGE_POLICY="${build_host_storage_policy}" \
  BUILD_HOST_STORAGE_OBSERVATIONS="${build_host_storage_observations_json}" \
  BUILD_HOST_STORAGE_REQUIRED_BYTES="${build_host_storage_required_bytes}" \
  BUILD_HOST_KERNEL_RELEASE="${build_host_kernel_release}" \
  BUILD_HOST_PROC_VERSION="${build_host_proc_version}" \
  BUILD_HOST_WSL_INTEROP_ENV_PRESENT="${build_host_wsl_interop_env_present}" \
  BUILD_HOST_WSL_DISTRO_NAME_ENV_PRESENT="${build_host_wsl_distro_name_env_present}" \
  BUILD_HOST_RUN_WSL_DIRECTORY_PRESENT="${build_host_run_wsl_directory_present}" \
  COLLECTION_TAG="${COLLECTION_IMAGE}" \
  PREPARE_TAG="${PREPARE_IMAGE}" \
  REFERENCE_TAG="${REFERENCE_IMAGE}" \
  python3 -I - <<'PY'
import datetime
import hashlib
import importlib.util
import json
import os
from pathlib import Path

root = Path(os.environ["BUILD_ROOT"]).resolve()
destination = Path(os.environ["BUILD_RECEIPT"])
started_ns = int(os.environ["BUILD_STARTED_UNIX_NS"])
finished_ns = int(os.environ["BUILD_FINISHED_UNIX_NS"])
version = json.loads(os.environ["BUILD_DOCKER_VERSION"])
images = {
    "collection": {
        "tag": os.environ["COLLECTION_TAG"],
        "id": os.environ["COLLECTION_ID"],
        "repo_digests": json.loads(os.environ["COLLECTION_REPO_DIGESTS"]),
    },
    "prepare": {
        "tag": os.environ["PREPARE_TAG"],
