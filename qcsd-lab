  capture_index=0
  while (( capture_index < ${#capture_arguments[@]} )); do
    if [[ "${capture_arguments[capture_index]}" == "--stage" ]]; then
      capture_index=$((capture_index + 1))
      if (( capture_index >= ${#capture_arguments[@]} )); then
        echo "--stage requires a value" >&2
        exit 2
      fi
      controlled_stage="${capture_arguments[capture_index]}"
    fi
    capture_index=$((capture_index + 1))
  done
  if [[ "${controlled_stage}" == "controlled" ||
        "${controlled_stage}" == "regression" ]]; then
  controlled_destination_name="buflo-study-controlled-v${study_cohort_version}"
  controlled_expect=""
  for argument in "${@:3}"; do
    if [[ -n "${controlled_expect}" ]]; then
      if [[ "${controlled_expect}" == "stage" ]]; then
        controlled_stage="${argument}"
      elif [[ "${controlled_expect}" == "destination" ]]; then
        if [[ "${argument}" =~ ^results/([A-Za-z0-9][A-Za-z0-9._-]*)$ ]]; then
          controlled_destination_name="${BASH_REMATCH[1]}"
        elif [[ "${argument}" =~ ^${ROOT}/results/([A-Za-z0-9][A-Za-z0-9._-]*)$ ]]; then
          controlled_destination_name="${BASH_REMATCH[1]}"
        else
          echo "controlled destination must be one safe direct child of results/" >&2
          exit 2
        fi
      elif [[ "${argument}" != "${study_cohort_version}" ]]; then
        echo "local capture cohort version differs from the selected build" >&2
        exit 2
      fi
      controlled_expect=""
      continue
    fi
    case "${argument}" in
      --stage) controlled_expect="stage" ;;
      --destination) controlled_expect="destination" ;;
      --cohort-version) controlled_expect="cohort-version" ;;
      --cohort-version=*)
        if [[ "${argument#--cohort-version=}" != "${study_cohort_version}" ]]; then
          echo "local capture cohort version differs from the selected build" >&2
          exit 2
        fi
        ;;
      *)
        echo "local buflo-study capture accepts only --stage, --destination, and --cohort-version" >&2
        exit 2
        ;;
    esac
  done
  if [[ -n "${controlled_expect}" ]]; then
    echo "local buflo-study capture option requires a value" >&2
    exit 2
  fi
    command -v base64 >/dev/null 2>&1 || {
      echo "controlled capture requires base64 on the host" >&2
      exit 1
    }
    if [[ "${controlled_stage}" == "regression" &&
          "${controlled_destination_name}" == "buflo-study-controlled-v${study_cohort_version}" ]]; then
      controlled_destination_name="buflo-study-regression-v${study_cohort_version}"
    fi
    controlled_destination="${ROOT}/results/${controlled_destination_name}"
    if [[ -L "${ROOT}/results" || -L "${controlled_destination}" ]]; then
      echo "controlled result roots cannot be symbolic links" >&2
      exit 1
    fi
    mkdir -p "${controlled_destination}"
    controlled_network="qcsd-buflo-study-v${study_cohort_version}"
    if docker network inspect "${controlled_network}" >/dev/null 2>&1; then
      echo "controlled Docker network already exists; remove stale ${controlled_network}" >&2
      exit 1
    fi
    first_server="qcsd-buflo-server-one"
    second_server="qcsd-buflo-server-two"
    if docker container inspect "${first_server}" >/dev/null 2>&1 ||
       docker container inspect "${second_server}" >/dev/null 2>&1; then
      echo "controlled server container name already exists; remove stale sidecars" >&2
      exit 1
    fi
    docker network create --driver bridge "${controlled_network}" >/dev/null
    sidecars+=("${first_server}" "${second_server}")
    cleanup_buflo_controlled() {
      cleanup_sidecars
      docker network rm "${controlled_network}" >/dev/null 2>&1 || true
    }
    trap cleanup_buflo_controlled EXIT INT TERM
    start_buflo_controlled_server \
      "${first_server}" qcsd-buflo-server-one 4433 "${controlled_network}" >/dev/null
    start_buflo_controlled_server \
      "${second_server}" qcsd-buflo-server-two 4434 "${controlled_network}" >/dev/null
    sleep 1
    profiles=(clean)
    if [[ "${controlled_stage}" == "controlled" ]]; then
      profiles+=(
        symmetric-50ms-rtt
        symmetric-5mbit-50ms-rtt-100-packet-queue
        symmetric-1pct-loss-50ms-rtt
