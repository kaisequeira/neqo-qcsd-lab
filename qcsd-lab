    QCSD_DOCKER_OUTPUT_BROWSER_EGRESS_NEXT=""
    if ! qcsd_capture_attached_docker_output QCSD_DOCKER_OUTPUT_BROWSER_EGRESS_NEXT \
      "${browser_egress_coordinator_prefix[@]}" \
