    --filter label=org.qcsd.qualification=browser-egress-qualification-v1)" || return 1
  if [[ -n "${container_id_output}" || -n "${network_id_output}" ||
        -n "${volume_name_output}" ]]; then
    echo "browser-egress could not prove exact stale topology retirement" >&2
    return 1
  fi
}

browser_egress_preserve_capture_closure() {
  local source="${browser_egress_attempt_scratch}/capture-closure.json"
  local destination="${browser_egress_attempt_evidence_host}/capture-closure.json"
  if [[ ! -e "${source}" && ! -L "${source}" ]]; then
    return 0
  fi
  if [[ -L "${source}" || ! -f "${source}" ||
        -L "${browser_egress_evidence_host}" ||
        ! -f "${browser_egress_evidence_host}" ]]; then
    echo "browser-egress closed-capture failure evidence is incomplete" >&2
    return 1
  fi
  python3 -I -c '
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import sys

source = Path(sys.argv[1])
destination = Path(sys.argv[2])
pcap = Path(sys.argv[3])
expected_relative = sys.argv[4]
expected_vector = sys.argv[5]
expected_uid = int(sys.argv[6])
expected_gid = int(sys.argv[7])

def read_sole_file(path, *, label, maximum):
    before = path.lstat()
    descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        opened = os.fstat(descriptor)
        if (
            not stat.S_ISREG(opened.st_mode)
            or (opened.st_dev, opened.st_ino) != (before.st_dev, before.st_ino)
            or opened.st_uid != expected_uid
            or opened.st_gid != expected_gid
            or stat.S_IMODE(opened.st_mode) != 0o600
            or opened.st_nlink != 1
            or opened.st_size <= 0
            or opened.st_size > maximum
        ):
            raise SystemExit(f"browser-egress {label} inode is unsafe")
        raw = b""
        while chunk := os.read(descriptor, 1024 * 1024):
            raw += chunk
    finally:
        os.close(descriptor)
    return raw

raw = read_sole_file(source, label="capture closure", maximum=2 * 1024 * 1024)
try:
    role = json.loads(raw)
except (UnicodeDecodeError, json.JSONDecodeError) as error:
    raise SystemExit("browser-egress capture closure is invalid JSON") from error
canonical = (json.dumps(role, indent=2, sort_keys=True, allow_nan=False) + "\n").encode()
closure = role.get("capture_closure") if isinstance(role, dict) else None
capture = closure.get("pcap") if isinstance(closure, dict) else None
if (
    raw != canonical
    or not isinstance(role, dict)
    or set(role) != {"schema_version", "role", "vector_id", "capture_closure"}
    or role.get("schema_version") != 1
    or role.get("role") != "observer"
    or role.get("vector_id") != expected_vector
    or closure.get("schema_version") != 1
    or closure.get("artifact_type") != "qcsd-browser-egress-capture-closure"
    or closure.get("vector_id") != expected_vector
    or not isinstance(capture, dict)
    or set(capture) != {"path", "sha256", "size_bytes"}
    or capture.get("path") != expected_relative
    or not isinstance(capture.get("sha256"), str)
    or re.fullmatch(r"[0-9a-f]{64}", capture["sha256"]) is None
    or type(capture.get("size_bytes")) is not int
    or capture["size_bytes"] <= 0
):
    raise SystemExit("browser-egress capture closure binding is invalid")
pcap_before = pcap.lstat()
pcap_descriptor = os.open(pcap, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
try:
    pcap_opened = os.fstat(pcap_descriptor)
    if (
        not stat.S_ISREG(pcap_opened.st_mode)
        or (pcap_opened.st_dev, pcap_opened.st_ino)
        != (pcap_before.st_dev, pcap_before.st_ino)
        or pcap_opened.st_uid != expected_uid
        or pcap_opened.st_gid != expected_gid
        or stat.S_IMODE(pcap_opened.st_mode) != 0o600
        or pcap_opened.st_nlink != 1
        or pcap_opened.st_size != capture["size_bytes"]
    ):
        raise SystemExit("browser-egress closed-capture inode is unsafe")
    pcap_digest = hashlib.sha256()
    while chunk := os.read(pcap_descriptor, 1024 * 1024):
        pcap_digest.update(chunk)
finally:
    os.close(pcap_descriptor)
if pcap_digest.hexdigest() != capture["sha256"]:
    raise SystemExit("browser-egress closed capture differs from its closure")
parent_descriptor = os.open(
    destination.parent,
    os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_DIRECTORY,
)
output_descriptor = -1
created = False
keep = False
try:
    parent = os.fstat(parent_descriptor)
    if (
        not stat.S_ISDIR(parent.st_mode)
        or parent.st_uid != expected_uid
        or parent.st_gid != expected_gid
        or stat.S_IMODE(parent.st_mode) != 0o700
    ):
        raise SystemExit("browser-egress capture-closure evidence parent is unsafe")
    try:
        output_descriptor = os.open(
            destination.name,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
            0o600,
            dir_fd=parent_descriptor,
        )
        created = True
    except FileExistsError:
        existing = read_sole_file(
            destination,
            label="capture-closure evidence",
            maximum=2 * 1024 * 1024,
        )
        if existing != raw:
            raise SystemExit("browser-egress capture-closure evidence conflicts")
        keep = True
    if created:
        view = memoryview(raw)
        while view:
            written = os.write(output_descriptor, view)
            if written <= 0:
                raise OSError("browser-egress capture-closure evidence write made no progress")
            view = view[written:]
        os.fchmod(output_descriptor, 0o600)
        metadata = os.fstat(output_descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != expected_uid
            or metadata.st_gid != expected_gid
            or stat.S_IMODE(metadata.st_mode) != 0o600
            or metadata.st_nlink != 1
            or metadata.st_size != len(raw)
        ):
            raise SystemExit("browser-egress capture-closure evidence inode is unsafe")
        os.fsync(output_descriptor)
        os.fsync(parent_descriptor)
        keep = True
finally:
    if output_descriptor >= 0:
        os.close(output_descriptor)
    if created and not keep:
        try:
            os.unlink(destination.name, dir_fd=parent_descriptor)
            os.fsync(parent_descriptor)
        except FileNotFoundError:
            pass
    os.close(parent_descriptor)
' "${source}" "${destination}" "${browser_egress_evidence_host}" \
    "${browser_egress_evidence_relative}" "${browser_egress_vector_id}" \
    "${qcsd_invoking_uid}" "${qcsd_invoking_gid}"
}

