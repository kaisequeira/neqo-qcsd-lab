  _qcsd_verify_git_checkout_binding "${ROOT}" "${ROOT}/.git" &&
    _qcsd_verify_git_checkout_binding "${ROOT}/neqo-qcsd" \
      "${ROOT}/.git/modules/third_party/neqo-qcsd" &&
    _qcsd_verify_git_index_bytes "${ROOT}/neqo-qcsd" || {
    echo "fit refuses redirected Git worktree or gitdir state" >&2
    exit 1
  }
  command -v python3 >/dev/null 2>&1 || {
    echo "fit requires python3 on the host for Neqo source verification" >&2
    exit 1
  }
  local empty_sha QCSD_DOCKER_OUTPUT_METADATA=""
  local image_neqo image_pin image_neqo_dirty image_neqo_patch
  local neqo_head head_gitlink index_gitlink
  local -a image_neqo_source=()
  empty_sha="e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
  qcsd_capture_attached_docker_output QCSD_DOCKER_OUTPUT_METADATA docker run \
    --entrypoint /bin/cat "${image_id}" /usr/share/qcsd-lab/source.json
  mapfile -t image_neqo_source < <(
    python3 -I -c 'import json,sys; v=json.load(sys.stdin); print(v["neqo_commit"]); print(v["neqo_pinned_commit"]); print(str(v["neqo_dirty"]).lower()); print(v["neqo_patch_sha256"])' <<<"${QCSD_DOCKER_OUTPUT_METADATA}"
  )
  image_neqo="${image_neqo_source[0]:-}"
  image_pin="${image_neqo_source[1]:-}"
  image_neqo_dirty="${image_neqo_source[2]:-}"
  image_neqo_patch="${image_neqo_source[3]:-}"
  neqo_head="$(_qcsd_trusted_git -C "${ROOT}/neqo-qcsd" rev-parse HEAD)"
  head_gitlink="$(_qcsd_trusted_git -C "${ROOT}" rev-parse HEAD:neqo-qcsd)"
  index_gitlink="$(_qcsd_trusted_git -C "${ROOT}" ls-files --stage -- neqo-qcsd | awk '$1 == 160000 {print $2}')"
  if [[ "${#image_neqo_source[@]}" -ne 4 ]] ||
     [[ ! "${image_neqo}" =~ ^[0-9a-f]{40}$ ]] ||
     [[ "${image_neqo}" != "${image_pin}" ]] ||
     [[ "${image_neqo_dirty}" != "false" ]] ||
     [[ "${image_neqo_patch}" != "${empty_sha}" ]] ||
     [[ "${neqo_head}" != "${image_neqo}" ]] ||
     [[ "${head_gitlink}" != "${image_neqo}" ]] ||
     [[ "${index_gitlink}" != "${image_neqo}" ]] ||
     [[ -n "$(_qcsd_trusted_git -C "${ROOT}/neqo-qcsd" status --porcelain --untracked-files=all)" ]]; then
    echo "fit requires the exact clean Neqo commit and parent gitlink embedded in the image" >&2
    exit 1
  fi
}

