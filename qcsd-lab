  IFS= read -r observed <&"${go_fd}" || return 1
  [[ "${observed}" == "${go_nonce}" ]] || return 1
  if IFS= read -r extra <&"${go_fd}"; then return 1; fi
  eval "exec ${go_fd}<&-" || return 1
