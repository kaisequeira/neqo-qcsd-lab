    [[ "${key}" != QCSD_DOCKER_LOCK_GUARDIAN_* ]] || unset "${key}"
  done < <(env)
  [[ "${go_fd}" =~ ^[0-9]+$ && "${go_nonce}" =~ ^[0-9a-f]{64}$ &&
      "${_QCSD_LIFECYCLE_RECOVERY_READY_FD}" =~ ^[0-9]+$ &&
