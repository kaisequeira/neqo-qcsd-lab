      echo "public kernel-TX router disappeared before teardown" >&2
      cleanup_status=1
    else
      router_running="$(_qcsd_docker_api container inspect \
        --format '{{.State.Running}}' \
        "${kernel_tx_public_router_id}" 2>/dev/null || true)"
      if [[ "${router_running}" != "true" ]]; then
        echo "public kernel-TX router was not running at teardown" >&2
        cleanup_status=1
      elif ! _qcsd_docker_api exec "${kernel_tx_public_router_id}" \
        /usr/bin/python3 -c '
from pathlib import Path
import sys

active = []
for comm in Path("/proc").glob("[0-9]*/comm"):
    try:
        if comm.read_text(encoding="ascii").strip() == "dumpcap":
            active.append(comm.parent.name)
    except OSError:
        pass
if active:
    raise SystemExit("active dumpcap children at public router teardown: " + ",".join(active))
      '; then
        echo "public kernel-TX router did not reach the idle end state" >&2
        cleanup_status=1
      fi
      if ! _qcsd_docker_api rm --force \
          "${kernel_tx_public_router_id}" >/dev/null; then
        echo "cannot remove public kernel-TX router ${kernel_tx_public_router_id}" >&2
        cleanup_status=1
      fi
    fi
    router_state="$(_qcsd_docker_exact_id_presence \
      "${kernel_tx_public_router_id}")"
    if [[ "${router_state}" == "absent" ]] &&
       ! qcsd_retire_docker_handoff run \
         "${kernel_tx_public_router_id}" QCSD_DOCKER_IDS_PUBLIC_ROUTERS; then
      echo "public kernel-TX router handoff retirement failed" >&2
      cleanup_status=1
    fi
  fi
  if (( ${#QCSD_DOCKER_IDS_PUBLIC_NETWORKS[@]} > 0 )); then
    kernel_tx_public_network_id="${QCSD_DOCKER_IDS_PUBLIC_NETWORKS[-1]}"
    public_network_state="$(_qcsd_docker_exact_network_presence \
      "${kernel_tx_public_network_id}")"
    if [[ "${public_network_state}" != "present" ]]; then
      echo "public kernel-TX client network disappeared before teardown (${public_network_state})" >&2
      cleanup_status=1
    else
      _qcsd_docker_api network rm \
        "${kernel_tx_public_network_id}" >/dev/null 2>&1 || true
      public_network_state="$(_qcsd_docker_exact_network_presence \
        "${kernel_tx_public_network_id}")"
    fi
    if [[ "${public_network_state}" == "present" ||
          "${public_network_state}" == "unknown" ]]; then
      echo "public kernel-TX client network teardown state is ${public_network_state}" >&2
      cleanup_status=1
    elif ! qcsd_retire_docker_handoff network \
        "${kernel_tx_public_network_id}" QCSD_DOCKER_IDS_PUBLIC_NETWORKS; then
      echo "public kernel-TX network handoff retirement failed" >&2
      cleanup_status=1
    fi
  fi
  if [[ -n "${kernel_tx_public_router_id:-}" ]]; then
    router_state="$(_qcsd_docker_exact_id_presence \
      "${kernel_tx_public_router_id}")"
    if [[ "${router_state}" != "absent" ]]; then
      echo "public kernel-TX router teardown state is ${router_state}" >&2
      cleanup_status=1
    fi
  fi
  if [[ "${kernel_tx_public_topology_started:-0}" == "1" &&
        ! -d "${kernel_tx_public_capture_root}" ]]; then
    echo "public kernel-TX capture root disappeared before teardown" >&2
    cleanup_status=1
  elif [[ -n "${kernel_tx_public_capture_root:-}" &&
          -d "${kernel_tx_public_capture_root}" ]]; then
    if find "${kernel_tx_public_capture_root}" -mindepth 1 -print -quit | grep -q .; then
      echo "public kernel-TX capture service left evidence at ${kernel_tx_public_capture_root}; preserving it and failing closed" >&2
      cleanup_status=1
    elif ! rmdir "${kernel_tx_public_capture_root}"; then
      echo "cannot remove empty public kernel-TX capture root" >&2
      cleanup_status=1
    fi
  fi
  (( cleanup_status == 0 )) || cleanup_failure_status=1
  _qcsd_finish_latched_cleanup
}

