    raise SystemExit("browser-egress vector managed policy is invalid")
print(policy["NetworkPredictionOptions"])
print(launch.get("launch_profile"))
' "${browser_egress_scratch}/next.json")
    if (( ${#browser_egress_vector_fields[@]} == 1 )) &&
       [[ "${browser_egress_vector_fields[0]}" == "complete" ]]; then
      break
