configure_buflo_qdisc() {
  local container_name="$1"
  local profile="$2"
  case "${profile}" in
    clean)
      docker exec "${container_name}" /bin/sh -eu -c \
        'tc qdisc del dev eth0 root 2>/dev/null || true'
      ;;
    symmetric-50ms-rtt)
      docker exec "${container_name}" \
        tc qdisc replace dev eth0 root netem delay 25ms
      ;;
    symmetric-5mbit-50ms-rtt-100-packet-queue)
      docker exec "${container_name}" \
        tc qdisc replace dev eth0 root netem delay 25ms rate 5mbit limit 100
      ;;
    symmetric-1pct-loss-50ms-rtt)
      docker exec "${container_name}" \
        tc qdisc replace dev eth0 root netem delay 25ms loss 1%
      ;;
    *)
      echo "unsupported controlled netem profile: ${profile}" >&2
      return 2
      ;;
  esac
}

buflo_qdisc_base64() {
  docker exec "$1" tc -details -j qdisc show dev eth0 | base64 -w0
}

