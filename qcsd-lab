_qcsd_invoke_cohort_allocator() {
  local action="${1:-}" input="${2:-}" output_name="${3:-}"
  local output_fd allocator_pid allocator_output='' extra_output=''
  local read_failed=0 wait_status=0 close_status=0
  [[ "${action}" =~ ^(publish|verify|chain)$ &&
      "${output_name}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ &&
      -n "${input}" && "${input}" != *$'\n'* &&
      "${_QCSD_LIFECYCLE_COHORT_LOCK_REQUIRED:-}" == 1 ]] || return 1
  exec {output_fd}< <(
    exec /usr/bin/python3 -I "${ROOT}/src/qcsd_lab/cohort_allocation.py" \
      "${action}" --root "${ROOT}" \
      --held-lock-owner-pid "${_QCSD_LIFECYCLE_QCSD_PID}" \
      --held-lock-owner-start "${_QCSD_LIFECYCLE_QCSD_START}" \
      --held-lock-guardian-pid "${_QCSD_LIFECYCLE_GUARD_PID}" \
      --held-lock-guardian-start "${_QCSD_LIFECYCLE_GUARD_START}" \
      --held-lock-guardian-fd "${_QCSD_LIFECYCLE_COHORT_LOCK_FD}" \
      --held-lock-path "${_QCSD_LIFECYCLE_COHORT_LOCK_PATH}" \
      --held-lock-device "${_QCSD_LIFECYCLE_COHORT_LOCK_DEVICE}" \
      --held-lock-inode "${_QCSD_LIFECYCLE_COHORT_LOCK_INODE}" \
      --held-lock-parent-device \
        "${_QCSD_LIFECYCLE_COHORT_LOCK_PARENT_DEVICE}" \
      --held-lock-parent-inode \
        "${_QCSD_LIFECYCLE_COHORT_LOCK_PARENT_INODE}" \
      --held-lock-cohort-version "${_QCSD_LIFECYCLE_COHORT_VERSION}" \
      <<<"${input}"
  ) || return 1
  allocator_pid=$!
  if ! IFS= read -r allocator_output <&"${output_fd}"; then
    read_failed=1
  fi
  if IFS= read -r extra_output <&"${output_fd}" || [[ -n "${extra_output}" ]]; then
    read_failed=1
  fi
  wait "${allocator_pid}" || wait_status=$?
  eval "exec ${output_fd}<&-" || close_status=$?
  (( read_failed == 0 && wait_status == 0 && close_status == 0 )) || return 1
  [[ -n "${allocator_output}" && "${allocator_output}" != *$'\n'* ]] || return 1
  printf -v "${output_name}" '%s' "${allocator_output}"
}

_qcsd_open_cohort_chain_channel() {
  local input="${1:-}" descriptor_name="${2:-}" producer_name="${3:-}"
  local channel_fd producer_pid
  [[ -n "${input}" && "${input}" != *$'\n'* &&
      "${descriptor_name}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ &&
      "${producer_name}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || return 1
  exec {channel_fd}< <(
    # Bash's builtin keeps the large chain out of every external exec argv.
    printf '%s\n' "${input}"
  ) || return 1
  producer_pid=$!
  if [[ ! "${channel_fd}" =~ ^[0-9]+$ ||
        ! "${producer_pid}" =~ ^[1-9][0-9]*$ ]]; then
    if [[ "${channel_fd}" =~ ^[0-9]+$ ]]; then
      eval "exec ${channel_fd}<&-" || true
    fi
    if [[ "${producer_pid}" =~ ^[1-9][0-9]*$ ]]; then
      wait "${producer_pid}" 2>/dev/null || true
    fi
    return 1
  fi
  printf -v "${descriptor_name}" '%s' "${channel_fd}"
  printf -v "${producer_name}" '%s' "${producer_pid}"
}

_qcsd_verify_saved_build_cohort_claim() {
  local boundary="${1:-}" claim_recheck chain_recheck
  [[ -n "${boundary}" && -n "${build_cohort_claim_snapshot:-}" &&
      -n "${build_cohort_claim_chain:-}" ]] || return 1
  if ! _qcsd_invoke_cohort_allocator verify \
      "${build_cohort_claim_snapshot}" claim_recheck ||
     [[ "${claim_recheck}" != "${build_cohort_claim_snapshot}" ]]; then
    echo "build durable cohort claim changed at ${boundary}" >&2
    return 1
  fi
  if ! _qcsd_invoke_cohort_allocator chain \
      "${build_cohort_claim_snapshot}" chain_recheck ||
     [[ "${chain_recheck}" != "${build_cohort_claim_chain}" ]]; then
    echo "build durable cohort claim chain changed at ${boundary}" >&2
    return 1
  fi
}

_qcsd_verify_saved_build_cohort_authority() {
  local boundary="${1:-}" recheck
  if [[ -z "${boundary}" ]] ||
     ! _qcsd_verify_clean_build_checkout \
       "${build_cohort_lab_head:-}" "${build_cohort_neqo_head:-}" \
       "${build_cohort_gitlink:-}" ||
     ! recheck="$(_qcsd_validate_consumed_cohort_ledger \
         "${build_cohort_version:-}")" ||
     [[ "${recheck}" != "${build_cohort_ledger_snapshot:-}" ]]; then
    echo "build consumed-cohort/source authority changed at ${boundary}" >&2
    return 1
  fi
  _qcsd_verify_saved_build_cohort_claim "${boundary}"
}

_qcsd_reprove_build_cohort_authority() {
  local boundary="$1" recheck observation
  if ! _qcsd_verify_clean_build_checkout \
      "${build_cohort_lab_head:-}" "${build_cohort_neqo_head:-}" \
      "${build_cohort_gitlink:-}" ||
     ! recheck="$(_qcsd_validate_consumed_cohort_ledger \
         "${build_cohort_version:-}")" ||
     [[ "${recheck}" != "${build_cohort_ledger_snapshot:-}" ]]; then
    echo "build consumed-cohort/source authority changed at ${boundary}" >&2
    return 1
