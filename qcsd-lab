    QCSD_DOCKER_OUTPUT_BROWSER_EGRESS_BEGIN=""
    qcsd_capture_attached_docker_output QCSD_DOCKER_OUTPUT_BROWSER_EGRESS_BEGIN \
      "${browser_egress_coordinator_prefix[@]}" \
      "${browser_egress_begin_mounts[@]}" \
      "${browser_egress_coordinator_suffix[@]}" \
      begin-attempt --result-root "${browser_egress_result_container}" \
