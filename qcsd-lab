    '{{(index .IPAM.Config 0).Subnet}}' "${kernel_tx_public_network_id}")"
  kernel_tx_public_client_subnet="$(python3 -I -c '
import ipaddress
import sys
network = ipaddress.ip_network(sys.argv[1], strict=True)
if network.version != 4:
    raise SystemExit("public kernel-TX client network is not IPv4")
print(network)
' "${kernel_tx_public_client_subnet}")"
  start_kernel_tx_public_router \
    "${kernel_tx_public_router_name}" \
    "${kernel_tx_public_network_id}" \
    "${kernel_tx_public_client_subnet}" \
    "${kernel_tx_public_capture_root}" \
    "${kernel_tx_public_capture_secret}" >/dev/null
  kernel_tx_public_topology_started=1
  kernel_tx_public_router_ip="$(_qcsd_docker_api container inspect --format \
    "{{with index .NetworkSettings.Networks \"${kernel_tx_public_client_network}\"}}{{.IPAddress}}{{end}}" \
    "${kernel_tx_public_router_id}")"
  if [[ -z "${kernel_tx_public_router_ip}" ]]; then
    echo "public kernel-TX router did not receive a client-side IPv4 address" >&2
    exit 1
  fi
  _qcsd_docker_api exec "${kernel_tx_public_router_id}" /bin/sh -eu -c '
ip -4 -o address show dev eth0 | grep -F " $1/" >/dev/null
test "$(cat /proc/sys/net/ipv4/ip_forward)" = 1
iptables -t nat -C POSTROUTING -s "$2" -o eth1 -j MASQUERADE
' sh "${kernel_tx_public_router_ip}" "${kernel_tx_public_client_subnet}"
  kernel_tx_public_network_b64="$(kernel_tx_public_network_receipt_base64 \
    "${kernel_tx_public_client_network}" \
    "${kernel_tx_public_client_subnet}" \
    "${kernel_tx_public_router_name}" \
    "${kernel_tx_public_router_ip}")"
  kernel_tx_public_binding_b64="$(kernel_tx_public_observer_binding_base64 \
    "${kernel_tx_public_client_network}" \
    "${kernel_tx_public_network_id}" \
    "${kernel_tx_public_router_name}" \
    "${kernel_tx_public_router_id}" \
    "${kernel_tx_public_router_ip}")"
  scheduler_host_partition_b64="$(capture_scheduler_host_partition_b64 \
    "${kernel_tx_public_router_name}" "${kernel_tx_public_router_id}")"
  replace_container_option_value --network "${kernel_tx_public_network_id}"
  replace_container_environment \
    QCSD_CAPTURE_SCHEDULER_HOST_PARTITION_B64 \
    "${scheduler_host_partition_b64}"
  container+=(
    --env "QCSD_CONTROLLED_ROUTER_CLIENT_IP=${kernel_tx_public_router_ip}"
    --env "QCSD_KERNEL_TX_PUBLIC_ROUTER_IP=${kernel_tx_public_router_ip}"
    --env "QCSD_KERNEL_TX_PUBLIC_CLIENT_SUBNET=${kernel_tx_public_client_subnet}"
    --env "QCSD_KERNEL_TX_POST_VETH_CAPTURE_ENDPOINT=${kernel_tx_public_router_ip}:19090"
    --env "QCSD_KERNEL_TX_POST_VETH_CAPTURE_SECRET=${kernel_tx_public_capture_secret}"
    --env "QCSD_KERNEL_TX_POST_VETH_CAPTURE_ROOT=/kernel-tx"
    --env "QCSD_KERNEL_TX_CONTROLLED_NETWORK_RECEIPT_B64=${kernel_tx_public_network_b64}"
    --env "QCSD_KERNEL_TX_CONTROLLED_OBSERVER_BINDING_B64=${kernel_tx_public_binding_b64}"
    --volume "${kernel_tx_public_capture_root}:/kernel-tx:ro"
  )
  set +e
  if [[ "${1:-}" == "class-study" ]]; then
    qcsd_run_attached_docker "${container[@]}" "${image_id}" \
      "${class_image_command[@]}" "${class_container_args[@]}"
  else
    qcsd_run_attached_docker "${container[@]}" "${image_id}" "$@"
  fi
  kernel_tx_public_status=$?
  set -e
  exit "${kernel_tx_public_status}"
fi

if [[ "${1:-}" == "test" && "${2:-}" == "pinned-cdp" ]]; then
  set +e
  qcsd_run_attached_docker "${container[@]}" \
    --env "QCSD_PINNED_CDP_EXPECTED_UID=${qcsd_invoking_uid}" \
    --env "QCSD_PINNED_CDP_EXPECTED_GID=${qcsd_invoking_gid}" \
    --entrypoint /usr/bin/tini \
    "${image_id}" -- /usr/bin/timeout --signal=TERM --kill-after=10s 120s \
    /opt/qcsd-venv/bin/python3 -m qcsd_lab.pinned_cdp \
    --cohort-version "${pinned_cdp_cohort_version}" \
    --build-execution-receipt "${pinned_cdp_build_container}" \
    --destination "${pinned_cdp_destination_container}"
  status=$?
  set -e
  exit "${status}"
fi

if [[ "${1:-}" == "test" && "${2:-}" == "live" ]]; then
  if (( $# != 2 )); then
    echo "test live accepts no additional arguments" >&2
    exit 2
  fi
  cleanup_live_sidecars() {
    local cleanup_entry_status="$1"
    local cleanup_signal_status=0 cleanup_complete=0 cleanup_failure_status=0
    _qcsd_begin_latched_cleanup
    local cleanup_status=0
    if ! cleanup_sidecars; then
      cleanup_status=1
    fi
    (( cleanup_status == 0 )) || cleanup_failure_status=1
    _qcsd_finish_latched_cleanup
  }
  trap 'cleanup_live_sidecars "$?"' EXIT
  first_server="qcsd-direct-server-$$"
  second_server="qcsd-direct-server-two-$$"
  start_capture_acceptance_server \
    "${first_server}" 4433 direct_first_server_id >/dev/null
  start_capture_acceptance_server \
    "${second_server}" 4434 direct_second_server_id >/dev/null
  first_address="$(_qcsd_docker_api container inspect \
    --format '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' \
    "${direct_first_server_id}")"
  second_address="$(_qcsd_docker_api container inspect \
    --format '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' \
    "${direct_second_server_id}")"
  test -n "${first_address}" && test -n "${second_address}"
  sleep 1
  set +e
  qcsd_run_attached_docker "${container[@]}" \
    --env "QCSD_RUN_CAPTURE_ACCEPTANCE=1" \
    --env "QCSD_CAPTURE_SERVER_ADDRESS=${first_address}" \
    --env "QCSD_CAPTURE_SERVER_PORT=4433" \
    --env "QCSD_CAPTURE_SERVER_TWO_ADDRESS=${second_address}" \
    --env "QCSD_CAPTURE_SERVER_TWO_PORT=4434" \
    "${image_id}" "$@"
  status=$?
  set -e
  exit "${status}"
fi

if [[ "${1:-}" == "buflo-study" && "${2:-}" == "reference" ]]; then
  set +e
  qcsd_run_attached_docker "${container[@]}" \
    "${image_id}" "${reference_container_args[@]}"
  status=$?
  set -e
  exit "${status}"
fi

if [[ "${1:-}" == "class-study" ]]; then
  if [[ "${class_study_action}" == "acquisition-run" ||
        "${class_study_action}" == "acquisition-status" ||
        "${class_study_action}" == "acquisition-complete" ]]; then
    set +e
    qcsd_run_attached_docker "${container[@]}" "${image_id}" \
      "${class_image_command[@]}" "${class_container_args[@]}"
    class_acquisition_status=$?
    set -e
    exit "${class_acquisition_status}"
  fi
  set +e
  qcsd_run_attached_docker "${container[@]}" "${image_id}" \
    "${class_image_command[@]}" "${class_container_args[@]}"
  class_status=$?
  set -e
  exit "${class_status}"
fi

set +e
qcsd_run_attached_docker "${container[@]}" "${image_id}" "$@"
status=$?
set -e
exit "${status}"
