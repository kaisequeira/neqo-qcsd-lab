configure_buflo_router() {
  local router_name="$1"
  local profile="$2"
  docker exec "${router_name}" /bin/sh -eu -c '
profile="$1"
if ! ip link show dev ifb0 >/dev/null 2>&1; then
  ip link add ifb0 type ifb
fi
ip link set dev ifb0 up
tc qdisc del dev eth0 ingress 2>/dev/null || true
tc qdisc del dev eth0 root 2>/dev/null || true
tc qdisc del dev ifb0 root 2>/dev/null || true
case "${profile}" in
  clean) ;;
  symmetric-50ms-rtt)
    tc qdisc replace dev ifb0 root handle 10: netem delay 25ms
    tc qdisc replace dev eth0 root handle 20: netem delay 25ms
    ;;
  symmetric-5mbit-50ms-rtt-100-packet-queue)
    tc qdisc replace dev ifb0 root handle 10: netem delay 25ms rate 5mbit limit 100
    tc qdisc replace dev eth0 root handle 20: netem delay 25ms rate 5mbit limit 100
    ;;
  symmetric-1pct-loss-50ms-rtt)
    tc qdisc replace dev ifb0 root handle 10: netem delay 25ms loss 1%
    tc qdisc replace dev eth0 root handle 20: netem delay 25ms loss 1%
    ;;
  *)
    echo "unsupported controlled netem profile: ${profile}" >&2
    exit 2
    ;;
esac
if [ "${profile}" != clean ]; then
  tc qdisc replace dev eth0 handle ffff: ingress
  tc filter replace dev eth0 parent ffff: protocol all u32 \
    match u32 0 0 action mirred egress redirect dev ifb0
fi
' sh "${profile}"
}

buflo_namespace_evidence() {
  local container_name="$1"
  local interfaces="$2"
  local include_router="$3"
  docker exec "${container_name}" /usr/bin/python3 -c '
import json
import subprocess
import sys

def observed(*command: str):
    completed = subprocess.run(command, text=True, capture_output=True, check=False)
    if completed.returncode != 0:
        raise SystemExit(
            f"network observation failed ({command!r}): {completed.stderr.strip()}"
        )
    try:
        return json.loads(completed.stdout)
    except json.JSONDecodeError as error:
        raise SystemExit(f"network observation was not JSON ({command!r}): {error}")

interfaces = sys.argv[1].split(",")
value = {
    "addresses": {
        interface: observed("ip", "-j", "address", "show", "dev", interface)
        for interface in interfaces
    },
    "qdiscs": {
        interface: observed("tc", "-details", "-j", "qdisc", "show", "dev", interface)
        for interface in interfaces
    },
    "offloads": {
        interface: observed("ethtool", "--json", "--show-features", interface)
        for interface in interfaces
        if interface.startswith("eth")
    },
    "routes": observed("ip", "-j", "-4", "route", "show", "table", "main"),
}
if sys.argv[2] == "1":
    value["client_ingress_filters"] = observed(
        "tc", "-details", "-j", "filter", "show", "dev", "eth0", "parent", "ffff:"
    )
    value["ip_forward"] = int(
        open("/proc/sys/net/ipv4/ip_forward", encoding="ascii").read().strip()
    )
print(json.dumps(value, sort_keys=True, separators=(",", ":")))
' "${interfaces}" "${include_router}"
}

buflo_controlled_evidence_base64() {
  local client_network="$1"
  local server_network="$2"
  local router_name="$3"
  local first_server="$4"
  local second_server="$5"
  local router_json first_server_json second_server_json
  local client_ipam server_ipam
  router_json="$(buflo_namespace_evidence "${router_name}" "eth0,eth1,ifb0" 1)"
  first_server_json="$(buflo_namespace_evidence "${first_server}" "eth0" 0)"
  second_server_json="$(buflo_namespace_evidence "${second_server}" "eth0" 0)"
  client_ipam="$(docker network inspect --format '{{json .IPAM.Config}}' "${client_network}")"
  server_ipam="$(docker network inspect --format '{{json .IPAM.Config}}' "${server_network}")"
  /usr/bin/python3 -c '
import base64
import json
import sys

value = {
    "schema_version": 1,
    "client_network": {"name": sys.argv[1], "ipam": json.loads(sys.argv[2])},
    "server_network": {"name": sys.argv[3], "ipam": json.loads(sys.argv[4])},
    "router": {"container": sys.argv[5], **json.loads(sys.argv[6])},
    "servers": [
        {
            "container": sys.argv[7],
            "alias": "qcsd-buflo-server-one",
            **json.loads(sys.argv[8]),
        },
        {
            "container": sys.argv[9],
            "alias": "qcsd-buflo-server-two",
            **json.loads(sys.argv[10]),
        },
    ],
}
encoded = json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
print(base64.b64encode(encoded).decode("ascii"))
' \
    "${client_network}" "${client_ipam}" \
    "${server_network}" "${server_ipam}" \
