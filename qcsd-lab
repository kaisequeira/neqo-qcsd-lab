  _QCSD_LIFECYCLE_COHORT_LOCK_PATH="${fields[45]}"
  _QCSD_LIFECYCLE_COHORT_LOCK_DEVICE="${fields[46]}"
  _QCSD_LIFECYCLE_COHORT_LOCK_INODE="${fields[47]}"
  _QCSD_LIFECYCLE_COHORT_LOCK_PARENT_DEVICE="${fields[48]}"
  _QCSD_LIFECYCLE_COHORT_LOCK_PARENT_INODE="${fields[49]}"
  [[ "${_QCSD_LIFECYCLE_GUARD_PID}" == "${PPID}" &&
