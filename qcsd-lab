  _QCSD_LIFECYCLE_LEASE_SOCKET="${fields[19]}"
  _QCSD_LIFECYCLE_LOCK_DEVICE="${fields[20]}"
  _QCSD_LIFECYCLE_LOCK_INODE="${fields[21]}"
  _QCSD_LIFECYCLE_LOCK_PARENT_DEVICE="${fields[22]}"
  _QCSD_LIFECYCLE_LOCK_PARENT_INODE="${fields[23]}"
  _QCSD_LIFECYCLE_LOCK_PATH="${fields[24]}"
  _QCSD_LIFECYCLE_NATIVE_SOURCE_DEVICE="${fields[25]}"
  _QCSD_LIFECYCLE_NATIVE_SOURCE_INODE="${fields[26]}"
  _QCSD_LIFECYCLE_NATIVE_PATH="${fields[27]}"
  _QCSD_LIFECYCLE_NATIVE_SHA256="${fields[28]}"
  _QCSD_LIFECYCLE_QCSD_PID="${fields[29]}"
  _QCSD_LIFECYCLE_QCSD_SOURCE_DEVICE="${fields[30]}"
  _QCSD_LIFECYCLE_QCSD_SOURCE_FD="${fields[31]}"
  _QCSD_LIFECYCLE_QCSD_SOURCE_INODE="${fields[32]}"
  _QCSD_LIFECYCLE_QCSD_SOURCE_PATH="${fields[33]}"
  _QCSD_LIFECYCLE_QCSD_SOURCE_SHA256="${fields[34]}"
  _QCSD_LIFECYCLE_QCSD_START="${fields[35]}"
