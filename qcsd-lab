  _QCSD_LIFECYCLE_LOCK_PARENT_INODE="${fields[19]}"
  _QCSD_LIFECYCLE_LOCK_PATH="${fields[20]}"
  _QCSD_LIFECYCLE_NATIVE_SOURCE_DEVICE="${fields[21]}"
  _QCSD_LIFECYCLE_NATIVE_SOURCE_INODE="${fields[22]}"
  _QCSD_LIFECYCLE_NATIVE_PATH="${fields[23]}"
  _QCSD_LIFECYCLE_NATIVE_SHA256="${fields[24]}"
  _QCSD_LIFECYCLE_QCSD_PID="${fields[25]}"
  _QCSD_LIFECYCLE_QCSD_SOURCE_DEVICE="${fields[26]}"
  _QCSD_LIFECYCLE_QCSD_SOURCE_FD="${fields[27]}"
  _QCSD_LIFECYCLE_QCSD_SOURCE_INODE="${fields[28]}"
  _QCSD_LIFECYCLE_QCSD_SOURCE_PATH="${fields[29]}"
  _QCSD_LIFECYCLE_QCSD_SOURCE_SHA256="${fields[30]}"
  _QCSD_LIFECYCLE_QCSD_START="${fields[31]}"
  _QCSD_LIFECYCLE_DOCKER_CONFIG_DEVICE="${fields[32]}"
  _QCSD_LIFECYCLE_DOCKER_CONFIG_INODE="${fields[33]}"
  _QCSD_LIFECYCLE_DOCKER_CONFIG_PATH="${fields[34]}"
  _QCSD_LIFECYCLE_BUILDX_CONFIG_DEVICE="${fields[35]}"
  _QCSD_LIFECYCLE_BUILDX_CONFIG_INODE="${fields[36]}"
  _QCSD_LIFECYCLE_BUILDX_CONFIG_PATH="${fields[37]}"
  [[ "${_QCSD_LIFECYCLE_GUARD_PID}" == "${PPID}" &&
      "${_QCSD_LIFECYCLE_GUARD_SOURCE_PATH}" == "${expected_guardian}" &&
      "${_QCSD_LIFECYCLE_GUARD_SOURCE_DEVICE}:${_QCSD_LIFECYCLE_GUARD_SOURCE_INODE}" == \
        "${expected_guardian_device}:${expected_guardian_inode}" ]] || return 1
  [[ "${_QCSD_LIFECYCLE_GUARD_SOURCE_DEVICE}:${_QCSD_LIFECYCLE_GUARD_SOURCE_INODE}" == \
        "${expected_guardian_device}:${expected_guardian_inode}" &&
      "${_QCSD_LIFECYCLE_GUARD_SOURCE_SHA256}" == "${expected_guardian_sha}" ]] || return 1
  # Bind the guardian proof to the exact helper bytes already loaded into this
  # shell.  A later pathname observation alone must not bless replacement
  # bytes that differ from the functions executing in this process.
  loaded_helper_device="${docker_supervisor_metadata%%:*}"
  loaded_helper_tail="${docker_supervisor_metadata#*:}"
  loaded_helper_inode="${loaded_helper_tail%%:*}"
  [[ "${_QCSD_LIFECYCLE_HELPER_SOURCE_PATH}" == "${DOCKER_SUPERVISOR}" &&
      "${_QCSD_LIFECYCLE_HELPER_SOURCE_DEVICE}" == "${loaded_helper_device}" &&
      "${_QCSD_LIFECYCLE_HELPER_SOURCE_INODE}" == "${loaded_helper_inode}" ]] || return 1
  [[ "${_QCSD_LIFECYCLE_HELPER_SHA256}" == "${docker_supervisor_sha256}" ]] || return 1
  [[ "${_QCSD_LIFECYCLE_QCSD_SOURCE_PATH}" == "${ROOT}/qcsd-lab" &&
      "${BASH_SOURCE[0]}" == "/proc/${_QCSD_LIFECYCLE_GUARD_PID}/fd/${_QCSD_LIFECYCLE_QCSD_SOURCE_FD}" &&
