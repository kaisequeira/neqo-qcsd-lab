      echo "browser-egress prevalidation output is malformed" >&2
      false
    fi
    browser_egress_failure_verdict=operational-failure
    browser_egress_failure_code=infrastructure-timeout
    browser_egress_failure_stage=topology-teardown
    browser_egress_cleanup_topology || false
    browser_egress_append_mounts=(
      --volume "${browser_egress_result_host}:${browser_egress_result_container}:rw"
      --volume "${browser_egress_result_host}/foundation.json:${browser_egress_result_container}/foundation.json:ro"
      --volume "${browser_egress_result_host}/attempts:${browser_egress_result_container}/attempts:rw"
      --volume "${browser_egress_result_host}/attempt-intents:${browser_egress_result_container}/attempt-intents:ro"
      --volume "${browser_egress_result_host}/evidence:${browser_egress_result_container}/evidence:ro"
    )
    while IFS= read -r -d '' browser_egress_prior_result; do
      if [[ -L "${browser_egress_prior_result}" || ! -f "${browser_egress_prior_result}" ]]; then
        echo "browser-egress attempt ledger contains an unsafe entry" >&2
        false
      fi
      browser_egress_append_mounts+=(
        --volume "${browser_egress_prior_result}:${browser_egress_result_container}/attempts/${browser_egress_prior_result##*/}:ro"
      )
    done < <(find "${browser_egress_result_host}/attempts" -mindepth 1 -maxdepth 1 -print0)
    browser_egress_failure_code=semantic-observation-failed
    browser_egress_failure_stage=result-assembly
    QCSD_DOCKER_OUTPUT_BROWSER_EGRESS_ASSEMBLE=""
    browser_egress_assemble_command_status=0
    if qcsd_capture_attached_docker_output QCSD_DOCKER_OUTPUT_BROWSER_EGRESS_ASSEMBLE \
      docker run --network none \
      --user "${qcsd_invoking_uid}:${qcsd_invoking_gid}" --cap-drop ALL \
      --security-opt no-new-privileges:true --read-only \
      --tmpfs /tmp:rw,nosuid,nodev,noexec,mode=1777 \
      --env "QCSD_LAB_IMAGE_DIGEST=${image_id}" --volume "${ROOT}:/lab:ro" \
      "${browser_egress_append_mounts[@]}" \
      --volume "${browser_egress_attempt_scratch}:/qcsd-input:ro" \
      --entrypoint /usr/bin/tini "${image_id}" -- "${browser_egress_tool}" assemble \
      --result-root "${browser_egress_result_container}" --vector-id "${browser_egress_vector_id}" \
      --next-json /qcsd-input/next.json --actor-json /qcsd-input/actor.json \
      --forbidden-json /qcsd-input/forbidden.json --dns-json /qcsd-input/dns.json \
      --fixture-json /qcsd-input/fixture.json --capture-json /qcsd-input/capture.json \
      --runtime-json /qcsd-input/runtime.json --started-at "${browser_egress_started_at}" \
      --finished-at "${browser_egress_finished_at}"; then
      browser_egress_assemble_command_status=0
    else
      browser_egress_assemble_command_status=$?
    fi
    printf '%s\n' "${QCSD_DOCKER_OUTPUT_BROWSER_EGRESS_ASSEMBLE}" \
      >"${browser_egress_attempt_scratch}/assemble.json"
    browser_egress_assemble_fields_output=""
    if browser_egress_assemble_fields_output="$(python3 -I -c '
import json, re, sys
value=json.load(open(sys.argv[1], encoding="utf-8"))
if not isinstance(value,dict) or type(value.get("schema_version")) is not int or value["schema_version"] != 1 or type(value.get("assembled")) is not bool:
    raise SystemExit("browser-egress assembly result is malformed")
if value["assembled"] is True:
    if set(value) != {"schema_version","assembled","checkpoint"} or not isinstance(value.get("checkpoint"),dict):
        raise SystemExit("browser-egress assembly result is malformed")
    print("passed")
else:
    if set(value) != {"schema_version","assembled","failure_code"}:
        raise SystemExit("browser-egress assembly result is malformed")
    print("failed")
    code=value.get("failure_code")
    if not isinstance(code, str) or re.fullmatch(r"[a-z0-9][a-z0-9-]{0,127}", code) is None:
        raise SystemExit("browser-egress assembly failure code is malformed")
    print(code)
' "${browser_egress_attempt_scratch}/assemble.json")"; then
      mapfile -t browser_egress_assemble_fields \
        <<<"${browser_egress_assemble_fields_output}"
    else
      browser_egress_assemble_fields=()
    fi
    if (( ${#browser_egress_assemble_fields[@]} == 2 )) &&
       [[ "${browser_egress_assemble_fields[0]}" == "failed" ]] &&
       (( browser_egress_assemble_command_status == 0 )); then
      browser_egress_failure_code="${browser_egress_assemble_fields[1]}"
      browser_egress_failure_stage="classified-${browser_egress_failure_code}"
      browser_egress_failure_verdict=semantic-failure
      [[ "${browser_egress_failure_code}" != "capture-process-failed" ]] || \
        browser_egress_failure_verdict=operational-failure
      false
    fi
    if (( browser_egress_assemble_command_status != 0 )) ||
       (( ${#browser_egress_assemble_fields[@]} != 1 )) ||
       [[ "${browser_egress_assemble_fields[0]}" != "passed" ]]; then
      browser_egress_failure_verdict=operational-failure
      browser_egress_failure_code=infrastructure-timeout
      browser_egress_failure_stage=result-publication-reconciliation
      # The mutating append may already have published a passed receipt.  Do
      # not add failure artifacts until the authoritative ledger proves that
      # this exact attempt remains unpublished.
      browser_egress_causal_inputs_ready=0
      QCSD_DOCKER_OUTPUT_BROWSER_EGRESS_ATTEMPT_STATUS=""
      if ! qcsd_capture_attached_docker_output \
        QCSD_DOCKER_OUTPUT_BROWSER_EGRESS_ATTEMPT_STATUS \
        docker run --network none \
        --user "${qcsd_invoking_uid}:${qcsd_invoking_gid}" --cap-drop ALL \
        --security-opt no-new-privileges:true --read-only \
        --tmpfs /tmp:rw,nosuid,nodev,noexec,mode=1777 \
        --env "QCSD_LAB_IMAGE_DIGEST=${image_id}" --volume "${ROOT}:/lab:ro" \
        "${browser_egress_append_mounts[@]}" \
        --volume "${browser_egress_attempt_scratch}:/qcsd-input:ro" \
        --entrypoint /usr/bin/tini "${image_id}" -- "${browser_egress_tool}" \
        attempt-status --result-root "${browser_egress_result_container}" \
        --vector-id "${browser_egress_vector_id}" \
        --next-json /qcsd-input/next.json; then
        trap - ERR
        echo "browser-egress could not reconcile ambiguous result publication" >&2
        exit 1
      fi
      browser_egress_attempt_status="$(python3 -I -c '
import json,sys
value=json.loads(sys.argv[1])
if set(value) != {"schema_version","published","verdict","checkpoint"} or value.get("schema_version") != 1 or type(value.get("published")) is not bool:
    raise SystemExit("browser-egress attempt-status output is malformed")
if value["published"]:
    if value.get("verdict") not in {"passed","operational-failure","semantic-failure"}:
        raise SystemExit("browser-egress published attempt verdict is invalid")
    print("published-" + value["verdict"])
elif value.get("verdict") is None:
    print("unpublished")
else:
    raise SystemExit("browser-egress unpublished attempt has a verdict")
' "${QCSD_DOCKER_OUTPUT_BROWSER_EGRESS_ATTEMPT_STATUS}")" || {
        trap - ERR
        echo "browser-egress attempt-status output is malformed" >&2
        exit 1
      }
      if [[ "${browser_egress_attempt_status}" != published-passed ]]; then
        if [[ "${browser_egress_attempt_status}" == published-* ]]; then
          trap - ERR
          echo "browser-egress ambiguous publication resolved to an unexpected recorded verdict" >&2
          exit 1
        fi
        browser_egress_causal_inputs_ready=1
        echo "browser-egress assembly did not publish its result" >&2
        false
      fi
    fi
    trap - ERR
    rm -rf -- "${browser_egress_attempt_scratch}"
    browser_egress_attempt_scratch=""
    browser_egress_causal_inputs_ready=0
  done
  browser_egress_finalize_mounts=(
    --volume "${browser_egress_result_host}:${browser_egress_result_container}:rw"
  )
  while IFS= read -r -d '' browser_egress_final_existing; do
    if [[ -L "${browser_egress_final_existing}" ]]; then
      echo "browser-egress finalization input contains a symlink" >&2
      exit 1
    fi
    if [[ ! -f "${browser_egress_final_existing}" &&
          ! -d "${browser_egress_final_existing}" ]]; then
      echo "browser-egress finalization input is non-regular" >&2
      exit 1
    fi
    browser_egress_final_name="${browser_egress_final_existing##*/}"
    if [[ ! "${browser_egress_final_name}" =~ ^[A-Za-z0-9._-]+$ ]]; then
      echo "browser-egress finalization input has an unsafe name" >&2
      exit 1
    fi
    browser_egress_finalize_mounts+=(
      --volume "${browser_egress_final_existing}:${browser_egress_result_container}/${browser_egress_final_name}:ro"
    )
  done < <(find "${browser_egress_result_host}" -mindepth 1 -maxdepth 1 -print0)
  qcsd_run_attached_docker docker run --network none \
    --user "${qcsd_invoking_uid}:${qcsd_invoking_gid}" --cap-drop ALL \
    --security-opt no-new-privileges:true --read-only \
    --tmpfs /tmp:rw,nosuid,nodev,noexec,mode=1777 \
    --env "QCSD_LAB_IMAGE_DIGEST=${image_id}" --volume "${ROOT}:/lab:ro" \
    "${browser_egress_finalize_mounts[@]}" \
    --entrypoint /usr/bin/tini "${image_id}" -- "${browser_egress_tool}" finalize \
    --result-root "${browser_egress_result_container}" >/dev/null
  rm -rf -- "${browser_egress_scratch}"
  trap - EXIT
  qcsd_run_attached_docker docker run --network none \
    --user "${qcsd_invoking_uid}:${qcsd_invoking_gid}" --cap-drop ALL \
    --security-opt no-new-privileges:true --read-only \
    --tmpfs /tmp:rw,nosuid,nodev,noexec,mode=1777 \
    --env "QCSD_LAB_IMAGE_DIGEST=${image_id}" --volume "${ROOT}:/lab:ro" \
    --entrypoint /usr/bin/tini "${image_id}" -- \
    /usr/bin/timeout --signal=TERM --kill-after=10s 600s \
    "${browser_egress_tool}" verify --cohort-version "${browser_egress_cohort_version}" \
    --build-execution-receipt "${browser_egress_build_container}" \
    --result-root "${browser_egress_result_container}" \
    --live-docker-json "${browser_egress_live_docker_json}"
  exit $?
fi

