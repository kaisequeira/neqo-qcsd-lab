      return 1
    fi
    root_metadata="$(stat -c '%u:%a:%F' -- "${supervisor_root}" 2>/dev/null)" ||
      continue
    if [[ "${root_metadata%%:*}" != "${current_uid}" ]]; then
      continue
    fi
    if [[ "${root_metadata}" != "${current_uid}:700:directory" ]]; then
      echo "qcsd-lab evidence build found unsafe prior supervisor state: ${supervisor_root}" >&2
      return 1
    fi
    if [[ -L "${record}" ]]; then
      echo "qcsd-lab evidence build found unsafe prior supervisor record: ${record}" >&2
      return 1
    fi
    record_metadata="$(stat -c '%u:%a:%h:%F' -- "${record}" 2>/dev/null)" ||
      continue
    if [[ "${record_metadata}" != "${current_uid}:600:1:regular file" ]]; then
      echo "qcsd-lab evidence build found unsafe prior supervisor record: ${record}" >&2
      return 1
    fi
    object_count=0
    working_directory_count=0
    daemon_id_count=0
    context_count=0
    host_count=0
    server_id_count=0
    cli_pid_count=0
    cli_start_count=0
    cli_session_count=0
    cli_group_count=0
    argv_hash_count=0
    cohort_count=0
    receipt_count=0
    transaction_state_count=0
    record_line_count=0
    scope_field_counts=()
    scope_field_values=()
    object=""
    working_directory=""
    docker_daemon_id=""
    docker_context=""
    docker_host=""
    docker_server_id=""
    cli_pid=""
    cli_start=""
    cli_session=""
    cli_group=""
    build_argv_sha256=""
    transaction_cohort=""
    transaction_receipt=""
    transaction_state=""
    while IFS= read -r line || [[ -n "${line}" ]]; do
      record_line_count=$((record_line_count + 1))
      field_key="${line%%=*}"
      case "${field_key}" in
        object|process_identity_role|scope_launcher_pid|scope_launcher_start_time|\
        scope_launcher_session|scope_launcher_process_group|docker_context|\
        docker_host|docker_server_id|docker_daemon_id|working_directory|\
        build_argv_sha256|scope_required|scope_unit|scope_control_group|\
        scope_state|scope_final_state|scope_signal_attempted|scope_signal_outcome|\
        scope_leak_detected|scope_kill_attempted|scope_kill_outcome|\
        scope_empty_proven|host_boot_id|status_file|status_file_state|\
        status_file_matches|docker_command_status|systemd_run_status|\
        requested_signal|forwarded_cli_signal|cli_signal_attempted|\
        cli_signal_outcome|cli_forced|cli_force_attempted|cli_force_outcome|\
        daemon_cancellation)
          field_count="${scope_field_counts[${field_key}]-0}"
          scope_field_counts[${field_key}]=$((field_count + 1))
          scope_field_values[${field_key}]="${line#*=}"
          ;;
      esac
      case "${line}" in
        object=*)
          object_count=$((object_count + 1))
          object="${line#object=}"
          ;;
        working_directory=*)
          working_directory_count=$((working_directory_count + 1))
          working_directory="${line#working_directory=}"
          ;;
        docker_daemon_id=*)
          daemon_id_count=$((daemon_id_count + 1))
          docker_daemon_id="${line#docker_daemon_id=}"
          ;;
        docker_context=*) context_count=$((context_count + 1)); docker_context="${line#*=}" ;;
        docker_host=*) host_count=$((host_count + 1)); docker_host="${line#*=}" ;;
        docker_server_id=*)
          server_id_count=$((server_id_count + 1)); docker_server_id="${line#*=}"
          ;;
        cli_pid=*) cli_pid_count=$((cli_pid_count + 1)); cli_pid="${line#*=}" ;;
        cli_start_time=*)
          cli_start_count=$((cli_start_count + 1)); cli_start="${line#*=}"
          ;;
        cli_session=*)
          cli_session_count=$((cli_session_count + 1)); cli_session="${line#*=}"
          ;;
        cli_process_group=*)
          cli_group_count=$((cli_group_count + 1)); cli_group="${line#*=}"
          ;;
        build_argv_sha256=*)
          argv_hash_count=$((argv_hash_count + 1)); build_argv_sha256="${line#*=}"
          ;;
        cohort_version=*)
          cohort_count=$((cohort_count + 1)); transaction_cohort="${line#*=}"
          ;;
        receipt_path=*)
          receipt_count=$((receipt_count + 1)); transaction_receipt="${line#*=}"
          ;;
        transaction_state=*)
          transaction_state_count=$((transaction_state_count + 1));
          transaction_state="${line#*=}"
          ;;
      esac
    done <"${record}"
    if (( object_count != 1 || working_directory_count != 1 ||
          daemon_id_count != 1 )) ||
       [[ "${object}" != "docker-build-cli" &&
          "${object}" != "docker-build-transaction" &&
          "${object}" != "docker-build-scope-launcher" ]]; then
      echo "qcsd-lab evidence build found malformed prior supervisor record: ${record}" >&2
      return 1
    fi
    canonical_path="$(realpath -m -- "${working_directory}" 2>/dev/null)" ||
      canonical_path=""
    if [[ ! "${docker_daemon_id}" =~ ^[A-Za-z0-9_.:-]+$ ||
          "${docker_daemon_id}" == "unavailable" ||
          "${working_directory}" != /* || "${working_directory}" == "/" ||
          "${canonical_path}" != "${working_directory}" ||
          ${context_count} -ne 1 ||
          ! "${docker_context}" =~ ^[A-Za-z0-9_.-]+$ ||
          ${host_count} -ne 1 ||
          ( "${docker_host}" != "unix:///var/run/docker.sock" &&
            "${docker_host}" != "npipe:////./pipe/dockerDesktopLinuxEngine" ) ]]; then
      echo "qcsd-lab evidence build found malformed prior supervisor record: ${record}" >&2
      return 1
    fi
    if [[ "${object}" == "docker-build-cli" ]]; then
      if (( server_id_count != 1 || cli_pid_count != 1 || cli_start_count != 1 ||
            cli_session_count != 1 || cli_group_count != 1 || argv_hash_count != 1 )) ||
         [[ "${docker_server_id}" != "${docker_daemon_id}" ||
            ! "${build_argv_sha256}" =~ ^[0-9a-f]{64}$ ||
            ! "${cli_pid}" =~ ^(unavailable|[1-9][0-9]*)$ ||
            ! "${cli_start}" =~ ^(unavailable|[1-9][0-9]*)$ ||
            ! "${cli_session}" =~ ^(unavailable|[1-9][0-9]*)$ ||
            ! "${cli_group}" =~ ^(unavailable|[1-9][0-9]*)$ ]]; then
        echo "qcsd-lab evidence build found malformed prior supervisor record: ${record}" >&2
        return 1
      fi
    elif [[ "${object}" == "docker-build-transaction" ]]; then
      canonical_path="$(realpath -m -- "${transaction_receipt}" 2>/dev/null)" ||
        canonical_path=""
      if (( server_id_count != 1 || cohort_count != 1 || receipt_count != 1 ||
            transaction_state_count != 1 )) ||
         [[ "${docker_server_id}" != "${docker_daemon_id}" ||
            ! "${transaction_cohort}" =~ ^[1-9][0-9]*$ ||
            "${transaction_receipt}" != /* || "${transaction_receipt}" == "/" ||
            "${canonical_path}" != "${transaction_receipt}" ||
            "${transaction_state}" != "uncommitted-static-tag-mutation" ]]; then
        echo "qcsd-lab evidence build found malformed prior supervisor record: ${record}" >&2
        return 1
      fi
    else
      scope_record_invalid=0
      if [[ "${record##*/}" == "SUPERVISION" ]]; then
        if (( record_line_count != ${#scope_supervision_fields[@]} )); then
          scope_record_invalid=1
        fi
        for expected_field in "${scope_supervision_fields[@]}"; do
          if (( ${scope_field_counts[${expected_field}]-0} != 1 )); then
            scope_record_invalid=1
          fi
        done
      elif [[ "${record##*/}" == "RECOVERY" ]]; then
        if (( record_line_count != ${#scope_recovery_fields[@]} )); then
          scope_record_invalid=1
        fi
        for expected_field in "${scope_recovery_fields[@]}"; do
          if (( ${scope_field_counts[${expected_field}]-0} != 1 )); then
            scope_record_invalid=1
          fi
        done
      else
        scope_record_invalid=1
      fi
      if (( scope_record_invalid != 0 )); then
        echo "qcsd-lab evidence build found malformed prior supervisor record: ${record}" >&2
        return 1
      fi

      scope_unit="${scope_field_values[scope_unit]}"
      scope_control_group="${scope_field_values[scope_control_group]}"
      if [[ "${scope_control_group}" != "unavailable" ]]; then
        canonical_path="$(realpath -m -- "${scope_control_group}" 2>/dev/null)" ||
          canonical_path=""
      else
        canonical_path="unavailable"
      fi
      if (( server_id_count != 1 || argv_hash_count != 1 )) ||
         [[ "${docker_server_id}" != "${docker_daemon_id}" ||
            "${scope_field_values[process_identity_role]}" != "local-systemd-run-scope-launcher" ||
            ! "${build_argv_sha256}" =~ ^[0-9a-f]{64}$ ||
            "${scope_field_values[scope_required]}" != "1" ||
            ! "${scope_unit}" =~ ^qcsd-docker-build-[0-9a-f]{32}[.]scope$ ||
            ! "${scope_field_values[host_boot_id]}" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ||
            "${scope_field_values[status_file]}" != "${supervisor_root}/build.status" ||
            ! "${scope_field_values[requested_signal]}" =~ ^(none|HUP|INT|QUIT|TERM)$ ||
            ! "${scope_field_values[forwarded_cli_signal]}" =~ ^(none|INT)$ ||
            "${scope_field_values[daemon_cancellation]}" != "unavailable-client-disconnect-only" ||
            ( "${scope_control_group}" != "unavailable" &&
              ( "${scope_control_group}" != /* ||
                "${canonical_path}" != "${scope_control_group}" ||
                "${scope_control_group}" != */"${scope_unit}" ||
                ! "${scope_control_group}" =~ ^/[A-Za-z0-9_.@:/-]+$ ) ) ]]; then
        echo "qcsd-lab evidence build found malformed prior supervisor record: ${record}" >&2
        return 1
      fi

      scope_pid="${scope_field_values[scope_launcher_pid]}"
      scope_start="${scope_field_values[scope_launcher_start_time]}"
      scope_session="${scope_field_values[scope_launcher_session]}"
      scope_group="${scope_field_values[scope_launcher_process_group]}"
      if [[ "${record##*/}" == "SUPERVISION" ]]; then
        scope_state="${scope_field_values[scope_state]}"
        if [[ "${scope_field_values[forwarded_cli_signal]}" != "none" ]]; then
          scope_record_invalid=1
        fi
        case "${scope_state}" in
          declared)
            if [[ "${scope_pid}" != "unavailable" ||
                  "${scope_start}" != "unavailable" ||
                  "${scope_session}" != "unavailable" ||
                  "${scope_group}" != "unavailable" ||
                  "${scope_control_group}" != "unavailable" ||
                  "${scope_field_values[status_file_state]}" != "declared" ||
                  "${scope_field_values[requested_signal]}" != "none" ]]; then
              scope_record_invalid=1
            fi
            ;;
          active|inactive)
            if [[ ! "${scope_pid}" =~ ^[1-9][0-9]*$ ||
                  ! "${scope_start}" =~ ^[1-9][0-9]*$ ||
                  "${scope_session}" != "${scope_pid}" ||
                  "${scope_group}" != "${scope_pid}" ||
                  "${scope_control_group}" == "unavailable" ||
                  "${scope_field_values[status_file_state]}" != "awaiting-command-status" ]]; then
              scope_record_invalid=1
            fi
            ;;
          absent)
            if [[ ! "${scope_pid}" =~ ^[1-9][0-9]*$ ||
                  ! "${scope_start}" =~ ^[1-9][0-9]*$ ||
                  "${scope_session}" != "${scope_pid}" ||
                  "${scope_group}" != "${scope_pid}" ||
                  "${scope_control_group}" != "unavailable" ||
                  "${scope_field_values[status_file_state]}" != "awaiting-command-status" ]]; then
              scope_record_invalid=1
            fi
            ;;
          *) scope_record_invalid=1 ;;
        esac
      else
        scope_state="${scope_field_values[scope_final_state]}"
        if [[ ! "${scope_pid}" =~ ^[1-9][0-9]*$ ||
              ! "${scope_start}" =~ ^(unavailable|[1-9][0-9]*)$ ]]; then
          scope_record_invalid=1
        elif [[ "${scope_session}" == "unavailable" &&
                "${scope_group}" == "unavailable" ]]; then
          :
        elif [[ "${scope_start}" =~ ^[1-9][0-9]*$ &&
                "${scope_session}" == "${scope_pid}" &&
                "${scope_group}" == "${scope_pid}" ]]; then
          :
        else
          scope_record_invalid=1
        fi

        case "${scope_field_values[scope_signal_attempted]}:${scope_field_values[scope_signal_outcome]}" in
          0:not_attempted) ;;
          1:accepted|1:unknown) ;;
          *) scope_record_invalid=1 ;;
        esac
        if [[ "${scope_field_values[requested_signal]}" == "none" ]]; then
          [[ "${scope_field_values[scope_signal_attempted]}" == "0" ]] ||
            scope_record_invalid=1
        elif [[ "${scope_field_values[scope_signal_attempted]}" == "0" ]]; then
          # A terminal signal may latch after the scope-signal boundary. It is
          # valid to make no signalling attempt only when the later evidence
          # proves both the scope and its launcher already terminal.
          if [[ "${scope_field_values[scope_empty_proven]}" != "1" ||
                "${scope_field_values[status_file_state]}" == "launcher-unreaped" ]]; then
            scope_record_invalid=1
          fi
        elif [[ "${scope_field_values[scope_signal_attempted]}" != "1" ]]; then
          scope_record_invalid=1
        fi

        case "${scope_field_values[scope_leak_detected]}:${scope_field_values[scope_kill_attempted]}:${scope_field_values[scope_kill_outcome]}" in
          0:0:not_attempted) ;;
          1:1:accepted|1:1:unknown) ;;
          *) scope_record_invalid=1 ;;
        esac
        case "${scope_field_values[scope_empty_proven]}:${scope_state}" in
          1:inactive)
            [[ "${scope_control_group}" != "unavailable" ]] ||
              scope_record_invalid=1
            ;;
          1:absent|0:unknown) ;;
          *) scope_record_invalid=1 ;;
        esac

        scope_docker_status="${scope_field_values[docker_command_status]}"
        scope_systemd_status="${scope_field_values[systemd_run_status]}"
        case "${scope_field_values[status_file_state]}" in
          valid)
            if [[ "${scope_field_values[status_file_matches]}" != "1" ||
                  ! "${scope_docker_status}" =~ ^(0|[1-9][0-9]{0,2})$ ||
                  ! "${scope_systemd_status}" =~ ^(0|[1-9][0-9]{0,2})$ ||
                  "${scope_docker_status}" != "${scope_systemd_status}" ]]; then
              scope_record_invalid=1
            elif (( 10#${scope_docker_status} > 255 ||
                    10#${scope_systemd_status} > 255 )); then
              scope_record_invalid=1
            fi
            ;;
          status-mismatch)
            if [[ "${scope_field_values[status_file_matches]}" != "0" ||
                  ! "${scope_docker_status}" =~ ^(0|[1-9][0-9]{0,2})$ ||
                  ! "${scope_systemd_status}" =~ ^(0|[1-9][0-9]{0,2})$ ||
                  "${scope_docker_status}" == "${scope_systemd_status}" ]]; then
              scope_record_invalid=1
            elif (( 10#${scope_docker_status} > 255 ||
                    10#${scope_systemd_status} > 255 )); then
              scope_record_invalid=1
            fi
            ;;
          invalid|missing)
            if [[ "${scope_field_values[status_file_matches]}" != "0" ||
                  "${scope_docker_status}" != "unavailable" ||
                  ! "${scope_systemd_status}" =~ ^(0|[1-9][0-9]{0,2})$ ]]; then
              scope_record_invalid=1
            elif (( 10#${scope_systemd_status} > 255 )); then
              scope_record_invalid=1
            fi
            ;;
          launcher-unreaped)
            if [[ "${scope_field_values[status_file_matches]}" != "0" ||
                  "${scope_docker_status}" != "unavailable" ||
                  "${scope_systemd_status}" != "unavailable" ]]; then
              scope_record_invalid=1
            fi
            ;;
          *) scope_record_invalid=1 ;;
        esac

        case "${scope_field_values[cli_signal_attempted]}:${scope_field_values[cli_signal_outcome]}:${scope_field_values[forwarded_cli_signal]}" in
          0:not_attempted:none) ;;
          1:accepted:INT|1:unknown:none) ;;
          *) scope_record_invalid=1 ;;
        esac
        if [[ "${scope_field_values[requested_signal]}" == "none" &&
              "${scope_field_values[cli_signal_attempted]}" != "0" ]]; then
          scope_record_invalid=1
        fi
        case "${scope_field_values[cli_force_attempted]}:${scope_field_values[cli_forced]}:${scope_field_values[cli_force_outcome]}" in
          0:0:not_attempted) ;;
          1:1:accepted|1:0:unknown) ;;
          *) scope_record_invalid=1 ;;
        esac
      fi
      if (( scope_record_invalid != 0 )); then
        echo "qcsd-lab evidence build found malformed prior supervisor record: ${record}" >&2
        return 1
      fi
    fi
    if [[ "${docker_daemon_id}" == "${build_docker_server_id}" ||
          "${working_directory}" == "${ROOT}" ]]; then
      echo "qcsd-lab evidence build is blocked by unresolved prior Docker build state: ${record}" >&2
      echo "restart and audit the Docker daemon, then remove only this verified supervisor directory before retrying" >&2
      return 1
    fi
  done
}

begin_evidence_build_transaction() {
  local staged root_metadata token transaction_boot_id
  if [[ -n "${build_transaction_root:-}" ]]; then
    echo "qcsd-lab evidence build transaction is already active" >&2
    return 1
  fi
  if [[ "${_QCSD_LIFECYCLE_LOCK_MODE:-}" != "exclusive" ]] ||
     ! command -v sync >/dev/null 2>&1 ||
     ! _qcsd_bind_helper_source_identity; then
    echo "qcsd-lab cannot establish durable build-transaction evidence" >&2
    return 1
  fi
  token="$(_qcsd_supervisor_token)" || return 1
  _qcsd_create_lifecycle_root transaction "${token}" || return 1
  build_transaction_root="${_qcsd_lifecycle_root}"
  IFS= read -r transaction_boot_id </proc/sys/kernel/random/boot_id || {
    _qcsd_cancel_lifecycle_root_creation || true; return 1;
  }
  [[ "${transaction_boot_id}" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] ||
    { _qcsd_cancel_lifecycle_root_creation || true; return 1; }
  root_metadata="$(stat -Lc '%u:%a:%F' -- "${build_transaction_root}" 2>/dev/null)" ||
    { _qcsd_cancel_lifecycle_root_creation || true; return 1; }
  if [[ "${root_metadata}" != "$(id -u):700:directory" ]]; then
    echo "qcsd-lab build transaction root is not private" >&2
    _qcsd_cancel_lifecycle_root_creation || true
    return 1
  fi
  staged="${build_transaction_root}/SUPERVISION.next"
  local supervisor_root="${build_transaction_root}"
  local lifecycle_state="request-authorised"
  if ! {
    printf 'object=docker-build-transaction\n'
    _qcsd_print_lifecycle_identity
    printf 'docker_context=%s\n' "${build_docker_context}"
    _qcsd_print_docker_binding
    printf 'docker_daemon_id=%s\n' "${build_docker_server_id}"
    printf 'host_boot_id=%s\n' "${transaction_boot_id}"
    printf 'working_directory=%s\n' "${ROOT}"
    printf 'cohort_version=%s\n' "${build_cohort_version}"
    printf 'receipt_path=%s\n' "${build_receipt}"
    printf 'transaction_state=uncommitted-static-tag-mutation\n'
  } >"${staged}"; then
    _qcsd_cancel_lifecycle_root_creation || true
    return 1
  fi
  if ! _qcsd_publish_supervision_file \
      "${staged}" "${build_transaction_root}/SUPERVISION"; then
    echo "qcsd-lab cannot publish durable build-transaction evidence" >&2
    if (( _QCSD_PUBLISH_REPLACED != 0 )); then
      _qcsd_commit_lifecycle_root_creation || true
    else
      _qcsd_cancel_lifecycle_root_creation || true
    fi
    return 1
  fi
  _qcsd_commit_lifecycle_root_creation || return 1
  _QCSD_DOCKER_BUILD_TRANSACTION_ROOT="${build_transaction_root}"
}

complete_evidence_build_transaction() {
  local record root_metadata record_metadata
  record="${build_transaction_root:-}/SUPERVISION"
  if [[ "${_QCSD_LIFECYCLE_LOCK_MODE:-}" != "exclusive" ]] ||
     ! _qcsd_verify_pinned_docker_daemon ||
     ! _qcsd_verify_pinned_host_boot ||
     ! _qcsd_lifecycle_validate_root \
        "${build_transaction_root:-}" transaction ||
     (( _QCSD_LIFECYCLE_SELECTED_UNPUBLISHED != 0 )) ||
     [[ "${_QCSD_LIFECYCLE_SELECTED_VALUES[lifecycle_state]}" != \
          "request-authorised" ||
        "${_QCSD_LIFECYCLE_SELECTED_VALUES[working_directory]}" != "${ROOT}" ||
        "${_QCSD_LIFECYCLE_SELECTED_VALUES[cohort_version]}" != \
          "${build_cohort_version}" ||
        "${_QCSD_LIFECYCLE_SELECTED_VALUES[receipt_path]}" != \
          "${build_receipt}" ]]; then
    echo "qcsd-lab cannot validate the active build transaction at commit" >&2
    return 1
  fi
  root_metadata="$(stat -Lc '%u:%a:%F' -- "${build_transaction_root:-}" 2>/dev/null)" ||
    return 1
  record_metadata="$(stat -Lc '%u:%a:%h:%F' -- "${record}" 2>/dev/null)" ||
    return 1
  if [[ "${root_metadata}" != "$(id -u):700:directory" ||
        "${record_metadata}" != "$(id -u):600:1:regular file" ||
        -L "${build_receipt}" || ! -f "${build_receipt}" ]]; then
    echo "qcsd-lab cannot acknowledge an incomplete build transaction" >&2
    return 1
  fi
  # The receipt writer has already fsynced both the validated receipt and its
  # parent directory. Removing this taint is therefore the commit point: a
  # signal before it leaves the transaction blocked; a signal after it cannot
  # erase the immutable receipt that accounts for every static-tag mutation.
  _qcsd_lifecycle_remove_root "${build_transaction_root}" 0 transaction-committed || return 1
  _QCSD_DOCKER_BUILD_TRANSACTION_ROOT=""
  build_transaction_root=""
}

read_built_image_id() {
  local target="$1"
  local iidfile="$2"
  local -a lines=()
  if [[ -L "${iidfile}" || ! -f "${iidfile}" ]]; then
    echo "qcsd-lab ${target} build did not create a regular IID file" >&2
    return 1
  fi
  mapfile -t lines <"${iidfile}"
  if (( ${#lines[@]} != 1 )) ||
     [[ ! "${lines[0]}" =~ ^sha256:[0-9a-f]{64}$ ]]; then
    echo "qcsd-lab ${target} build returned an invalid immutable image ID" >&2
    return 1
  fi
  printf '%s\n' "${lines[0]}"
}

verify_built_image_binding() {
  local target="$1"
  local tag="$2"
  local expected_id="$3"
  local observed_id
  observed_id="$(
    _qcsd_docker_api --context "${build_docker_context}" image inspect \
      --format '{{.Id}}' "${tag}"
  )"
  if [[ "${observed_id}" != "${expected_id}" ]]; then
    echo "qcsd-lab ${target} image tag no longer binds its build-produced ID" >&2
    return 1
  fi
}

reject_docker_endpoint_overrides() {
  local variable
  for variable in DOCKER_HOST DOCKER_CONTEXT DOCKER_CONFIG DOCKER_TLS_VERIFY \
                  DOCKER_CERT_PATH DOCKER_DEFAULT_PLATFORM BUILDX_BUILDER \
                  BUILDX_CONFIG BUILDKIT_HOST DOCKER_BUILDKIT; do
    if [[ -n "${!variable:-}" ]]; then
      echo "qcsd-lab evidence build rejects Docker endpoint/builder override ${variable}" >&2
      return 1
    fi
  done
}

validate_local_docker_build_endpoint() {
  local current_context current_endpoint current_server_name
  local current_server_operating_system current_server_os_type
  local current_server_architecture current_server_id current_identity
  local current_server_json
  local -a current_server_fields
  current_context="$(_qcsd_docker_api context show)"
  if [[ "${current_context}" != "default" &&
        "${current_context}" != "desktop-linux" ]]; then
    echo "qcsd-lab evidence build requires the default local Docker context" >&2
    return 1
  fi
  current_endpoint="$(
    _qcsd_docker_api context inspect --format '{{.Endpoints.docker.Host}}' \
      "${current_context}"
  )"
  if [[ "${current_endpoint}" != "unix:///var/run/docker.sock" &&
        "${current_endpoint}" != "npipe:////./pipe/dockerDesktopLinuxEngine" ]]; then
    echo "qcsd-lab evidence build requires a local Docker Desktop endpoint" >&2
    return 1
  fi
  current_server_json="$(
    _qcsd_docker_api --context "${current_context}" info --format '{{json .}}'
  )"
  if ! mapfile -t current_server_fields < <(
    printf '%s\n' "${current_server_json}" | python3 -I -c '
import json, sys
value = json.load(sys.stdin)
for key in ("Name", "OperatingSystem", "OSType", "Architecture", "ID"):
    item = value.get(key)
    if not isinstance(item, str) or not item:
        raise SystemExit(1)
    print(item)
'
  ) || (( ${#current_server_fields[@]} != 5 )); then
    echo "qcsd-lab evidence build received invalid local Docker server identity" >&2
    return 1
  fi
  current_server_name="${current_server_fields[0]}"
  current_server_operating_system="${current_server_fields[1]}"
  current_server_os_type="${current_server_fields[2]}"
  current_server_architecture="${current_server_fields[3]}"
  current_server_id="${current_server_fields[4]}"
  if [[ -z "${current_server_name}" ||
        -z "${current_server_operating_system}" ||
        "${current_server_os_type}" != "linux" ||
        -z "${current_server_architecture}" ||
        -z "${current_server_id}" ]]; then
    echo "qcsd-lab evidence build received invalid local Docker server identity" >&2
    return 1
  fi
  if (( build_host_storage_applicable )) &&
     [[ "${current_server_operating_system,,}" != *docker\ desktop* ]]; then
    echo "qcsd-lab WSL evidence build requires the local Docker Desktop Linux engine" >&2
    return 1
  fi
  current_identity="${current_context}"$'\t'"${current_endpoint}"$'\t'\
"${current_server_name}"$'\t'"${current_server_operating_system}"$'\t'\
"${current_server_os_type}"$'\t'"${current_server_architecture}"$'\t'\
"${current_server_id}"
  if [[ -n "${build_docker_identity}" &&
        "${current_identity}" != "${build_docker_identity}" ]]; then
    echo "qcsd-lab evidence build Docker daemon identity changed between build boundaries" >&2
    return 1
  fi
  build_docker_identity="${current_identity}"
  build_docker_context="${current_context}"
  build_docker_endpoint="${current_endpoint}"
  build_docker_server_name="${current_server_name}"
  build_docker_server_operating_system="${current_server_operating_system}"
  build_docker_server_os_type="${current_server_os_type}"
  build_docker_server_architecture="${current_server_architecture}"
  build_docker_server_id="${current_server_id}"
  build_docker_lock_identity="${current_server_id}"$'\t'\
"${current_server_os_type}"$'\t'"${current_server_architecture}"
}

wsl_host_build_storage_init() {
  build_host_storage_applicable=0
  build_host_storage_platform="other-host"
  build_host_storage_policy="docker-data-vhdx-backing-volume-minimum-v1"
  build_host_storage_required_bytes="${WSL_HOST_BUILD_MIN_AVAILABLE_BYTES}"
  build_host_storage_identity=""
  build_host_storage_observations=()
  build_docker_identity=""
  build_docker_lock_identity=""
  build_host_wsl_interop_env_present=0
  build_host_wsl_distro_name_env_present=0
  build_host_run_wsl_directory_present=0
  if ! build_host_kernel_release="$(uname -r)" ||
     [[ -z "${build_host_kernel_release}" ]]; then
    echo "qcsd-lab build cannot establish the host kernel release" >&2
    return 1
  fi
  if ! build_host_proc_version="$(< /proc/version)" ||
     [[ -z "${build_host_proc_version}" ]]; then
    echo "qcsd-lab build cannot establish the host kernel version evidence" >&2
    return 1
  fi
  if [[ -n "${WSL_INTEROP:-}" ]]; then
    build_host_wsl_interop_env_present=1
  fi
  if [[ -n "${WSL_DISTRO_NAME:-}" ]]; then
    build_host_wsl_distro_name_env_present=1
  fi
  if [[ -d /run/WSL ]]; then
    build_host_run_wsl_directory_present=1
  fi
  if [[ "${build_host_kernel_release,,}" == *microsoft* ||
        "${build_host_proc_version,,}" == *microsoft* ]] ||
     (( build_host_wsl_interop_env_present ||
        build_host_wsl_distro_name_env_present ||
        build_host_run_wsl_directory_present )); then
    build_host_storage_applicable=1
    build_host_storage_platform="windows-wsl2"
  fi
}

wsl_host_build_storage_probe() {
  local boundary="${1}"
  if (( ! build_host_storage_applicable )); then
    return 0
  fi
  command -v powershell.exe >/dev/null 2>&1 || {
    echo "qcsd-lab build cannot verify the Docker data VHDX backing volume: powershell.exe is unavailable" >&2
    return 1
  }
  command -v wslpath >/dev/null 2>&1 || {
    echo "qcsd-lab build cannot verify the Docker data VHDX backing volume: wslpath is unavailable" >&2
    return 1
  }

  local probe_script probe_script_windows raw validated
  local data_vhd_path backing_volume_unique_id available_bytes identity
  probe_script="${ROOT}/tools/windows_docker_storage_probe.ps1"
  if [[ -L "${probe_script}" || ! -f "${probe_script}" ]]; then
    echo "qcsd-lab build cannot verify the Docker data VHDX backing volume: the source-controlled probe is unavailable" >&2
    return 1
  fi
  if ! probe_script_windows="$(wslpath -w -- "${probe_script}")" ||
     [[ -z "${probe_script_windows}" ]]; then
    echo "qcsd-lab build cannot map the Docker data VHDX probe into Windows" >&2
    return 1
  fi
  if ! raw="$(
    powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass \
      -File "${probe_script_windows}" -Boundary "${boundary}"
  )"; then
    echo "qcsd-lab build cannot establish exactly one healthy Docker data VHDX backing volume at ${boundary}; WSL logical free space is not accepted" >&2
    return 1
  fi

  if ! validated="$(
    printf '%s\n' "${raw}" | python3 -I \
      "${ROOT}/src/qcsd_lab/build_storage.py" observation --boundary "${boundary}" \
      --probe-path "${probe_script}"
  )"; then
    return 1
  fi
  local -a build_host_storage_fields
  mapfile -t build_host_storage_fields <<< "${validated}"
  if (( ${#build_host_storage_fields[@]} != 5 )); then
    echo "qcsd-lab build host-storage probe returned malformed validated evidence" >&2
    return 1
  fi
  data_vhd_path="${build_host_storage_fields[1]}"
  backing_volume_unique_id="${build_host_storage_fields[2]}"
  available_bytes="${build_host_storage_fields[3]}"
  identity="${build_host_storage_fields[4]}"
  if [[ -n "${build_host_storage_identity}" &&
        "${identity}" != "${build_host_storage_identity}" ]]; then
    echo "qcsd-lab build Docker data VHDX backing-volume identity changed at ${boundary}; refusing an evidentiary receipt" >&2
    return 1
  fi
  build_host_storage_identity="${identity}"
  build_host_storage_observations+=("${build_host_storage_fields[0]}")
  echo "WSL Docker backing-storage check passed at ${boundary}: ${available_bytes} available bytes" >&2
}

# Parse a build request and enforce its create-only destination before any
# host-capacity or Docker probe.  A responsive daemon and large WSL ext4 free
# count do not prove that the Windows volume backing Docker's VHDX can safely
# export a new image.
if [[ "${1:-}" == "build" ]]; then
  build_transaction_root=""
  build_cohort_version=1
  if (( $# == 3 )) && [[ "${2:-}" == "--cohort-version" ]]; then
    build_cohort_version="${3}"
  elif (( $# == 2 )) && [[ "${2:-}" == --cohort-version=* ]]; then
    build_cohort_version="${2#--cohort-version=}"
  elif (( $# != 1 )); then
    echo "build accepts only one optional --cohort-version N" >&2
    exit 2
  fi
  if [[ ! "${build_cohort_version}" =~ ^[1-9][0-9]*$ ]]; then
    echo "build cohort version must be a positive integer" >&2
    exit 2
  fi
  reject_evidence_build_image_overrides
  build_receipt="${ROOT}/artifacts/buflo-study/build-execution-v${build_cohort_version}.json"
  build_receipt_parent="$(dirname "${build_receipt}")"
  if [[ -L "${build_receipt_parent}" || -L "${build_receipt}" ]]; then
    echo "build receipt parent/destination cannot be a symlink" >&2
    exit 1
  fi
  reject_docker_endpoint_overrides
  require_docker
  mkdir -p "${build_receipt_parent}"
  build_receipt_parent="$(realpath "${build_receipt_parent}")"
  build_receipt="${build_receipt_parent}/$(basename "${build_receipt}")"
  build_receipt_parent_identity="$(stat -Lc '%d:%i:%u:%a:%F' -- \
    "${build_receipt_parent}")" || exit 1
  if [[ -e "${build_receipt}" ]]; then
    echo "build requires an absent create-only receipt: ${build_receipt}" >&2
    exit 1
  fi
  require_submodule
  wsl_host_build_storage_init
  wsl_host_build_storage_probe "before-collection"
  validate_local_docker_build_endpoint
  acquire_evidence_build_lock
  if [[ -L "${build_receipt_parent}" || -L "${build_receipt}" ||
        "$(stat -Lc '%d:%i:%u:%a:%F' -- "${build_receipt_parent}" 2>/dev/null)" != \
          "${build_receipt_parent_identity}" || -e "${build_receipt}" ]]; then
    echo "build lost its create-only receipt destination while waiting for lifecycle/build admission" >&2
    exit 1
  fi
  # The build supervisor binds its durable taint to its physical working
  # directory. Canonicalise that directory before both the taint scan and every
  # Docker build so invocation from another caller directory cannot bypass the
  # next-build interlock.
  cd "${ROOT}"
  _qcsd_verify_clean_build_checkout || {
    echo "build requires an exact clean raw-byte Lab/Neqo checkout" >&2
    exit 1
  }
  reject_unresolved_evidence_build
  _QCSD_DOCKER_BUILD_DAEMON_ID="${build_docker_server_id}"
  _QCSD_DOCKER_BUILD_LOCK_FD="${build_host_lock_fd}"
elif [[ "${1:-}" == "lifecycle-recover" ]]; then
  # Deliberately stop after guarded daemon/boot admission and durable-ledger
  # reconciliation. This action never selects an image, creates a campaign
  # object, or enters any build/capture path.
  require_docker
  echo "qcsd-lab Docker lifecycle reconciliation completed" >&2
  exit 0
elif [[ "${1:-}" != "class-study" && "${1:-}" != "etf-probe" ]]; then
  require_docker
  require_submodule
fi

# This host-side command deliberately creates only a disposable Docker veth
# topology and a non-evidentiary capability receipt. It remains outside the
# campaign container and immutable BuFLO-study state. The guarded shell owns
# every Docker mutation; Python validates inputs and finalises the receipt.
if [[ "${1:-}" == "etf-probe" ]]; then
  require_docker
  etf_probe_python="/usr/bin/python3"
  [[ -x "${etf_probe_python}" ]] || {
    echo "etf-probe requires python3 on the host" >&2
    exit 1
  }

  etf_probe_scratch="$(mktemp -d --tmpdir=/tmp qcsd-etf-probe.XXXXXXXX)"
  etf_probe_output="${etf_probe_scratch}/output"
  mkdir -- "${etf_probe_output}"
  chmod 0777 -- "${etf_probe_output}"
  etf_probe_request="${etf_probe_scratch}/request.json"
  etf_probe_version="${etf_probe_scratch}/docker-version.json"
  etf_probe_info="${etf_probe_scratch}/docker-info.json"
  etf_probe_image="${etf_probe_scratch}/docker-image.json"
  etf_probe_state="${etf_probe_scratch}/lifecycle.state"
  etf_probe_request_ready=0
  etf_probe_stage="request-validation"
  etf_probe_network_name="unavailable"
  etf_probe_receiver_name="unavailable"
  etf_probe_sender_name="unavailable"
  etf_probe_network_id="unavailable"
  etf_probe_receiver_id="unavailable"
  etf_probe_receiver_cpu="unavailable"
  etf_probe_main_cpu="unavailable"
  etf_probe_helper_cpu="unavailable"
  etf_probe_sender_exit="unavailable"
  etf_probe_receiver_exit="unavailable"
  etf_probe_receiver_presence_before="not-created"
  etf_probe_receiver_remove_status="not-attempted"
  etf_probe_receiver_presence_after="not-created"
  etf_probe_receiver_handoff_retired=0
  etf_probe_network_presence_before="not-created"
  etf_probe_network_remove_status="not-attempted"
  etf_probe_network_presence_after="not-created"
  etf_probe_network_handoff_retired=0
  QCSD_DOCKER_IDS_ETF_RECEIVERS=()
  QCSD_DOCKER_IDS_ETF_NETWORKS=()

  cleanup_etf_probe() {
    local cleanup_entry_status="$1"
    local cleanup_signal_status=0 cleanup_complete=0
    local cleanup_failure_status=0 cleanup_status=0
    local etf_probe_finalizer_status=0 etf_probe_state_staged=""
    # Publish latch-only mode in one builtin before removing the EXIT trap.
    (( cleanup_signal_status = _QCSD_LIFETIME_SIGNAL_STATUS,
       cleanup_complete = 0,
       cleanup_failure_status = 0,
       _QCSD_LIFETIME_CLEANUP_ACTIVE = 1 ))
    trap - EXIT

    if (( ${#QCSD_DOCKER_IDS_ETF_RECEIVERS[@]} > 0 )); then
      etf_probe_receiver_id="${QCSD_DOCKER_IDS_ETF_RECEIVERS[-1]}"
      etf_probe_receiver_presence_before="$(_qcsd_docker_exact_id_presence \
        "${etf_probe_receiver_id}")"
      if [[ "${etf_probe_receiver_presence_before}" == "present" ]]; then
        if _qcsd_docker_api rm --force \
            "${etf_probe_receiver_id}" >/dev/null 2>&1; then
          etf_probe_receiver_remove_status=0
        else
          etf_probe_receiver_remove_status=$?
          cleanup_status=1
        fi
      else
        echo "ETF receiver disappeared before teardown (${etf_probe_receiver_presence_before})" >&2
        cleanup_status=1
      fi
      etf_probe_receiver_presence_after="$(_qcsd_docker_exact_id_presence \
        "${etf_probe_receiver_id}")"
      if [[ "${etf_probe_receiver_presence_after}" != "absent" ]]; then
        echo "ETF receiver teardown state is ${etf_probe_receiver_presence_after}" >&2
        cleanup_status=1
      elif qcsd_retire_docker_handoff run \
          "${etf_probe_receiver_id}" QCSD_DOCKER_IDS_ETF_RECEIVERS; then
        etf_probe_receiver_handoff_retired=1
      else
        echo "ETF receiver handoff retirement failed" >&2
        cleanup_status=1
      fi
    fi

    if (( ${#QCSD_DOCKER_IDS_ETF_NETWORKS[@]} > 0 )); then
      etf_probe_network_id="${QCSD_DOCKER_IDS_ETF_NETWORKS[-1]}"
      etf_probe_network_presence_before="$(_qcsd_docker_exact_network_presence \
        "${etf_probe_network_id}")"
      if [[ "${etf_probe_network_presence_before}" == "present" ]]; then
        if _qcsd_docker_api network rm \
            "${etf_probe_network_id}" >/dev/null 2>&1; then
          etf_probe_network_remove_status=0
        else
          etf_probe_network_remove_status=$?
          cleanup_status=1
        fi
      else
        echo "ETF network disappeared before teardown (${etf_probe_network_presence_before})" >&2
        cleanup_status=1
      fi
      etf_probe_network_presence_after="$(_qcsd_docker_exact_network_presence \
        "${etf_probe_network_id}")"
      if [[ "${etf_probe_network_presence_after}" != "absent" ]]; then
        echo "ETF network teardown state is ${etf_probe_network_presence_after}" >&2
        cleanup_status=1
      elif qcsd_retire_docker_handoff network \
          "${etf_probe_network_id}" QCSD_DOCKER_IDS_ETF_NETWORKS; then
        etf_probe_network_handoff_retired=1
      else
        echo "ETF network handoff retirement failed" >&2
        cleanup_status=1
      fi
    fi

    if (( etf_probe_request_ready != 0 )); then
      etf_probe_state_staged="${etf_probe_state}.next"
      if ! {
        printf 'network_name=%s\n' "${etf_probe_network_name}"
        printf 'receiver_name=%s\n' "${etf_probe_receiver_name}"
        printf 'sender_name=%s\n' "${etf_probe_sender_name}"
        printf 'network_id=%s\n' "${etf_probe_network_id}"
        printf 'receiver_id=%s\n' "${etf_probe_receiver_id}"
        printf 'receiver_cpu=%s\n' "${etf_probe_receiver_cpu}"
        printf 'main_cpu=%s\n' "${etf_probe_main_cpu}"
        printf 'helper_cpu=%s\n' "${etf_probe_helper_cpu}"
        printf 'sender_exit_code=%s\n' "${etf_probe_sender_exit}"
        printf 'receiver_exit_code=%s\n' "${etf_probe_receiver_exit}"
        printf 'launcher_exit_code=%s\n' "${cleanup_entry_status}"
        printf 'signal_status=%s\n' "${_QCSD_LIFETIME_SIGNAL_STATUS}"
        printf 'stage=%s\n' "${etf_probe_stage}"
        printf 'receiver_presence_before=%s\n' \
          "${etf_probe_receiver_presence_before}"
        printf 'receiver_remove_status=%s\n' \
          "${etf_probe_receiver_remove_status}"
        printf 'receiver_presence_after=%s\n' \
          "${etf_probe_receiver_presence_after}"
        printf 'receiver_handoff_retired=%s\n' \
          "${etf_probe_receiver_handoff_retired}"
        printf 'network_presence_before=%s\n' \
          "${etf_probe_network_presence_before}"
        printf 'network_remove_status=%s\n' \
          "${etf_probe_network_remove_status}"
        printf 'network_presence_after=%s\n' \
          "${etf_probe_network_presence_after}"
        printf 'network_handoff_retired=%s\n' \
          "${etf_probe_network_handoff_retired}"
        if (( cleanup_status == 0 )); then
          printf 'cleanup_passed=1\n'
        else
          printf 'cleanup_passed=0\n'
        fi
      } >"${etf_probe_state_staged}" ||
         ! chmod 0600 -- "${etf_probe_state_staged}" ||
         ! sync -f "${etf_probe_state_staged}" ||
         ! mv -f -- "${etf_probe_state_staged}" "${etf_probe_state}" ||
         ! sync -f "${etf_probe_scratch}"; then
        echo "cannot publish the ETF supervised lifecycle bundle" >&2
        cleanup_status=1
        etf_probe_finalizer_status=1
      elif QCSD_ETF_PROBE_LAB_ROOT="${ROOT}" "${etf_probe_python}" -I -c '
import json
import os
import sys
from pathlib import Path

lab_root = Path(os.environ["QCSD_ETF_PROBE_LAB_ROOT"]).resolve()
os.environ["QCSD_LAB_ROOT"] = str(lab_root)
sys.path.insert(0, str(lab_root / "src"))
from qcsd_lab.etf_probe import finalize_supervised_bundle

path, digest, passed = finalize_supervised_bundle(Path(sys.argv[1]), Path(sys.argv[2]))
print(json.dumps({"passed": passed, "path": str(path), "sha256": digest}, sort_keys=True))
raise SystemExit(0 if passed else 10)
' "${etf_probe_request}" "${etf_probe_scratch}"; then
        etf_probe_finalizer_status=0
      else
        etf_probe_finalizer_status=$?
        cleanup_status=1
      fi
    fi

    if (( etf_probe_request_ready == 0 ||
          etf_probe_finalizer_status == 0 ||
          etf_probe_finalizer_status == 10 )); then
      if ! rm -f -- \
          "${etf_probe_output}/receiver.ready" \
          "${etf_probe_output}/receiver.json" \
          "${etf_probe_output}/sender.json" \
          "${etf_probe_request}" "${etf_probe_version}" \
          "${etf_probe_info}" "${etf_probe_image}" \
          "${etf_probe_state}" "${etf_probe_state}.next"; then
        echo "cannot remove known ETF probe scratch files" >&2
        cleanup_status=1
      fi
      if ! rmdir -- "${etf_probe_output}" "${etf_probe_scratch}"; then
        echo "ETF probe scratch root contains unexpected state: ${etf_probe_scratch}" >&2
        cleanup_status=1
      fi
    else
      echo "ETF probe finalisation failed; preserving ${etf_probe_scratch}" >&2
    fi

    (( cleanup_status == 0 )) || cleanup_failure_status=1
    cleanup_complete=1
    if (( cleanup_entry_status != 0 )); then
      exit "${cleanup_entry_status}"
    elif (( _QCSD_LIFETIME_SIGNAL_STATUS != 0 )); then
      exit "${_QCSD_LIFETIME_SIGNAL_STATUS}"
    else
      exit "${cleanup_failure_status}"
    fi
  }
  trap 'cleanup_etf_probe "$?"' EXIT

  if QCSD_ETF_PROBE_LAB_ROOT="${ROOT}" "${etf_probe_python}" -I -c '
import os
import sys
from pathlib import Path

lab_root = Path(os.environ["QCSD_ETF_PROBE_LAB_ROOT"]).resolve()
os.environ["QCSD_LAB_ROOT"] = str(lab_root)
sys.path.insert(0, str(lab_root / "src"))
from qcsd_lab.etf_probe import prepare_supervised_request

prepare_supervised_request(Path(sys.argv[1]), sys.argv[2:])
' "${etf_probe_request}" "${@:2}"; then
    if [[ -L "${etf_probe_request}" || ! -f "${etf_probe_request}" ]]; then
      echo "ETF probe request validation returned without a regular request" >&2
      exit 1
    fi
    etf_probe_request_ready=1
  else
    exit $?
  fi

  etf_probe_stage="docker-provenance"
  _qcsd_docker_api version --format '{{json .}}' >"${etf_probe_version}"
  _qcsd_docker_api info --format '{{json .}}' >"${etf_probe_info}"
  etf_probe_requested_image="$(QCSD_ETF_PROBE_LAB_ROOT="${ROOT}" \
    "${etf_probe_python}" -I -c '
