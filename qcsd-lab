    type(version) is not int or version < 1
    or not isinstance(binding, dict) or set(binding) != {"path", "sha256"}
    or binding.get("path") != f"/lab/artifacts/buflo-study/build-execution-v{version}.json"
    or re.fullmatch(r"[0-9a-f]{64}", str(binding.get("sha256"))) is None
    or not isinstance(identity, dict)
