    len(ids) != 5
    or len(set(ids)) != 5
    or any(re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", item) is None for item in ids)
):
    raise SystemExit("qualify-response-chaff workload cohort is invalid")
if mode == "legacy":
    if set_name:
        raise SystemExit("legacy qualify-response-chaff must not carry a set name")
    target = "v2"
    candidate_pattern = r"[.]v2[.]qcsd-batch-[A-Za-z0-9_-]+"
elif mode == "set":
    if re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", set_name) is None:
        raise SystemExit("qualify-response-chaff set slug is invalid")
    target = f"sets/{set_name}"
    candidate_pattern = rf"sets/[.]{re.escape(set_name)}[.]qcsd-batch-[A-Za-z0-9_-]+"
else:
    raise SystemExit("qualify-response-chaff publication mode is invalid")
if any(after.get(path) != record for path, record in before.items()):
    raise SystemExit("qualify-response-chaff changed pre-existing qualification evidence")
added = set(after) - set(before)
if status == 0:
    expected = {target: "directory"}
    expected.update({f"{target}/{workload}.json": "file" for workload in ids})
    if added != set(expected):
        raise SystemExit(
            "qualify-response-chaff changed files outside the exact schema-two cohort"
        )
    if any(after[path].get("type") != kind for path, kind in expected.items()):
        raise SystemExit("qualify-response-chaff schema-two output type is invalid")
else:
    if not added:
        raise SystemExit(0)
    root_depth = 1 if mode == "legacy" else 2
    roots = {"/".join(path.split("/")[:root_depth]) for path in added}
    if len(roots) != 1:
        raise SystemExit(
            "failed qualify-response-chaff created more than one diagnostic candidate"
        )
    root = roots.pop()
    if not re.fullmatch(candidate_pattern, root):
        raise SystemExit(
            "failed qualify-response-chaff changed files outside one hidden candidate"
        )
    if after.get(root, {}).get("type") != "directory":
        raise SystemExit("failed qualify-response-chaff candidate is not a directory")
' "$1" "$2" "$3" "$4" "$5" "${@:6}"
}

