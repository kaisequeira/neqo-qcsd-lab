if any(after.get(path) != record for path, record in before.items()):
    raise SystemExit("derive-chaff-prefix-specs changed a pre-existing config input")
added = set(after) - set(before)
if status != 0 and added:
    raise SystemExit("failed derive-chaff-prefix-specs changed the config tree")
if status == 0 and added != set(expected):
    raise SystemExit("derive-chaff-prefix-specs changed files outside the exact-six output")
