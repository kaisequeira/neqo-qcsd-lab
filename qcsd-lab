if ":" in observer_ip:
    raise SystemExit("kernel-TX observer must use the controlled IPv4 router address")
value = {
    "schema_version": 1,
    "artifact_type": "qcsd-kernel-tx-controlled-observer-binding",
    "topology_kind": "shared-two-network-router",
