#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COLLECTION_IMAGE="${QCSD_LAB_COLLECTION_IMAGE:-neqo-qcsd-lab-collection:local}"
PREPARE_IMAGE="${QCSD_LAB_PREPARE_IMAGE:-neqo-qcsd-lab-prepare:local}"
REFERENCE_IMAGE="${QCSD_LAB_REFERENCE_IMAGE:-neqo-qcsd-lab-reference:local}"

usage() {
  echo "Usage: qcsd-lab {build|prepare|derive-chaff-prefix-specs|qualify-chaff|qualify-response-chaff|run|resume|verify|analyze|fit|buflo-study|test} [arguments...]" >&2
}

require_submodule() {
  if [[ ! -f "${ROOT}/neqo-qcsd/Cargo.lock" ]]; then
    echo "Missing Neqo submodule; run: git submodule update --init --recursive" >&2
    exit 1
  fi
}

command -v docker >/dev/null 2>&1 || {
  echo "qcsd-lab requires Docker on the host" >&2
  exit 1
}
if ! docker info >/dev/null 2>&1; then
  echo "Docker is installed but its daemon is unavailable" >&2
  exit 1
fi

require_submodule

if [[ "${1:-}" == "build" ]]; then
  build_cohort_version=1
  if (( $# == 3 )) && [[ "${2:-}" == "--cohort-version" ]]; then
    build_cohort_version="${3}"
  elif (( $# == 2 )) && [[ "${2:-}" == --cohort-version=* ]]; then
    build_cohort_version="${2#--cohort-version=}"
  elif (( $# != 1 )); then
    echo "build accepts only one optional --cohort-version N" >&2
    exit 2
  fi
  if [[ ! "${build_cohort_version}" =~ ^[1-9][0-9]*$ ]]; then
    echo "build cohort version must be a positive integer" >&2
    exit 2
  fi
  build_receipt="${ROOT}/artifacts/buflo-study/build-execution-v${build_cohort_version}.json"
  build_receipt_parent="$(dirname "${build_receipt}")"
  if [[ -L "${build_receipt_parent}" || -L "${build_receipt}" ]]; then
    echo "build receipt parent/destination cannot be a symlink" >&2
    exit 1
  fi
  mkdir -p "${build_receipt_parent}"
  build_receipt_parent="$(realpath "${build_receipt_parent}")"
  build_receipt="${build_receipt_parent}/$(basename "${build_receipt}")"
  if [[ -e "${build_receipt}" ]]; then
    echo "build requires an absent create-only receipt: ${build_receipt}" >&2
    exit 1
  fi
  build_started_unix_ns="$(date +%s%N)"
  docker build --pull --no-cache --target collection \
    --tag "${COLLECTION_IMAGE}" --file "${ROOT}/Dockerfile" "${ROOT}"
  docker build --pull --no-cache --target prepare \
    --tag "${PREPARE_IMAGE}" --file "${ROOT}/Dockerfile" "${ROOT}"
  docker build --pull --no-cache --target reference \
    --tag "${REFERENCE_IMAGE}" --file "${ROOT}/Dockerfile" "${ROOT}"
  build_finished_unix_ns="$(date +%s%N)"
  collection_id="$(docker image inspect --format '{{.Id}}' "${COLLECTION_IMAGE}")"
  prepare_id="$(docker image inspect --format '{{.Id}}' "${PREPARE_IMAGE}")"
  reference_id="$(docker image inspect --format '{{.Id}}' "${REFERENCE_IMAGE}")"
  build_source="$(
    docker run --rm --entrypoint /bin/cat \
      "${collection_id}" /usr/share/qcsd-lab/source.json
  )"
  build_inputs="$(
    docker run --rm --entrypoint /bin/cat \
      "${collection_id}" /usr/share/qcsd-lab/study-build-inputs.json
  )"
  build_docker_version="$(docker version --format '{{json .}}')"
  COLLECTION_ID="${collection_id}" \
  COLLECTION_REPO_DIGESTS="$(docker image inspect --format '{{json .RepoDigests}}' "${collection_id}")" \
  PREPARE_ID="${prepare_id}" \
  PREPARE_REPO_DIGESTS="$(docker image inspect --format '{{json .RepoDigests}}' "${prepare_id}")" \
  REFERENCE_ID="${reference_id}" \
  REFERENCE_REPO_DIGESTS="$(docker image inspect --format '{{json .RepoDigests}}' "${reference_id}")" \
  BUILD_SOURCE="${build_source}" \
  BUILD_INPUTS="${build_inputs}" \
  BUILD_DOCKER_VERSION="${build_docker_version}" \
  BUILD_STARTED_UNIX_NS="${build_started_unix_ns}" \
  BUILD_FINISHED_UNIX_NS="${build_finished_unix_ns}" \
  BUILD_RECEIPT="${build_receipt}" \
  BUILD_COHORT_VERSION="${build_cohort_version}" \
  BUILD_ROOT="${ROOT}" \
  COLLECTION_TAG="${COLLECTION_IMAGE}" \
  PREPARE_TAG="${PREPARE_IMAGE}" \
  REFERENCE_TAG="${REFERENCE_IMAGE}" \
  python3 - <<'PY'
import datetime
import hashlib
import json
import os
from pathlib import Path

root = Path(os.environ["BUILD_ROOT"]).resolve()
destination = Path(os.environ["BUILD_RECEIPT"])
started_ns = int(os.environ["BUILD_STARTED_UNIX_NS"])
finished_ns = int(os.environ["BUILD_FINISHED_UNIX_NS"])
version = json.loads(os.environ["BUILD_DOCKER_VERSION"])
source = json.loads(os.environ["BUILD_SOURCE"])
source["image_digest"] = os.environ["COLLECTION_ID"]
images = {
    "collection": {
        "tag": os.environ["COLLECTION_TAG"],
        "id": os.environ["COLLECTION_ID"],
        "repo_digests": json.loads(os.environ["COLLECTION_REPO_DIGESTS"]),
    },
    "prepare": {
        "tag": os.environ["PREPARE_TAG"],
        "id": os.environ["PREPARE_ID"],
        "repo_digests": json.loads(os.environ["PREPARE_REPO_DIGESTS"]),
    },
    "reference": {
        "tag": os.environ["REFERENCE_TAG"],
        "id": os.environ["REFERENCE_ID"],
        "repo_digests": json.loads(os.environ["REFERENCE_REPO_DIGESTS"]),
    },
}
commands = []
for target in ("collection", "prepare", "reference"):
    commands.append(
        {
            "target": target,
            "argv": [
                "docker", "build", "--pull", "--no-cache", "--target", target,
                "--tag", images[target]["tag"], "--file", str(root / "Dockerfile"),
                str(root),
            ],
            "exit_code": 0,
            "image_id": images[target]["id"],
        }
    )

def stamp(unix_ns):
    return datetime.datetime.fromtimestamp(
        unix_ns / 1_000_000_000, tz=datetime.timezone.utc
    ).isoformat()

value = {
    "schema_version": 1,
    "artifact_type": "qcsd-buflo-study-no-cache-build-execution",
    "cohort_version": int(os.environ["BUILD_COHORT_VERSION"]),
    "started_at": stamp(started_ns),
    "finished_at": stamp(finished_ns),
    "duration_seconds": (finished_ns - started_ns) / 1_000_000_000,
    "docker": {
        "client_version": version["Client"]["Version"],
        "server_version": version["Server"]["Version"],
    },
    "commands": commands,
    "images": images,
    "source": source,
    "build_inputs": json.loads(os.environ["BUILD_INPUTS"]),
    "dockerfile_sha256": hashlib.sha256((root / "Dockerfile").read_bytes()).hexdigest(),
    "cache_policy": {
        "pull": True,
        "no_cache": True,
        "scope": "Docker-layer-cache-disabled;declared-BuildKit-dependency-cache-mounts-only",
    },
}
payload = json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
value["payload_sha256"] = hashlib.sha256(payload).hexdigest()
encoded = (json.dumps(value, indent=2, sort_keys=True) + "\n").encode()
with destination.open("xb") as output:
    output.write(encoded)
    output.flush()
    os.fsync(output.fileno())
directory = os.open(destination.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
try:
    os.fsync(directory)
finally:
    os.close(directory)
PY
  echo "Created no-cache build receipt: ${build_receipt}"
  exit 0
fi

study_cohort_version=""
study_cohort_version_seen=0
study_campaign_name="${2##*/}"
study_capture_admission_host=""
study_capture_admission_container=""
study_admission_build_path=""
study_admission_build_sha256=""
study_admission_collection_image=""
study_resume_public=0
study_resume_root=""

if [[ "${1:-}" == "buflo-study" ]]; then
  study_cohort_version=1
  study_index=3
  while (( study_index <= $# )); do
    study_argument="${!study_index}"
    case "${study_argument}" in
      --cohort-version)
        if (( study_cohort_version_seen )); then
          echo "buflo-study accepts at most one --cohort-version value" >&2
          exit 2
        fi
        study_next=$((study_index + 1))
        if (( study_next > $# )); then
          echo "--cohort-version requires a value" >&2
          exit 2
        fi
        study_cohort_version="${!study_next}"
        study_cohort_version_seen=1
        study_index=$((study_index + 2))
        continue
        ;;
      --cohort-version=*)
        if (( study_cohort_version_seen )); then
          echo "buflo-study accepts at most one --cohort-version value" >&2
          exit 2
        fi
        study_cohort_version="${study_argument#--cohort-version=}"
        study_cohort_version_seen=1
        ;;
    esac
    study_index=$((study_index + 1))
  done
  if [[ ! "${study_cohort_version}" =~ ^[1-9][0-9]*$ ]]; then
    echo "buflo-study cohort version must be a positive integer" >&2
    exit 2
  fi
fi

read_capture_admission_binding() {
  local admission="$1"
  local -a fields=()
  mapfile -t fields < <(
    python3 -c '
import json, re, sys
from pathlib import Path
path = Path(sys.argv[1])
value = json.loads(path.read_text(encoding="utf-8"))
version = value.get("cohort_version")
binding = value.get("build_execution_receipt")
identity = value.get("build_execution")
if (
    type(version) is not int or version < 1
    or not isinstance(binding, dict) or set(binding) != {"path", "sha256"}
    or binding.get("path") != f"/lab/artifacts/buflo-study/build-execution-v{version}.json"
    or re.fullmatch(r"[0-9a-f]{64}", str(binding.get("sha256"))) is None
    or not isinstance(identity, dict)
    or identity.get("cohort_version") != version
    or identity.get("sha256") != binding.get("sha256")
    or re.fullmatch(r"sha256:[0-9a-f]{64}", str(identity.get("collection_image"))) is None
):
    raise SystemExit("capture admission has no valid versioned build binding")
print(version)
print(binding["path"])
print(binding["sha256"])
print(identity["collection_image"])
' "${admission}"
  )
  if (( ${#fields[@]} != 4 )); then
    echo "capture admission has no valid versioned build binding" >&2
    exit 1
  fi
  study_cohort_version="${fields[0]}"
  study_admission_build_path="${fields[1]}"
  study_admission_build_sha256="${fields[2]}"
  study_admission_collection_image="${fields[3]}"
}

if [[ "${1:-}" == "run" &&
      "${study_campaign_name}" =~ ^buflo-study-v1-(smoke|rehearsal|formal-[0-9]{2})\.yml$ ]]; then
  if [[ -z "${QCSD_BUFLO_CAPTURE_ADMISSION:-}" ]]; then
    echo "direct public BuFLO-study run requires QCSD_BUFLO_CAPTURE_ADMISSION" >&2
    exit 1
  fi
  study_capture_admission_host="$(realpath -e -- "${QCSD_BUFLO_CAPTURE_ADMISSION}")"
  if [[ -L "${QCSD_BUFLO_CAPTURE_ADMISSION}" ||
        ! -f "${study_capture_admission_host}" ||
        "${study_capture_admission_host}" != "${ROOT}/"* ]]; then
    echo "QCSD_BUFLO_CAPTURE_ADMISSION must be a regular file inside the Lab root" >&2
    exit 1
  fi
  study_capture_admission_container="/lab/${study_capture_admission_host#${ROOT}/}"
  read_capture_admission_binding "${study_capture_admission_host}"
fi

if [[ "${1:-}" == "resume" ]]; then
  study_resume_root="$(realpath -e -- "${2:-}")"
  if [[ -L "${2:-}" || ! -d "${study_resume_root}" ||
        "${study_resume_root}" != "${ROOT}/results/"* ]]; then
    echo "resume requires a non-symlink result root under results/" >&2
    exit 1
  fi
  study_resume_name="$(
    python3 -c 'import json,sys; print(json.load(open(sys.argv[1], encoding="utf-8"))["name"])' \
      "${study_resume_root}/experiment.json"
  )"
  if [[ "${study_resume_name}" =~ ^buflo-study-v1-(public-(smoke|rehearsal)|formal-[0-9]{2})-1200$ ]]; then
    study_resume_public=1
    study_capture_admission_host="${study_resume_root}/inputs/capture-admission.json"
    if [[ -L "${study_capture_admission_host}" ||
          ! -f "${study_capture_admission_host}" ]]; then
      echo "public BuFLO-study resume requires its frozen capture admission" >&2
      exit 1
    fi
    study_capture_admission_container="/lab/results/${study_capture_admission_host#${ROOT}/results/}"
    read_capture_admission_binding "${study_capture_admission_host}"
  fi
fi

study_build_execution_path=""
study_build_execution_sha256=""
if [[ -n "${study_cohort_version}" ]]; then
  study_build_execution_path="${ROOT}/artifacts/buflo-study/build-execution-v${study_cohort_version}.json"
  if [[ -L "${study_build_execution_path}" || ! -f "${study_build_execution_path}" ]]; then
    echo "BuFLO study cohort v${study_cohort_version} requires ${study_build_execution_path}" >&2
    exit 1
  fi
  mapfile -t study_build_fields < <(
    python3 -c '
import hashlib, json, re, sys
from pathlib import Path
path = Path(sys.argv[1])
expected = int(sys.argv[2])
raw = path.read_bytes()
value = json.loads(raw)
payload = dict(value)
claimed = payload.pop("payload_sha256", None)
actual = hashlib.sha256(
    json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
).hexdigest()
images = value.get("images")
source = value.get("source")
if (
    value.get("schema_version") != 1
    or value.get("artifact_type") != "qcsd-buflo-study-no-cache-build-execution"
    or value.get("cohort_version") != expected
    or claimed != actual
    or not isinstance(images, dict) or set(images) != {"collection", "prepare", "reference"}
    or not isinstance(source, dict)
):
    raise SystemExit("selected build receipt is invalid")
ids = []
for target in ("collection", "prepare", "reference"):
    record = images[target]
    image_id = record.get("id") if isinstance(record, dict) else None
    if re.fullmatch(r"sha256:[0-9a-f]{64}", str(image_id)) is None:
        raise SystemExit("selected build receipt image binding is invalid")
    ids.append(image_id)
if source.get("image_digest") != ids[0]:
    raise SystemExit("selected build source differs from its collection image")
print(hashlib.sha256(raw).hexdigest())
print(*ids, sep="\n")
' "${study_build_execution_path}" "${study_cohort_version}"
  )
  if (( ${#study_build_fields[@]} != 4 )); then
    echo "selected build receipt is invalid" >&2
    exit 1
  fi
  study_build_execution_sha256="${study_build_fields[0]}"
  COLLECTION_IMAGE="${study_build_fields[1]}"
  PREPARE_IMAGE="${study_build_fields[2]}"
  REFERENCE_IMAGE="${study_build_fields[3]}"
  if [[ -n "${study_admission_build_path}" ]] &&
     { [[ "${study_admission_build_path}" != "/lab/artifacts/buflo-study/build-execution-v${study_cohort_version}.json" ]] ||
       [[ "${study_admission_build_sha256}" != "${study_build_execution_sha256}" ]] ||
       [[ "${study_admission_collection_image}" != "${COLLECTION_IMAGE}" ]]; }; then
    echo "capture admission and selected cohort build receipt differ" >&2
    exit 1
  fi
fi

case "${1:-}" in
  prepare|derive-chaff-prefix-specs|qualify-chaff|qualify-response-chaff) image="${PREPARE_IMAGE}" ;;
  run|resume|verify|analyze|fit|buflo-study|test) image="${COLLECTION_IMAGE}" ;;
  *) usage; exit 2 ;;
esac
if [[ "${1:-}" == "buflo-study" && "${2:-}" == "reference" ]]; then
  image="${REFERENCE_IMAGE}"
fi

if ! docker image inspect "${image}" >/dev/null 2>&1; then
  echo "Missing image ${image}; run: ./qcsd-lab build" >&2
  exit 1
fi
if [[ "${1:-}" == "buflo-study" && "${2:-}" == "reference" ]]; then
  reference_build_receipt="${study_build_execution_path}"
  if [[ -L "${reference_build_receipt}" || ! -f "${reference_build_receipt}" ]]; then
    echo "buflo-study reference requires the create-only no-cache build receipt" >&2
    exit 1
  fi
fi

if [[ "${1:-}" == "buflo-study" && "${2:-}" == "qualify" &&
      "${QCSD_BUFLO_QUALIFY_VERIFY_ONLY:-0}" != "1" &&
      "${QCSD_BUFLO_QUALIFY_CONTROLLED_ONLY:-0}" != "1" ]]; then
  if ! docker image inspect "${PREPARE_IMAGE}" >/dev/null 2>&1; then
    echo "Missing image ${PREPARE_IMAGE}; run: ./qcsd-lab build" >&2
    exit 1
  fi
  qualification_expect=""
  qualification_controlled_results=0
  qualification_destinations=0
  qualification_cohort_version=1
  qualification_cohort_versions=0
  for argument in "${@:3}"; do
    if [[ -n "${qualification_expect}" ]]; then
      if [[ "${qualification_expect}" == "controlled-result" ]]; then
        qualification_controlled_results=$((qualification_controlled_results + 1))
      elif [[ "${qualification_expect}" == "cohort-version" ]]; then
        qualification_cohort_versions=$((qualification_cohort_versions + 1))
        if [[ ${qualification_cohort_versions} -ne 1 ]]; then
          echo "buflo-study qualify accepts at most one --cohort-version value" >&2
          exit 2
        fi
        if [[ ! "${argument}" =~ ^[1-9][0-9]*$ ]]; then
          echo "buflo-study qualify cohort version must be a positive integer" >&2
          exit 2
        fi
        qualification_cohort_version="${argument}"
      else
        qualification_destinations=$((qualification_destinations + 1))
      fi
      qualification_expect=""
      continue
    fi
    case "${argument}" in
      --controlled-result) qualification_expect="controlled-result" ;;
      --destination) qualification_expect="destination" ;;
      --cohort-version) qualification_expect="cohort-version" ;;
      --cohort-version=*)
        qualification_cohort_versions=$((qualification_cohort_versions + 1))
        if [[ ${qualification_cohort_versions} -ne 1 ]]; then
          echo "buflo-study qualify accepts at most one --cohort-version value" >&2
          exit 2
        fi
        qualification_cohort_version="${argument#--cohort-version=}"
        if [[ ! "${qualification_cohort_version}" =~ ^[1-9][0-9]*$ ]]; then
          echo "buflo-study qualify cohort version must be a positive integer" >&2
          exit 2
        fi
        ;;
      *)
        echo "buflo-study qualify accepts repeated --controlled-result, one --destination, and one --cohort-version" >&2
        exit 2
        ;;
    esac
  done
  if [[ -n "${qualification_expect}" || ${qualification_controlled_results} -eq 0 ||
        ${qualification_destinations} -ne 1 ]]; then
    echo "buflo-study qualify requires controlled roots and exactly one --destination" >&2
    exit 2
  fi
  QCSD_BUFLO_QUALIFY_CONTROLLED_ONLY=1 "${ROOT}/qcsd-lab" "$@"
  qualification_set="buflo-study-public5-v${qualification_cohort_version}"
  qualification_target="${ROOT}/config/chaff-response-qualification-store/sets/${qualification_set}"
  if [[ -L "${qualification_target}" ||
        ( -e "${qualification_target}" && ! -d "${qualification_target}" ) ]]; then
    echo "buflo-study qualify existing public5 evidence must be a non-symlink directory" >&2
    exit 1
  fi
  if [[ ! -e "${qualification_target}" ]]; then
    QCSD_LAB_PREPARE_IMAGE="${PREPARE_IMAGE}" \
    "${ROOT}/qcsd-lab" qualify-response-chaff \
      --set "${qualification_set}" \
      getbootstrap-home-r4 cloudflare-quiche-r4 hyper-basic-client-r3 \
      serde-home-r2 rfc9114-text-r2
  fi
  QCSD_BUFLO_QUALIFY_VERIFY_ONLY=1 "${ROOT}/qcsd-lab" "$@"
  exit $?
fi

reference_root=""
reference_destination=""
reference_cohort_inputs=""
reference_container_args=()
if [[ "${1:-}" == "buflo-study" && "${2:-}" == "reference" ]]; then
  index=3
  while (( index <= $# )); do
    argument="${!index}"
    case "${argument}" in
      --reference-root|--destination|--cohort-version)
        next=$((index + 1))
        if (( next > $# )); then
          echo "${argument} requires a value" >&2
          exit 2
        fi
        value="${!next}"
        if [[ "${argument}" == "--reference-root" ]]; then
          reference_root="${value}"
        elif [[ "${argument}" == "--destination" ]]; then
          reference_destination="${value}"
        fi
        index=$((index + 2))
        ;;
      --cohort-version=*)
        index=$((index + 1))
        ;;
      *)
        echo "isolated buflo-study reference accepts only --reference-root, --destination, and --cohort-version" >&2
        exit 2
        ;;
    esac
  done
  if [[ -z "${reference_root}" || -z "${reference_destination}" ]]; then
    echo "buflo-study reference requires --reference-root and --destination" >&2
    exit 2
  fi
  reference_root_input="${reference_root}"
  reference_parent_input="$(dirname "${reference_destination}")"
  if [[ -L "${reference_root_input}" || -L "${reference_parent_input}" ]]; then
    echo "reference input/output roots cannot be symlinks" >&2
    exit 1
  fi
  reference_root="$(realpath "${reference_root_input}")"
  reference_parent="$(realpath "${reference_parent_input}")"
  reference_name="$(basename "${reference_destination}")"
  reference_destination="${reference_parent}/${reference_name}"
  if [[ ! -d "${reference_root}" || -L "${reference_root}" ]]; then
    echo "reference root must be an existing non-symlink directory" >&2
    exit 1
  fi
  if [[ ! -d "${reference_parent}" || -L "${reference_parent}" ||
        -e "${reference_destination}" || -L "${reference_destination}" ||
        ! "${reference_name}" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "reference destination must be an absent safe child of an existing directory" >&2
    exit 1
  fi
  reference_cohort_inputs="${ROOT}/artifacts/buflo-study/cohort-inputs"
  if [[ -L "${ROOT}/artifacts" || -L "${ROOT}/artifacts/buflo-study" ||
        -L "${reference_cohort_inputs}" ]]; then
    echo "reference cohort-input artifact path cannot contain symlinks" >&2
    exit 1
  fi
  mkdir -p "${reference_cohort_inputs}"
  reference_cohort_inputs="$(realpath "${reference_cohort_inputs}")"
  reference_container_args=(
    buflo-study reference
    --reference-root /reference-input
    --destination "/reference-output/${reference_name}"
    --cohort-version "${study_cohort_version}"
  )
fi

if [[ "${1:-}" == "derive-chaff-prefix-specs" ||
      "${1:-}" == "qualify-chaff" ||
      "${1:-}" == "qualify-response-chaff" ||
      "${1:-}" == "fit" ]]; then
  guarded_root="${ROOT}/config"
  guarded_label="derive-chaff-prefix-specs config"
  if [[ "${1:-}" == "qualify-chaff" ]]; then
    guarded_label="qualify-chaff config"
  fi
  if [[ "${1:-}" == "qualify-response-chaff" ]]; then
    guarded_label="qualify-response-chaff config"
  fi
  if [[ "${1:-}" == "fit" ]]; then
    guarded_root="${ROOT}/artifacts"
    guarded_label="fit artifact"
  fi
  if [[ ! -d "${guarded_root}" || -L "${guarded_root}" ]]; then
    echo "${guarded_label} root must be an existing non-symlink directory" >&2
    exit 1
  fi
else
  mkdir -p "${ROOT}/results" "${ROOT}/artifacts" "${ROOT}/config/workloads"
fi
image_id="$(docker image inspect --format '{{.Id}}' "${image}")"
buflo_host_lock_fd=""
study_capture_scheduler_contract=""
if [[ ( "${1:-}" == "buflo-study" && "${2:-}" == "capture" ) ||
      ( "${1:-}" == "run" &&
        "${study_campaign_name}" =~ ^buflo-study-v1-(smoke|rehearsal|formal-[0-9]{2})\.yml$ ) ||
      "${study_resume_public}" == "1" ]]; then
  study_capture_scheduler_contract="qcsd-client-rr1-cpu10-v1"
  command -v flock >/dev/null 2>&1 || {
    echo "buflo-study capture requires flock on the host" >&2
    exit 1
  }
  buflo_lock_path="${ROOT}/results/.buflo-study-v1.capture.lock"
  if [[ -L "${buflo_lock_path}" ]]; then
    echo "buflo-study capture lock cannot be a symlink" >&2
    exit 1
  fi
  exec {buflo_host_lock_fd}>"${buflo_lock_path}"
  if ! flock -n "${buflo_host_lock_fd}"; then
