    _qcsd_verify_saved_build_cohort_claim "${boundary}" || return 1
    if ! observation="$(
      QCSD_COHORT_REPROOF_BOUNDARY="${boundary}" \
      QCSD_COHORT_REPROOF_AUTHORITY="${recheck}" \
      QCSD_COHORT_REPROOF_CLAIM="${build_cohort_claim_snapshot}" \
        /usr/bin/python3 -I - <<'PY'
import datetime
import hashlib
import json
import os
import re

