  if [[ "${study_resume_name}" =~ ^buflo-study-v1-(public-(smoke|rehearsal)|formal-[0-9]{2})-1200$ ]]; then
    study_resume_public=1
    study_capture_admission_host="${study_resume_root}/inputs/capture-admission.json"
    if [[ -L "${study_capture_admission_host}" ||
          ! -f "${study_capture_admission_host}" ]]; then
