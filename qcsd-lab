replace_container_option_value() {
  local option="$1"
  local value="$2"
  local index matches=0
  for (( index = 0; index + 1 < ${#container[@]}; index++ )); do
    if [[ "${container[index]}" == "${option}" ]]; then
      container[index + 1]="${value}"
      matches=$((matches + 1))
    fi
  done
  if (( matches != 1 )); then
    echo "public kernel-TX launcher expected one ${option} option, observed ${matches}" >&2
    return 1
  fi
}

replace_container_environment() {
  local name="$1"
  local value="$2"
  local index matches=0
  for (( index = 0; index < ${#container[@]}; index++ )); do
    if [[ "${container[index]}" == "${name}="* ]]; then
      container[index]="${name}=${value}"
      matches=$((matches + 1))
    fi
  done
  if (( matches != 1 )); then
    echo "public kernel-TX launcher expected one ${name} environment, observed ${matches}" >&2
    return 1
  fi
}

_qcsd_latch_cleanup_signal() {
  local received_status="$1"
  _qcsd_latch_lifetime_signal "${received_status}"
}

_qcsd_begin_latched_cleanup() {
  # Enter latch-only mode before removing the EXIT handler.  A terminal signal
  # delivered at either command boundary must continue through this teardown,
  # never re-enter it or escape through a momentarily unprotected EXIT path.
  _QCSD_LIFETIME_CLEANUP_ACTIVE=1
  trap - EXIT
  cleanup_signal_status="${_QCSD_LIFETIME_SIGNAL_STATUS}"
}

_qcsd_cleanup_terminal_hook() {
  # Test-only boundary override. Production intentionally does no work here.
  :
}

_qcsd_finish_latched_cleanup() {
  # The lifetime handler remains in latch-only mode through the final hook and
  # status selection. This closes the final check-to-exit window without
  # discarding a signal or allowing it to interrupt teardown.
  cleanup_complete=1
  _qcsd_cleanup_terminal_hook
  if (( cleanup_entry_status != 0 )); then
    exit "${cleanup_entry_status}"
  elif (( _QCSD_LIFETIME_SIGNAL_STATUS != 0 )); then
    exit "${_QCSD_LIFETIME_SIGNAL_STATUS}"
  else
    exit "${cleanup_failure_status}"
  fi
}

cleanup_kernel_tx_public_topology() {
  local cleanup_entry_status="$1"
  local cleanup_signal_status=0 cleanup_complete=0 cleanup_failure_status=0
  _qcsd_begin_latched_cleanup
  local cleanup_status=0
  local router_running=""
  local router_state=""
  local public_network_state=""
  if (( ${#QCSD_DOCKER_IDS_PUBLIC_ROUTERS[@]} > 0 )); then
    kernel_tx_public_router_id="${QCSD_DOCKER_IDS_PUBLIC_ROUTERS[-1]}"
    router_state="$(_qcsd_docker_exact_id_presence \
      "${kernel_tx_public_router_id}")"
