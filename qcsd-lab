prepare_kernel_tx_capture_root() {
  local capture_root="$1"
  local access_action="$2"
  local capture_root_metadata=""
  local capture_root_first_entry=""
  if [[ -L "${capture_root}" || ! -d "${capture_root}" ]]; then
    echo "kernel-TX capture root must be an existing non-symbolic-link directory" >&2
    return 1
  fi
  if [[ "${access_action}" == "initialize" ]]; then
    capture_root_metadata="$(stat -c '%u' -- "${capture_root}" 2>/dev/null)" ||
      capture_root_metadata=""
    if [[ "${capture_root_metadata}" != "${qcsd_invoking_uid}" ]]; then
      echo "kernel-TX capture root is not owned by the invoking user" >&2
      return 1
    fi
    if ! chgrp -- "${qcsd_invoking_gid}" "${capture_root}"; then
      echo "cannot assign the kernel-TX capture root group" >&2
      return 1
    fi
    if ! chmod 2770 -- "${capture_root}"; then
      echo "cannot set the kernel-TX capture root mode" >&2
      return 1
    fi
  elif [[ "${access_action}" != "verify" ]]; then
    echo "kernel-TX capture root access action is invalid" >&2
    return 1
  fi
  if [[ -L "${capture_root}" || ! -d "${capture_root}" ]]; then
    echo "kernel-TX capture root changed type during access validation" >&2
    return 1
  fi
  capture_root_metadata="$(
    stat -c '%u:%g:%a' -- "${capture_root}" 2>/dev/null
  )" || capture_root_metadata=""
  if [[ "${capture_root_metadata}" != \
        "${qcsd_invoking_uid}:${qcsd_invoking_gid}:2770" ]]; then
    echo "kernel-TX capture root access contract is invalid" >&2
    return 1
  fi
  if ! capture_root_first_entry="$(
    /usr/bin/find "${capture_root}" -mindepth 1 -print -quit
  )"; then
    echo "cannot inspect the kernel-TX capture root" >&2
    return 1
  fi
  if [[ -n "${capture_root_first_entry}" ]]; then
    echo "kernel-TX post-veth capture root contains stale evidence; audit it before resuming" >&2
    return 1
  fi
}

verify_kernel_tx_router_capture_access() {
  local router_id="$1"
  local group_add_json=""
  group_add_json="$(_qcsd_docker_api container inspect \
    --format '{{json .HostConfig.GroupAdd}}' "${router_id}")" || return 1
  if ! /usr/bin/python3 -I -c '
import json
import sys

expected = sys.argv[2]
try:
    observed = json.loads(sys.argv[1])
except json.JSONDecodeError as error:
    raise SystemExit("router GroupAdd metadata is not JSON") from error
if observed != [expected]:
    raise SystemExit(f"router GroupAdd differs: {observed!r} != {[expected]!r}")
' "${group_add_json}" "${qcsd_invoking_gid}"; then
    echo "kernel-TX router Docker group contract is invalid" >&2
    return 1
  fi
  if ! _qcsd_docker_api exec "${router_id}" /usr/bin/python3 -I -c '
import os
import stat
import sys
from pathlib import Path

expected_uid = int(sys.argv[1])
expected_gid = int(sys.argv[2])
status = {}
for line in Path("/proc/1/status").read_text(encoding="ascii").splitlines():
    name, separator, value = line.partition(":")
    if separator:
        status[name] = value.strip()
service_uids = [int(value) for value in status.get("Uid", "").split()]
service_groups = [int(value) for value in status.get("Groups", "").split()]
if len(service_uids) != 4 or any(value != 0 for value in service_uids):
    raise SystemExit(f"router service UID contract differs: {service_uids!r}")
if expected_gid not in service_groups:
    raise SystemExit(
        f"router service lacks capture GID {expected_gid}: {service_groups!r}"
    )
root = Path("/kernel-tx")
root_status = os.lstat(root)
if (
    not stat.S_ISDIR(root_status.st_mode)
    or root_status.st_uid != expected_uid
    or root_status.st_gid != expected_gid
    or stat.S_IMODE(root_status.st_mode) != 0o2770
):
    raise SystemExit(
        "router capture root metadata differs: "
        f"uid={root_status.st_uid} gid={root_status.st_gid} "
        f"mode={stat.S_IMODE(root_status.st_mode):04o}"
    )
probe = root / ".qcsd-router-access-probe"
fd = None
try:
    fd = os.open(
        probe,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
        0o600,
    )
    probe_status = os.fstat(fd)
    if (
        not stat.S_ISREG(probe_status.st_mode)
        or probe_status.st_uid != 0
        or probe_status.st_gid != expected_gid
    ):
        raise SystemExit(
            "router capture probe metadata differs: "
            f"uid={probe_status.st_uid} gid={probe_status.st_gid}"
        )
finally:
    if fd is not None:
        os.close(fd)
    try:
        os.unlink(probe)
    except FileNotFoundError:
        pass
if os.listdir(root):
    raise SystemExit("router capture root is not empty after its access probe")
' "${qcsd_invoking_uid}" "${qcsd_invoking_gid}"; then
    echo "kernel-TX router live capture-root access contract failed" >&2
    return 1
  fi
}

