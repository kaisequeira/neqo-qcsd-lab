#!/usr/bin/env bash
set -euo pipefail
QCSD_ORIGINAL_ARGV=("$@")

# A guarded inner invocation executes the exact qcsd bytes held open by the
# guardian.  Derive the repository root from the separately bound canonical
# path only after proving that Bash is reading that guardian-owned descriptor.
if [[ -n "${QCSD_DOCKER_LOCK_GUARDIAN_QCSD_SOURCE_FD:-}" ||
      -n "${QCSD_DOCKER_LOCK_GUARDIAN_QCSD_SOURCE_PATH:-}" ]]; then
  qcsd_loaded_source_canonical="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null)" ||
    qcsd_loaded_source_canonical=""
  [[ "${QCSD_DOCKER_LOCK_GUARDIAN_PID:-}" =~ ^[1-9][0-9]*$ &&
      "${QCSD_DOCKER_LOCK_GUARDIAN_QCSD_SOURCE_FD:-}" =~ ^[0-9]+$ &&
      "${QCSD_DOCKER_LOCK_GUARDIAN_QCSD_SOURCE_PATH:-}" == /* &&
      "${BASH_SOURCE[0]}" == "/proc/${QCSD_DOCKER_LOCK_GUARDIAN_PID}/fd/${QCSD_DOCKER_LOCK_GUARDIAN_QCSD_SOURCE_FD}" &&
      "${qcsd_loaded_source_canonical}" == "${QCSD_DOCKER_LOCK_GUARDIAN_QCSD_SOURCE_PATH}" ]] || exit 1
  ROOT="$(cd "$(dirname "${QCSD_DOCKER_LOCK_GUARDIAN_QCSD_SOURCE_PATH}")" && pwd -P)"
else
  ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
fi
qcsd_invoking_uid="$(/usr/bin/id -u)"
qcsd_invoking_gid="$(/usr/bin/id -g)"
if [[ ! "${qcsd_invoking_uid}" =~ ^(0|[1-9][0-9]*)$ ||
      ! "${qcsd_invoking_gid}" =~ ^(0|[1-9][0-9]*)$ ]]; then
  echo "Cannot resolve the invoking numeric UID/GID" >&2
  exit 1
fi
readonly qcsd_invoking_uid qcsd_invoking_gid
DOCKER_SUPERVISOR="${ROOT}/tools/docker_signal_supervisor.sh"
docker_supervisor_canonical="$(readlink -f -- "${DOCKER_SUPERVISOR}" 2>/dev/null)" ||
  docker_supervisor_canonical=""
docker_supervisor_metadata="$(stat -Lc '%d:%i:%s:%Y:%u:%a:%h:%F' -- \
  "${DOCKER_SUPERVISOR}" 2>/dev/null)" || docker_supervisor_metadata=""
if [[ -L "${DOCKER_SUPERVISOR}" || ! -f "${DOCKER_SUPERVISOR}" ||
      "${docker_supervisor_canonical}" != "${DOCKER_SUPERVISOR}" ||
      ! "${docker_supervisor_metadata}" =~ \
        ^[0-9]+:[0-9]+:[0-9]+:[0-9]+:$(id -u):[0-7]{3,4}:1:regular[[:space:]]file$ ]]; then
  echo "Missing regular Docker signal supervisor: ${DOCKER_SUPERVISOR}" >&2
  exit 1
fi
docker_supervisor_mode="$(stat -Lc '%a' -- "${DOCKER_SUPERVISOR}")"
if (( (8#${docker_supervisor_mode} & 0022) != 0 )); then
  echo "Docker signal supervisor is group/world writable" >&2
  exit 1
fi
docker_supervisor_sha256="$(sha256sum -- "${DOCKER_SUPERVISOR}" | awk '{print $1}')"
[[ "${docker_supervisor_sha256}" =~ ^[0-9a-f]{64}$ ]] || exit 1
# shellcheck source=tools/docker_signal_supervisor.sh
source "${DOCKER_SUPERVISOR}"
if [[ "$(stat -Lc '%d:%i:%s:%Y:%u:%a:%h:%F' -- \
       "${DOCKER_SUPERVISOR}" 2>/dev/null)" != "${docker_supervisor_metadata}" ||
      "$(sha256sum -- "${DOCKER_SUPERVISOR}" | awk '{print $1}')" != \
        "${docker_supervisor_sha256}" ]]; then
  echo "Docker signal supervisor changed while it was sourced" >&2
  exit 1
fi
COLLECTION_IMAGE="${QCSD_LAB_COLLECTION_IMAGE:-neqo-qcsd-lab-collection:local}"
PREPARE_IMAGE="${QCSD_LAB_PREPARE_IMAGE:-neqo-qcsd-lab-prepare:local}"
REFERENCE_IMAGE="${QCSD_LAB_REFERENCE_IMAGE:-neqo-qcsd-lab-reference:local}"
WSL_HOST_BUILD_MIN_AVAILABLE_BYTES=68719476736
QCSD_LAUNCH_ACTION="${1:-}"

usage() {
  echo "Usage: qcsd-lab {lifecycle-recover|build|prepare|derive-chaff-prefix-specs|qualify-chaff|qualify-response-chaff|run|resume|verify|analyze|fit|buflo-study|class-study|etf-probe|test} [arguments...]" >&2
}

_qcsd_trusted_git() {
  GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null GIT_OPTIONAL_LOCKS=0 \
    GIT_NO_REPLACE_OBJECTS=1 \
    /usr/bin/git -c core.fsmonitor=false -c core.hooksPath=/dev/null \
      -c core.excludesFile=/dev/null "$@"
}

_qcsd_verify_git_checkout_binding() {
  local checkout="$1" expected_git_dir="$2" observed_tree observed_git_dir metadata_file
  observed_tree="$(_qcsd_trusted_git -C "${checkout}" rev-parse --show-toplevel)" || return 1
  observed_git_dir="$(_qcsd_trusted_git -C "${checkout}" rev-parse --absolute-git-dir)" || return 1
  [[ "$(realpath -- "${observed_tree}")" == "$(realpath -- "${checkout}")" &&
      "$(realpath -- "${observed_git_dir}")" == "$(realpath -- "${expected_git_dir}")" ]] || return 1
  # Local exclude/attribute files are outside the recorded checkout and can
  # otherwise hide build-context inputs or install conversion filters.
  for metadata_file in "${expected_git_dir}/info/exclude" \
    "${expected_git_dir}/info/attributes" "${expected_git_dir}/info/grafts"; do
    [[ ! -L "${metadata_file}" && ( ! -e "${metadata_file}" || -f "${metadata_file}" ) ]] || return 1
    if [[ "${metadata_file}" == */info/grafts && -s "${metadata_file}" ]]; then
      return 1
    fi
    if [[ "${metadata_file}" != */info/grafts && -f "${metadata_file}" ]] &&
       awk 'NF && $1 !~ /^#/ { found=1 } END { exit found ? 0 : 1 }' \
         "${metadata_file}"; then
      return 1
    fi
  done
}

_qcsd_verify_git_index_bytes() {
  local checkout="$1" object_format inventory status
  object_format="$(_qcsd_trusted_git -C "${checkout}" rev-parse --show-object-format)" || return 1
  [[ "${object_format}" == "sha1" || "${object_format}" == "sha256" ]] || return 1
  inventory="$(mktemp --tmpdir=/tmp qcsd-git-index.XXXXXXXX)" || return 1
  if ! _qcsd_trusted_git -C "${checkout}" ls-files --stage -z >"${inventory}"; then
    rm -f -- "${inventory}"
    return 1
  fi
  if /usr/bin/python3 -I -c '
import hashlib, os, stat, sys

root = os.fsencode(sys.argv[1])
algorithm = sys.argv[2]
root_fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
records = sys.stdin.buffer.read().split(b"\0")
for record in records:
    if not record:
        continue
    header, separator, relative = record.partition(b"\t")
    fields = header.split(b" ")
    if not separator or len(fields) != 3 or fields[2] != b"0":
        raise SystemExit(1)
    mode, expected = fields[0], fields[1].decode("ascii")
    if relative.startswith(b"/") or b"\0" in relative or b".." in relative.split(b"/"):
        raise SystemExit(1)
    if mode == b"160000":
        continue
    parts = relative.split(b"/")
    parent_fd = os.dup(root_fd)
    try:
        for component in parts[:-1]:
            child_fd = os.open(
                component,
                os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
                dir_fd=parent_fd,
            )
            os.close(parent_fd)
            parent_fd = child_fd
        name = parts[-1]
        value = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
        if mode == b"120000":
            if not stat.S_ISLNK(value.st_mode):
                raise SystemExit(1)
            payload = os.fsencode(os.readlink(name, dir_fd=parent_fd))
        elif mode in (b"100644", b"100755"):
            descriptor = os.open(
                name, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=parent_fd
            )
            try:
                opened = os.fstat(descriptor)
                if (
                    not stat.S_ISREG(opened.st_mode)
                    or opened.st_nlink != 1
                    or (opened.st_dev, opened.st_ino) != (value.st_dev, value.st_ino)
                ):
                    raise SystemExit(1)
                executable = bool(opened.st_mode & 0o111)
                if executable != (mode == b"100755"):
                    raise SystemExit(1)
                payload = b""
                while True:
                    block = os.read(descriptor, 1024 * 1024)
                    if not block:
                        break
                    payload += block
            finally:
                os.close(descriptor)
        else:
            raise SystemExit(1)
    finally:
        os.close(parent_fd)
    digest = hashlib.new(algorithm)
    digest.update(b"blob " + str(len(payload)).encode("ascii") + b"\0")
    digest.update(payload)
    if digest.hexdigest() != expected:
        raise SystemExit(1)
os.close(root_fd)
' "${checkout}" "${object_format}" <"${inventory}"; then
    status=0
  else
    status=$?
  fi
  rm -f -- "${inventory}"
  return "${status}"
}

_qcsd_verify_clean_build_checkout() {
  local head_gitlink index_gitlink neqo_head
  _qcsd_verify_git_checkout_binding "${ROOT}" "${ROOT}/.git" &&
    _qcsd_verify_git_checkout_binding "${ROOT}/neqo-qcsd" \
      "${ROOT}/.git/modules/third_party/neqo-qcsd" &&
    _qcsd_verify_git_index_bytes "${ROOT}" &&
    _qcsd_verify_git_index_bytes "${ROOT}/neqo-qcsd" || return 1
  [[ -z "$(_qcsd_trusted_git -C "${ROOT}" status --porcelain --untracked-files=all)" &&
      -z "$(_qcsd_trusted_git -C "${ROOT}/neqo-qcsd" status --porcelain --untracked-files=all)" ]] || return 1
  head_gitlink="$(_qcsd_trusted_git -C "${ROOT}" rev-parse HEAD:neqo-qcsd)" || return 1
  index_gitlink="$(_qcsd_trusted_git -C "${ROOT}" ls-files --stage -- neqo-qcsd |
    awk '$1 == 160000 {print $2}')" || return 1
  neqo_head="$(_qcsd_trusted_git -C "${ROOT}/neqo-qcsd" rev-parse HEAD)" || return 1
  [[ "${head_gitlink}" =~ ^[0-9a-f]{40,64}$ &&
      "${head_gitlink}" == "${index_gitlink}" &&
      "${head_gitlink}" == "${neqo_head}" ]]
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

pinned_cdp_cohort_version=""
pinned_cdp_build_host=""
pinned_cdp_build_container=""
pinned_cdp_destination_host=""
pinned_cdp_destination_container=""
pinned_cdp_destination_parent=""
pinned_cdp_destination_parent_container=""
if [[ "${1:-}" == "test" && "${2:-}" == "pinned-cdp" ]]; then
  if (( $# == 3 )) && [[ "${3:-}" == "-h" || "${3:-}" == "--help" ]]; then
    echo "Usage: qcsd-lab test pinned-cdp --cohort-version N --build-execution-receipt PATH --destination PATH"
    exit 0
  fi
  pinned_cdp_build_raw=""
  pinned_cdp_destination_raw=""
  pinned_cdp_seen_cohort=0
  pinned_cdp_seen_build=0
  pinned_cdp_seen_destination=0
  pinned_cdp_index=3
  while (( pinned_cdp_index <= $# )); do
    pinned_cdp_argument="${!pinned_cdp_index}"
    pinned_cdp_value=""
    case "${pinned_cdp_argument}" in
      --cohort-version|--build-execution-receipt|--destination)
        pinned_cdp_next=$((pinned_cdp_index + 1))
        if (( pinned_cdp_next > $# )); then
          echo "${pinned_cdp_argument} requires a value" >&2
          exit 2
        fi
        pinned_cdp_value="${!pinned_cdp_next}"
        pinned_cdp_index=$((pinned_cdp_index + 2))
        ;;
      --cohort-version=*|--build-execution-receipt=*|--destination=*)
        pinned_cdp_value="${pinned_cdp_argument#*=}"
        if [[ -z "${pinned_cdp_value}" ]]; then
          echo "${pinned_cdp_argument%%=*} requires a value" >&2
          exit 2
        fi
        pinned_cdp_index=$((pinned_cdp_index + 1))
        ;;
      *)
        echo "test pinned-cdp rejects unknown argument: ${pinned_cdp_argument}" >&2
        exit 2
        ;;
    esac
    case "${pinned_cdp_argument%%=*}" in
      --cohort-version)
        if (( pinned_cdp_seen_cohort )); then
          echo "test pinned-cdp accepts exactly one --cohort-version" >&2
          exit 2
        fi
        pinned_cdp_seen_cohort=1
        pinned_cdp_cohort_version="${pinned_cdp_value}"
        ;;
      --build-execution-receipt)
        if (( pinned_cdp_seen_build )); then
          echo "test pinned-cdp accepts exactly one --build-execution-receipt" >&2
          exit 2
        fi
        pinned_cdp_seen_build=1
        pinned_cdp_build_raw="${pinned_cdp_value}"
        ;;
      --destination)
        if (( pinned_cdp_seen_destination )); then
          echo "test pinned-cdp accepts exactly one --destination" >&2
          exit 2
        fi
        pinned_cdp_seen_destination=1
        pinned_cdp_destination_raw="${pinned_cdp_value}"
        ;;
    esac
  done
  if (( ! pinned_cdp_seen_cohort || ! pinned_cdp_seen_build ||
        ! pinned_cdp_seen_destination )); then
    echo "test pinned-cdp requires --cohort-version, --build-execution-receipt, and --destination" >&2
    exit 2
  fi
  if [[ ! "${pinned_cdp_cohort_version}" =~ ^[1-9][0-9]*$ ]]; then
    echo "test pinned-cdp cohort version must be a positive integer" >&2
    exit 2
  fi
  pinned_cdp_build_relative="artifacts/buflo-study/build-execution-v${pinned_cdp_cohort_version}.json"
  pinned_cdp_destination_relative="artifacts/buflo-study/pinned-cdp-execution-v${pinned_cdp_cohort_version}.json"
  case "${pinned_cdp_build_raw}" in
    "${pinned_cdp_build_relative}"|"/lab/${pinned_cdp_build_relative}"|"${ROOT}/${pinned_cdp_build_relative}")
      pinned_cdp_build_host="${ROOT}/${pinned_cdp_build_relative}"
      ;;
    *)
      echo "test pinned-cdp build receipt must be ${pinned_cdp_build_relative}" >&2
      exit 2
      ;;
  esac
  case "${pinned_cdp_destination_raw}" in
    "${pinned_cdp_destination_relative}"|"/lab/${pinned_cdp_destination_relative}"|"${ROOT}/${pinned_cdp_destination_relative}")
      pinned_cdp_destination_host="${ROOT}/${pinned_cdp_destination_relative}"
      ;;
    *)
      echo "test pinned-cdp destination must be ${pinned_cdp_destination_relative}" >&2
      exit 2
      ;;
  esac
  pinned_cdp_destination_parent="${ROOT}/artifacts/buflo-study"
  if [[ -L "${ROOT}/artifacts" || -L "${pinned_cdp_destination_parent}" ||
        ! -d "${pinned_cdp_destination_parent}" ||
        "$(realpath -e -- "${pinned_cdp_destination_parent}" 2>/dev/null)" != "${pinned_cdp_destination_parent}" ]]; then
    echo "test pinned-cdp requires the canonical non-symlink artifacts/buflo-study directory" >&2
    exit 1
  fi
  if [[ -L "${pinned_cdp_build_host}" || ! -f "${pinned_cdp_build_host}" ||
        "$(realpath -e -- "${pinned_cdp_build_host}" 2>/dev/null)" != "${pinned_cdp_build_host}" ]]; then
    echo "test pinned-cdp requires its exact regular no-cache build receipt" >&2
    exit 1
  fi
  if [[ -e "${pinned_cdp_destination_host}" ||
        -L "${pinned_cdp_destination_host}" ]]; then
    echo "test pinned-cdp requires an absent create-only destination" >&2
    exit 1
  fi
  pinned_cdp_build_container="/lab/${pinned_cdp_build_relative}"
  pinned_cdp_destination_container="/lab/${pinned_cdp_destination_relative}"
  pinned_cdp_destination_parent_container="/lab/artifacts/buflo-study"
fi

if [[ "${1:-}" == "lifecycle-recover" && $# != 1 ]]; then
  echo "lifecycle-recover accepts no arguments" >&2
  exit 2
fi

# ETF probe help is read-only.  Executing the probe is deferred until the
# ordinary Docker endpoint pin and stale-supervisor admission gate have run.
if [[ "${1:-}" == "etf-probe" && $# == 2 &&
      ( "${2}" == "-h" || "${2}" == "--help" ) ]]; then
  etf_probe_python="/usr/bin/python3"
  [[ -x "${etf_probe_python}" ]] || {
    echo "etf-probe requires python3 on the host" >&2
    exit 1
  }
  QCSD_ETF_PROBE_LAB_ROOT="${ROOT}" exec "${etf_probe_python}" -I -c '
import os
import sys
from pathlib import Path

lab_root = Path(os.environ["QCSD_ETF_PROBE_LAB_ROOT"]).resolve()
os.environ["QCSD_LAB_ROOT"] = str(lab_root)
sys.path.insert(0, str(lab_root / "src"))
from qcsd_lab.etf_probe import main

main(sys.argv[1:])
' "${@:2}"
fi

# Acquisition spans stability windows measured in days.  Keep its supervisor
# on the host so it can remain interruptible, resume only from checkpoint.json,
# and invoke the existing bounded Docker-backed coordinator actions when work
# is due.  The Python tool owns argument validation; this branch intentionally
# runs before all Docker and mutable study-state checks.
if [[ "${1:-}" == "class-study" && "${2:-}" == "acquisition-watch" ]]; then
  if [[ ! -x /usr/bin/python3 ]]; then
    echo "class-study acquisition-watch requires /usr/bin/python3" >&2
    exit 1
  fi
  exec /usr/bin/python3 -I "${ROOT}/tools/class_acquisition_watch.py" "${@:3}"
fi

# Nested help is read-only and must not depend on Docker, a built image, or
# any mutable study state.  Forward only the two exact argparse help shapes;
# ordinary execution continues through every host-side validation below.
if [[ ( "${1:-}" == "class-study" || "${1:-}" == "buflo-study" ) &&
      ( ( $# == 2 && "${2:-}" == "--help" ) ||
        ( $# == 3 && "${3:-}" == "--help" ) ) ]]; then
  help_python="python3"
  if [[ -x "${ROOT}/.venv/bin/python" ]]; then
    help_python="${ROOT}/.venv/bin/python"
  fi
  command -v "${help_python}" >/dev/null 2>&1 || {
    echo "qcsd-lab nested help requires python3" >&2
    exit 1
  }
  if [[ $# == 2 && "${1}" == "class-study" && "${2}" == "--help" ]]; then
    PYTHONPATH="${ROOT}/src" "${help_python}" -c \
      'from qcsd_lab.cli import main; main()' "$@"
    echo
    echo "Host-only action:"
    echo "  acquisition-watch   supervise due acquisition work with bounded 1-5 s heartbeats"
    exit 0
  fi
  PYTHONPATH="${ROOT}/src" exec "${help_python}" -c \
    'from qcsd_lab.cli import main; main()' "$@"
fi

# Formal classifier work can run for hours.  Reject missing wall-capacity
# authority before build-receipt validation or Docker inspection so an invalid
# invocation cannot pay any evaluator startup cost.  Focused-study callers may
# provide the typed CLI override; generic analysis receives only the forwarded
# environment value.
qcsd_dlsvm_wall_argument=0
qcsd_validation_attestation_argument=0
qcsd_option_index=1
while (( qcsd_option_index <= $# )); do
  qcsd_option="${!qcsd_option_index}"
  case "${qcsd_option}" in
    --dlsvm-wall-seconds=*)
      if [[ -z "${qcsd_option#--dlsvm-wall-seconds=}" ]]; then
        echo "--dlsvm-wall-seconds requires a value" >&2
        exit 2
      fi
      qcsd_dlsvm_wall_argument=1
      ;;
    --dlsvm-wall-seconds)
      qcsd_option_value_index=$((qcsd_option_index + 1))
      if (( qcsd_option_value_index > $# )); then
        echo "--dlsvm-wall-seconds requires a value" >&2
        exit 2
      fi
      qcsd_dlsvm_wall_argument=1
      qcsd_option_index="${qcsd_option_value_index}"
      ;;
    --validation-attestation|--validation-attestation=*)
      qcsd_validation_attestation_argument=1
      ;;
  esac
  qcsd_option_index=$((qcsd_option_index + 1))
done
if [[ "${1:-}" == "buflo-study" &&
      ( "${2:-}" == "evaluate" || "${2:-}" == "verify" ) &&
      -z "${QCSD_DLSVM_AVAILABLE_WALL_SECONDS:-}" &&
      "${qcsd_dlsvm_wall_argument}" != "1" ]]; then
  echo "buflo-study ${2} requires --dlsvm-wall-seconds or QCSD_DLSVM_AVAILABLE_WALL_SECONDS for current capacity admission" >&2
  exit 2
fi
if [[ "${1:-}" == "analyze" &&
      "${qcsd_validation_attestation_argument}" == "1" &&
      -z "${QCSD_DLSVM_AVAILABLE_WALL_SECONDS:-}" ]]; then
  echo "analyze --validation-attestation requires QCSD_DLSVM_AVAILABLE_WALL_SECONDS for current capacity admission" >&2
  exit 2
fi

# Keep one terminal-signal handler installed for the complete mutable launcher
# lifetime.  Cleanup routines change only the atomic phase flag; they never
# replace four traps one at a time and therefore have no transition window in
# which a signal can be discarded or can interrupt exact-object teardown.
_QCSD_LIFETIME_SIGNAL_STATUS=0
_QCSD_LIFETIME_CLEANUP_ACTIVE=0
_qcsd_latch_lifetime_signal() {
  local received_status="$1"
  if (( _QCSD_LIFETIME_SIGNAL_STATUS == 0 )); then
    _QCSD_LIFETIME_SIGNAL_STATUS="${received_status}"
  fi
  if (( _QCSD_LIFETIME_CLEANUP_ACTIVE == 0 )); then
    exit "${_QCSD_LIFETIME_SIGNAL_STATUS}"
  fi
}
trap '_qcsd_latch_lifetime_signal 129' HUP
trap '_qcsd_latch_lifetime_signal 130' INT
trap '_qcsd_latch_lifetime_signal 131' QUIT
trap '_qcsd_latch_lifetime_signal 143' TERM

require_submodule() {
  if [[ ! -f "${ROOT}/neqo-qcsd/Cargo.lock" ]]; then
    echo "Missing Neqo submodule; run: git submodule update --init --recursive" >&2
    exit 1
  fi
}

readonly _QCSD_DOCKER_STALE_NETWORK_SETTLE_SECONDS=5
readonly _QCSD_DOCKER_STALE_RUN_SETTLE_SECONDS=5

_qcsd_admission_parse_record() {
  local record="$1"
  local values_name="$2"
  local order_name="$3"
  local -n values_ref="${values_name}"
  local -n order_ref="${order_name}"
  local metadata size last_byte line key value grep_status
  values_ref=()
  order_ref=()
  [[ ! -L "${record}" && -f "${record}" ]] || return 1
  metadata="$(stat -c '%u:%a:%h:%F' -- "${record}" 2>/dev/null)" || return 1
  [[ "${metadata}" == "$(id -u):600:1:regular file" ]] || return 1
  size="$(stat -c '%s' -- "${record}" 2>/dev/null)" || return 1
  [[ "${size}" =~ ^[1-9][0-9]*$ ]] || return 1
  (( size <= 16384 )) || return 1
  last_byte="$(
    od -An -tu1 -j "$((size - 1))" -N1 -- "${record}" 2>/dev/null |
      tr -d '[:space:]'
  )" || return 1
  [[ "${last_byte}" == "10" ]] || return 1
  if LC_ALL=C grep -q '[^ -~]' -- "${record}"; then
    return 1
  else
    grep_status=$?
    (( grep_status == 1 )) || return 1
  fi
  while IFS= read -r line || [[ -n "${line}" ]]; do
    [[ "${line}" == *=* ]] || return 1
    key="${line%%=*}"
    value="${line#*=}"
    [[ "${key}" =~ ^[a-z][a-z0-9_]*$ && -n "${value}" ]] || return 1
    [[ ! -v "values_ref[${key}]" ]] || return 1
    values_ref["${key}"]="${value}"
    order_ref+=("${key}")
  done <"${record}"
  (( ${#order_ref[@]} > 0 ))
}

_qcsd_admission_exact_fields() {
  local values_name="$1"
  local order_name="$2"
  local expected_name="$3"
  local -n values_ref="${values_name}"
  local -n order_ref="${order_name}"
  local -n expected_ref="${expected_name}"
  local index
  (( ${#values_ref[@]} == ${#expected_ref[@]} &&
     ${#order_ref[@]} == ${#expected_ref[@]} )) || return 1
  for (( index = 0; index < ${#expected_ref[@]}; index++ )); do
    [[ "${order_ref[index]}" == "${expected_ref[index]}" &&
        -v "values_ref[${expected_ref[index]}]" ]] || return 1
  done
}

_qcsd_admission_validate_root_entries() {
  local supervisor_root="$1"
  local root_kind="$2"
  local current_uid metadata owner mode links kind mode_value entry name
  local nullglob_was_set=0
  local dotglob_was_set=0
  local -a entries=()
  current_uid="$(id -u)"
  [[ ! -L "${supervisor_root}" && -d "${supervisor_root}" ]] || return 1
  metadata="$(stat -Lc '%u:%a:%F' -- "${supervisor_root}" 2>/dev/null)" || return 1
  [[ "${metadata}" == "${current_uid}:700:directory" ]] || return 1
  shopt -q nullglob && nullglob_was_set=1
  shopt -q dotglob && dotglob_was_set=1
  shopt -s nullglob dotglob
  entries=("${supervisor_root}"/*)
  (( nullglob_was_set )) || shopt -u nullglob
  (( dotglob_was_set )) || shopt -u dotglob
  for entry in "${entries[@]}"; do
    name="${entry##*/}"
    case "${name}" in
      SUPERVISION.next|RECOVERY.next|run.status.next)
        echo "qcsd-lab Docker admission found staged prior supervisor state: ${entry}" >&2
        return 1
        ;;
      SUPERVISION|RECOVERY)
        [[ ! -L "${entry}" && -f "${entry}" ]] || return 1
        metadata="$(stat -c '%u:%a:%h:%F' -- "${entry}" 2>/dev/null)" || return 1
        [[ "${metadata}" == "${current_uid}:600:1:regular file" ]] || return 1
        ;;
      container.cid)
        [[ "${root_kind}" == "run" && ! -L "${entry}" && -f "${entry}" ]] ||
          return 1
        metadata="$(stat -c '%u:%a:%h:%F' -- "${entry}" 2>/dev/null)" || return 1
        IFS=: read -r owner mode links kind <<<"${metadata}"
        [[ "${owner}" == "${current_uid}" && "${links}" == "1" &&
            "${kind}" == "regular file" && "${mode}" =~ ^[0-7]{3,4}$ ]] ||
          return 1
        mode_value=$((8#${mode}))
        (( (mode_value & 0022) == 0 )) || return 1
        ;;
      run.status|stdout)
        [[ "${root_kind}" == "run" && ! -L "${entry}" && -f "${entry}" ]] ||
          return 1
        metadata="$(stat -c '%u:%a:%h:%F' -- "${entry}" 2>/dev/null)" || return 1
        [[ "${metadata}" == "${current_uid}:600:1:regular file" ]] || return 1
        ;;
      wait.pipe)
        [[ "${root_kind}" == "run" && ! -L "${entry}" && -p "${entry}" ]] ||
          return 1
        metadata="$(stat -c '%u:%a:%F' -- "${entry}" 2>/dev/null)" || return 1
        [[ "${metadata}" == "${current_uid}:600:fifo" ]] || return 1
        ;;
      *)
        echo "qcsd-lab Docker admission found an unexpected prior supervisor entry: ${entry}" >&2
        return 1
        ;;
    esac
  done
}

_qcsd_admission_validate_common_record() {
  local values_name="$1"
  local expected_object="$2"
  local -n values_ref="${values_name}"
  [[ "${values_ref[object]}" == "${expected_object}" &&
      "${values_ref[supervisor_pid]}" =~ ^[1-9][0-9]*$ &&
      "${values_ref[supervisor_start_time]}" =~ ^[1-9][0-9]*$ &&
      "${values_ref[supervisor_session]}" =~ ^[1-9][0-9]*$ &&
      "${values_ref[supervisor_process_group]}" =~ ^[1-9][0-9]*$ &&
      "${values_ref[docker_context]}" == "${_QCSD_DOCKER_PINNED_CONTEXT}" &&
      "${values_ref[docker_host]}" == "${_QCSD_DOCKER_PINNED_HOST}" &&
      "${values_ref[docker_server_id]}" == "${_QCSD_DOCKER_PINNED_SERVER_ID}" &&
      "${values_ref[docker_daemon_id]}" == "${_QCSD_DOCKER_PINNED_SERVER_ID}" &&
      "${values_ref[docker_server_id]}" =~ ^[A-Za-z0-9_.:-]+$ &&
      "${values_ref[docker_server_id]}" != "unavailable" &&
      "${values_ref[host_boot_id]}" == "${qcsd_admission_boot_id}" &&
      "${values_ref[supervisor_label]}" =~ ^org[.]qcsd[.]supervisor[.]instance=[0-9a-f]{32}$ ]]
}

_qcsd_admission_validate_network_record() {
  local values_name="$1"
  local order_name="$2"
  local record_name="$3"
  local -n values_ref="${values_name}"
  local -a expected_fields=(
    object supervisor_pid supervisor_start_time supervisor_session
    supervisor_process_group network_id docker_context docker_host
    docker_server_id docker_daemon_id host_boot_id supervisor_label
    requested_signal network_state
  )
  _qcsd_admission_exact_fields \
    "${values_name}" "${order_name}" expected_fields || return 1
  _qcsd_admission_validate_common_record "${values_name}" network || return 1
  [[ "${values_ref[network_id]}" =~ ^(unavailable|[0-9a-f]{64})$ &&
      "${values_ref[requested_signal]}" =~ ^(none|HUP|INT|QUIT|TERM)$ ]] ||
    return 1
  if [[ "${record_name}" == "SUPERVISION" ]]; then
    [[ "${values_ref[network_id]}" == "unavailable" &&
        "${values_ref[requested_signal]}" == "none" &&
        "${values_ref[network_state]}" == "launching" ]]
    return $?
  fi
  [[ "${record_name}" == "RECOVERY" &&
      "${values_ref[network_state]}" =~ ^(present|absent|unknown)$ ]] || return 1
  if [[ "${values_ref[network_state]}" == "present" ]]; then
    [[ "${values_ref[network_id]}" =~ ^[0-9a-f]{64}$ ]] || return 1
  fi
}

_qcsd_admission_validate_launcher_tuple() {
  local values_name="$1"
  local -n values_ref="${values_name}"
  local pid="${values_ref[scope_launcher_pid]}"
  if [[ "${pid}" == "unavailable" ]]; then
    [[ "${values_ref[scope_launcher_start_time]}" == "unavailable" &&
        "${values_ref[scope_launcher_session]}" == "unavailable" &&
        "${values_ref[scope_launcher_process_group]}" == "unavailable" &&
        "${values_ref[cli_pid]}" == "unavailable" &&
        "${values_ref[cli_start_time]}" == "unavailable" &&
        "${values_ref[cli_session]}" == "unavailable" &&
        "${values_ref[cli_process_group]}" == "unavailable" ]]
    return $?
  fi
  [[ "${pid}" =~ ^[1-9][0-9]*$ &&
      "${values_ref[scope_launcher_start_time]}" =~ ^[1-9][0-9]*$ &&
      "${values_ref[scope_launcher_session]}" == "${pid}" &&
      "${values_ref[scope_launcher_process_group]}" == "${pid}" &&
      "${values_ref[cli_pid]}" == "${pid}" &&
      "${values_ref[cli_start_time]}" == "${values_ref[scope_launcher_start_time]}" &&
      "${values_ref[cli_session]}" == "${pid}" &&
      "${values_ref[cli_process_group]}" == "${pid}" ]]
}

_qcsd_admission_validate_scope_common() {
  local values_name="$1"
  local supervisor_root="$2"
  local -n values_ref="${values_name}"
  local control_group canonical_path
  [[ "${values_ref[object]}" == "docker-run-scope-launcher" &&
      "${values_ref[process_identity_role]}" == "local-systemd-run-scope-launcher" &&
      "${values_ref[mode]}" =~ ^(attached|detached)$ &&
      "${values_ref[container_id]}" =~ ^(unavailable|[0-9a-f]{64})$ &&
      "${values_ref[scope_required]}" == "1" &&
      "${values_ref[scope_unit]}" =~ ^qcsd-docker-run-[0-9a-f]{32}[.]scope$ &&
      "${values_ref[status_file]}" == "${supervisor_root}/run.status" &&
      "${values_ref[requested_signal]}" =~ ^(none|HUP|INT|QUIT|TERM)$ &&
      "${values_ref[target_state]}" =~ ^(launching|running|stopped|absent|unknown)$ ]] ||
    return 1
  _qcsd_admission_validate_common_record \
    "${values_name}" docker-run-scope-launcher || return 1
  _qcsd_admission_validate_launcher_tuple "${values_name}" || return 1
  control_group="${values_ref[scope_control_group]}"
  if [[ "${control_group}" != "unavailable" ]]; then
    [[ "${control_group}" == /* &&
        "${control_group}" =~ ^/[A-Za-z0-9_.@:/-]+$ &&
        "${control_group}" == */"${values_ref[scope_unit]}" ]] || return 1
    canonical_path="$(realpath -m -- "${control_group}" 2>/dev/null)" || return 1
    [[ "${canonical_path}" == "${control_group}" ]] || return 1
  fi
  if [[ "${values_ref[target_state]}" =~ ^(running|stopped)$ &&
        ! "${values_ref[container_id]}" =~ ^[0-9a-f]{64}$ ]]; then
    return 1
  fi
}

_qcsd_admission_validate_run_record() {
  local values_name="$1"
  local order_name="$2"
  local record_name="$3"
  local supervisor_root="$4"
  local -n values_ref="${values_name}"
  local signal_tuple force_tuple scope_tuple status_value systemd_value
  local -a supervision_fields=(
    object process_identity_role supervisor_pid supervisor_start_time
    supervisor_session supervisor_process_group mode scope_launcher_pid
    scope_launcher_start_time scope_launcher_session scope_launcher_process_group
    cli_pid cli_start_time cli_session cli_process_group container_id
    docker_context docker_host docker_server_id docker_daemon_id supervisor_label
    scope_required scope_unit scope_control_group scope_state host_boot_id
    status_file status_file_state requested_signal forwarded_target_signal target_state
  )
  local -a interim_fields=(
    object process_identity_role supervisor_pid supervisor_start_time
    supervisor_session supervisor_process_group mode scope_launcher_pid
    scope_launcher_start_time scope_launcher_session scope_launcher_process_group
    cli_pid cli_start_time cli_session cli_process_group container_id
    docker_context docker_host docker_server_id docker_daemon_id supervisor_label
    scope_required scope_unit scope_control_group scope_state host_boot_id
    status_file status_file_state requested_signal interruption_reason
    planned_target_signal target_signal_attempted target_signal_api_outcome
    forwarded_target_signal target_state phase
  )
  local -a final_fields=(
    object process_identity_role supervisor_pid supervisor_start_time
    supervisor_session supervisor_process_group mode scope_launcher_pid
    scope_launcher_start_time scope_launcher_session scope_launcher_process_group
    cli_pid cli_start_time cli_session cli_process_group container_id
    docker_context docker_host docker_server_id docker_daemon_id supervisor_label
    scope_required scope_unit scope_control_group scope_final_state
    scope_leak_detected scope_kill_attempted scope_kill_outcome scope_empty_proven
    host_boot_id status_file status_file_state status_file_matches
    docker_command_status systemd_run_status requested_signal interruption_reason
    planned_target_signal target_signal_attempted target_signal_api_outcome
    forwarded_target_signal target_state forced_without_bound_target
    interrupted_without_bound_target docker_cli_forced docker_cli_force_attempted
    docker_cli_force_outcome target_forced target_force_attempted
    target_force_api_outcome
  )
  if [[ "${record_name}" == "SUPERVISION" ]]; then
    _qcsd_admission_exact_fields \
      "${values_name}" "${order_name}" supervision_fields || return 1
  elif [[ "${record_name}" == "RECOVERY" &&
          "${values_ref[phase]:-}" == "interrupted-before-daemon-teardown" ]]; then
    _qcsd_admission_exact_fields \
      "${values_name}" "${order_name}" interim_fields || return 1
  elif [[ "${record_name}" == "RECOVERY" ]]; then
    _qcsd_admission_exact_fields \
      "${values_name}" "${order_name}" final_fields || return 1
  else
    return 1
  fi
  _qcsd_admission_validate_scope_common \
    "${values_name}" "${supervisor_root}" || return 1

  if [[ "${record_name}" == "SUPERVISION" ]]; then
    if [[ "${values_ref[scope_state]}" == "declared" ]]; then
      [[ "${values_ref[scope_launcher_pid]}" == "unavailable" &&
          "${values_ref[container_id]}" == "unavailable" &&
          "${values_ref[scope_control_group]}" == "unavailable" &&
          "${values_ref[status_file_state]}" == "declared" &&
          "${values_ref[requested_signal]}" == "none" &&
          "${values_ref[forwarded_target_signal]}" == "none" &&
          "${values_ref[target_state]}" == "launching" ]] || return 1
    else
      [[ "${values_ref[scope_state]}" =~ ^(active|inactive|absent)$ &&
          "${values_ref[scope_launcher_pid]}" =~ ^[1-9][0-9]*$ &&
          "${values_ref[container_id]}" == "unavailable" &&
          "${values_ref[status_file_state]}" == "awaiting-command-status" &&
          "${values_ref[forwarded_target_signal]}" == "none" &&
          "${values_ref[target_state]}" == "launching" ]] || return 1
      if [[ "${values_ref[scope_state]}" == "active" ]]; then
        [[ "${values_ref[scope_control_group]}" != "unavailable" ]] || return 1
      fi
    fi
    return 0
  fi

  # The launcher publishes every non-declared state only after its mandatory
  # stopped-child birth-identity handshake.  A recovery record without that
  # complete tuple cannot authorise a process or scope action.
  [[ "${values_ref[scope_launcher_pid]}" =~ ^[1-9][0-9]*$ ]] || return 1

  [[ "${values_ref[interruption_reason]}" =~ ^(host_signal|internal_abort|none)$ &&
      "${values_ref[planned_target_signal]}" =~ ^(none|HUP|INT|QUIT|TERM)$ ]] ||
    return 1
  if [[ "${values_ref[interruption_reason]}" == "host_signal" ]]; then
    [[ "${values_ref[requested_signal]}" != "none" ]] || return 1
  elif [[ "${values_ref[interruption_reason]}" == "internal_abort" ]]; then
    # A later host signal can be latched after internal_abort became the first
    # terminal reason but before the atomic recovery record is published.
    :
  else
    [[ "${values_ref[requested_signal]}" == "none" &&
        "${values_ref[planned_target_signal]}" == "none" ]] || return 1
  fi

  if [[ "${values_ref[phase]:-}" == "interrupted-before-daemon-teardown" ]]; then
    [[ "${values_ref[scope_state]}" =~ ^(unavailable|active|inactive|absent|unknown)$ &&
        "${values_ref[status_file_state]}" =~ ^(declared|awaiting-command-status|valid|status-mismatch|invalid|missing|launcher-unreaped)$ &&
        "${values_ref[target_signal_attempted]}" == "0" &&
        "${values_ref[target_signal_api_outcome]}" == "not_attempted" &&
        "${values_ref[forwarded_target_signal]}" == "none" ]] || return 1
    if [[ "${values_ref[scope_state]}" == "active" &&
          "${values_ref[scope_control_group]}" == "unavailable" ]]; then
      return 1
    fi
    return 0
  fi

  [[ "${values_ref[scope_final_state]}" =~ ^(inactive|absent|unknown)$ &&
      "${values_ref[scope_leak_detected]}" =~ ^[01]$ &&
      "${values_ref[scope_kill_attempted]}" =~ ^[01]$ &&
      "${values_ref[scope_empty_proven]}" =~ ^[01]$ &&
      "${values_ref[status_file_matches]}" =~ ^[01]$ &&
      "${values_ref[target_signal_attempted]}" =~ ^[01]$ &&
      "${values_ref[forced_without_bound_target]}" =~ ^[01]$ &&
      "${values_ref[interrupted_without_bound_target]}" =~ ^[01]$ &&
      "${values_ref[docker_cli_forced]}" =~ ^[01]$ &&
      "${values_ref[docker_cli_force_attempted]}" =~ ^[01]$ &&
      "${values_ref[target_forced]}" =~ ^[01]$ &&
      "${values_ref[target_force_attempted]}" =~ ^[01]$ ]] || return 1
  scope_tuple="${values_ref[scope_leak_detected]}:${values_ref[scope_kill_attempted]}:${values_ref[scope_kill_outcome]}"
  [[ "${scope_tuple}" =~ ^(0:0:not_attempted|1:1:accepted|1:1:unknown)$ ]] || return 1
  if [[ "${values_ref[scope_empty_proven]}" == "1" ]]; then
    [[ "${values_ref[scope_final_state]}" =~ ^(inactive|absent)$ ]] || return 1
  else
    [[ "${values_ref[scope_final_state]}" == "unknown" &&
        "${values_ref[scope_leak_detected]}" == "1" ]] || return 1
  fi
  case "${values_ref[status_file_state]}" in
    valid)
      status_value="${values_ref[docker_command_status]}"
      systemd_value="${values_ref[systemd_run_status]}"
      [[ "${values_ref[status_file_matches]}" == "1" &&
          "${status_value}" =~ ^(0|[1-9][0-9]{0,2})$ &&
          "${systemd_value}" == "${status_value}" ]] || return 1
      (( 10#${status_value} <= 255 )) || return 1
      ;;
    status-mismatch)
      status_value="${values_ref[docker_command_status]}"
      systemd_value="${values_ref[systemd_run_status]}"
      [[ "${values_ref[status_file_matches]}" == "0" &&
          "${status_value}" =~ ^(0|[1-9][0-9]{0,2})$ &&
          "${systemd_value}" =~ ^(0|[1-9][0-9]{0,2})$ &&
          "${systemd_value}" != "${status_value}" ]] || return 1
      (( 10#${status_value} <= 255 && 10#${systemd_value} <= 255 )) || return 1
      ;;
    invalid|missing)
      systemd_value="${values_ref[systemd_run_status]}"
      [[ "${values_ref[status_file_matches]}" == "0" &&
          "${values_ref[docker_command_status]}" == "unavailable" &&
          "${systemd_value}" =~ ^(0|[1-9][0-9]{0,2})$ ]] || return 1
      (( 10#${systemd_value} <= 255 )) || return 1
      ;;
    launcher-unreaped)
      [[ "${values_ref[status_file_matches]}" == "0" &&
          "${values_ref[docker_command_status]}" == "unavailable" &&
          "${values_ref[systemd_run_status]}" == "unavailable" ]] || return 1
      ;;
    *) return 1 ;;
  esac
  signal_tuple="${values_ref[target_signal_attempted]}:${values_ref[target_signal_api_outcome]}:${values_ref[forwarded_target_signal]}"
  case "${signal_tuple}" in
    0:not_attempted:none|1:unknown:none) ;;
    1:accepted:HUP|1:accepted:INT|1:accepted:QUIT|1:accepted:TERM)
      [[ "${values_ref[forwarded_target_signal]}" == \
          "${values_ref[planned_target_signal]}" ]] || return 1
      ;;
    *) return 1 ;;
  esac
  force_tuple="${values_ref[docker_cli_force_attempted]}:${values_ref[docker_cli_forced]}:${values_ref[docker_cli_force_outcome]}"
  [[ "${force_tuple}" =~ ^(0:0:not_attempted|1:1:accepted|1:0:unknown)$ ]] || return 1
  force_tuple="${values_ref[target_force_attempted]}:${values_ref[target_forced]}:${values_ref[target_force_api_outcome]}"
  [[ "${force_tuple}" =~ ^(0:0:not_attempted|1:1:accepted|1:1:unknown)$ ]] || return 1
}

_qcsd_admission_records_match() {
  local supervision_name="$1"
  local recovery_name="$2"
  local root_kind="$3"
  local -n supervision_ref="${supervision_name}"
  local -n recovery_ref="${recovery_name}"
  local field
  local -a immutable_fields=(
    object supervisor_pid supervisor_start_time supervisor_session
    supervisor_process_group docker_context docker_host docker_server_id
    docker_daemon_id host_boot_id supervisor_label
  )
  if [[ "${root_kind}" == "run" ]]; then
    immutable_fields+=(process_identity_role mode scope_required scope_unit status_file)
  fi
  for field in "${immutable_fields[@]}"; do
    [[ "${supervision_ref[${field}]}" == "${recovery_ref[${field}]}" ]] ||
      return 1
  done
  if [[ "${root_kind}" == "run" ]]; then
    for field in scope_launcher_pid scope_launcher_start_time \
                 scope_launcher_session scope_launcher_process_group \
                 cli_pid cli_start_time cli_session cli_process_group \
                 container_id scope_control_group; do
      if [[ "${supervision_ref[${field}]}" != "unavailable" &&
            "${supervision_ref[${field}]}" != "${recovery_ref[${field}]}" ]]; then
        return 1
      fi
    done
  fi
}

_qcsd_admission_require_stale_supervisor() {
  local values_name="$1"
  local record="$2"
  local -n values_ref="${values_name}"
  if _qcsd_job_is_running \
      "${values_ref[supervisor_pid]}" "${values_ref[supervisor_start_time]}" \
      "${values_ref[supervisor_session]}" \
      "${values_ref[supervisor_process_group]}"; then
    echo "qcsd-lab Docker admission is blocked by an active prior supervisor: ${record}" >&2
    return 1
  fi
  if ! _qcsd_bound_process_is_gone \
      "${values_ref[supervisor_pid]}" "${values_ref[supervisor_start_time]}" \
      "${values_ref[supervisor_session]}" \
      "${values_ref[supervisor_process_group]}"; then
    echo "qcsd-lab Docker admission cannot prove the prior supervisor stopped: ${record}" >&2
    return 1
  fi
}

_qcsd_admission_validate_launcher_liveness() {
  local values_name="$1"
  local record="$2"
  local -n values_ref="${values_name}"
  local launcher_pid="${values_ref[scope_launcher_pid]}" owner
  [[ "${launcher_pid}" != "unavailable" ]] || return 0
  if _qcsd_job_is_running \
      "${launcher_pid}" "${values_ref[scope_launcher_start_time]}" \
      "${values_ref[scope_launcher_session]}" \
      "${values_ref[scope_launcher_process_group]}"; then
    owner="$(stat -c '%u' -- "/proc/${launcher_pid}" 2>/dev/null)" || {
      _qcsd_bound_process_is_gone \
        "${launcher_pid}" "${values_ref[scope_launcher_start_time]}" \
        "${values_ref[scope_launcher_session]}" \
        "${values_ref[scope_launcher_process_group]}" && return 0
      echo "qcsd-lab Docker admission cannot bind the stale scope launcher: ${record}" >&2
      return 1
    }
    [[ "${owner}" == "$(id -u)" ]] || {
      echo "qcsd-lab Docker admission refuses a foreign stale scope launcher: ${record}" >&2
      return 1
    }
    return 0
  fi
  _qcsd_bound_process_is_gone \
    "${launcher_pid}" "${values_ref[scope_launcher_start_time]}" \
    "${values_ref[scope_launcher_session]}" \
    "${values_ref[scope_launcher_process_group]}" || {
    echo "qcsd-lab Docker admission cannot prove the stale scope-launcher identity: ${record}" >&2
    return 1
  }
}

_qcsd_admission_validate_scope_liveness() {
  local values_name="$1"
  local record="$2"
  local -n values_ref="${values_name}"
  local recorded_group="${values_ref[scope_control_group]}"
  _qcsd_query_user_scope "${values_ref[scope_unit]}" || {
    echo "qcsd-lab Docker admission cannot query the bound stale run scope: ${record}" >&2
    return 1
  }
  if [[ "${recorded_group}" != "unavailable" &&
        "${_qcsd_scope_control_group}" != "unavailable" &&
        "${recorded_group}" != "${_qcsd_scope_control_group}" ]]; then
    echo "qcsd-lab Docker admission found a conflicting stale run-scope identity: ${record}" >&2
    return 1
  fi
}

_qcsd_admission_recover_run_scope() {
  local values_name="$1"
  local record_name="$2"
  local record="$3"
  local -n values_ref="${values_name}"
  local launcher_pid="${values_ref[scope_launcher_pid]}"
  if ! _qcsd_wait_user_scope_inactive "${values_ref[scope_unit]}"; then
    _qcsd_kill_user_scope "${values_ref[scope_unit]}" KILL || true
    if ! _qcsd_wait_user_scope_inactive "${values_ref[scope_unit]}"; then
      echo "qcsd-lab Docker admission cannot prove the stale run scope empty: ${record}" >&2
      return 1
    fi
  fi
  if [[ "${launcher_pid}" == "unavailable" ]]; then
    if [[ "${record_name}" == "SUPERVISION" &&
          "${values_ref[scope_state]}" == "declared" ]]; then
      return 0
    fi
    echo "qcsd-lab Docker admission lacks a bound stale scope-launcher identity: ${record}" >&2
    return 1
  fi
  if _qcsd_job_is_running \
      "${launcher_pid}" "${values_ref[scope_launcher_start_time]}" \
      "${values_ref[scope_launcher_session]}" \
      "${values_ref[scope_launcher_process_group]}"; then
    if [[ "$(stat -c '%u' -- "/proc/${launcher_pid}" 2>/dev/null)" != "$(id -u)" ]]; then
      echo "qcsd-lab Docker admission refuses a foreign stale scope launcher: ${record}" >&2
      return 1
    fi
    _qcsd_signal_bound_process_group \
      "${launcher_pid}" "${values_ref[scope_launcher_start_time]}" \
      "${values_ref[scope_launcher_session]}" \
      "${values_ref[scope_launcher_process_group]}" KILL || true
    _qcsd_wait_for_job_stop \
      "${launcher_pid}" "${values_ref[scope_launcher_start_time]}" \
      "${values_ref[scope_launcher_session]}" \
      "${values_ref[scope_launcher_process_group]}" \
      "${_QCSD_DOCKER_REAP_POLLS}" "${_QCSD_DOCKER_REAP_DELAY_SECONDS}" || true
  fi
  if ! _qcsd_bound_process_is_gone \
      "${launcher_pid}" "${values_ref[scope_launcher_start_time]}" \
      "${values_ref[scope_launcher_session]}" \
      "${values_ref[scope_launcher_process_group]}"; then
    echo "qcsd-lab Docker admission cannot prove the stale scope launcher stopped: ${record}" >&2
    return 1
  fi
}

_qcsd_admission_recover_container() {
  local values_name="$1"
  local supervisor_root="$2"
  local record="$3"
  local -n values_ref="${values_name}"
  local token="${values_ref[supervisor_label]#*=}"
  local recorded_id="${values_ref[container_id]}"
  local cidfile_id="" resolved_id="" resolved_state="unknown" presence snapshot
  local _qcsd_target_docker_context="${values_ref[docker_context]}"
  # Legacy run receipts predate an explicit request-authorised bit. Treat all
  # of them conservatively so a daemon-side create delayed beyond client death
  # becomes label-visible before the first recovery decision.
  sleep "${_QCSD_DOCKER_STALE_RUN_SETTLE_SECONDS}"
  if [[ -e "${supervisor_root}/container.cid" ||
        -L "${supervisor_root}/container.cid" ]]; then
    if ! cidfile_id="$(_qcsd_private_cid "${supervisor_root}/container.cid")"; then
      echo "qcsd-lab Docker admission found an invalid stale cidfile: ${record}" >&2
      return 1
    fi
    if [[ "${recorded_id}" == "unavailable" ]]; then
      recorded_id="${cidfile_id}"
    elif [[ "${recorded_id}" != "${cidfile_id}" ]]; then
      echo "qcsd-lab Docker admission found conflicting stale container IDs: ${record}" >&2
      return 1
    fi
  fi
  _qcsd_resolve_docker_target "" "${token}"
  resolved_state="${_qcsd_resolved_state}"
  resolved_id="${_qcsd_resolved_cid}"
  if [[ "${resolved_state}" == "unknown" ]]; then
    echo "qcsd-lab Docker admission cannot resolve one exact stale container: ${record}" >&2
    return 1
  fi
  if [[ "${recorded_id}" == "unavailable" &&
        "${resolved_state}" == "absent" ]]; then
    echo "qcsd-lab Docker admission cannot prove an authorised ID-less create terminal: ${record}" >&2
    return 1
  fi
  if [[ -n "${resolved_id}" ]]; then
    if [[ "${recorded_id}" != "unavailable" &&
          "${recorded_id}" != "${resolved_id}" ]]; then
      echo "qcsd-lab Docker admission found an ambiguous stale container identity: ${record}" >&2
      return 1
    fi
    recorded_id="${resolved_id}"
    [[ "${resolved_state}" =~ ^(running|stopped)$ ]] || return 1
    _qcsd_target_docker_api rm --force "${resolved_id}" >/dev/null 2>&1 || true
  elif [[ "${recorded_id}" != "unavailable" ]]; then
    presence="$(_qcsd_docker_exact_id_presence "${recorded_id}")"
    if [[ "${presence}" != "absent" ]]; then
      echo "qcsd-lab Docker admission found an unowned or ambiguous recorded container: ${record}" >&2
      return 1
    fi
  fi
  for snapshot in 1 2; do
    _qcsd_resolve_docker_target "" "${token}"
    [[ "${_qcsd_resolved_state}" == "absent" ]] || {
      echo "qcsd-lab Docker admission cannot prove stale container-label absence: ${record}" >&2
      return 1
    }
    if [[ "${recorded_id}" != "unavailable" ]]; then
      presence="$(_qcsd_docker_exact_id_presence "${recorded_id}")"
      [[ "${presence}" == "absent" ]] || {
        echo "qcsd-lab Docker admission cannot prove exact stale-container absence: ${record}" >&2
        return 1
      }
    fi
    (( snapshot == 2 )) || sleep 0.1
  done
}

_qcsd_admission_recover_network() {
  local values_name="$1"
  local record="$2"
  local -n values_ref="${values_name}"
  local token="${values_ref[supervisor_label]#*=}"
  local recorded_id="${values_ref[network_id]}"
  local resolved_id resolved_state presence snapshot
  local _qcsd_target_docker_context="${values_ref[docker_context]}"
  # A killed network supervisor may have left its bounded three-second Docker
  # API service alive.  Its systemd RuntimeMaxSec plus TimeoutStopSec is four
  # seconds; wait five before accepting label absence as terminal.
  sleep "${_QCSD_DOCKER_STALE_NETWORK_SETTLE_SECONDS}"
  _qcsd_resolve_docker_network "${token}" ""
  resolved_state="${_qcsd_resolved_network_state}"
  resolved_id="${_qcsd_resolved_network_id}"
  if [[ "${resolved_state}" == "unknown" ]]; then
    echo "qcsd-lab Docker admission cannot resolve one exact stale network: ${record}" >&2
    return 1
  fi
  if [[ "${recorded_id}" == "unavailable" &&
        "${resolved_state}" == "absent" ]]; then
    echo "qcsd-lab Docker admission cannot prove an authorised ID-less network create terminal: ${record}" >&2
    return 1
  fi
  if [[ -n "${resolved_id}" ]]; then
    if [[ "${recorded_id}" != "unavailable" &&
          "${recorded_id}" != "${resolved_id}" ]]; then
      echo "qcsd-lab Docker admission found an ambiguous stale network identity: ${record}" >&2
      return 1
    fi
    recorded_id="${resolved_id}"
    [[ "${resolved_state}" == "present" ]] || return 1
    _qcsd_target_docker_api network rm "${resolved_id}" >/dev/null 2>&1 || true
  elif [[ "${recorded_id}" != "unavailable" ]]; then
    presence="$(_qcsd_docker_exact_network_presence "${recorded_id}")"
    if [[ "${presence}" != "absent" ]]; then
      echo "qcsd-lab Docker admission found an unowned or ambiguous recorded network: ${record}" >&2
      return 1
    fi
  fi
  for snapshot in 1 2; do
    _qcsd_resolve_docker_network "${token}" ""
    [[ "${_qcsd_resolved_network_state}" == "absent" ]] || {
      echo "qcsd-lab Docker admission cannot prove stale network-label absence: ${record}" >&2
      return 1
    }
    if [[ "${recorded_id}" != "unavailable" ]]; then
      presence="$(_qcsd_docker_exact_network_presence "${recorded_id}")"
      [[ "${presence}" == "absent" ]] || {
        echo "qcsd-lab Docker admission cannot prove exact stale-network absence: ${record}" >&2
        return 1
      }
    fi
    (( snapshot == 2 )) || sleep 0.1
  done
}

_qcsd_admission_remove_recovered_root() {
  local supervisor_root="$1"
  local root_kind="$2"
  _qcsd_admission_validate_root_entries "${supervisor_root}" "${root_kind}" || {
    echo "qcsd-lab Docker admission lost the private supervisor-root identity: ${supervisor_root}" >&2
    return 1
  }
  if [[ "${root_kind}" == "run" ]]; then
    rm -f -- "${supervisor_root}/container.cid" \
      "${supervisor_root}/run.status" "${supervisor_root}/stdout" \
      "${supervisor_root}/wait.pipe" || return 1
    sync -f "${supervisor_root}" || return 1
  fi
  if [[ -e "${supervisor_root}/SUPERVISION" ]]; then
    rm -f -- "${supervisor_root}/SUPERVISION" || return 1
    sync -f "${supervisor_root}" || return 1
  fi
  if [[ -e "${supervisor_root}/RECOVERY" ]]; then
    rm -f -- "${supervisor_root}/RECOVERY" || return 1
    sync -f "${supervisor_root}" || return 1
  fi
  rmdir -- "${supervisor_root}" || return 1
  sync -f /tmp
}

_qcsd_admission_root_manifest_sha256() {
  local supervisor_root="$1" root_kind="$2" entry name metadata digest root_metadata
  _qcsd_admission_validate_root_entries "${supervisor_root}" "${root_kind}" ||
    return 1
  root_metadata="$(stat -Lc '%d:%i:%u:%a:%F' -- "${supervisor_root}" 2>/dev/null)" ||
    return 1
  {
    printf '.\t%s\tdirectory\n' "${root_metadata}"
    for entry in "${supervisor_root}"/*; do
      [[ -e "${entry}" || -L "${entry}" ]] || continue
      name="${entry##*/}"
      metadata="$(stat -Lc '%d:%i:%u:%a:%h:%s:%F' -- "${entry}" 2>/dev/null)" ||
        return 1
      if [[ -f "${entry}" && ! -L "${entry}" ]]; then
        digest="$(sha256sum -- "${entry}" | awk '{print $1}')" || return 1
      else
        digest=non-regular
      fi
      printf '%s\t%s\t%s\n' "${name}" "${metadata}" "${digest}"
    done
  } | sha256sum | awk '{print $1}'
}

_qcsd_admission_claim_unique() {
  local claims_name="$1"
  local identity="$2"
  local supervisor_root="$3"
  local description="$4"
  local -n claims_ref="${claims_name}"
  if [[ -n "${claims_ref[${identity}]+present}" ]]; then
    echo "qcsd-lab Docker admission found an ambiguous duplicate ${description}: ${supervisor_root}" >&2
    return 1
  fi
  claims_ref["${identity}"]="${supervisor_root}"
}

_qcsd_admission_recover_root() {
  local supervisor_root="$1"
  local root_kind="$2"
  local action="${3:-recover}"
  local current_uid root_metadata record_name selected_name selected_record
  local validated_object_id="unavailable" validated_cid=""
  local supervision_path="${supervisor_root}/SUPERVISION"
  local recovery_path="${supervisor_root}/RECOVERY"
  local -A supervision_values=() recovery_values=()
  local -a supervision_order=() recovery_order=()
  current_uid="$(id -u)"
  [[ ! -L "${supervisor_root}" && -d "${supervisor_root}" ]] || {
    echo "qcsd-lab Docker admission found an unsafe prior supervisor root: ${supervisor_root}" >&2
    return 1
  }
  root_metadata="$(stat -c '%u:%a:%F' -- "${supervisor_root}" 2>/dev/null)" || return 1
  [[ "${root_metadata}" == "${current_uid}:700:directory" ]] || {
    echo "qcsd-lab Docker admission found an unsafe prior supervisor root: ${supervisor_root}" >&2
    return 1
  }
  _qcsd_admission_validate_root_entries "${supervisor_root}" "${root_kind}" || {
    echo "qcsd-lab Docker admission found unsafe or malformed prior supervisor contents: ${supervisor_root}" >&2
    return 1
  }
  if [[ ! -e "${supervision_path}" && ! -e "${recovery_path}" ]]; then
    echo "qcsd-lab Docker admission found a prior supervisor root without a final record: ${supervisor_root}" >&2
    return 1
  fi
  if [[ -e "${supervision_path}" ]]; then
    _qcsd_admission_parse_record \
      "${supervision_path}" supervision_values supervision_order || {
      echo "qcsd-lab Docker admission found a malformed record: ${supervision_path}" >&2
      return 1
    }
    if [[ "${root_kind}" == "run" ]]; then
      _qcsd_admission_validate_run_record supervision_values supervision_order \
        SUPERVISION "${supervisor_root}" || {
        echo "qcsd-lab Docker admission found a malformed record: ${supervision_path}" >&2
        return 1
      }
    else
      _qcsd_admission_validate_network_record \
        supervision_values supervision_order SUPERVISION || {
        echo "qcsd-lab Docker admission found a malformed record: ${supervision_path}" >&2
        return 1
      }
    fi
  fi
  if [[ -e "${recovery_path}" ]]; then
    _qcsd_admission_parse_record \
      "${recovery_path}" recovery_values recovery_order || {
      echo "qcsd-lab Docker admission found a malformed record: ${recovery_path}" >&2
      return 1
    }
    if [[ "${root_kind}" == "run" ]]; then
      _qcsd_admission_validate_run_record recovery_values recovery_order \
        RECOVERY "${supervisor_root}" || {
        echo "qcsd-lab Docker admission found a malformed record: ${recovery_path}" >&2
        return 1
      }
    else
      _qcsd_admission_validate_network_record \
        recovery_values recovery_order RECOVERY || {
        echo "qcsd-lab Docker admission found a malformed record: ${recovery_path}" >&2
        return 1
      }
    fi
  fi
  if [[ -e "${supervision_path}" && -e "${recovery_path}" ]]; then
    _qcsd_admission_records_match \
      supervision_values recovery_values "${root_kind}" || {
      echo "qcsd-lab Docker admission found ambiguous coexisting supervisor records: ${supervisor_root}" >&2
      return 1
    }
  fi
  if [[ -e "${recovery_path}" ]]; then
    selected_name=recovery_values
    selected_record="${recovery_path}"
    record_name=RECOVERY
  else
    selected_name=supervision_values
    selected_record="${supervision_path}"
    record_name=SUPERVISION
  fi
  local -n selected_values_ref="${selected_name}"
  if [[ "${root_kind}" == "run" ]]; then
    validated_object_id="${selected_values_ref[container_id]}"
    if [[ -e "${supervisor_root}/container.cid" ||
          -L "${supervisor_root}/container.cid" ]]; then
      validated_cid="$(_qcsd_private_cid "${supervisor_root}/container.cid")" || {
        echo "qcsd-lab Docker admission found an invalid stale cidfile: ${selected_record}" >&2
        return 1
      }
      if [[ "${validated_object_id}" != "unavailable" &&
            "${validated_object_id}" != "${validated_cid}" ]]; then
        echo "qcsd-lab Docker admission found conflicting stale container IDs: ${selected_record}" >&2
        return 1
      fi
      validated_object_id="${validated_cid}"
    fi
  else
    validated_object_id="${selected_values_ref[network_id]}"
  fi
  _qcsd_admission_require_stale_supervisor \
    "${selected_name}" "${selected_record}" || return 1
  if [[ "${root_kind}" == "run" ]]; then
    _qcsd_admission_validate_launcher_liveness \
      "${selected_name}" "${selected_record}" || return 1
    _qcsd_admission_validate_scope_liveness \
      "${selected_name}" "${selected_record}" || return 1
  fi
  if [[ "${action}" == "validate" ]]; then
    _QCSD_ADMISSION_VALIDATED_RECORD="${selected_record}"
    _QCSD_ADMISSION_VALIDATED_RECORD_SHA256="$(sha256sum -- "${selected_record}" | awk '{print $1}')" ||
      return 1
    _QCSD_ADMISSION_VALIDATED_LABEL="${selected_values_ref[supervisor_label]}"
    _QCSD_ADMISSION_VALIDATED_SCOPE_UNIT="unavailable"
    _QCSD_ADMISSION_VALIDATED_OBJECT_ID="unavailable"
    _QCSD_ADMISSION_VALIDATED_LAUNCHER_TUPLE="unavailable"
    if [[ "${root_kind}" == "run" ]]; then
      _QCSD_ADMISSION_VALIDATED_SCOPE_UNIT="${selected_values_ref[scope_unit]}"
      if [[ "${selected_values_ref[scope_launcher_pid]}" != unavailable ]]; then
        _QCSD_ADMISSION_VALIDATED_LAUNCHER_TUPLE="${selected_values_ref[scope_launcher_pid]}:${selected_values_ref[scope_launcher_start_time]}:${selected_values_ref[scope_launcher_session]}:${selected_values_ref[scope_launcher_process_group]}"
      fi
    fi
    _QCSD_ADMISSION_VALIDATED_OBJECT_ID="${validated_object_id}"
    _QCSD_ADMISSION_VALIDATED_MANIFEST_SHA256="$(_qcsd_admission_root_manifest_sha256 \
      "${supervisor_root}" "${root_kind}")" || return 1
    return 0
  fi
  [[ "${action}" == "recover" ]] || return 1
  local selected_record_snapshot="${selected_record}"
  local selected_sha_snapshot manifest_snapshot label_snapshot scope_snapshot object_snapshot
  selected_sha_snapshot="$(sha256sum -- "${selected_record}" | awk '{print $1}')" || return 1
  manifest_snapshot="$(_qcsd_admission_root_manifest_sha256 \
    "${supervisor_root}" "${root_kind}")" || return 1
  label_snapshot="${selected_values_ref[supervisor_label]}"
  scope_snapshot="unavailable"
  [[ "${root_kind}" != run ]] || scope_snapshot="${selected_values_ref[scope_unit]}"
  object_snapshot="${validated_object_id}"
  if [[ "${root_kind}" == "run" ]]; then
    _qcsd_admission_recover_run_scope \
      "${selected_name}" "${record_name}" "${selected_record}" || return 1
    _qcsd_admission_recover_container \
      "${selected_name}" "${supervisor_root}" "${selected_record}" || return 1
  else
    _qcsd_admission_recover_network \
      "${selected_name}" "${selected_record}" || return 1
  fi
  _qcsd_admission_recover_root "${supervisor_root}" "${root_kind}" validate || return 1
  [[ "${_QCSD_ADMISSION_VALIDATED_RECORD}" == "${selected_record_snapshot}" &&
      "${_QCSD_ADMISSION_VALIDATED_RECORD_SHA256}" == "${selected_sha_snapshot}" &&
      "${_QCSD_ADMISSION_VALIDATED_MANIFEST_SHA256}" == "${manifest_snapshot}" &&
      "${_QCSD_ADMISSION_VALIDATED_LABEL}" == "${label_snapshot}" &&
      "${_QCSD_ADMISSION_VALIDATED_SCOPE_UNIT}" == "${scope_snapshot}" &&
      "${_QCSD_ADMISSION_VALIDATED_OBJECT_ID}" == "${object_snapshot}" ]] || {
    echo "qcsd-lab Docker admission observed changed stale ownership evidence: ${supervisor_root}" >&2
    return 1
  }
  _qcsd_admission_remove_recovered_root \
    "${supervisor_root}" "${root_kind}" || {
    echo "qcsd-lab Docker admission could not remove a verified stale supervisor root: ${supervisor_root}" >&2
    return 1
  }
  echo "qcsd-lab Docker admission recovered verified stale ${root_kind} state: ${supervisor_root}" >&2
}

reconcile_legacy_stale_docker_supervisors() {
  local supervisor_root nullglob_was_set=0
  local -a run_roots=() network_roots=()
  local -A seen_labels=() seen_scope_units=() seen_launcher_tuples=()
  local -A seen_container_ids=() seen_network_ids=()
  command -v grep >/dev/null 2>&1 &&
    command -v od >/dev/null 2>&1 &&
    command -v realpath >/dev/null 2>&1 &&
    command -v stat >/dev/null 2>&1 &&
    command -v sync >/dev/null 2>&1 || {
    echo "qcsd-lab Docker admission requires grep, od, realpath, stat, and sync" >&2
    return 1
  }
  _qcsd_secure_tmp_root || {
    echo "qcsd-lab Docker admission cannot establish a secure shared temporary root" >&2
    return 1
  }
  IFS= read -r qcsd_admission_boot_id </proc/sys/kernel/random/boot_id ||
    qcsd_admission_boot_id=""
  [[ "${qcsd_admission_boot_id}" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || {
    echo "qcsd-lab Docker admission cannot bind the current host boot" >&2
    return 1
  }
  shopt -q nullglob && nullglob_was_set=1
  shopt -s nullglob
  run_roots=(/tmp/qcsd-docker-supervisor.*)
  network_roots=(/tmp/qcsd-docker-network-supervisor.*)
  (( nullglob_was_set )) || shopt -u nullglob
  # Validate the complete initial admission set before changing an owned scope
  # or Docker object.  Each root is validated again immediately before its
  # recovery so a concurrent state change fails closed.
  for supervisor_root in "${run_roots[@]}"; do
    [[ "${supervisor_root##*/}" =~ ^qcsd-docker-supervisor[.][A-Za-z0-9]{8}$ ]] || {
      echo "qcsd-lab Docker admission found an invalid reserved run-root name: ${supervisor_root}" >&2
      return 1
    }
    _qcsd_admission_recover_root "${supervisor_root}" run validate || return 1
    _qcsd_admission_claim_unique seen_labels \
      "${_QCSD_ADMISSION_VALIDATED_LABEL}" "${supervisor_root}" \
      "supervisor-label nonce" || return 1
    _qcsd_admission_claim_unique seen_scope_units \
      "${_QCSD_ADMISSION_VALIDATED_SCOPE_UNIT}" "${supervisor_root}" \
      "run-scope unit" || return 1
    if [[ "${_QCSD_ADMISSION_VALIDATED_LAUNCHER_TUPLE}" != unavailable ]]; then
      _qcsd_admission_claim_unique seen_launcher_tuples \
        "${_QCSD_ADMISSION_VALIDATED_LAUNCHER_TUPLE}" "${supervisor_root}" \
        "scope-launcher identity tuple" || return 1
    fi
    if [[ "${_QCSD_ADMISSION_VALIDATED_OBJECT_ID}" != "unavailable" ]]; then
      _qcsd_admission_claim_unique seen_container_ids \
        "${_QCSD_ADMISSION_VALIDATED_OBJECT_ID}" "${supervisor_root}" \
        "container ID" || return 1
    fi
  done
  for supervisor_root in "${network_roots[@]}"; do
    [[ "${supervisor_root##*/}" =~ ^qcsd-docker-network-supervisor[.][A-Za-z0-9]{8}$ ]] || {
      echo "qcsd-lab Docker admission found an invalid reserved network-root name: ${supervisor_root}" >&2
      return 1
    }
    _qcsd_admission_recover_root "${supervisor_root}" network validate || return 1
    _qcsd_admission_claim_unique seen_labels \
      "${_QCSD_ADMISSION_VALIDATED_LABEL}" "${supervisor_root}" \
      "supervisor-label nonce" || return 1
    if [[ "${_QCSD_ADMISSION_VALIDATED_OBJECT_ID}" != "unavailable" ]]; then
      _qcsd_admission_claim_unique seen_network_ids \
        "${_QCSD_ADMISSION_VALIDATED_OBJECT_ID}" "${supervisor_root}" \
        "network ID" || return 1
    fi
  done
  for supervisor_root in "${run_roots[@]}"; do
    _qcsd_admission_recover_root "${supervisor_root}" run recover || return 1
  done
  for supervisor_root in "${network_roots[@]}"; do
    _qcsd_admission_recover_root "${supervisor_root}" network recover || return 1
  done
}

_qcsd_validate_lifecycle_guardian() {
  local proof parsed ready_fd go_fd go_nonce observed extra key
  local loaded_helper_device loaded_helper_tail loaded_helper_inode
  local expected_guardian expected_guardian_metadata expected_guardian_sha
  local ambient_guardian_fd_path ambient_guardian_metadata ambient_guardian_sha
  local expected_guardian_device expected_guardian_tail expected_guardian_inode
  local self_start self_parent self_session self_pgrp guardian_start guardian_uid
  local -a fields=()
  [[ "${QCSD_DOCKER_LOCK_GUARDIAN_PID:-}" =~ ^[1-9][0-9]*$ &&
      "${QCSD_DOCKER_LOCK_GUARDIAN_SOURCE_FD:-}" =~ ^[0-9]+$ ]] || return 1
  # Do not let the ambient handshake select its own verifier.  Bind it first
  # to the checked-in guardian and to this shell's exact direct parent.
  expected_guardian="${ROOT}/tools/docker_lifecycle_lock_guardian.py"
  [[ -f "${expected_guardian}" && ! -L "${expected_guardian}" ]] || return 1
  expected_guardian_metadata="$(stat -Lc '%d:%i:%u:%a:%h:%F' -- \
    "${expected_guardian}")" || return 1
  [[ "${expected_guardian_metadata}" == *":$(id -u):644:1:regular file" ]] || return 1
  expected_guardian_device="${expected_guardian_metadata%%:*}"
  expected_guardian_tail="${expected_guardian_metadata#*:}"
  expected_guardian_inode="${expected_guardian_tail%%:*}"
  expected_guardian_sha="$(sha256sum -- "${expected_guardian}")" || return 1
  expected_guardian_sha="${expected_guardian_sha%% *}"
  [[ "${expected_guardian_sha}" =~ ^[0-9a-f]{64}$ ]] || return 1
  [[ "${QCSD_DOCKER_LOCK_GUARDIAN_PID}" == "${PPID}" ]] || return 1
  read -r self_start self_parent self_session self_pgrp < <(/usr/bin/python3 -I - \
      "${QCSD_DOCKER_LOCK_GUARDIAN_INNER_PID:-0}" <<'PY'
import pathlib, sys
raw = pathlib.Path(f"/proc/{int(sys.argv[1])}/stat").read_text()
fields = raw.rsplit(") ", 1)[1].split()
print(fields[19], fields[1], fields[3], fields[2])
PY
  ) || return 1
  [[ "${self_parent}" == "${QCSD_DOCKER_LOCK_GUARDIAN_PID}" &&
      "${QCSD_DOCKER_LOCK_GUARDIAN_INNER_PID:-}" =~ ^[1-9][0-9]*$ &&
      "${QCSD_DOCKER_LOCK_GUARDIAN_INNER_START_TIME:-}" == "${self_start}" &&
      "${QCSD_DOCKER_LOCK_GUARDIAN_INNER_SESSION:-}" == "${self_session}" &&
      "${QCSD_DOCKER_LOCK_GUARDIAN_INNER_PROCESS_GROUP:-}" == "${self_pgrp}" ]] || return 1
  read -r guardian_start guardian_uid < <(/usr/bin/python3 -I - \
      "${QCSD_DOCKER_LOCK_GUARDIAN_PID}" <<'PY'
import os, pathlib, sys
pid = int(sys.argv[1])
raw = pathlib.Path(f"/proc/{pid}/stat").read_text()
fields = raw.rsplit(") ", 1)[1].split()
print(fields[19], os.stat(f"/proc/{pid}").st_uid)
PY
  ) || return 1
  [[ "${guardian_start}" == "${QCSD_DOCKER_LOCK_GUARDIAN_START_TIME:-}" &&
      "${guardian_uid}" == "$(id -u)" ]] || return 1
  ambient_guardian_fd_path="/proc/${QCSD_DOCKER_LOCK_GUARDIAN_PID}/fd/${QCSD_DOCKER_LOCK_GUARDIAN_SOURCE_FD}"
  [[ -f "${ambient_guardian_fd_path}" ]] || return 1
  ambient_guardian_metadata="$(stat -Lc '%d:%i:%u:%a:%h:%F' -- \
    "${ambient_guardian_fd_path}")" || return 1
  [[ "${ambient_guardian_metadata}" == "${expected_guardian_metadata}" ]] || return 1
  ambient_guardian_sha="$(sha256sum -- "${ambient_guardian_fd_path}")" || return 1
  ambient_guardian_sha="${ambient_guardian_sha%% *}"
  [[ "${ambient_guardian_sha}" == "${expected_guardian_sha}" &&
      "${QCSD_DOCKER_LOCK_GUARDIAN_SOURCE_PATH:-}" == "${expected_guardian}" &&
      "${QCSD_DOCKER_LOCK_GUARDIAN_SOURCE_DEVICE:-}" == "${expected_guardian_device}" &&
      "${QCSD_DOCKER_LOCK_GUARDIAN_SOURCE_INODE:-}" == "${expected_guardian_inode}" ]] || return 1
  ready_fd="${QCSD_DOCKER_LOCK_GUARDIAN_READY_FD:-}"
  proof="$(/usr/bin/python3 -I \
    "/proc/${QCSD_DOCKER_LOCK_GUARDIAN_PID}/fd/${QCSD_DOCKER_LOCK_GUARDIAN_SOURCE_FD}" \
    --verify-inner)" || return 1
  [[ "${ready_fd}" =~ ^[0-9]+$ ]] || return 1
  eval "exec ${ready_fd}>&-" || return 1
  parsed="$(/usr/bin/python3 -I -c '
import json,sys
v=json.loads(sys.stdin.read())
keys=("schema","boot_id","guardian_pid","guardian_source_device",
"guardian_source_inode","guardian_source_path","guardian_source_sha256",
"guardian_start_time","go_fd","go_nonce","helper_source_device",
"helper_source_inode","helper_source_path","helper_source_sha256","lease_nonce",
"lease_socket","lock_device","lock_inode","lock_parent_device",
"lock_parent_inode","lock_path","native_source_device","native_source_inode",
"native_source_path","native_source_sha256","qcsd_pid","qcsd_source_device",
"qcsd_source_fd","qcsd_source_inode","qcsd_source_path","qcsd_source_sha256",
"qcsd_start_time","docker_config_device","docker_config_inode","docker_config_path",
"buildx_config_device","buildx_config_inode","buildx_config_path")
if set(v)!=set(keys) or v["schema"]!=1: raise SystemExit(1)
for k in keys: print(v[k])
' <<<"${proof}")" || return 1
  mapfile -t fields <<<"${parsed}"
  (( ${#fields[@]} == 38 )) || return 1
  _QCSD_LIFECYCLE_BOOT_ID="${fields[1]}"
  _QCSD_LIFECYCLE_GUARD_PID="${fields[2]}"
  _QCSD_LIFECYCLE_GUARD_SOURCE_DEVICE="${fields[3]}"
  _QCSD_LIFECYCLE_GUARD_SOURCE_INODE="${fields[4]}"
  _QCSD_LIFECYCLE_GUARD_SOURCE_PATH="${fields[5]}"
  _QCSD_LIFECYCLE_GUARD_SOURCE_SHA256="${fields[6]}"
  _QCSD_LIFECYCLE_GUARD_START="${fields[7]}"
  go_fd="${fields[8]}"; go_nonce="${fields[9]}"
  _QCSD_LIFECYCLE_HELPER_SOURCE_DEVICE="${fields[10]}"
  _QCSD_LIFECYCLE_HELPER_SOURCE_INODE="${fields[11]}"
  _QCSD_LIFECYCLE_HELPER_SOURCE_PATH="${fields[12]}"
  _QCSD_LIFECYCLE_HELPER_SHA256="${fields[13]}"
  _QCSD_LIFECYCLE_LEASE_NONCE="${fields[14]}"
  _QCSD_LIFECYCLE_LEASE_SOCKET="${fields[15]}"
  _QCSD_LIFECYCLE_LOCK_DEVICE="${fields[16]}"
  _QCSD_LIFECYCLE_LOCK_INODE="${fields[17]}"
