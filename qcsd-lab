import json
import subprocess
import sys

def observed(*command: str):
    completed = subprocess.run(command, text=True, capture_output=True, check=False)
    if completed.returncode != 0:
        raise SystemExit(
            f"network observation failed ({command!r}): {completed.stderr.strip()}"
        )
